// The liquid-glass blur pyramid, encoded as render passes.
//
// This is the same filter `Shaders/UiGlassBlurH.ksl` and `UiGlassBlurV.ksl`
// dispatch, reached through a fullscreen draw instead of a compute grid, for a
// backend that cannot encode a dispatch — and, through KIRA_GLASS_REFERENCE, as
// the A/B that says whether a difference came from the effect or from the way
// it was encoded. That only answers anything if both encodings run the *same*
// arithmetic, which is why the taps live in `UiGlassBlurCommon` and neither
// file spells a weight.
//
// The filter is separable: one pass along x, then one along y, each stepping by
// one texel of the level it is writing. `axis` carries that step in the source's
// uv, so a pass is horizontal or vertical by what the host put in the uniform —
// the shader has no axis of its own. `level` picks near or far; the two differ
// only in tap count and spread, and a uniform branch is coherent across the
// whole draw.
//
// The vertex stage draws one oversized triangle rather than a quad: three
// vertices cover the screen with no diagonal seam, and the positions are
// derived from the vertex index rather than pulled from a buffer.

import UiGlassBlurCommon

type VertexIn {
    @builtin(vertex_index)
    let vid: UInt
}

type VertexOut {
    @builtin(position)
    let clip_position: Float4
    let uv: Float2
    let axis: Float2
    let level: Float
}

type FragmentOut {
    let color: Float4
}

type BlurParams {
    // One texel of the target along the axis this pass filters, in the source's
    // uv — (1/width, 0) horizontally, (0, 1/height) vertically. Then which
    // level of the pyramid to produce: below 0.5 near, at or above it far.
    let stepX: Float
    let stepY: Float
    let level: Float
    let padding: Float
}

shader UiBlur {
    group Pass {
        uniform params: BlurParams
        texture source: Texture2d
        sampler linear: Sampler
    }

    vertex {
        input VertexIn
        output VertexOut

        function entry(input: VertexIn) -> VertexOut {
            let far = 3.0
            let near = 0.0 - 1.0
            let x = near
            if input.vid == UInt(1) {
                x = far
            }
            let y = near
            if input.vid == UInt(2) {
                y = far
            }
            let out: VertexOut
            out.clip_position = Float4(x, y, 0.0, 1.0)
            out.uv = Float2((x + 1.0) * 0.5, (1.0 - y) * 0.5)
            out.axis = Float2(params.stepX, params.stepY)
            out.level = params.level
            return out
        }
    }

    fragment {
        input VertexOut
        output FragmentOut

        function entry(input: VertexOut) -> FragmentOut {
            let result: FragmentOut
            if input.level >= 0.5 {
                result.color = UiGlassBlurCommon.farFilter(source, linear, input.uv, input.axis)
            } else {
                result.color = UiGlassBlurCommon.nearFilter(source, linear, input.uv, input.axis)
            }
            return result
        }
    }
}
