// The UI compositor's single shader. Every primitive the UI Foundation draws goes
// through it, selected per vertex by `mode`:
//   0 — SDF rounded-rect / border surface (local = pixel offset from the centre)
//   1 — glyph or icon coverage from the atlas (local = uv)
//   2 — an external texture (a TextureView), `local` carrying its uv
//   3 — liquid glass: refract the captured backdrop through the rounded shape
//   4 — adaptive glyph: ink chosen from the capture under the run
//
// Geometry is pulled by index from a storage buffer rather than described by a
// vertex layout, so one buffer feeds every mode with no per-primitive layout.
//
// The buffer holds one record per QUAD, not per vertex. Six of the values a vertex
// needs differ between the four corners and eighteen are the same for all of them,
// so a per-vertex buffer wrote those eighteen numbers four times over — and a
// screen of text is one quad per glyph. The record carries each corner-varying
// value as its two extremes, and the vertex stage picks the one its corner wants.
//
// Both extremes are stored as the vertex stage will emit them, INCLUDING the clip
// position, which the host computes rather than this stage deriving it from a
// viewport. The pick is `mix` against a weight of exactly 0 or 1, which returns one
// operand unchanged, so every value the stage produces is the number the host
// wrote — the change is invisible in the framebuffer rather than merely close.
//
// Field reuse per mode is the price of one shader: mode 3 carries the glass rect's
// uv transform in `border` (rg = centre, ba = half-size) and its wash strength in
// `borderWidth`; mode 4 carries the run's sample point in `border.rg`, the wash in
// `borderWidth` and the wash colour's luminance in `edgeRefraction`.

type UiQuad {
    // Clip position and pixel position at the top-left and bottom-right corners.
    let posX0: Float
    let posY0: Float
    let posX1: Float
    let posY1: Float
    let pxX0: Float
    let pxY0: Float
    let pxX1: Float
    let pxY1: Float
    // `local` at the same two corners: the SDF offset from the centre for a
    // surface, the atlas uv for a glyph.
    let localX0: Float
    let localY0: Float
    let localX1: Float
    let localY1: Float
    let halfW: Float
    let halfH: Float
    let radius: Float
    let borderWidth: Float
    let mode: Float
    let edgeRefraction: Float
    let fillR: Float
    let fillG: Float
    let fillB: Float
    let fillA: Float
    let borderR: Float
    let borderG: Float
    let borderB: Float
    let borderA: Float
    let clipMinX: Float
    let clipMinY: Float
    let clipMaxX: Float
    let clipMaxY: Float
    // The material block: what a liquid-glass surface shades itself with. Carried
    // per vertex so two surfaces in one frame can differ, and so a control can
    // move one without recompiling the shader. Zero in every other mode.
    let edgeStrokeStrength: Float
    let edgeStrokeDarken: Float
    let edgeStrokePeak: Float
    let edgeStrokeFade: Float
    let sheenStrength: Float
    let lensMaxBend: Float
    let refractionReach: Float
    let blurNearSplit: Float
    // The border block: the ring's spread (already snapped to a whole device
    // pixel by the host), the offset/spread of the pair that reach past the left
    // and right extremes, and the grey they are all drawn in.
    let borderSpread: Float
    let borderSideOffset: Float
    let borderSideSpread: Float
    let borderGrey: Float
    // The sides are drawn in their own, darker grey — measured off the reference,
    // where the left and right edges are #C7C7C7 at full coverage while the top and
    // bottom are a half-covered #DBDBDB.
    let borderSideGrey: Float
    // The inner rim: how strongly it tints, and how far in from the edge it runs.
    let innerRimStrength: Float
    let innerRimWidth: Float
    // The wash, as the platform authors it: two fills, each with a colour, an
    // opacity and a blend mode. The LOWER layer's colour is `fill` and its opacity
    // is `borderWidth` (mode 3 has no border of its own to describe), so what is
    // carried here is that layer's blend mode and the upper layer whole.
    let washBlend: Float
    let washUpperR: Float
    let washUpperG: Float
    let washUpperB: Float
    let washUpperAlpha: Float
    let washUpperBlend: Float
    let materialSpare0: Float
    let materialSpare1: Float
    let materialSpare2: Float
}

type VertexIn {
    @builtin(vertex_index)
    let vid: UInt
}

type VertexOut {
    @builtin(position)
    let clip_position: Float4

    let local: Float2
    let px: Float2
    let hsize: Float2
    let radius: Float
    let borderWidth: Float
    let mode: Float
    let edgeRefraction: Float
    let fill: Float4
    let border: Float4
    let clip: Float4
    // The material block, packed as three vectors: stroke strength / darken /
    // peak / fade, sheen / lens bend / refraction reach / blur split, and the
    // border's ring spread / side offset / side spread / grey.
    let edge: Float4
    let lens: Float4
    let borderStack: Float4
    // Ring grey in x, side grey in y, then the inner rim's strength and width.
    let borderInk: Float4
    // The wash's upper layer: colour in xyz, opacity in w.
    let wash: Float4
    // The two layers' blend modes: lower in x, upper in y.
    let washBlend: Float2
}

type FragmentOut {
    let color: Float4
}

// --- material constants ----------------------------------------------------
// Every number the material shades with is named here. Nothing below is written
// inline at its use site.

// The edge stroke, the sheen's strength, the lens and the blur split are per
// SURFACE now (FoundationGlassMaterial, carried in the vertex) — a value a control
// can move. What stays here is the shape of the falloff rather than its amount:
// the sheen's band inside the stroke.
function sheenStart() -> Float { return 2.0 }
function sheenEnd() -> Float { return 5.0 }

// The wash ceiling — how opaque a frost step may ever make the surface. It guards
// the LOWER layer only: that one's opacity is a number a surface (or a slider) can
// write freely, while the upper layer's comes out of the platform table, where an
// opacity of 1 is a real value and clamping it would be a transcription error.
function washCeiling() -> Float { return 0.9 }

// The shadow stack under a glass element, straight from the design document:
//   drop shadow  X  1.25  Y 0  blur 0  spread -0.75  #DBDBDB 100%
//   drop shadow  X -1.25  Y 0  blur 0  spread -0.75  #DBDBDB 100%
//   drop shadow  X  0     Y 0  blur 0  spread  0.5   #DBDBDB 100%
//   (a fourth — Y 8, blur 48, black 25% — is present but DISABLED)
//
// All three that are on have zero blur, which makes them BORDERS rather than
// shadows: a zero-blur shadow is the silhouette drawn behind the element, so the
// only part that shows is the band its spread pushes past the shape. The
// spread-0.5 ring is the edge itself; the +-1.25 pair at spread -0.75 reaches 0.5
// past the left and right extremes and thickens the sides.
//
// The disabled fourth is what an ambient shadow would be, and it stays off here:
// with it on, 25% black blurred 48 sits at the same value as #DBDBDB right at the
// edge, and the border it is meant to sit under stops reading at all. An app that
// wants the element to cast a shadow composes one under it.
// Its numbers are per surface (FoundationGlassMaterial's border block), so the
// document's values are defaults rather than something compiled in.

// The band at the edge over which blur fades in (the rim stays crisp).
function blurEdgeStart() -> Float { return 2.0 }
function blurEdgeEnd() -> Float { return 22.0 }

// Adaptive text: the composite luminance either side of which a run inks itself
// dark or light, and the dark ink (the light one is white).
function inkDarkAbove() -> Float { return 0.62 }
function inkLightBelow() -> Float { return 0.44 }
function inkDark() -> Float3 { return Float3(0.07, 0.08, 0.10) }

// --- text ------------------------------------------------------------------
// Glyph coverage is not opacity, and treating it as one is why unhinted text looks
// washed out. A stem that covers 60% of a pixel does not look 60% as dark as a
// solid one, because the display is not linear: composite the coverage straight and
// dark text on a light page comes out visibly lighter than the weight it was drawn
// at. Apple's answer is to correct the coverage before compositing, which is what
// keeps their text looking full-bodied despite being rendered from unhinted
// outlines and never snapped to the pixel grid.
//
// The correction has to know which way to go. Dark ink on a light page loses weight
// and wants thickening (an exponent below 1); light ink on a dark page GAINS weight
// from the same effect and wants the opposite, or it blooms. The ink's own luminance
// is the available signal — dark text is on a light background almost by definition
// — so the exponent slides between the two by it.
function inkGammaOnLight() -> Float { return 1.0 }
function inkGammaOnDark() -> Float { return 1.0 }

function inkCoverageGamma(inkLuma: Float) -> Float {
    return mix(inkGammaOnLight(), inkGammaOnDark(), clamp(inkLuma, 0.0, 1.0))
}

// Luminance weights (Rec. 601), used for the wash and for the ink decision.
function lumaWeights() -> Float3 { return Float3(0.299, 0.587, 0.114) }

function absolute(value: Float) -> Float {
    if value < 0.0 { return 0.0 - value }
    return value
}

function minimum(left: Float, right: Float) -> Float {
    if left < right { return left }
    return right
}

function maximum(left: Float, right: Float) -> Float {
    if left > right { return left }
    return right
}

// --- blend modes ------------------------------------------------------------
// A material's fills are not all "mix toward a colour". The platform's light
// materials dodge, its chrome hard-lights, its liquid glass lightens and darkens,
// and the result of reading them as plain alpha blends is a wash of the right
// colour at the wrong strength. Ids are assigned in app/Core/Materials.kira
// (foundationBlendId) and must agree with it.
function blendChannel(base: Float, layer: Float, mode: Float) -> Float {
    // 0 — normal
    if mode < 0.5 { return layer }
    // 1 — linear dodge (add)
    if mode < 1.5 { return clamp(base + layer, 0.0, 1.0) }
    // 2 — colour dodge. Against pure white this saturates to 1 wherever the base
    // is lit at all, which is what makes the light materials so much brighter than
    // their opacities suggest.
    if mode < 2.5 {
        if layer >= 1.0 {
            if base > 0.0 { return 1.0 }
            return 0.0
        }
        return minimum(1.0, base / (1.0 - layer))
    }
    // 3 — hard light (the layer decides)
    if mode < 3.5 {
        if layer <= 0.5 { return 2.0 * base * layer }
        return 1.0 - 2.0 * (1.0 - base) * (1.0 - layer)
    }
    // 4 — overlay (hard light with the operands swapped: the base decides)
    if mode < 4.5 {
        if base <= 0.5 { return 2.0 * base * layer }
        return 1.0 - 2.0 * (1.0 - base) * (1.0 - layer)
    }
    // 5 — lighten
    if mode < 5.5 { return maximum(base, layer) }
    // 6 — darken
    if mode < 6.5 { return minimum(base, layer) }
    // 7 — multiply
    return base * layer
}

// One fill composited onto what is already there, at its own opacity.
function blendLayer(base: Float3, layer: Float3, alpha: Float, mode: Float) -> Float3 {
    if alpha <= 0.0 { return base }
    // Select scalar blend mode once for the whole RGB vector. Calling
    // blendChannel independently for x/y/z repeated the same mode ladder three
    // times per glass pixel; Lighten and Darken are the dominant Liquid Glass
    // pair and reduce directly to component-wise max/min.
    if mode < 0.5 { return mix(base, layer, alpha) }
    if mode < 1.5 {
        let added = Float3(
            clamp(base.x + layer.x, 0.0, 1.0),
            clamp(base.y + layer.y, 0.0, 1.0),
            clamp(base.z + layer.z, 0.0, 1.0)
        )
        return mix(base, added, alpha)
    }
    if mode >= 4.5 {
        if mode < 5.5 {
            let lightened = Float3(
                maximum(base.x, layer.x),
                maximum(base.y, layer.y),
                maximum(base.z, layer.z)
            )
            return mix(base, lightened, alpha)
        }
        if mode < 6.5 {
            let darkened = Float3(
                minimum(base.x, layer.x),
                minimum(base.y, layer.y),
                minimum(base.z, layer.z)
            )
            return mix(base, darkened, alpha)
        }
        return mix(base, base * layer, alpha)
    }
    let blended = Float3(
        blendChannel(base.x, layer.x, mode),
        blendChannel(base.y, layer.y, mode),
        blendChannel(base.z, layer.z, mode)
    )
    return mix(base, blended, alpha)
}

// Signed distance to a rounded box, in pixels: negative inside, positive outside.
function sdRound(point: Float2, halfSize: Float2, radius: Float) -> Float {
    let q = Float2(
        absolute(point.x) - halfSize.x + radius,
        absolute(point.y) - halfSize.y + radius
    )
    let outside = Float2(maximum(q.x, 0.0), maximum(q.y, 0.0))
    return minimum(maximum(q.x, q.y), 0.0) + length(outside) - radius
}

// Analytic outward normal of the same rounded-box SDF. The former central
// difference evaluated sdRound four more times per glass pixel; this follows the
// exact piecewise gradient (corner arc or nearest straight side) directly.
function sdRoundNormal(point: Float2, halfSize: Float2, radius: Float) -> Float2 {
    let sx = -1.0
    if point.x >= 0.0 { sx = 1.0 }
    let sy = -1.0
    if point.y >= 0.0 { sy = 1.0 }
    let q = Float2(
        absolute(point.x) - halfSize.x + radius,
        absolute(point.y) - halfSize.y + radius
    )
    let ox = maximum(q.x, 0.0)
    let oy = maximum(q.y, 0.0)
    if ox > 0.0 {
        if oy > 0.0 {
            return normalize(Float2(ox * sx, oy * sy) + Float2(0.0001, 0.0))
        }
        return Float2(sx, 0.0)
    }
    if oy > 0.0 {
        return Float2(0.0, sy)
    }
    if q.x > q.y {
        return Float2(sx, 0.0)
    }
    return Float2(0.0, sy)
}

// The Kira Graphics liquid_glass example's refraction curve, constants intact.
function refractionCurve(value: Float) -> Float {
    let e = 2.718281828459045
    return 1.0 - 2.3 * pow(5.2 * e, -6.9 * value - 0.7)
}

shader UiBatch {
    group Batch {
        storage read verts: [UiQuad]
        texture atlas: Texture2d
        sampler atlasSmp: Sampler
        texture external: Texture2d
        sampler externalSmp: Sampler
        texture backdrop: Texture2d
        sampler backdropSmp: Sampler
        texture nearBlur: Texture2d
        sampler nearSmp: Sampler
    }

    vertex {
        input VertexIn
        output VertexOut

        function entry(input: VertexIn) -> VertexOut {
            // Four vertices to a quad, wound top-left, top-right, bottom-right,
            // bottom-left — the order uiBatchQuadIndices emits indices in, so the
            // corner is the vertex index modulo four and the quad is it divided.
            let v = verts[input.vid / UInt(4)]
            let corner = input.vid % UInt(4)
            // Which extreme this corner takes on each axis: corners 1 and 2 are the
            // right-hand pair, corners 2 and 3 the bottom one. Both land on exactly
            // 0.0 or 1.0, which is what makes the mix below a selection.
            let right = Float((corner + UInt(1)) % UInt(4) / UInt(2))
            let bottom = Float(corner / UInt(2))
            let out: VertexOut
            out.clip_position = Float4(
                mix(v.posX0, v.posX1, right),
                mix(v.posY0, v.posY1, bottom),
                0.0,
                1.0,
            )
            out.local = Float2(mix(v.localX0, v.localX1, right), mix(v.localY0, v.localY1, bottom))
            out.px = Float2(mix(v.pxX0, v.pxX1, right), mix(v.pxY0, v.pxY1, bottom))
            out.hsize = Float2(v.halfW, v.halfH)
            out.radius = v.radius
            out.borderWidth = v.borderWidth
            out.mode = v.mode
            out.edgeRefraction = v.edgeRefraction
            out.fill = Float4(v.fillR, v.fillG, v.fillB, v.fillA)
            out.border = Float4(v.borderR, v.borderG, v.borderB, v.borderA)
            out.clip = Float4(v.clipMinX, v.clipMinY, v.clipMaxX, v.clipMaxY)
            out.edge = Float4(v.edgeStrokeStrength, v.edgeStrokeDarken, v.edgeStrokePeak, v.edgeStrokeFade)
            out.lens = Float4(v.sheenStrength, v.lensMaxBend, v.refractionReach, v.blurNearSplit)
            out.borderStack = Float4(v.borderSpread, v.borderSideOffset, v.borderSideSpread, v.borderGrey)
            out.borderInk = Float4(v.borderGrey, v.borderSideGrey, v.innerRimStrength, v.innerRimWidth)
            out.wash = Float4(v.washUpperR, v.washUpperG, v.washUpperB, v.washUpperAlpha)
            out.washBlend = Float2(v.washBlend, v.washUpperBlend)
            return out
        }
    }

    fragment {
        input VertexOut
        output FragmentOut

        function entry(input: VertexOut) -> FragmentOut {
            let out: FragmentOut

            // Rectangular clip, carried per vertex rather than as pass state.
            if input.px.x < input.clip.x {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }
            if input.px.y < input.clip.y {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }
            if input.px.x > input.clip.z {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }
            if input.px.y > input.clip.w {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }

            // --- mode 4: adaptive glyph ---
            if input.mode > 3.5 {
                let cov = sample(atlas, atlasSmp, input.local).x
                if cov <= 0.002 {
                    out.color = Float4(0.0, 0.0, 0.0, 0.0)
                    return out
                }
                let behind = sample(backdrop, backdropSmp, Float2(input.border.x, input.border.y))
                let behindLuma = dot(Float3(behind.x, behind.y, behind.z), lumaWeights())
                // The capture holds what is UNDER the glass, not the glass, so the
                // surface's wash is mixed back in before the decision.
                let lit = mix(behindLuma, input.edgeRefraction, clamp(input.borderWidth, 0.0, 1.0))
                let ink = smoothstep(inkDarkAbove(), inkLightBelow(), lit)
                let inkRgb = mix(inkDark(), Float3(1.0, 1.0, 1.0), ink)
                // Same correction as mode 1, with the ink this run just chose.
                let inkA = input.fill.w * pow(cov, inkCoverageGamma(dot(inkRgb, lumaWeights())))
                out.color = Float4(inkRgb.x * inkA, inkRgb.y * inkA, inkRgb.z * inkA, inkA)
                return out
            }

            // --- mode 3: liquid glass — LIVES IN ITS OWN PIPELINES ---
            // Glass region patches route to UiGlassFull / UiGlassBand /
            // UiGlassCore in uiBatchDrawStream, so no glass quad reaches this
            // shader; a stray one draws transparent. The branch body below is
            // compiled out (`if false`) rather than deleted: it stays the
            // reference copy of the math, while its static register allocation
            // — which taxed every chrome fragment this pipeline shades — is
            // released.
            if input.mode > 2.5 {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }
            if false {
                let distancePx = sdRound(input.local, input.hsize, input.radius)

                // The document's three enabled shadows (see the constants above).
                //
                // They are computed on both sides of the shape's hard boundary: a
                // 0.5px band lives inside the
                // anti-aliasing band of the edge. Deeper than that, coverage is
                // exactly one and the shadow's `over` contribution is exactly zero,
                // so avoid evaluating three SDFs and a texture sample over the
                // entire glass interior while retaining every contributing pixel.
                let shadowAlpha = 0.0
                let shadowRgb = Float3(0.0, 0.0, 0.0)
                if distancePx > -0.5 {
                //
                // Spread grows the silhouette AND its corner radius, which keeps a
                // spread shadow's corners concentric with the shape's instead of
                // squaring off as the spread rises.
                let ringSpread = input.borderStack.x
                let sideReach = input.borderStack.y
                let ringHalf = input.hsize + Float2(ringSpread, ringSpread)
                let ringDistance = sdRound(input.local, ringHalf, maximum(input.radius + ringSpread, 0.0))
                let ring = clamp(0.5 - ringDistance, 0.0, 1.0)
                // The side band is the document's shadow: the silhouette SHRUNK by
                // its spread in both axes, then offset left and right. Shrinking is
                // what keeps it off the top and bottom — vertically it ends inside
                // the shape — while the offset pushes it past the left and right
                // edges. Expanding it instead put a dark band along the top, which
                // the reference does not have.
                let sideSpread = input.borderStack.z
                let sideHalf = input.hsize - Float2(sideSpread, sideSpread)
                let sideRadius = maximum(input.radius - sideSpread, 0.0)
                let leftDistance = sdRound(input.local + Float2(sideReach, 0.0), sideHalf, sideRadius)
                let rightDistance = sdRound(input.local - Float2(sideReach, 0.0), sideHalf, sideRadius)
                // Three shadows, composited the way the design tool stacks them:
                // MULTIPLIED, not painted over one another. It is the only thing
                // that explains the reference — reconstructed from its alpha
                // channel, its top edge is #DBDBDB (219) and its side is ~184, and
                // no number of opaque #DBDBDB layers can go below 219. Multiplied,
                // two of them give 219/255 * 219/255 -> 188, which is the side.
                //
                // So each silhouette contributes a MULTIPLIER, faded in by its own
                // coverage, and the ink is their product: one layer at a top edge,
                // two where the offset pair overlaps the ring at a side.
                let leftBand = clamp(0.5 - leftDistance, 0.0, 1.0)
                let rightBand = clamp(0.5 - rightDistance, 0.0, 1.0)
                let stacked = 1.0 - (1.0 - ring) * (1.0 - leftBand) * (1.0 - rightBand)
                let ringGrey = input.borderInk.x
                // Where the layers actually overlap is what carries the second
                // multiply, so the pixel is split by AREA rather than by fading the
                // ink: the part only the ring covers, the part only the offset pair
                // covers, and the part both do. The first two take the ink once, the
                // third takes it squared. Fading the ink by coverage instead counts
                // the alpha twice and washes a half-covered edge out to nothing.
                let pairBand = maximum(leftBand, rightBand)
                let onlyRing = ring * (1.0 - pairBand)
                let onlyPair = pairBand * (1.0 - ring)
                let bothBands = ring * pairBand
                let inkOnce = ringGrey
                let inkTwice = ringGrey * ringGrey
                // The two are separate inks, so they composite rather than merge:
                // the side pair sits over the ring, and where only the ring reaches
                // (top and bottom) its own lighter grey is what shows.
                let sideGrey = input.borderInk.y
                let hairline = stacked
                shadowAlpha = hairline
                // One ink for all three: the document gives every enabled shadow the
                // same #DBDBDB, and what separates the edges is how many of them
                // reach a given pixel — multiplied together — not what colour each
                // one is.
                // The ink is a MULTIPLIER, so it has to multiply something: what is
                // actually behind this fragment, sampled from the capture. Painting
                // the ink as a colour instead only agrees with multiplying over a
                // WHITE page — 0.859 * 255 is #DBDBDB either way — and over a photo
                // it paints a light rim onto dark content instead of darkening it.
                // That is the white rim that ringed every surface over a backdrop.
                let coveredArea = maximum(stacked, 0.0001)
                let inkLevel = (inkOnce * (onlyRing + onlyPair) + inkTwice * bothBands) / coveredArea
                let gpOutside = input.local / input.hsize
                let uvOutside = Float2(
                    input.border.x + gpOutside.x * input.border.z,
                    input.border.y + gpOutside.y * input.border.w
                )
                let behindEdge = sample(external, externalSmp, uvOutside)
                shadowRgb = Float3(behindEdge.x, behindEdge.y, behindEdge.z) * inkLevel * stacked
                }

                if distancePx > 0.5 {
                    if shadowAlpha <= 0.002 {
                        out.color = Float4(0.0, 0.0, 0.0, 0.0)
                        return out
                    }
                    out.color = Float4(shadowRgb.x, shadowRgb.y, shadowRgb.z, shadowAlpha)
                    return out
                }
                let cov = clamp(0.5 - distancePx, 0.0, 1.0)
                let minHalf = maximum(minimum(input.hsize.x, input.hsize.y), 1.0)
                let inside = maximum(0.0 - distancePx, 0.0)

                // The lens: displace the sample along the SDF's outward normal, by
                // a curve of how deep into the surface the fragment is.
                let gp = input.local / input.hsize
                let uvFrag = Float2(
                    input.border.x + gp.x * input.border.z,
                    input.border.y + gp.y * input.border.w
                )
                let n = Float2(0.0, -1.0)
                let coord = uvFrag
                // At 72pt into the surface the authored exponential lens bends by
                // less than 0.018pt (<0.04 physical pixels at 2x). Keep the exact
                // curve in its visible rim and take its limiting value in the deep
                // interior, avoiding a pow + SDF normal over most large glass.
                if inside < 72.0 {
                    let ref = refractionCurve(inside / maximum(input.lens.z, 1.0))
                    n = sdRoundNormal(input.local, input.hsize, input.radius)
                    let bend = (1.0 - ref) * minimum(minHalf, input.lens.y)
                    let uvScale = Float2(input.border.z / input.hsize.x, input.border.w / input.hsize.y)
                    coord = uvFrag - n * bend * uvScale
                }

                // Two real radii: the dial's lower part crosses sharp -> near, the
                // rest near -> far. Cross-fading sharp against fully-soft would
                // double-image the backdrop rather than blur it.
                let dial = clamp(input.fill.w, 0.0, 1.0)
                if inside < blurEdgeEnd() {
                    dial = dial * smoothstep(blurEdgeStart(), blurEdgeEnd(), inside)
                }
                let split = clamp(input.lens.w, 0.01, 0.99)
                let rgb = Float3(0.0, 0.0, 0.0)
                // At the dial's exact endpoints the cross-fade weight is 0 or 1
                // and the other arm's tap contributes nothing — skip it. Clear
                // glass (dial 0) and full frost (dial 1) are the two states
                // surfaces actually rest in, so most glass pixels take one tap;
                // the edge fade and mid-dial pixels keep the exact two-tap mix.
                if dial <= 0.0 {
                    let sharpTap = sample(external, externalSmp, coord)
                    rgb = Float3(sharpTap.x, sharpTap.y, sharpTap.z)
                } else if dial >= 1.0 {
                    let softTap = sample(backdrop, backdropSmp, coord)
                    rgb = Float3(softTap.x, softTap.y, softTap.z)
                } else if dial < split {
                    let sharpTap = sample(external, externalSmp, coord)
                    let nearTap = sample(nearBlur, nearSmp, coord)
                    rgb = mix(
                        Float3(sharpTap.x, sharpTap.y, sharpTap.z),
                        Float3(nearTap.x, nearTap.y, nearTap.z),
                        dial / split
                    )
                } else {
                    let nearTap = sample(nearBlur, nearSmp, coord)
                    let softTap = sample(backdrop, backdropSmp, coord)
                    rgb = mix(
                        Float3(nearTap.x, nearTap.y, nearTap.z),
                        Float3(softTap.x, softTap.y, softTap.z),
                        (dial - split) / (1.0 - split)
                    )
                }

                // The wash: the material's fills, in the order and with the blend
                // modes the platform authors them in (app/Core/Materials.kira).
                // Applied as given — adapting it to the backdrop is the tint
                // colour's job, and a named step has to mean what it says.
                let washA = clamp(input.borderWidth, 0.0, washCeiling())
                rgb = blendLayer(rgb, Float3(input.fill.x, input.fill.y, input.fill.z), washA, input.washBlend.x)
                let washUpperA = clamp(input.wash.w, 0.0, 1.0)
                rgb = blendLayer(rgb, Float3(input.wash.x, input.wash.y, input.wash.z), washUpperA, input.washBlend.y)

                // The edge: a thin darkening stroke the whole way round, plus a
                // sheen on the upper rim. Adding white here is what a lit rim looks
                // like on a dark backdrop; on a light one the edge is a grey line.
                let lighting = clamp(input.edgeRefraction, 0.0, 2.0)
                let peak = input.edge.z
                let stroke = 0.0
                if inside < maximum(input.edge.w, peak + 0.01) {
                    stroke = smoothstep(0.0, peak, inside) * (1.0 - smoothstep(peak, maximum(input.edge.w, peak + 0.01), inside)) * input.edge.x * lighting
                }
                let sheen = 0.0
                if inside < sheenEnd() {
                    sheen = (1.0 - smoothstep(sheenStart(), sheenEnd(), inside)) * input.lens.x * clamp(0.0 - n.y, 0.0, 1.0) * lighting
                }
                rgb = mix(rgb, rgb * input.edge.y, stroke)
                rgb = rgb + Float3(sheen, sheen, sheen)

                // The inner rim, in the side line's own ink: the border outside the
                // shape stops at the boundary, and without this the edge goes from
                // a full-strength line to the interior in one step. The reference
                // carries one more pixel at roughly half strength.
                let rimWidth = input.borderInk.w
                let rimInk = input.borderInk.y
                let rim = 0.0
                if inside < rimWidth {
                    rim = clamp(rimWidth - inside, 0.0, 1.0) * input.borderInk.z
                }
                rgb = mix(rgb, Float3(rimInk, rimInk, rimInk), rim)

                // The glass over the shadow stack, in one premultiplied result: the
                // edge's anti-aliasing band is exactly where the 0.5px borders
                // live, so the two have to resolve in the same fragment rather than
                // in two draws that each own part of the pixel.
                let glassRgb = clamp(rgb, Float3(0.0, 0.0, 0.0), Float3(1.0, 1.0, 1.0))
                let over = 1.0 - cov
                let outRgb = glassRgb * cov + shadowRgb * over
                let outAlpha = cov + shadowAlpha * over
                out.color = Float4(outRgb.x, outRgb.y, outRgb.z, outAlpha)
                return out
            }

            // --- mode 2: external texture ---
            if input.mode > 1.5 {
                let transition = clamp(input.edgeRefraction, 0.0, 1.0)
                // Steady light/dark mode samples exactly one 4K source. Sampling
                // both and mixing by a compile-time-unknown 0 or 1 doubled the
                // dominant fullscreen bandwidth forever after the 350ms crossfade.
                if transition <= 0.001 {
                    let texel = sample(external, externalSmp, input.local)
                    let alpha = texel.w * input.fill.w
                    out.color = Float4(texel.x * input.fill.w, texel.y * input.fill.w, texel.z * input.fill.w, alpha)
                    return out
                }
                if transition >= 0.999 {
                    let texel = sample(backdrop, backdropSmp, input.local)
                    let alpha = texel.w * input.fill.w
                    out.color = Float4(texel.x * input.fill.w, texel.y * input.fill.w, texel.z * input.fill.w, alpha)
                    return out
                }
                let primary = sample(external, externalSmp, input.local)
                let secondary = sample(backdrop, backdropSmp, input.local)
                let texel = mix(primary, secondary, transition)
                let alpha = texel.w * input.fill.w
                out.color = Float4(texel.x * input.fill.w, texel.y * input.fill.w, texel.z * input.fill.w, alpha)
                return out
            }

            // --- mode 1: glyph / icon coverage ---
            if input.mode > 0.5 {
                let cov = sample(atlas, atlasSmp, input.local).x
                let inkLuma = dot(Float3(input.fill.x, input.fill.y, input.fill.z), lumaWeights())
                let shaped = pow(cov, inkCoverageGamma(inkLuma))
                let alpha = input.fill.w * shaped
                out.color = Float4(input.fill.x * alpha, input.fill.y * alpha, input.fill.z * alpha, alpha)
                return out
            }

            // --- mode 0: SDF surface with an optional border ---
            let d = sdRound(input.local, input.hsize, input.radius)
            let fillCov = clamp(0.5 - d, 0.0, 1.0)
            if input.borderWidth > 0.0 {
                if input.border.w > 0.0 {
                    let innerHalf = input.hsize - Float2(input.borderWidth, input.borderWidth)
                    let di = sdRound(input.local, innerHalf, maximum(input.radius - input.borderWidth, 0.0))
                    let innerCov = clamp(0.5 - di, 0.0, 1.0)
                    let mixed = mix(Float3(input.border.x, input.border.y, input.border.z), Float3(input.fill.x, input.fill.y, input.fill.z), innerCov)
                    let mixedA = mix(input.border.w, input.fill.w, innerCov) * fillCov
                    out.color = Float4(mixed.x * mixedA, mixed.y * mixedA, mixed.z * mixedA, mixedA)
                    return out
                }
            }
            let plainA = input.fill.w * fillCov
            out.color = Float4(input.fill.x * plainA, input.fill.y * plainA, input.fill.z * plainA, plainA)
            return out
        }
    }
}
