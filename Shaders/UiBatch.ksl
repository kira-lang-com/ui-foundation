// The UI compositor's single shader. Every primitive the UI Foundation draws goes
// through it, selected per vertex by `mode`:
//   0 — SDF rounded-rect / border surface (local = pixel offset from the centre)
//   0.25 — SDF squircle / border surface (a fourth-power superellipse corner)
//   1 — glyph or icon coverage from the atlas (local = uv)
//   2 — an external texture (a TextureView), `local` carrying its uv
//   3 — liquid glass: refract the captured backdrop through the rounded shape
//   4 — adaptive glyph: ink chosen from the capture under the run
//
// Geometry is pulled by index from a storage buffer rather than described by a
// vertex layout, so one buffer feeds every mode with no per-primitive layout.
//
// The buffer holds one record per QUAD, not per vertex. Six of the values a vertex
// needs differ between the four corners and eighteen are the same for all of them,
// so a per-vertex buffer wrote those eighteen numbers four times over — and a
// screen of text is one quad per glyph. The record carries each corner-varying
// value as its two extremes, and the vertex stage picks the one its corner wants.
//
// Both extremes are stored as the vertex stage will emit them, INCLUDING the clip
// position, which the host computes rather than this stage deriving it from a
// viewport. The pick is `mix` against a weight of exactly 0 or 1, which returns one
// operand unchanged, so every value the stage produces is the number the host
// wrote — the change is invisible in the framebuffer rather than merely close.
//
// Field reuse per mode is the price of one shader: mode 3 carries the glass rect's
// uv transform in `border` (rg = centre, ba = half-size) and its wash strength in
// `borderWidth`; mode 4 carries the run's sample point in `border.rg`, the wash in
// `borderWidth` and the wash colour's luminance in `edgeRefraction`.

import GlassCommon

type UiQuad {
    // Clip position and pixel position at the top-left and bottom-right corners.
    let posX0: Float
    let posY0: Float
    let posX1: Float
    let posY1: Float
    let pxX0: Float
    let pxY0: Float
    let pxX1: Float
    let pxY1: Float
    // `local` at the same two corners: the SDF offset from the centre for a
    // surface, the atlas uv for a glyph.
    let localX0: Float
    let localY0: Float
    let localX1: Float
    let localY1: Float
    let halfW: Float
    let halfH: Float
    let radius: Float
    let borderWidth: Float
    let mode: Float
    let edgeRefraction: Float
    let fillR: Float
    let fillG: Float
    let fillB: Float
    let fillA: Float
    let borderR: Float
    let borderG: Float
    let borderB: Float
    let borderA: Float
    let clipMinX: Float
    let clipMinY: Float
    let clipMaxX: Float
    let clipMaxY: Float
    // The material block: what a liquid-glass surface shades itself with. Carried
    // per vertex so two surfaces in one frame can differ, and so a control can
    // move one without recompiling the shader. Zero in every other mode.
    let edgeStrokeStrength: Float
    let edgeStrokeDarken: Float
    let edgeStrokePeak: Float
    let edgeStrokeFade: Float
    let sheenStrength: Float
    let lensMaxBend: Float
    let refractionReach: Float
    let blurNearSplit: Float
    // The border block: the ring's spread (already snapped to a whole device
    // pixel by the host), the offset/spread of the pair that reach past the left
    // and right extremes, and the grey they are all drawn in.
    let borderSpread: Float
    let borderSideOffset: Float
    let borderSideSpread: Float
    let borderGrey: Float
    // The sides are drawn in their own, darker grey — measured off the reference,
    // where the left and right edges are #C7C7C7 at full coverage while the top and
    // bottom are a half-covered #DBDBDB.
    let borderSideGrey: Float
    // The inner rim: how strongly it tints, and how far in from the edge it runs.
    let innerRimStrength: Float
    let innerRimWidth: Float
    // The wash, as the platform authors it: two fills, each with a colour, an
    // opacity and a blend mode. The LOWER layer's colour is `fill` and its opacity
    // is `borderWidth` (mode 3 has no border of its own to describe), so what is
    // carried here is that layer's blend mode and the upper layer whole.
    let washBlend: Float
    let washUpperR: Float
    let washUpperG: Float
    let washUpperB: Float
    let washUpperAlpha: Float
    let washUpperBlend: Float
    let materialSpare0: Float
    let materialSpare1: Float
    let materialSpare2: Float
    // A gradient fill: the colour the far end of the quad takes, and which way
    // "far" runs — 0 none, 1 down, 2 across, 3 corner to corner. The near end is
    // `fill`, so a flat surface is a gradient whose axis is none and costs the
    // same quad it always did.
    //
    // The blend happens in the VERTEX stage: a corner's colour is the mix at
    // that corner, and the rasterizer interpolates between them for free. A
    // gradient drawn as a stack of strips — which is what a UI layer without
    // this has to do — is a dozen quads, a dozen draw records, and visible bands
    // wherever the strips are wider than the eye's threshold.
    let gradientR: Float
    let gradientG: Float
    let gradientB: Float
    let gradientA: Float
    let gradientAxis: Float
}

type VertexIn {
    @builtin(vertex_index)
    let vid: UInt
}

type VertexOut {
    @builtin(position)
    let clip_position: Float4

    let local: Float2
    let px: Float2
    let hsize: Float2
    let radius: Float
    let borderWidth: Float
    let mode: Float
    let edgeRefraction: Float
    let fill: Float4
    let border: Float4
    let clip: Float4
    // The material block, packed as three vectors: stroke strength / darken /
    // peak / fade, sheen / lens bend / refraction reach / blur split, and the
    // border's ring spread / side offset / side spread / grey.
    let edge: Float4
    let lens: Float4
    let borderStack: Float4
    // Ring grey in x, side grey in y, then the inner rim's strength and width.
    let borderInk: Float4
    // The wash's upper layer: colour in xyz, opacity in w.
    let wash: Float4
    // The two layers' blend modes: lower in x, upper in y.
    let washBlend: Float2
}

type FragmentOut {
    let color: Float4
}
// Adaptive text: the composite luminance either side of which a run inks itself
// dark or light, and the dark ink (the light one is white).
const inkDarkAbove: Float = 0.62
const inkLightBelow: Float = 0.44
function inkDark() -> Float3 { return Float3(0.07, 0.08, 0.10) }

// --- text ------------------------------------------------------------------
// Glyph coverage is not opacity, and treating it as one is why unhinted text looks
// washed out. A stem that covers 60% of a pixel does not look 60% as dark as a
// solid one, because the display is not linear: composite the coverage straight and
// dark text on a light page comes out visibly lighter than the weight it was drawn
// at. Apple's answer is to correct the coverage before compositing, which is what
// keeps their text looking full-bodied despite being rendered from unhinted
// outlines and never snapped to the pixel grid.
//
// The correction has to know which way to go. Dark ink on a light page loses weight
// and wants thickening (an exponent below 1); light ink on a dark page GAINS weight
// from the same effect and wants the opposite, or it blooms. The ink's own luminance
// is the available signal — dark text is on a light background almost by definition
// — so the exponent slides between the two by it.
const inkGammaOnLight: Float = 1.0
const inkGammaOnDark: Float = 1.0

function inkCoverageGamma(inkLuma: Float) -> Float {
    return mix(inkGammaOnLight, inkGammaOnDark, clamp(inkLuma, 0.0, 1.0))
}

// Luminance weights (Rec. 601), used for the wash and for the ink decision.
function lumaWeights() -> Float3 { return Float3(0.299, 0.587, 0.114) }

function surfaceDistance(point: Float2, halfSize: Float2, radius: Float, mode: Float) -> Float {
    if mode > 0.1 && mode < 0.5 {
        return GlassCommon.sdSquircle(point, halfSize, radius)
    }
    return GlassCommon.sdRound(point, halfSize, radius)
}
shader UiBatch {
    // The first seven of the batch family's bindings, which are the ones this
    // shader reads: a rect, a glyph, an external-texture quad and an adaptive
    // text run need the atlas, the external photograph and the far backdrop.
    // The near blur, the second photograph and the crossfade weight belong to
    // the glass pipelines, and are declared by those.
    group Batch {
        storage read verts: [UiQuad]
        texture atlas: Texture2d
        sampler atlasSmp: Sampler
        texture external: Texture2d
        sampler externalSmp: Sampler
        texture backdrop: Texture2d
        sampler backdropSmp: Sampler
    }

    vertex {
        input VertexIn
        output VertexOut

        function entry(input: VertexIn) -> VertexOut {
            // Four vertices to a quad, wound top-left, top-right, bottom-right,
            // bottom-left — the order uiBatchQuadIndices emits indices in, so the
            // corner is the vertex index modulo four and the quad is it divided.
            let v = verts[input.vid / UInt(4)]
            let corner = input.vid % UInt(4)
            // Which extreme this corner takes on each axis: corners 1 and 2 are the
            // right-hand pair, corners 2 and 3 the bottom one. Both land on exactly
            // 0.0 or 1.0, which is what makes the mix below a selection.
            let right = Float((corner + UInt(1)) % UInt(4) / UInt(2))
            let bottom = Float(corner / UInt(2))
            let out: VertexOut
            out.clip_position = Float4(
                mix(v.posX0, v.posX1, right),
                mix(v.posY0, v.posY1, bottom),
                0.0,
                1.0,
            )
            out.local = Float2(mix(v.localX0, v.localX1, right), mix(v.localY0, v.localY1, bottom))
            out.px = Float2(mix(v.pxX0, v.pxX1, right), mix(v.pxY0, v.pxY1, bottom))
            out.hsize = Float2(v.halfW, v.halfH)
            out.radius = v.radius
            out.borderWidth = v.borderWidth
            out.mode = v.mode
            out.edgeRefraction = v.edgeRefraction
            // The corner's own fill: the near colour, or its mix with the far
            // one at this corner's position along the gradient's axis.
            let mixT = 0.0
            if v.gradientAxis > 2.5 {
                mixT = (right + bottom) * 0.5
            } else if v.gradientAxis > 1.5 {
                mixT = right
            } else if v.gradientAxis > 0.5 {
                mixT = bottom
            }
            out.fill = mix(
                Float4(v.fillR, v.fillG, v.fillB, v.fillA),
                Float4(v.gradientR, v.gradientG, v.gradientB, v.gradientA),
                mixT,
            )
            out.border = Float4(v.borderR, v.borderG, v.borderB, v.borderA)
            out.clip = Float4(v.clipMinX, v.clipMinY, v.clipMaxX, v.clipMaxY)
            out.edge = Float4(v.edgeStrokeStrength, v.edgeStrokeDarken, v.edgeStrokePeak, v.edgeStrokeFade)
            out.lens = Float4(v.sheenStrength, v.lensMaxBend, v.refractionReach, v.blurNearSplit)
            out.borderStack = Float4(v.borderSpread, v.borderSideOffset, v.borderSideSpread, v.borderGrey)
            out.borderInk = Float4(v.borderGrey, v.borderSideGrey, v.innerRimStrength, v.innerRimWidth)
            out.wash = Float4(v.washUpperR, v.washUpperG, v.washUpperB, v.washUpperAlpha)
            out.washBlend = Float2(v.washBlend, v.washUpperBlend)
            return out
        }
    }

    fragment {
        input VertexOut
        output FragmentOut

        function entry(input: VertexOut) -> FragmentOut {
            let out: FragmentOut

            // Rectangular clip, carried per vertex rather than as pass state.
            if input.px.x < input.clip.x {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }
            if input.px.y < input.clip.y {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }
            if input.px.x > input.clip.z {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }
            if input.px.y > input.clip.w {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }

            // --- mode 4: adaptive glyph ---
            if input.mode > 3.5 {
                let cov = sample(atlas, atlasSmp, input.local).x
                if cov <= 0.002 {
                    out.color = Float4(0.0, 0.0, 0.0, 0.0)
                    return out
                }
                let behind = sample(backdrop, backdropSmp, Float2(input.border.x, input.border.y))
                let behindLuma = dot(Float3(behind.x, behind.y, behind.z), lumaWeights())
                // The capture holds what is UNDER the glass, not the glass, so the
                // surface's wash is mixed back in before the decision.
                let lit = mix(behindLuma, input.edgeRefraction, clamp(input.borderWidth, 0.0, 1.0))
                let ink = smoothstep(inkDarkAbove, inkLightBelow, lit)
                let inkRgb = mix(inkDark(), Float3(1.0, 1.0, 1.0), ink)
                // Same correction as mode 1, with the ink this run just chose.
                let inkA = input.fill.w * pow(cov, inkCoverageGamma(dot(inkRgb, lumaWeights())))
                out.color = Float4(inkRgb.x * inkA, inkRgb.y * inkA, inkRgb.z * inkA, inkA)
                return out
            }

            // --- mode 3: liquid glass — LIVES IN ITS OWN PIPELINES ---
            // Glass region patches route to UiGlassFull / UiGlassBand /
            // UiGlassLens / UiGlassCore in uiBatchDrawStream, so no glass quad
            // reaches this shader; a stray one draws transparent.
            //
            // The material's arithmetic is in those four and in
            // `GlassCommon.ksl`, and it is not repeated here. It used to be —
            // the whole branch sat below under `if false`, kept as a reference
            // copy — and a copy nothing runs is not a reference, it is a second
            // implementation that drifts from the four that do. It also left
            // this shader DECLARING the near-blur tap and the second backdrop
            // photograph it no longer read, which every GL driver eliminated
            // and then reported missing at every link.
            if input.mode > 2.5 {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }
            // --- mode 2: external texture ---
            if input.mode > 1.5 {
                let transition = clamp(input.edgeRefraction, 0.0, 1.0)
                // TextureView's local coordinates are UVs, while the shared SDF
                // expects point-space offsets from the quad centre. Keep the
                // engine target's corners inside the same self-contained mask as
                // every other Foundation surface.
                let textureLocal = (input.local - Float2(0.5, 0.5)) * Float2(input.hsize.x * 2.0, input.hsize.y * 2.0)
                let textureDistance = surfaceDistance(textureLocal, input.hsize, input.radius, 0.0)
                let textureCoverage = clamp(0.5 - textureDistance, 0.0, 1.0)
                // Steady light/dark mode samples exactly one 4K source. Sampling
                // both and mixing by a compile-time-unknown 0 or 1 doubled the
                // dominant fullscreen bandwidth forever after the 350ms crossfade.
                if transition <= 0.001 {
                    let texel = sample(external, externalSmp, input.local)
                    let alpha = texel.w * input.fill.w * textureCoverage
                    out.color = Float4(texel.x * input.fill.w * textureCoverage, texel.y * input.fill.w * textureCoverage, texel.z * input.fill.w * textureCoverage, alpha)
                    return out
                }
                if transition >= 0.999 {
                    let texel = sample(backdrop, backdropSmp, input.local)
                    let alpha = texel.w * input.fill.w * textureCoverage
                    out.color = Float4(texel.x * input.fill.w * textureCoverage, texel.y * input.fill.w * textureCoverage, texel.z * input.fill.w * textureCoverage, alpha)
                    return out
                }
                let primary = sample(external, externalSmp, input.local)
                let secondary = sample(backdrop, backdropSmp, input.local)
                let texel = mix(primary, secondary, transition)
                let alpha = texel.w * input.fill.w * textureCoverage
                out.color = Float4(texel.x * input.fill.w * textureCoverage, texel.y * input.fill.w * textureCoverage, texel.z * input.fill.w * textureCoverage, alpha)
                return out
            }

            // --- mode 1: glyph / icon coverage ---
            if input.mode > 0.5 {
                let cov = sample(atlas, atlasSmp, input.local).x
                let inkLuma = dot(Float3(input.fill.x, input.fill.y, input.fill.z), lumaWeights())
                let shaped = pow(cov, inkCoverageGamma(inkLuma))
                let alpha = input.fill.w * shaped
                out.color = Float4(input.fill.x * alpha, input.fill.y * alpha, input.fill.z * alpha, alpha)
                return out
            }

            // --- mode 0 / 0.25: SDF surface with an optional border ---
            let d = surfaceDistance(input.local, input.hsize, input.radius, input.mode)
            let fillCov = clamp(0.5 - d, 0.0, 1.0)
            if input.borderWidth > 0.0 {
                if input.border.w > 0.0 {
                    let innerHalf = input.hsize - Float2(input.borderWidth, input.borderWidth)
                    let di = surfaceDistance(input.local, innerHalf, max(input.radius - input.borderWidth, 0.0), input.mode)
                    let innerCov = clamp(0.5 - di, 0.0, 1.0)
                    let mixed = mix(Float3(input.border.x, input.border.y, input.border.z), Float3(input.fill.x, input.fill.y, input.fill.z), innerCov)
                    let mixedA = mix(input.border.w, input.fill.w, innerCov) * fillCov
                    out.color = Float4(mixed.x * mixedA, mixed.y * mixedA, mixed.z * mixedA, mixedA)
                    return out
                }
            }
            let plainA = input.fill.w * fillCov
            out.color = Float4(input.fill.x * plainA, input.fill.y * plainA, input.fill.z * plainA, plainA)
            return out
        }
    }
}
