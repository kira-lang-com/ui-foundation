// Liquid glass, FULL pipeline: the outer-ring patches — the shape's edge with
// its anti-aliasing band and the border-shadow skirt outside it. This is the
// complete glass stack (shadow silhouettes, coverage, lens, edge stroke,
// sheen, inner rim, washes), the one region where all of it can be live at
// once. It exists as its own pipeline so the generic UI shader can drop the
// glass branch entirely: that branch's static register allocation throttled
// occupancy for every chrome fragment the generic pipeline shades, which
// profiling showed costs far more than the glass pixels themselves.
//
// The shared arithmetic lives in `GlassCommon.ksl` and is imported. What is
// still duplicated from `UiBatch.ksl` is the quad record and the vertex stage —
// a `type` and a stage rather than functions, which an import does not yet
// carry; a change to either there lands here too.

import GlassCommon

type UiQuad {
    let posX0: Float
    let posY0: Float
    let posX1: Float
    let posY1: Float
    let pxX0: Float
    let pxY0: Float
    let pxX1: Float
    let pxY1: Float
    let localX0: Float
    let localY0: Float
    let localX1: Float
    let localY1: Float
    let halfW: Float
    let halfH: Float
    let radius: Float
    let borderWidth: Float
    let mode: Float
    let edgeRefraction: Float
    let fillR: Float
    let fillG: Float
    let fillB: Float
    let fillA: Float
    let borderR: Float
    let borderG: Float
    let borderB: Float
    let borderA: Float
    let clipMinX: Float
    let clipMinY: Float
    let clipMaxX: Float
    let clipMaxY: Float
    let edgeStrokeStrength: Float
    let edgeStrokeDarken: Float
    let edgeStrokePeak: Float
    let edgeStrokeFade: Float
    let sheenStrength: Float
    let lensMaxBend: Float
    let refractionReach: Float
    let blurNearSplit: Float
    let borderSpread: Float
    let borderSideOffset: Float
    let borderSideSpread: Float
    let borderGrey: Float
    let borderSideGrey: Float
    let innerRimStrength: Float
    let innerRimWidth: Float
    let washBlend: Float
    let washUpperR: Float
    let washUpperG: Float
    let washUpperB: Float
    let washUpperAlpha: Float
    let washUpperBlend: Float
    let materialSpare0: Float
    let materialSpare1: Float
    let materialSpare2: Float
}

type VertexIn {
    @builtin(vertex_index)
    let vid: UInt
}

type VertexOut {
    @builtin(position)
    let clip_position: Float4

    let local: Float2
    let px: Float2
    let hsize: Float2
    let radius: Float
    let borderWidth: Float
    let mode: Float
    let edgeRefraction: Float
    let fill: Float4
    let border: Float4
    let clip: Float4
    let edge: Float4
    let lens: Float4
    let borderStack: Float4
    let borderInk: Float4
    let wash: Float4
    let washBlend: Float2
}

type FragmentOut {
    let color: Float4
}

// How far the frame stands between the two backdrop photographs. One number for
// the whole screen, so it rides a uniform rather than every vertex.
type BackdropBlend {
    let blend: Float
}

shader UiGlassFull {
    group Batch {
        storage read verts: [UiQuad]
        texture atlas: Texture2d
        sampler atlasSmp: Sampler
        texture external: Texture2d
        sampler externalSmp: Sampler
        texture backdrop: Texture2d
        sampler backdropSmp: Sampler
        texture nearBlur: Texture2d
        sampler nearSmp: Sampler
        texture externalSecond: Texture2d
        sampler externalSecondSmp: Sampler
        uniform backdropBlend: BackdropBlend
    }

    vertex {
        input VertexIn
        output VertexOut

        function entry(input: VertexIn) -> VertexOut {
            let v = verts[input.vid / UInt(4)]
            let corner = input.vid % UInt(4)
            let right = Float((corner + UInt(1)) % UInt(4) / UInt(2))
            let bottom = Float(corner / UInt(2))
            let out: VertexOut
            out.clip_position = Float4(
                mix(v.posX0, v.posX1, right),
                mix(v.posY0, v.posY1, bottom),
                0.0,
                1.0,
            )
            out.local = Float2(mix(v.localX0, v.localX1, right), mix(v.localY0, v.localY1, bottom))
            out.px = Float2(mix(v.pxX0, v.pxX1, right), mix(v.pxY0, v.pxY1, bottom))
            out.hsize = Float2(v.halfW, v.halfH)
            out.radius = v.radius
            out.borderWidth = v.borderWidth
            out.mode = v.mode
            out.edgeRefraction = v.edgeRefraction
            out.fill = Float4(v.fillR, v.fillG, v.fillB, v.fillA)
            out.border = Float4(v.borderR, v.borderG, v.borderB, v.borderA)
            out.clip = Float4(v.clipMinX, v.clipMinY, v.clipMaxX, v.clipMaxY)
            out.edge = Float4(v.edgeStrokeStrength, v.edgeStrokeDarken, v.edgeStrokePeak, v.edgeStrokeFade)
            out.lens = Float4(v.sheenStrength, v.lensMaxBend, v.refractionReach, v.blurNearSplit)
            out.borderStack = Float4(v.borderSpread, v.borderSideOffset, v.borderSideSpread, v.borderGrey)
            out.borderInk = Float4(v.borderGrey, v.borderSideGrey, v.innerRimStrength, v.innerRimWidth)
            out.wash = Float4(v.washUpperR, v.washUpperG, v.washUpperB, v.washUpperAlpha)
            out.washBlend = Float2(v.washBlend, v.washUpperBlend)
            return out
        }
    }

    fragment {
        input VertexOut
        output FragmentOut

        function entry(input: VertexOut) -> FragmentOut {
            let out: FragmentOut

            if input.px.x < input.clip.x {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }
            if input.px.y < input.clip.y {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }
            if input.px.x > input.clip.z {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }
            if input.px.y > input.clip.w {
                out.color = Float4(0.0, 0.0, 0.0, 0.0)
                return out
            }

            let distancePx = GlassCommon.sdRound(input.local, input.hsize, input.radius)
            let shadowAlpha = 0.0
            let shadowRgb = Float3(0.0, 0.0, 0.0)
            if distancePx > -0.5 {
            let ringSpread = input.borderStack.x
            let sideReach = input.borderStack.y
            let ringHalf = input.hsize + Float2(ringSpread, ringSpread)
            let ringDistance = GlassCommon.sdRound(input.local, ringHalf, max(input.radius + ringSpread, 0.0))
            let ring = clamp(0.5 - ringDistance, 0.0, 1.0)
            let sideSpread = input.borderStack.z
            let sideHalf = input.hsize - Float2(sideSpread, sideSpread)
            let sideRadius = max(input.radius - sideSpread, 0.0)
            let leftDistance = GlassCommon.sdRound(input.local + Float2(sideReach, 0.0), sideHalf, sideRadius)
            let rightDistance = GlassCommon.sdRound(input.local - Float2(sideReach, 0.0), sideHalf, sideRadius)
            let leftBand = clamp(0.5 - leftDistance, 0.0, 1.0)
            let rightBand = clamp(0.5 - rightDistance, 0.0, 1.0)
            let stacked = 1.0 - (1.0 - ring) * (1.0 - leftBand) * (1.0 - rightBand)
            let ringGrey = input.borderInk.x
            let pairBand = max(leftBand, rightBand)
            let onlyRing = ring * (1.0 - pairBand)
            let onlyPair = pairBand * (1.0 - ring)
            let bothBands = ring * pairBand
            let inkOnce = ringGrey
            let inkTwice = ringGrey * ringGrey
            let sideGrey = input.borderInk.y
            let hairline = stacked
            shadowAlpha = hairline
            let coveredArea = max(stacked, 0.0001)
            let inkLevel = (inkOnce * (onlyRing + onlyPair) + inkTwice * bothBands) / coveredArea
            let gpOutside = input.local / input.hsize
            let uvOutside = Float2(
                input.border.x + gpOutside.x * input.border.z,
                input.border.y + gpOutside.y * input.border.w
            )
            let behindEdge = GlassCommon.backdropTap(external, externalSmp, externalSecond, externalSecondSmp, uvOutside, backdropBlend.blend)
            shadowRgb = Float3(behindEdge.x, behindEdge.y, behindEdge.z) * inkLevel * stacked
            }

            if distancePx > 0.5 {
                if shadowAlpha <= 0.002 {
                    out.color = Float4(0.0, 0.0, 0.0, 0.0)
                    return out
                }
                out.color = Float4(shadowRgb.x, shadowRgb.y, shadowRgb.z, shadowAlpha)
                return out
            }
            let cov = clamp(0.5 - distancePx, 0.0, 1.0)
            let minHalf = max(min(input.hsize.x, input.hsize.y), 1.0)
            let inside = max(0.0 - distancePx, 0.0)

            let gp = input.local / input.hsize
            let uvFrag = Float2(
                input.border.x + gp.x * input.border.z,
                input.border.y + gp.y * input.border.w
            )
            let n = Float2(0.0, -1.0)
            let coord = uvFrag
            if inside < 72.0 {
                let ref = GlassCommon.refractionCurve(inside / max(input.lens.z, 1.0))
                n = GlassCommon.sdRoundNormal(input.local, input.hsize, input.radius)
                let bend = (1.0 - ref) * min(minHalf, input.lens.y)
                let uvScale = Float2(input.border.z / input.hsize.x, input.border.w / input.hsize.y)
                coord = uvFrag - n * bend * uvScale
            }

            let dial = clamp(input.fill.w, 0.0, 1.0)
            if inside < GlassCommon.blurEdgeEnd {
                dial = dial * smoothstep(GlassCommon.blurEdgeStart, GlassCommon.blurEdgeEnd, inside)
            }
            let split = clamp(input.lens.w, 0.01, 0.99)
            let rgb = Float3(0.0, 0.0, 0.0)
            if dial <= 0.0 {
                let sharpTap = GlassCommon.backdropTap(external, externalSmp, externalSecond, externalSecondSmp, coord, backdropBlend.blend)
                rgb = Float3(sharpTap.x, sharpTap.y, sharpTap.z)
            } else if dial >= 1.0 {
                let softTap = sample(backdrop, backdropSmp, coord)
                rgb = Float3(softTap.x, softTap.y, softTap.z)
            } else if dial < split {
                let sharpTap = GlassCommon.backdropTap(external, externalSmp, externalSecond, externalSecondSmp, coord, backdropBlend.blend)
                let nearTap = sample(nearBlur, nearSmp, coord)
                rgb = mix(
                    Float3(sharpTap.x, sharpTap.y, sharpTap.z),
                    Float3(nearTap.x, nearTap.y, nearTap.z),
                    dial / split
                )
            } else {
                let nearTap = sample(nearBlur, nearSmp, coord)
                let softTap = sample(backdrop, backdropSmp, coord)
                rgb = mix(
                    Float3(nearTap.x, nearTap.y, nearTap.z),
                    Float3(softTap.x, softTap.y, softTap.z),
                    (dial - split) / (1.0 - split)
                )
            }

            let washA = clamp(input.borderWidth, 0.0, GlassCommon.washCeiling)
            rgb = GlassCommon.blendLayer(rgb, Float3(input.fill.x, input.fill.y, input.fill.z), washA, input.washBlend.x)
            let washUpperA = clamp(input.wash.w, 0.0, 1.0)
            rgb = GlassCommon.blendLayer(rgb, Float3(input.wash.x, input.wash.y, input.wash.z), washUpperA, input.washBlend.y)

            let lighting = clamp(input.edgeRefraction, 0.0, 2.0)
            let peak = input.edge.z
            let stroke = 0.0
            if inside < max(input.edge.w, peak + 0.01) {
                stroke = smoothstep(0.0, peak, inside) * (1.0 - smoothstep(peak, max(input.edge.w, peak + 0.01), inside)) * input.edge.x * lighting
            }
            let sheen = 0.0
            if inside < GlassCommon.sheenEnd {
                sheen = (1.0 - smoothstep(GlassCommon.sheenStart, GlassCommon.sheenEnd, inside)) * input.lens.x * clamp(0.0 - n.y, 0.0, 1.0) * lighting
            }
            rgb = mix(rgb, rgb * input.edge.y, stroke)
            rgb = rgb + Float3(sheen, sheen, sheen)

            let rimWidth = input.borderInk.w
            let rimInk = input.borderInk.y
            let rim = 0.0
            if inside < rimWidth {
                rim = clamp(rimWidth - inside, 0.0, 1.0) * input.borderInk.z
            }
            rgb = mix(rgb, Float3(rimInk, rimInk, rimInk), rim)

            let glassRgb = clamp(rgb, Float3(0.0, 0.0, 0.0), Float3(1.0, 1.0, 1.0))
            let over = 1.0 - cov
            let outRgb = glassRgb * cov + shadowRgb * over
            let outAlpha = cov + shadowAlpha * over
            out.color = Float4(outRgb.x, outRgb.y, outRgb.z, outAlpha)
            return out
        }
    }
}
