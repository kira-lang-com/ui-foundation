// What `kira lint` checks this package for. Foundation's `Lint.kira` declares
// the vocabulary; `LintRunner.kira` holds what each code actually looks for.
//
// Beside `package.kira` rather than under `app/`: what governs a whole package
// belongs next to what the package is called and what it depends on.

import Foundation

// 700 lines is the hard ceiling for every `.kira` and `.ksl` file. The number
// is written here rather than left to the runner's default so it is the same
// one this repo's AGENTS.md states, in the file that enforces it.
Lint FileLength {
    let code: String = "KLINT003"
    let severity: String = "warning"
    let enabled: Bool = true
    let limit: Int = 700
}

// A variant written with the type it already belongs to. Kira resolves a
// leading dot against the expected type, and `x == .Red` compiles to a tag
// compare with no throwaway enum, so the qualified spelling does more work.
Lint QualifiedVariant {
    let code: String = "KLINT001"
    let severity: String = "warning"
    let enabled: Bool = true
}

// A `while` counting an index by hand, where a `for` does it for you. Reported
// only when the rewrite is safe, and it carries the fix.
Lint ManualIndexLoop {
    let code: String = "KLINT002"
    let severity: String = "warning"
    let enabled: Bool = true
}
