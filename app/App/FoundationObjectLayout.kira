import KiraGraphics
import KiraLayout
import Foundation
function runFoundationLayout(view: FoundationView, available: borrow Size) -> LayoutTree {
    return FoundationLayoutPass().run(root: view, available: available)
}

function frameRight(frame: borrow Rect) -> Float {
    return frame.x + frame.width
}

function frameBottom(frame: borrow Rect) -> Float {
    return frame.y + frame.height
}

function smokePass(condition: Bool) -> Int {
    return condition ? 1 : 0
}

function floatAbs(value: Float) -> Float {
    return value < 0.0 ? 0.0 - value : value
}

function approxEqual(left: Float, right: Float) -> Bool {
    return floatAbs(left - right) < 0.01
}

function smokeTextColor() -> Color {
    return Color {
        r: 0.96
        g: 0.97
        b: 0.99
        a: 1.0
    }
}

function foundationFrameAtPath(root: borrow FoundationView, tree: borrow LayoutTree, path: borrow [Int]) -> Rect {
    return foundationFrameAtPathStep(root, tree, 0, path, 0)
}

function foundationFrameAtPathStep(root: borrow FoundationView, tree: borrow LayoutTree, nodeIndex: Int, path: borrow [Int], pathOffset: Int) -> Rect {
    if pathOffset >= path.count {
        return layoutFrame(tree, nodeIndex)
    }

    let childOffset = path[pathOffset]
    if childOffset < 0 || childOffset >= root.children.count {
        return Rect {}
    }

    let node = tree.nodes[nodeIndex]
    if node.firstChild == 0 {
        return Rect {}
    }

    return foundationFrameAtPathStep(root.children[childOffset], tree, node.firstChild + childOffset, path, pathOffset + 1)
}

function foundationIncrementalSampleView(label: String) -> FoundationView {
    return Column(
        children: [
            Text("HEADER", smokeTextColor(), 20.0, 600.0),
            Row(
                children: [
                    Text("LEFT", smokeTextColor(), 16.0, 400.0),
                    Text(move label, smokeTextColor(), 16.0, 400.0)
                ],
                width: .Hug,
                height: .Hug,
                spacing: 8.0,
                padding: EdgeInsets {},
                crossAxisAlignment: .Start
            )
        ],
        width: .Hug,
        height: .Hug,
        spacing: 10.0,
        padding: EdgeInsets {},
        crossAxisAlignment: .Start
    )
}

// Proves the retained incremental layout path: a repeated identical frame does
// zero measure/place work, and a localized text change recomputes only its
// ancestor chain while sibling subtrees are reused with pixel-identical frames.
function FoundationIncrementalLayoutSmoke() -> Int {
    var passed = 0
    let viewport = Size {
        width: 1280.0
        height: 720.0
    }
    let pass = FoundationLayoutPass()

    // Frame 1: cold start, full layout.
    var tree = pass.runIncremental(root: foundationIncrementalSampleView("ALPHA"), available: viewport, cached: LayoutTree { nodes: [] })
    let firstComputes = tree.measureComputes
    let rootWidthFirst = layoutFrame(tree, 0).width

    // Frame 2: identical view -> no recompute at all, geometry unchanged.
    tree = pass.runIncremental(root: foundationIncrementalSampleView("ALPHA"), available: viewport, cached: move tree)
    let headerBefore = layoutFrame(tree, 1)
    let leftBefore = layoutFrame(tree, 3)
    passed = passed + smokePass(
        firstComputes > 0 &&
        tree.measureComputes == 0 &&
        tree.placeComputes == 0 &&
        tree.measureSkips > 0 &&
        tree.placeSkips > 0 &&
        layoutFrame(tree, 0).width == rootWidthFirst
    )

    // Frame 3: change only the right-hand label. Its subtree recomputes; the
    // header and the unchanged "LEFT" sibling are reused.
    tree = pass.runIncremental(root: foundationIncrementalSampleView("OMEGA-LONGER-LABEL"), available: viewport, cached: move tree)
    let headerAfter = layoutFrame(tree, 1)
    let leftAfter = layoutFrame(tree, 3)
    passed = passed + smokePass(
        tree.measureComputes > 0 &&
        tree.measureComputes < firstComputes &&
        tree.measureSkips > 0 &&
        headerAfter.x == headerBefore.x &&
        headerAfter.y == headerBefore.y &&
        headerAfter.width == headerBefore.width &&
        headerAfter.height == headerBefore.height &&
        leftAfter.x == leftBefore.x &&
        leftAfter.width == leftBefore.width
    )

    // Frame 4: full-correctness guard. A from-scratch layout of the same final
    // view must produce byte-identical geometry to the incrementally updated
    // tree -- retention must never drift from a clean recompute.
    let fromScratch = pass.run(root: foundationIncrementalSampleView("OMEGA-LONGER-LABEL"), available: viewport)
    var allMatch = fromScratch.nodes.count == tree.nodes.count
    var index = 0
    while index < tree.nodes.count && allMatch {
        let a = layoutFrame(tree, index)
        let b = layoutFrame(fromScratch, index)
        if a.x != b.x || a.y != b.y || a.width != b.width || a.height != b.height {
            allMatch = false
        }
        index = index + 1
    }
    passed = passed + smokePass(allMatch)

    return passed
}

// A Fill/flex-heavy nested view: a Fill sidebar beside a Fill content column
// that holds a fixed-height Frame wrapping a stretched Row. This exercises the
// flexible/placeResized path -- the cases the retained cache must never let
// drift from a clean layout.
function foundationIncrementalDeepView(label: String) -> FoundationView {
    let sidebar = Frame(
        child: Column(
            children: [Text("NAV", smokeTextColor(), 16.0, 600.0)],
            width: .Fill,
            height: .Hug,
            spacing: 6.0,
            padding: EdgeInsets {},
            crossAxisAlignment: .Start
        ),
        width: .Fixed(220.0),
        height: .Fill,
        flex: 0,
        alignment: .TopLeading,
        padding: EdgeInsets {}
    )
    let content = Frame(
        child: Column(
            children: [
                Text("TITLE", smokeTextColor(), 28.0, 700.0),
                Row(
                    children: [
                        Text("LEFT", smokeTextColor(), 16.0, 400.0),
                        Text(move label, smokeTextColor(), 16.0, 400.0)
                    ],
                    width: .Fill,
                    height: .Fixed(40.0),
                    spacing: 12.0,
                    padding: EdgeInsets {},
                    crossAxisAlignment: .Stretch
                )
            ],
            width: .Fill,
            height: .Hug,
            spacing: 18.0,
            padding: EdgeInsets {},
            crossAxisAlignment: .Start
        ),
        width: .Fill,
        height: .Fill,
        flex: 0,
        alignment: .TopLeading,
        padding: EdgeInsets {}
    )
    return Row(
        children: [sidebar, content],
        width: .Fill,
        height: .Fill,
        spacing: 24.0,
        padding: EdgeInsets {
            top: 16.0
            trailing: 16.0
            bottom: 16.0
            leading: 16.0
        },
        crossAxisAlignment: .Stretch
    )
}

function foundationTreesGeometryEqual(a: borrow LayoutTree, b: borrow LayoutTree) -> Bool {
    if a.nodes.count != b.nodes.count {
        return false
    }
        for i in 0..a.nodes.count {
        let fa = layoutFrame(a, i)
        let fb = layoutFrame(b, i)
        if fa.x != fb.x || fa.y != fb.y || fa.width != fb.width || fa.height != fb.height {
            return false
        }
            }
    return true
}

// Strong correctness guard for the flexible path: at every step the
// incrementally updated tree must be geometry-identical to a from-scratch
// layout of the same view -- through a deep leaf change and a viewport resize,
// both of which cascade through Fill/stretch nodes.
function FoundationIncrementalDeepSmoke() -> Int {
    var passed = 0
    let pass = FoundationLayoutPass()
    let viewport = Size { width: 1280.0 height: 720.0 }

    var tree = pass.runIncremental(root: foundationIncrementalDeepView("ALPHA"), available: viewport, cached: LayoutTree { nodes: [] })

    // Static repeat: zero recompute, identical to from-scratch.
    tree = pass.runIncremental(root: foundationIncrementalDeepView("ALPHA"), available: viewport, cached: move tree)
    let scratchA = pass.run(root: foundationIncrementalDeepView("ALPHA"), available: viewport)
    passed = passed + smokePass(tree.measureComputes == 0 && tree.placeComputes == 0 && foundationTreesGeometryEqual(tree, scratchA))

    // Deep leaf change cascading through Fill/stretch ancestors.
    tree = pass.runIncremental(root: foundationIncrementalDeepView("OMEGA-LONGER"), available: viewport, cached: move tree)
    let scratchB = pass.run(root: foundationIncrementalDeepView("OMEGA-LONGER"), available: viewport)
    passed = passed + smokePass(tree.measureSkips > 0 && foundationTreesGeometryEqual(tree, scratchB))

    // Viewport resize: same descriptors, new constraints -- everything Fill
    // must re-resolve, and the result must still match from-scratch.
    let smaller = Size { width: 900.0 height: 500.0 }
    tree = pass.runIncremental(root: foundationIncrementalDeepView("OMEGA-LONGER"), available: smaller, cached: move tree)
    let scratchC = pass.run(root: foundationIncrementalDeepView("OMEGA-LONGER"), available: smaller)
    passed = passed + smokePass(foundationTreesGeometryEqual(tree, scratchC))

    return passed
}

// Correctness guard for the resize path's in-place relayout: re-measuring an
// already-built tree against a new viewport must produce geometry byte-identical
// to a clean from-scratch layout at that viewport. Covers a shrink and a grow
// across a Fill/flex-heavy tree, the cases where stale cached geometry would show.
function FoundationResizeLayoutSmoke() -> Int {
    var passed = 0
    let pass = FoundationLayoutPass()

    let large = Size { width: 1280.0 height: 720.0 }
    let small = Size { width: 900.0 height: 500.0 }

    var tree = pass.run(root: foundationIncrementalDeepView("ALPHA"), available: large)

    // Shrink in place, then compare to a clean layout at the smaller viewport.
    pass.relayout(tree, small)
    let scratchSmall = pass.run(root: foundationIncrementalDeepView("ALPHA"), available: small)
    passed = passed + smokePass(foundationTreesGeometryEqual(tree, scratchSmall))

    // Grow back in place, then compare to a clean layout at the larger viewport.
    pass.relayout(tree, large)
    let scratchLarge = pass.run(root: foundationIncrementalDeepView("ALPHA"), available: large)
    passed = passed + smokePass(foundationTreesGeometryEqual(tree, scratchLarge))

    return passed
}

function FoundationPrimitiveLayoutSmoke() -> Int {
    var passed = 0

    let columnRoot = Column(
        children: [
            Text("TOP", smokeTextColor(), 18.0, 400.0),
            Text("BOTTOM", smokeTextColor(), 18.0, 400.0)
        ],
        width: .Hug,
        height: .Hug,
        spacing: 12.0,
        padding: EdgeInsets {},
        crossAxisAlignment: .Start
    )
    let columnLayout = runFoundationLayout(move columnRoot, Size {
        width: 400.0
        height: 200.0
    })
    let columnTop = foundationFrameAtPath(
        Column(
            children: [
                Text("TOP", smokeTextColor(), 18.0, 400.0),
                Text("BOTTOM", smokeTextColor(), 18.0, 400.0)
            ],
            width: .Hug,
            height: .Hug,
            spacing: 12.0,
            padding: EdgeInsets {},
            crossAxisAlignment: .Start
        ),
        columnLayout,
        [0]
    )
    let columnBottom = foundationFrameAtPath(
        Column(
            children: [
                Text("TOP", smokeTextColor(), 18.0, 400.0),
                Text("BOTTOM", smokeTextColor(), 18.0, 400.0)
            ],
            width: .Hug,
            height: .Hug,
            spacing: 12.0,
            padding: EdgeInsets {},
            crossAxisAlignment: .Start
        ),
        columnLayout,
        [1]
    )
    passed = passed + smokePass(
        approxEqual(columnTop.x, 0.0) &&
        approxEqual(columnTop.y, 0.0) &&
        approxEqual(columnBottom.x, 0.0) &&
        approxEqual(columnBottom.y, 33.6) &&
        columnBottom.y > frameBottom(columnTop)
    )

    let rowRoot = Row(
        children: [
            Text("LEFT", smokeTextColor(), 18.0, 400.0),
            Text("RIGHT", smokeTextColor(), 18.0, 400.0)
        ],
        width: .Hug,
        height: .Hug,
        spacing: 14.0,
        padding: EdgeInsets {},
        crossAxisAlignment: .Start
    )
    let rowLayout = runFoundationLayout(move rowRoot, Size {
        width: 400.0
        height: 120.0
    })
    let rowLeft = foundationFrameAtPath(
        Row(
            children: [
                Text("LEFT", smokeTextColor(), 18.0, 400.0),
                Text("RIGHT", smokeTextColor(), 18.0, 400.0)
            ],
            width: .Hug,
            height: .Hug,
            spacing: 14.0,
            padding: EdgeInsets {},
            crossAxisAlignment: .Start
        ),
        rowLayout,
        [0]
    )
    let rowRight = foundationFrameAtPath(
        Row(
            children: [
                Text("LEFT", smokeTextColor(), 18.0, 400.0),
                Text("RIGHT", smokeTextColor(), 18.0, 400.0)
            ],
            width: .Hug,
            height: .Hug,
            spacing: 14.0,
            padding: EdgeInsets {},
            crossAxisAlignment: .Start
        ),
        rowLayout,
        [1]
    )
    passed = passed + smokePass(
        approxEqual(rowLeft.x, 0.0) &&
        approxEqual(rowLeft.y, 0.0) &&
        approxEqual(rowRight.x, 58.28) &&
        approxEqual(rowRight.y, 0.0) &&
        rowRight.x > frameRight(rowLeft)
    )

    let frameRootView = Frame(
        child: Text("HELLO", smokeTextColor(), 20.0, 400.0),
        width: .Fill,
        height: .Fill,
        flex: 0,
        alignment: .TopLeading,
        padding: EdgeInsets {}
    )
    let frameLayout = runFoundationLayout(move frameRootView, Size {
        width: 300.0
        height: 120.0
    })
    let frameRoot = layoutFrame(frameLayout, 0)
    let frameChild = foundationFrameAtPath(
        Frame(
            child: Text("HELLO", smokeTextColor(), 20.0, 400.0),
            width: .Fill,
            height: .Fill,
            flex: 0,
            alignment: .TopLeading,
            padding: EdgeInsets {}
        ),
        frameLayout,
        [0]
    )
    passed = passed + smokePass(
        approxEqual(frameRoot.width, 300.0) &&
        approxEqual(frameRoot.height, 120.0) &&
        approxEqual(frameChild.x, 0.0) &&
        approxEqual(frameChild.y, 0.0) &&
        frameChild.width > 0.0 &&
        frameChild.width < 300.0 &&
        frameChild.height > 0.0 &&
        frameChild.height < 120.0
    )

    let surfaceRootView = Surface(
        children: [
            Text("PAD", smokeTextColor(), 16.0, 400.0)
        ],
        width: .Hug,
        height: .Hug,
        flex: 0,
        fill: Color { r: 1.0 g: 1.0 b: 1.0 a: 1.0 },
        border: Color { r: 0.0 g: 0.0 b: 0.0 a: 0.0 },
        borderWidth: 0.0,
        radius: 0.0,
        shape: .RegularRoundedRect,
        material: .Flat,
        effects: [],
        padding: EdgeInsets {
            top: 10.0
            trailing: 12.0
            bottom: 14.0
            leading: 16.0
        },
        clipContent: false
    )
    let surfaceLayout = runFoundationLayout(move surfaceRootView, Size {
        width: 300.0
        height: 200.0
    })
    let surfaceRoot = layoutFrame(surfaceLayout, 0)
    let paddedChild = foundationFrameAtPath(
        Surface(
            children: [
                Text("PAD", smokeTextColor(), 16.0, 400.0)
            ],
            width: .Hug,
            height: .Hug,
            flex: 0,
            fill: Color { r: 1.0 g: 1.0 b: 1.0 a: 1.0 },
            border: Color { r: 0.0 g: 0.0 b: 0.0 a: 0.0 },
            borderWidth: 0.0,
            radius: 0.0,
            shape: .RegularRoundedRect,
            material: .Flat,
            effects: [],
            padding: EdgeInsets {
                top: 10.0
                trailing: 12.0
                bottom: 14.0
                leading: 16.0
            },
            clipContent: false
        ),
        surfaceLayout,
        [0]
    )
    passed = passed + smokePass(
        approxEqual(paddedChild.x, 16.0) &&
        approxEqual(paddedChild.y, 10.0) &&
        approxEqual(surfaceRoot.width, paddedChild.width + 28.0) &&
        approxEqual(surfaceRoot.height, paddedChild.height + 24.0)
    )

    let textLayoutA = runFoundationLayout(
        Text("KIRA", smokeTextColor(), 26.0, 400.0),
        Size {
            width: 300.0
            height: 100.0
        }
    )
    let textLayoutB = runFoundationLayout(
        Text("KIRA", smokeTextColor(), 26.0, 400.0),
        Size {
            width: 300.0
            height: 100.0
        }
    )
    let textFrameA = layoutFrame(textLayoutA, 0)
    let textFrameB = layoutFrame(textLayoutB, 0)
    passed = passed + smokePass(textFrameA.width > 0.0 && textFrameA.height > 0.0 && textFrameA.width == textFrameB.width && textFrameA.height == textFrameB.height)

    let spacerRootView = Row(
        children: [
            Text("LEFT", smokeTextColor(), 16.0, 400.0),
            Spacer(0.0, 1),
            Text("RIGHT", smokeTextColor(), 16.0, 400.0)
        ],
        width: .Fill,
        height: .Fixed(28.0),
        spacing: 0.0,
        padding: EdgeInsets {},
        crossAxisAlignment: .Stretch
    )
    let spacerLayout = runFoundationLayout(move spacerRootView, Size {
        width: 320.0
        height: 28.0
    })
    let spacerFrame = foundationFrameAtPath(
        Row(
            children: [
                Text("LEFT", smokeTextColor(), 16.0, 400.0),
                Spacer(0.0, 1),
                Text("RIGHT", smokeTextColor(), 16.0, 400.0)
            ],
            width: .Fill,
            height: .Fixed(28.0),
            spacing: 0.0,
            padding: EdgeInsets {},
            crossAxisAlignment: .Stretch
        ),
        spacerLayout,
        [1]
    )
    let spacerRight = foundationFrameAtPath(
        Row(
            children: [
                Text("LEFT", smokeTextColor(), 16.0, 400.0),
                Spacer(0.0, 1),
                Text("RIGHT", smokeTextColor(), 16.0, 400.0)
            ],
            width: .Fill,
            height: .Fixed(28.0),
            spacing: 0.0,
            padding: EdgeInsets {},
            crossAxisAlignment: .Stretch
        ),
        spacerLayout,
        [2]
    )
    passed = passed + smokePass(
        approxEqual(spacerFrame.x, 39.36) &&
        approxEqual(spacerFrame.width, 230.72) &&
        approxEqual(spacerRight.x, 270.08) &&
        spacerFrame.width > 0.0 &&
        spacerRight.x >= frameRight(spacerFrame)
    )

    return passed
}