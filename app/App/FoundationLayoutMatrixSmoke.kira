import Foundation
import KiraLayout
function foundationMatrixInsets(top: Float, trailing: Float, bottom: Float, leading: Float) -> EdgeInsets {
    return EdgeInsets {
        top: top
        trailing: trailing
        bottom: bottom
        leading: leading
    }
}

function foundationMatrixLeaf(width: SizeMode, height: SizeMode, flex: Int, margin: EdgeInsets, x: Float, y: Float) -> LayoutNode {
    var node = LayoutNode(
        firstChild: 0,
        childCount: 0
    )
    layoutNodeFlattenDescriptor(node, LayoutDescriptor {
        width: width
        height: height
        flex: flex
        arrange: .Fill
        axis: .Vertical
        alignment: .Stretch
        overlayAlignment: .Center
        padding: EdgeInsets {}
        margin: margin
        x: x
        y: y
    })
    return node
}

function foundationMatrixContainer(
    width: SizeMode,
    height: SizeMode,
    flex: Int,
    arrange: ArrangeMode,
    axis: Axis,
    spacing: Float,
    rowSpacing: Float,
    alignment: CrossAlignment,
    overlayAlignment: Alignment,
    columns: Int,
    padding: EdgeInsets,
    margin: EdgeInsets,
    firstChild: Int,
    childCount: Int,
) -> LayoutNode {
    var node = LayoutNode(
        firstChild: firstChild,
        childCount: childCount
    )
    layoutNodeFlattenDescriptor(node, LayoutDescriptor {
        width: width
        height: height
        flex: flex
        arrange: arrange
        axis: axis
        spacing: spacing
        rowSpacing: rowSpacing
        alignment: alignment
        overlayAlignment: overlayAlignment
        columns: columns
        padding: padding
        margin: margin
    })
    return node
}

function foundationMatrixRun(tree: LayoutTree, available: borrow Size) -> LayoutTree {
    var laidOut = layoutResetCounters(move tree)
    let engine = LayoutEngine()
    engine.measure(tree: laidOut, index: 0, available: available)
    engine.place(tree: laidOut, index: 0, origin: Point {})
    layoutMarkAllClean(laidOut)
    return laidOut
}

function foundationMatrixRelayout(tree: LayoutTree, available: borrow Size) -> LayoutTree {
    var laidOut = layoutResetCounters(move tree)
    let engine = LayoutEngine()
    engine.measure(tree: laidOut, index: 0, available: available)
    engine.place(tree: laidOut, index: 0, origin: Point {})
    return laidOut
}

function foundationMatrixTreeByCode(code: Int) -> LayoutTree {
    if code == 1 {
        return foundationMatrixStackTree(.Start)
    }
    if code == 2 {
        return foundationMatrixStackTree(.Center)
    }
    if code == 3 {
        return foundationMatrixStackTree(.End)
    }
    if code == 4 {
        return foundationMatrixStackTree(.Stretch)
    }
    if code == 5 {
        return foundationMatrixAbsoluteTree()
    }
    if code == 6 {
        return foundationMatrixGridTree()
    }
    if code == 7 {
        return foundationMatrixWrapTree()
    }
    if code == 8 {
        return foundationMatrixOverlayTree(.TopLeading)
    }
    if code == 9 {
        return foundationMatrixOverlayTree(.Center)
    }
    if code == 10 {
        return foundationMatrixOverlayTree(.BottomTrailing)
    }
    return foundationMatrixFillTree()
}

function foundationMatrixCaseMatches(code: Int, large: borrow Size, small: borrow Size) -> Bool {
    var relaid = foundationMatrixRun(foundationMatrixTreeByCode(code), large)
    relaid = foundationMatrixRelayout(move relaid, small)
    let scratchSmall = foundationMatrixRun(foundationMatrixTreeByCode(code), small)
    if !foundationTreesGeometryEqual(relaid, scratchSmall) {
        return false
    }
    relaid = foundationMatrixRelayout(move relaid, large)
    let scratchLarge = foundationMatrixRun(foundationMatrixTreeByCode(code), large)
    return foundationTreesGeometryEqual(relaid, scratchLarge)
}

function foundationMatrixStackTree(alignment: CrossAlignment) -> LayoutTree {
    return LayoutTree(nodes: [
        foundationMatrixContainer(
            width: .Fill,
            height: .Hug,
            flex: 0,
            arrange: .Stack,
            axis: .Horizontal,
            spacing: 6.0,
            rowSpacing: 0.0,
            alignment: move alignment,
            overlayAlignment: .Center,
            columns: 1,
            padding: foundationMatrixInsets(4.0, 6.0, 5.0, 7.0),
            margin: EdgeInsets {},
            firstChild: 1,
            childCount: 4
        ),
        foundationMatrixLeaf(.Fixed(80.0), .Fixed(28.0), 0, foundationMatrixInsets(1.0, 2.0, 3.0, 4.0), 0.0, 0.0),
        foundationMatrixLeaf(.Fill, .Fixed(22.0), 2, foundationMatrixInsets(0.0, 3.0, 2.0, 1.0), 0.0, 0.0),
        foundationMatrixLeaf(.Fraction(0.25), .Min(26.0), 0, foundationMatrixInsets(2.0, 1.0, 1.0, 2.0), 0.0, 0.0),
        foundationMatrixLeaf(.Max(90.0), .Fixed(18.0), 0, foundationMatrixInsets(0.0, 2.0, 0.0, 2.0), 0.0, 0.0)
    ])
}

function foundationMatrixAbsoluteTree() -> LayoutTree {
    return LayoutTree(nodes: [
        foundationMatrixContainer(
            width: .Hug,
            height: .Hug,
            flex: 0,
            arrange: .Absolute,
            axis: .Vertical,
            spacing: 0.0,
            rowSpacing: 0.0,
            alignment: .Start,
            overlayAlignment: .Center,
            columns: 1,
            padding: foundationMatrixInsets(3.0, 4.0, 5.0, 6.0),
            margin: EdgeInsets {},
            firstChild: 1,
            childCount: 2
        ),
        foundationMatrixLeaf(.Fixed(44.0), .Fixed(18.0), 0, foundationMatrixInsets(1.0, 0.0, 0.0, 2.0), 10.0, 12.0),
        foundationMatrixLeaf(.Fixed(30.0), .Fixed(26.0), 0, foundationMatrixInsets(0.0, 1.0, 2.0, 0.0), 72.0, 24.0)
    ])
}

function foundationMatrixGridTree() -> LayoutTree {
    return LayoutTree(nodes: [
        foundationMatrixContainer(
            width: .Fill,
            height: .Hug,
            flex: 0,
            arrange: .Grid,
            axis: .Vertical,
            spacing: 8.0,
            rowSpacing: 5.0,
            alignment: .Stretch,
            overlayAlignment: .Center,
            columns: 2,
            padding: foundationMatrixInsets(3.0, 4.0, 3.0, 4.0),
            margin: EdgeInsets {},
            firstChild: 1,
            childCount: 3
        ),
        foundationMatrixLeaf(.Fill, .Fixed(20.0), 0, foundationMatrixInsets(1.0, 2.0, 1.0, 2.0), 0.0, 0.0),
        foundationMatrixLeaf(.Fixed(36.0), .Max(34.0), 0, foundationMatrixInsets(0.0, 1.0, 2.0, 1.0), 0.0, 0.0),
        foundationMatrixLeaf(.Fixed(28.0), .Min(24.0), 0, foundationMatrixInsets(2.0, 0.0, 0.0, 3.0), 0.0, 0.0)
    ])
}

function foundationMatrixWrapTree() -> LayoutTree {
    return LayoutTree(nodes: [
        foundationMatrixContainer(
            width: .Fill,
            height: .Hug,
            flex: 0,
            arrange: .Wrap,
            axis: .Horizontal,
            spacing: 5.0,
            rowSpacing: 7.0,
            alignment: .End,
            overlayAlignment: .Center,
            columns: 1,
            padding: foundationMatrixInsets(2.0, 3.0, 4.0, 5.0),
            margin: EdgeInsets {},
            firstChild: 1,
            childCount: 4
        ),
        foundationMatrixLeaf(.Fixed(48.0), .Fixed(16.0), 0, foundationMatrixInsets(0.0, 1.0, 2.0, 1.0), 0.0, 0.0),
        foundationMatrixLeaf(.Fraction(0.3), .Fixed(20.0), 0, foundationMatrixInsets(1.0, 2.0, 0.0, 2.0), 0.0, 0.0),
        foundationMatrixLeaf(.Min(34.0), .Fixed(18.0), 0, foundationMatrixInsets(0.0, 0.0, 1.0, 3.0), 0.0, 0.0),
        foundationMatrixLeaf(.Max(60.0), .Fixed(22.0), 0, foundationMatrixInsets(2.0, 1.0, 0.0, 1.0), 0.0, 0.0)
    ])
}

function foundationMatrixOverlayTree(alignment: Alignment) -> LayoutTree {
    return LayoutTree(nodes: [
        foundationMatrixContainer(
            width: .Fixed(180.0),
            height: .Fixed(110.0),
            flex: 0,
            arrange: .Overlay,
            axis: .Vertical,
            spacing: 0.0,
            rowSpacing: 0.0,
            alignment: .Stretch,
            overlayAlignment: move alignment,
            columns: 1,
            padding: foundationMatrixInsets(6.0, 7.0, 8.0, 9.0),
            margin: EdgeInsets {},
            firstChild: 1,
            childCount: 1
        ),
        foundationMatrixLeaf(.Fixed(34.0), .Fixed(20.0), 0, foundationMatrixInsets(1.0, 2.0, 3.0, 4.0), 0.0, 0.0)
    ])
}

function foundationMatrixFillTree() -> LayoutTree {
    return LayoutTree(nodes: [
        foundationMatrixContainer(
            width: .Fraction(0.75),
            height: .Min(80.0),
            flex: 0,
            arrange: .Fill,
            axis: .Vertical,
            spacing: 0.0,
            rowSpacing: 0.0,
            alignment: .Stretch,
            overlayAlignment: .Center,
            columns: 1,
            padding: foundationMatrixInsets(5.0, 6.0, 7.0, 8.0),
            margin: EdgeInsets {},
            firstChild: 1,
            childCount: 1
        ),
        foundationMatrixLeaf(.Fill, .Fill, 1, foundationMatrixInsets(2.0, 3.0, 4.0, 5.0), 0.0, 0.0)
    ])
}

function FoundationFlattenVariantSmoke() -> Bool {
    let large = Size { width: 640.0 height: 420.0 }
    let small = Size { width: 360.0 height: 260.0 }
    return foundationMatrixCaseMatches(1, large, small) &&
        foundationMatrixCaseMatches(2, large, small) &&
        foundationMatrixCaseMatches(3, large, small) &&
        foundationMatrixCaseMatches(4, large, small) &&
        foundationMatrixCaseMatches(5, large, small) &&
        foundationMatrixCaseMatches(6, large, small) &&
        foundationMatrixCaseMatches(7, large, small) &&
        foundationMatrixCaseMatches(8, large, small) &&
        foundationMatrixCaseMatches(9, large, small) &&
        foundationMatrixCaseMatches(10, large, small) &&
        foundationMatrixCaseMatches(11, large, small)
}