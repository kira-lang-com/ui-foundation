import KiraGraphics
import KiraLayout
import Foundation

// The interactive run loop: a window, an event pump, and a frame built from the
// retained tree each time something changed.
//
// Separate from `RunFoundationApp` because the two answer different questions.
// This one owns the loop that keeps running; that one owns starting an app and
// handing it a root view.

function RunFoundationInteractiveApp(
    title: String,
    width: Int,
    height: Int,
    rootBuilder: borrow (borrow FoundationUiContext) -> FoundationView,
    // Host hook: runs FIRST every frame, BEFORE the UI render pass begins — the place a
    // hosting engine ticks its simulation and runs its own (offscreen) render passes, e.g.
    // drawing the scene into the render-target texture a TextureView shows this same frame.
    engineFrame: borrow (borrow mut RenderFrame) -> Void = foundationNoopEngineFrame,
    // Host-owned animation invalidation. Return true only while external state used
    // by rootBuilder is changing without an input event (for example a theme tween).
    needsRebuild: borrow () -> Bool = foundationNoContinuousRebuild,
    // Live FPS badge overlay (bottom-left). Chrome-dense apps (editors) turn it off.
    showFpsOverlay: Bool = true,
    // Expanded opt-in diagnostics: FPS/frame/CPU/GPU timings, drawable size,
    // Metal allocation, resources, workload, window state, and frame serial.
    // When enabled it replaces the compact FPS badge.
    showGraphicsHud: Bool = false,
    // When false, a resize-only frame (viewport changed, no new input events)
    // reuses the cached widget tree — skipping the builder and the retained
    // reconcile — and only re-lays-out and re-renders. Correct whenever the
    // builder's OUTPUT STRUCTURE does not depend on the viewport size (fixed
    // chrome); hosts whose widget tree adapts to the viewport keep the default.
    rebuildOnResize: Bool = true,
    // The mode the window OPENS in. A running app moves between modes with
    // `frame.setWindowMode`; fullscreen ignores the size above and takes the
    // display's, which the layout picks up from the frame's viewport like any
    // other size.
    windowMode: WindowMode = .Windowed,
    // A window the desktop shows through. The frame is cleared to the key
    // colour instead of a page, so what the interface does not paint is a hole:
    // a floating panel, a rounded window with nothing square behind it, a
    // heads-up display over whatever is running underneath.
    transparent: Bool = false,
    // How opaque the whole window is composited — the sheet of glass an overlay
    // is drawn on, which is not the same as a translucent surface inside an
    // opaque window.
    opacity: Float = 1.0,
    // Launch-time harness — capture, quit-after, input scripts — as a value
    // rather than environment variables. Default is unconfigured, so a run given
    // none reads the environment exactly as before; a caller that provides one
    // (a screenshot tool, a driven test) needs no environment at all.
    harness: HarnessConfig = HarnessConfig {},
    // The content-owned titlebar region, if the host has one. Without one, the
    // graphics layer's narrow invisible top-edge fallback keeps the undecorated
    // window movable.
    //
    // LAST, and every parameter added after it belongs here too: a call binds
    // its arguments by POSITION and a label on one is decorative, so a
    // parameter inserted in the middle of this list silently rebinds every
    // existing call — `engineFrame:` becomes this, `needsRebuild:` becomes
    // `engineFrame`, and the compiler reports a type error at best and nothing
    // at all at worst.
    windowDragRegion: borrow (Float, Float) -> Bool = graphicsApplicationFallbackWindowDragRegion,
) {
    let runtimeStorage = nativeState(FoundationAppState {
        root: foundationEmptyRootView()
        batch: UiBatch { storage: nullPointer() }
        profile: foundationFrameProfileFromEnvironment()
        page: foundationPageFor(transparent)
        transparent: transparent
    })
    let runtimeUser = nativeUserData(runtimeStorage)

    let declaredWindowDragRegion: borrow (Float, Float) -> Bool = windowDragRegion
    let resolvedWindowDragRegion: (Float, Float) -> Bool = { x, y in
        if declaredWindowDragRegion(x, y) == false {
            return false
        }
        // Toolbar controls keep their clicks. Only otherwise-empty toolbar
        // surface is window furniture, matching a native titlebar.
        let current = nativeRecover<FoundationAppState>(runtimeUser)
        return foundationHitRegionIndexAtPoint(current.hitRegions, x, y) < 0
    }

    var app = GraphicsApplication {
        title: title
        width: width
        height: height
        sampleCount: 1
        windowMode: windowMode
        transparent: transparent
        opacity: opacity
        // Platform-aware default: Metal on Apple hosts, Sokol everywhere else
        // (including Web/WASM, where the host-platform probe honestly reports
        // Unknown and Sokol/WebGPU is the only backend). The per-frame path
        // already dispatches on the frame's own backend.
        backend: graphicsDefaultBackend()
        harness: harness
        windowDragRegion: resolvedWindowDragRegion
    }

    app.onEvent { event in
        foundationDispatchEvent(runtimeUser, event)
        return
    }

    app.onFrame { frame in
        // Engine-first: host simulation + offscreen passes complete before any UI work, so a
        // TextureView composites THIS frame's engine output, never last frame's.
        let hostFrame: borrow (borrow mut RenderFrame) -> Void = engineFrame
        hostFrame(frame)
        let hostNeedsRebuild: borrow () -> Bool = needsRebuild
        var state = nativeRecover<FoundationAppState>(frame.userData)
        let profileFrameStart = foundationProfileNow(state.profile, frame)
        state.ui.frameCount = state.frameCount
        // The live window, in points, so an interactive resize reflows. Asked of
        // the frame rather than branched on the backend: Metal keeps it on its
        // context and sokol derives it from the drawable, and which of those it
        // is has nothing to do with laying out an interface.
        var mvW = frame.viewportWidth()
        var mvH = frame.viewportHeight()
        if mvW <= 0.0 {
            mvW = intAsFloat(value: width)
        }
        if mvH <= 0.0 {
            mvH = intAsFloat(value: height)
        }
        // A forced render scale changes how many points the drawable holds, and
        // LAYOUT has to agree with the batch about that. Laying out against the
        // window's own point size while drawing at a different scale renders a
        // tree wider than the surface and clips whatever sits at the trailing
        // edge — which is the whole right-hand panel.
        let renderScale = foundationRenderScale(frame.backingScale())
        if renderScale > 0.0 {
            mvW = intAsFloat(value: frame.drawableWidth()) / renderScale
            mvH = intAsFloat(value: frame.drawableHeight()) / renderScale
        }
        state.ui.viewport = Size {
            width: mvW
            height: mvH
        }
        if state.ui.viewport.width <= 0.0 || state.ui.viewport.height <= 0.0 {
            state.ui.viewport = Size {
                width: 1280.0
                height: 720.0
            }
        }
        foundationWriteViewportSnapshot(state.ui.viewport.width, state.ui.viewport.height)
        let graphics = foundationFrameGraphics(frame)
        if !state.batchReady {
            state.batch = UiBatch { storage: createBatch(graphics) }
            state.batchReady = true
        }
        let batch = state.batch

        // A VM hot patch preserves the window and callback-state store, so the
        // retained fast path would otherwise keep presenting the old tree
        // forever. Invalidate one frame when the runner marks a swap boundary;
        // the normal builder/reconcile/layout path then installs the new code's
        // view and the steady-state fast path resumes on the following frame.
        if kiraGraphicsLiveReloadPending() {
            state.hasPresentedFrame = false
            state.ui.eventCount = state.ui.eventCount + 1
        }

        // Re-present fast path: no events arrived since the last full rebuild and
        // the viewport is unchanged, so the rebuilt tree could not differ. The
        // retained batch's vertex/index buffers already describe this frame's
        // pixels — re-flush them and skip the widget build, retained reconcile,
        // layout, and render entirely. Hit regions persist in state, so input
        // keeps working; the engine hook already ran, and a TextureView samples
        // its texture's CURRENT contents on flush, so an engine-rendered viewport
        // stays live even on skipped frames.
        let vpWNow = Int(state.ui.viewport.width)
        let vpHNow = Int(state.ui.viewport.height)
        let overlayEnabled = showFpsOverlay || showGraphicsHud
        if overlayEnabled {
            state.hudRefreshElapsed = state.hudRefreshElapsed + foundationFrameDuration(frame)
        }
        let hudNeedsRefresh = overlayEnabled && state.hudRefreshElapsed >= foundationHudRefreshSeconds()
        // Momentum runs on the frame clock, not on input. A thrown list keeps
        // moving after the finger has gone and an edge springs back after the
        // pull that stretched it, so every scrolling region is advanced here —
        // on frames no event arrived on, which is most of the frames a throw
        // lasts for.
        //
        // The motion preference travels as an argument rather than being read
        // here, because this package has no platform to ask; a host that knows
        // one threads it in the same way it threads `needsRebuild`.
        let scrollMoving = foundationScrollAdvance(foundationFrameDuration(frame), false)
        if state.hasPresentedFrame &&
            // A region still in motion has a new offset this frame, and the
            // offset is applied during layout — so the frame that skips layout
            // is the frame that freezes the throw.
            !scrollMoving &&
            !hostNeedsRebuild() &&
            state.batchReady &&
            state.ui.eventCount == state.lastPresentedEventCount &&
            vpWNow == state.lastPresentedViewportW &&
            vpHNow == state.lastPresentedViewportH {
            // The overlay's counters are the ONE thing that changes while the
            // application's pixels do not. It has a retained stream of its own, so
            // refreshing it rewrites that stream and nothing else — the widget
            // build, the retained reconcile, the layout and every application quad
            // are all still skipped on this frame.
            if hudNeedsRefresh {
                let hudStats = foundationFrameGraphicsStats(frame)
                let hudOverlay = foundationGraphicsOverlay(hudStats, showGraphicsHud)
                let hudLayout = FoundationLayoutPass().run(root: hudOverlay, available: state.ui.viewport)
                foundationEmitHud(graphics, state.batch, hudOverlay, hudLayout, vpWNow, vpHNow)
                state.hudRefreshElapsed = 0.0
            }
            // Re-runs the retained streams — including the liquid-glass
            // capture/blur passes on a split frame, so glass stays live over an
            // engine viewport that re-renders beneath it.
            let profilePresentStart = foundationProfileNow(state.profile, frame)
            state.batch.presentBatch(frame, graphics, state.page.r, state.page.g, state.page.b, state.page.a)
            let profilePresentEnd = foundationProfileNow(state.profile, frame)
            foundationProfileSample(
                state.profile,
                FoundationFramePhases {
                    presentNs: profilePresentEnd - profilePresentStart
                    frameNs: profilePresentEnd - profileFrameStart
                    represented: true
                },
                state.batch.presentPhaseTimes(),
                state.batch.glassFrameStats(),
            )
            foundationProfileReportWhenFull(state.profile)
            state.frameCount = state.frameCount + 1
            state.ui.clickedKey = 0
            state.ui.scrollX = 0.0
            state.ui.scrollY = 0.0
            state.ui.lastTextCodepoint = 0
            state.ui.lastKeyCode = 0
            return
        }

        // Resize-only frame for a fixed-structure host: reuse the cached tree.
        // (Reaching here means the re-present gate above did not hit, so either
        // the viewport moved or events arrived; the event check isolates resize.)
        // (The overlay used to be composed into this tree, which is why a resize-only
        // frame could not be taken while one was shown: the composed root changed
        // every frame. It has its own stream now, so the cached tree is reusable
        // whether or not an overlay is on screen.)
        let resizeOnly = !rebuildOnResize &&
            state.hasCachedRoot &&
            state.ui.eventCount == state.lastPresentedEventCount

        let profileBuildStart = foundationProfileNow(state.profile, frame)
        var root = FoundationView {
            kind: .Spacer
        }
        if resizeOnly {
            root = state.cachedRoot
        } else {
            let buildRoot: borrow (borrow FoundationUiContext) -> FoundationView = rootBuilder
            root = buildRoot(state.ui)
        }
        let profileBuildEnd = foundationProfileNow(state.profile, frame)

        // The walk only ACCUMULATES quads, so the swapchain pass must not begin
        // yet — a liquid-glass frame runs its capture/blur passes first, and
        // presentBatch owns the whole pass structure.
        var backend = KiraGraphicsFoundationBackend {
            graphics: graphics
            batch: batch
            windowTransparent: state.transparent
        }
        let viewport = state.ui.viewport
        // A resize-only frame reuses the cached tree, so the retained structure
        // cannot have changed — skip the reconcile as well.
        let profileLayoutStart = foundationProfileNow(state.profile, frame)
        if state.frameCount == 0 {
            state.retainedTree = foundationRetainedMount(root)
        } else {
            if !resizeOnly {
                state.retainedTree = foundationRetainedUpdate(state.retainedTree, root)
            }
        }
        if !state.announcedTree && foundationRenderableViewCount(root) > 0 {
            kiraGraphicsLiveUiFoundationTreeBuilt()
            state.announcedTree = true
        }
        if !state.announcedRetainedTree && state.retainedTree.rootId != 0 {
            kiraGraphicsLiveUiFoundationRetainedTreeReady()
            state.announcedRetainedTree = true
        }

        // Retained, incremental layout: reuse the previous frame's laid-out
        // tree and recompute only the subtrees whose descriptors actually
        // changed (or whose offered size changed). A static frame does no
        // measure/place work; a localized change touches only its ancestor
        // chain. This replaces the previous all-or-nothing gate, which either
        // reused the entire cached tree or rebuilt it from scratch and could go
        // stale when a layout-affecting field changed without moving the lossy
        // invalidation signature.
        //
        // EXCEPT when the viewport changed OR input events drove this rebuild:
        // the incremental engine's offer-based skip leaves flexed subtrees with
        // stale geometry when content changes size (observed as panels laid out
        // half at the old size, half at the new after a resize, and as sibling
        // flex panels stealing height after a click moved a row highlight).
        // Resize and event frames pay for one full layout; the incremental path
        // remains for event-free per-frame rebuilds (the FPS-overlay hosts,
        // where only the badge subtree changes each frame).
        var laidOut = LayoutTree {
            nodes: []
        }
        var viewportChanged = true
        if state.cachedLayoutTree.nodes.count > 0 {
            let cachedRootFrame = foundationRootFrame(state.cachedLayoutTree)
            viewportChanged = Int(cachedRootFrame.width) != Int(viewport.width) || Int(cachedRootFrame.height) != Int(viewport.height)
        }
        let eventsArrived = state.ui.eventCount != state.lastPresentedEventCount
        if viewportChanged || eventsArrived {
            laidOut = FoundationLayoutPass().run(root: root, available: viewport)
        } else {
            laidOut = FoundationLayoutPass().runIncremental(root: root, available: viewport, cached: state.cachedLayoutTree)
        }
        state.cachedLayoutTree = laidOut
        let profileLayoutEnd = foundationProfileNow(state.profile, frame)
        let rootFrame = foundationRootFrame(laidOut)
        if rootFrame.width > 0.0 && rootFrame.height > 0.0 && !state.announcedLayout {
            kiraGraphicsLiveUiFoundationLayoutNonEmpty()
            state.announcedLayout = true
        }

        let profileRenderStart = foundationProfileNow(state.profile, frame)
        backend.beginFrame(Int(viewport.width), Int(viewport.height))
        let renderCount = foundationRender(root, laidOut, backend)
        let profileRenderEnd = foundationProfileNow(state.profile, frame)
        state.hitRegions = backend.hitRegions
        foundationReconcileFocus(state.ui, state.hitRegions)
        if renderCount > 0 && !state.announcedRenderCommands {
            kiraGraphicsLiveUiFoundationRenderCommandsGenerated()
            state.announcedRenderCommands = true
        }

        state.frameCount = state.frameCount + 1
        // The overlay is written into its own stream on a full frame too, so a
        // rebuild and a refresh produce the same vertices by the same path —
        // there is one HUD, not a composed one and a retained one.
        if overlayEnabled {
            let hudStats = foundationFrameGraphicsStats(frame)
            let hudOverlay = foundationGraphicsOverlay(hudStats, showGraphicsHud)
            let hudLayout = FoundationLayoutPass().run(root: hudOverlay, available: viewport)
            foundationEmitHud(graphics, state.batch, hudOverlay, hudLayout, Int(viewport.width), Int(viewport.height))
        }
        let profilePresentStart = foundationProfileNow(state.profile, frame)
        state.batch.presentBatch(frame, graphics, state.page.r, state.page.g, state.page.b, state.page.a)
        let profilePresentEnd = foundationProfileNow(state.profile, frame)
        foundationProfileSample(
            state.profile,
            FoundationFramePhases {
                buildNs: profileBuildEnd - profileBuildStart
                layoutNs: profileLayoutEnd - profileLayoutStart
                renderNs: profileRenderEnd - profileRenderStart
                presentNs: profilePresentEnd - profilePresentStart
                frameNs: profilePresentEnd - profileFrameStart
            },
            state.batch.presentPhaseTimes(),
            state.batch.glassFrameStats(),
        )
        foundationProfileReportWhenFull(state.profile)
        // Record what this full frame presented; the re-present gate above
        // compares against these next frame.
        state.hasPresentedFrame = true
        state.lastPresentedViewportW = Int(viewport.width)
        state.lastPresentedViewportH = Int(viewport.height)
        state.lastPresentedEventCount = state.ui.eventCount
        if overlayEnabled {
            state.hudRefreshElapsed = 0.0
        }
        // Cache the composed root for resize-only reuse (fixed-structure hosts).
        if !rebuildOnResize {
            state.cachedRoot = move root
            state.hasCachedRoot = true
        }
        state.ui.clickedKey = 0
        state.ui.scrollX = 0.0
        state.ui.scrollY = 0.0
        state.ui.lastTextCodepoint = 0
        state.ui.lastKeyCode = 0
        return
    }

    kiraGraphicsLiveUiFoundationAppStarted()
    app.run(runtimeUser)
    nativeStateFree(runtimeStorage)
    return
}

// Cross-backend guard for the damage-skip predicate. Proves that re-present is
// allowed only when a frame was already presented, the batch exists, and the FPS,
// viewport width and viewport height all match the last presented frame. Each case
// flips exactly one input so a regression that drops a field from the comparison
// (re-presenting a changed frame into a stale image) fails here.
function FoundationRepresentSkipSmoke() -> Int {
    var passed = 0

    // Steady state: everything matches -> re-present.
    passed = passed + smokePass(
        foundationShouldRepresent(true, true, 60, 60, 1280, 1280, 720, 720)
    )

    // First frame (nothing presented yet) -> must rebuild.
    passed = passed + smokePass(
        !foundationShouldRepresent(false, true, 60, 60, 1280, 1280, 720, 720)
    )

    // FPS changed (badge differs) -> rebuild.
    passed = passed + smokePass(
        !foundationShouldRepresent(true, true, 59, 60, 1280, 1280, 720, 720)
    )

    // Viewport width changed (resize) -> rebuild.
    passed = passed + smokePass(
        !foundationShouldRepresent(true, true, 60, 60, 1281, 1280, 720, 720)
    )

    // Viewport height changed (resize) -> rebuild.
    passed = passed + smokePass(
        !foundationShouldRepresent(true, true, 60, 60, 1280, 1280, 719, 720)
    )

    // Batch not yet created -> rebuild.
    passed = passed + smokePass(
        !foundationShouldRepresent(true, false, 60, 60, 1280, 1280, 720, 720)
    )

    return passed
}
