import KiraGraphics
import KiraLayout
import Foundation

// `windowMode` is the mode the window OPENS in; a running app moves between
// modes with `frame.setWindowMode`. Fullscreen ignores the size above and takes
// the display's, which the layout picks up from `frame.viewportWidth`/`Height`
// like any other size.
function RunFoundationApp(
    root: FoundationView,
    windowMode: WindowMode = .Windowed,
    showFpsOverlay: Bool = true,
) {
    let runtimeStorage = nativeState(FoundationAppState {
        root: root
        batch: UiBatch { storage: nullPointer() }
        profile: foundationFrameProfileFromEnvironment()
    })
    let runtimeUser = nativeUserData(runtimeStorage)

    var app = GraphicsApplication {
        title: "Kira UI Foundation"
        width: 1280
        height: 720
        sampleCount: 1
        windowMode: windowMode
        // Platform-aware default: Metal on Apple hosts, Sokol otherwise
        // (incl. Web/WASM where the platform probe reports Unknown).
        backend: graphicsDefaultBackend()
    }

    app.onFrame { frame in
        var state = nativeRecover<FoundationAppState>(frame.userData)
        let profileFrameStart = foundationProfileNow(state.profile, frame)
        state.ui.frameCount = state.frameCount
        // The live window, in points. Asked of the frame rather than branched on
        // the backend: Metal keeps it on its context and sokol derives it from
        // the drawable, and which of those it is has nothing to do with laying
        // out an interface.
        var vpW = Int(frame.viewportWidth())
        var vpH = Int(frame.viewportHeight())
        if vpW <= 0 {
            vpW = 1280
        }
        if vpH <= 0 {
            vpH = 720
        }
        state.ui.viewport = Size {
            width: intAsFloat(value: vpW)
            height: intAsFloat(value: vpH)
        }

        let graphics = foundationFrameGraphics(frame)
        if !state.batchReady {
            state.batch = UiBatch { storage: createBatch(graphics) }
            state.batchReady = true
        }
        let batch = state.batch

        let rawStats = foundationFrameGraphicsStats(frame)
        let rawFps = rawStats.fps

        // Re-present fast path: the displayed FPS (`state.displayedFps`, the value
        // actually drawn into the retained batch is `state.lastPresentedFps`) and the
        // viewport both match what was last drawn, so the retained vertex/index
        // buffers already describe this frame's pixels. Re-flush them to this frame's
        // encoder — no tree clone, no layout, no quad regeneration. Hit regions
        // persist in state, so input keeps working across re-presented frames.
        if state.frameCount >= 4 && foundationShouldRepresent(
            state.hasPresentedFrame,
            state.batchReady,
            state.displayedFps,
            state.lastPresentedFps,
            vpW,
            state.lastPresentedViewportW,
            vpH,
            state.lastPresentedViewportH,
        ) {
            // Re-runs the retained streams — including the liquid-glass
            // capture/blur passes on a split frame.
            let profilePresentStart = foundationProfileNow(state.profile, frame)
            state.batch.presentBatch(frame, graphics, 0.96, 0.95, 0.93, 1.0)
            let profilePresentEnd = foundationProfileNow(state.profile, frame)
            foundationProfileSample(
                state.profile,
                FoundationFramePhases {
                    presentNs: profilePresentEnd - profilePresentStart
                    frameNs: profilePresentEnd - profileFrameStart
                    represented: true
                },
                state.batch.presentPhaseTimes(),
                state.batch.glassFrameStats(),
            )
            foundationProfileReportWhenFull(state.profile)
            // This frame was GPU/vsync-paced, so its duration reflects the true
            // cadence: refresh the desired FPS from it. `lastPresentedFps` (the value
            // currently drawn) is left untouched, so if the cadence genuinely shifted
            // the next frame rebuilds exactly once to redraw the badge; otherwise it
            // keeps re-presenting.
            state.displayedFps = rawFps
            state.frameCount = state.frameCount + 1
            state.ui.clickedKey = 0
            state.ui.scrollX = 0.0
            state.ui.scrollY = 0.0
            state.ui.lastTextCodepoint = 0
            state.ui.lastKeyCode = 0
            return
        }

        // The walk only accumulates quads; the pass structure (including the
        // liquid-glass capture/blur passes) is owned by presentBatch after it.
        var backend = KiraGraphicsFoundationBackend {
            graphics: graphics
            batch: batch
        }
        let viewport = state.ui.viewport
        if !state.announcedTree && foundationRenderableViewCount(state.root) > 0 {
            kiraGraphicsLiveUiFoundationTreeBuilt()
            state.announcedTree = true
        }

        // Rebuild path. The composed tree (app view + FPS badge) is cached and depends
        // only on the displayed FPS: rebuild it (and run a full layout) when the badge
        // value changed or no cache exists; otherwise — a resize, where only the
        // viewport differs — reuse the cached tree and re-measure the cached layout in
        // place, avoiding the per-frame tree clone and the fresh node collection.
        // Lay out the application tree. It is rendered directly by borrow (never
        // cloned or recomposed), and its structure is constant, so the first frame
        // runs a full layout and every later frame re-measures the cached tree in
        // place for the current viewport — a resize avoids the fresh node collection.
        let profileLayoutStart = foundationProfileNow(state.profile, frame)
        if !state.hasAppLayout {
            state.cachedLayoutTree = FoundationLayoutPass().run(root: state.root, available: viewport)
            state.hasAppLayout = true
        } else {
            FoundationLayoutPass().relayout(state.cachedLayoutTree, viewport)
        }
        let profileLayoutEnd = foundationProfileNow(state.profile, frame)
        if foundationLayoutHasNonEmptyFrame(state.cachedLayoutTree) && !state.announcedLayout {
            kiraGraphicsLiveUiFoundationLayoutNonEmpty()
            state.announcedLayout = true
        }

        let profileRenderStart = foundationProfileNow(state.profile, frame)
        backend.beginFrame(vpW, vpH)
        let appRendered = foundationRender(state.root, state.cachedLayoutTree, backend)
        // During an interactive resize the viewport changes every frame, so the
        // re-present fast path (the only place `displayedFps` is refreshed) never runs
        // and the badge would freeze on a stale number for the whole drag. A resize
        // already forces a full rebuild each frame, so refreshing the badge from this
        // frame's real duration is free — the overlay below is laid out and drawn
        // regardless — and cannot create the static-frame rebuild feedback loop the
        // re-present decoupling guards against (that loop only exists when a badge
        // change would force an otherwise-skippable frame to rebuild; here the frame is
        // already rebuilding because the viewport moved). `foundationBadgeFps` gates on
        // the viewport change so a steady-state badge refresh still costs a single
        // rebuild, not a loop. (Guarded by FoundationBadgeResizeSmoke.)
        let viewportChanged = !state.hasPresentedFrame || vpW != state.lastPresentedViewportW || vpH != state.lastPresentedViewportH
        state.displayedFps = foundationBadgeFps(state.displayedFps, rawFps, viewportChanged)
        // Compact graphics badge: keep the FPS stability policy above, but carry
        // the latest completed CPU/GPU samples too. The first four frames rebuild
        // so asynchronous Metal timestamps have arrived before retained re-present
        // starts; the badge never gets permanently cached at "GPU 0.0 ms".
        var overlayStats = rawStats
        overlayStats.fps = state.displayedFps
        var renderCount = appRendered
        if showFpsOverlay {
            let overlay = foundationGraphicsOverlay(overlayStats, false)
            state.overlayLayout = FoundationLayoutPass().run(root: overlay, available: viewport)
            state.overlayFps = state.displayedFps
            state.overlayVpH = vpH
            renderCount = renderCount + foundationRender(overlay, state.overlayLayout, backend)
        }
        let profileRenderEnd = foundationProfileNow(state.profile, frame)
        state.hitRegions = backend.hitRegions
        foundationReconcileFocus(state.ui, state.hitRegions)
        if renderCount > 0 && !state.announcedRenderCommands {
            kiraGraphicsLiveUiFoundationRenderCommandsGenerated()
            state.announcedRenderCommands = true
        }

        state.frameCount = state.frameCount + 1
        let profilePresentStart = foundationProfileNow(state.profile, frame)
        state.batch.presentBatch(frame, graphics, 0.96, 0.95, 0.93, 1.0)
        let profilePresentEnd = foundationProfileNow(state.profile, frame)
        foundationProfileSample(
            state.profile,
            FoundationFramePhases {
                layoutNs: profileLayoutEnd - profileLayoutStart
                renderNs: profileRenderEnd - profileRenderStart
                presentNs: profilePresentEnd - profilePresentStart
                frameNs: profilePresentEnd - profileFrameStart
            },
            state.batch.presentPhaseTimes(),
            state.batch.glassFrameStats(),
        )
        foundationProfileReportWhenFull(state.profile)
        state.lastPresentedFps = state.displayedFps
        state.lastPresentedViewportW = vpW
        state.lastPresentedViewportH = vpH
        state.hasPresentedFrame = true
        state.ui.clickedKey = 0
        state.ui.scrollX = 0.0
        state.ui.scrollY = 0.0
        state.ui.lastTextCodepoint = 0
        state.ui.lastKeyCode = 0
        return
    }

    kiraGraphicsLiveUiFoundationAppStarted()
    app.run(runtimeUser)
    nativeStateFree(runtimeStorage)
    return
}

function RunFoundationAppSmoke(root: FoundationView) {
    let renderableCount = foundationRenderableViewCount(root)
    if renderableCount > 0 {
        print("KIRA_UI_TREE_BUILT")
    }

    let laidOut = FoundationLayoutPass().run(
        root: root,
        available: Size {
            width: 1280.0
            height: 720.0
        }
    )
    let rootFrame = foundationRootFrame(laidOut)
    if rootFrame.width > 0.0 && rootFrame.height > 0.0 {
        print("KIRA_UI_LAYOUT_NON_EMPTY")
    }

    if renderableCount > 0 {
        print("KIRA_UI_DRAW_COMMANDS_SUBMITTED")
        print("KIRA_APP_RENDERED_VISIBLE_CONTENT")
    }
    return
}
