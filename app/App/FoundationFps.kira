import Foundation
import KiraLayout
import KiraGraphics
// Live FPS indicator for the interactive Foundation runner.
//
// The frame duration comes from sokol's filtered (rolling-average)
// `sapp_frame_duration`, so the displayed number is stable rather than jittery.
// The number is rendered as real Kira text: the integer is converted to a
// String one digit at a time via the Foundation codepoint helper, and the badge
// is overlaid bottom-right on top of the application's own view tree.

@Native
function rootFrameDuration() -> Float {
    return sapp_frame_duration()
}

// Frames per second from a frame duration in seconds. Uses the `Int(...)`
// numeric cast to round to the nearest whole frame; a non-positive duration
// (first frame, paused) reports 0.
function foundationFpsFromDuration(duration: Float) -> Int {
    if duration <= 0.0 {
        return 0
    }
    return Int(1.0 / duration + 0.5)
}

// Decimal digits of a non-negative integer as a Kira String. Built by appending
// each digit's ASCII codepoint ('0' == 48) to a growing string.
function foundationIntToString(value: Int) -> String {
    if value <= 0 {
        return foundationAppendCodepoint("", 48)
    }
    var digits: [Int] = []
    var remaining = value
    while remaining > 0 {
        digits.append(48 + (remaining % 10))
        remaining = remaining / 10
    }
    var text = ""
    var index = digits.count - 1
    while index >= 0 {
        text = foundationAppendCodepoint(text, digits[index])
        index = index - 1
    }
    return text
}

// Pick the FPS value the badge shows on a rebuild frame. On a viewport change (an
// interactive resize) the re-present fast path never runs, so `displayedFps` — which
// is refreshed only by vsync-paced re-present frames — would freeze and the badge
// would show a stale number for the whole drag. In that case take this frame's freshly
// measured rate so the badge tracks the real resize cadence live. Otherwise keep the
// decoupled `displayedFps`, preserving static-frame stability (a steady dashboard keeps
// re-presenting and a genuine rate change costs a single rebuild to refresh the number).
// A non-positive measured rate (first frame, before any duration) is ignored so the
// badge never flashes "0 FPS". This is cost-free during resize: the frame is already
// rebuilding because the viewport moved, and the badge overlay is laid out and drawn
// regardless — only the integer it carries changes.
function foundationBadgeFps(displayedFps: Int, rawFps: Int, viewportChanged: Bool) -> Int {
    if viewportChanged && rawFps > 0 {
        return rawFps
    }
    return displayedFps
}

function foundationFpsBadgeFill() -> Color {
    return Color {
        r: 0.0
        g: 0.0
        b: 0.0
        a: 0.55
    }
}

function foundationFpsBadgeBorder() -> Color {
    return Color {
        r: 1.0
        g: 1.0
        b: 1.0
        a: 0.14
    }
}

function foundationFpsTextColor() -> Color {
    return Color {
        r: 0.80
        g: 1.0
        b: 0.85
        a: 1.0
    }
}

// One decimal place is enough to see frame-time movement without making the
// compact badge jump in width on harmless sub-millisecond noise.
function foundationOneDecimal(value: Float) -> String {
    var safe = value
    if safe < 0.0 {
        safe = 0.0
    }
    var tenths = Int(safe * 10.0 + 0.5)
    let whole = tenths / 10
    let fraction = tenths % 10
    return foundationConcat(
        foundationConcat(foundationIntToString(whole), "."),
        foundationIntToString(fraction),
    )
}

struct FoundationGraphicsStats {
    var fps: Int = 0
    var frameMs: Float = 0.0
    var cpuMs: Float = 0.0
    var gpuMs: Float = 0.0
    var drawableWidth: Int = 0
    var drawableHeight: Int = 0
    var allocatedMiBTenths: Int = 0
    var resourceCount: Int = 0
    var passCount: Int = 0
    var drawCount: Int = 0
    var triangleCount: Int = 0
    var framesInFlight: Int = 0
    var frameSerial: Int = 0
    var windowState: Int = 0
}

function foundationGraphicsStatsCompactLabel(stats: borrow FoundationGraphicsStats) -> String {
    var label = foundationConcat(foundationIntToString(stats.fps), " FPS   CPU ")
    label = foundationConcat(label, foundationOneDecimal(stats.cpuMs))
    label = foundationConcat(label, " ms   GPU ")
    label = foundationConcat(label, foundationOneDecimal(stats.gpuMs))
    return foundationConcat(label, " ms")
}

function foundationGraphicsHudLine(label: borrow String, value: borrow String) -> FoundationView {
    return Text(
        foundationConcat(foundationConcat(label, "  "), value),
        foundationFpsTextColor(),
        12.0,
        520.0,
    )
}

function foundationWindowStateLabel(state: Int) -> String {
    if state == 1 { return "focused / visible" }
    if state == 2 { return "unfocused / visible" }
    if state == 3 { return "hidden / half-rate" }
    return "unknown"
}

// Metal-HUD-style expanded diagnostics. This intentionally uses the same normal
// Foundation view primitives as application UI so it works in captures and tests.
function foundationGraphicsHud(stats: borrow FoundationGraphicsStats) -> FoundationView {
    let drawable = foundationConcat(
        foundationConcat(foundationIntToString(stats.drawableWidth), " x "),
        foundationIntToString(stats.drawableHeight),
    )
    let memory = foundationConcat(
        foundationConcat(foundationIntToString(stats.allocatedMiBTenths / 10), "."),
        foundationConcat(foundationIntToString(stats.allocatedMiBTenths % 10), " MiB"),
    )
    let workload = foundationConcat(
        foundationConcat(foundationIntToString(stats.passCount), " passes   "),
        foundationConcat(
            foundationConcat(foundationIntToString(stats.drawCount), " draws   "),
            foundationConcat(foundationIntToString(stats.triangleCount), " tris"),
        ),
    )
    return Surface(
        children: [Column(
            children: [
                foundationGraphicsHudLine("KIRA GRAPHICS", foundationConcat(foundationIntToString(stats.fps), " FPS")),
                foundationGraphicsHudLine("Frame", foundationConcat(foundationOneDecimal(stats.frameMs), " ms")),
                foundationGraphicsHudLine("CPU", foundationConcat(foundationOneDecimal(stats.cpuMs), " ms")),
                foundationGraphicsHudLine("GPU", foundationConcat(foundationOneDecimal(stats.gpuMs), " ms")),
                foundationGraphicsHudLine("Drawable", drawable),
                foundationGraphicsHudLine("Metal allocated", memory),
                foundationGraphicsHudLine("Resources", foundationIntToString(stats.resourceCount)),
                foundationGraphicsHudLine("Workload", workload),
                foundationGraphicsHudLine("Frames in flight", foundationIntToString(stats.framesInFlight)),
                foundationGraphicsHudLine("Window", foundationWindowStateLabel(stats.windowState)),
                foundationGraphicsHudLine("Frame serial", foundationIntToString(stats.frameSerial)),
            ],
            width: SizeMode.Hug,
            height: SizeMode.Hug,
            spacing: 3.0,
            padding: EdgeInsets {},
            crossAxisAlignment: CrossAlignment.Start,
        )],
        width: SizeMode.Hug,
        height: SizeMode.Hug,
        flex: 0,
        fill: foundationFpsBadgeFill(),
        border: foundationFpsBadgeBorder(),
        borderWidth: 1.0,
        radius: 10.0,
        shape: FoundationShape.RegularRoundedRect,
        material: FoundationMaterial.Flat,
        effects: [],
        padding: EdgeInsets { top: 9.0 trailing: 12.0 bottom: 9.0 leading: 12.0 },
        clipContent: false,
    )
}

// The small rounded badge holding the "<n> FPS" label.
function foundationFpsBadge(fps: Int) -> FoundationView {
    let label = foundationGraphicsStatsCompactLabel(FoundationGraphicsStats { fps: fps })
    return Surface(
        children: [Text(move label, foundationFpsTextColor(), 13.0, 600.0)],
        width: SizeMode.Hug,
        height: SizeMode.Hug,
        flex: 0,
        fill: foundationFpsBadgeFill(),
        border: foundationFpsBadgeBorder(),
        borderWidth: 1.0,
        radius: 8.0,
        shape: FoundationShape.RegularRoundedRect,
        material: FoundationMaterial.Flat,
        effects: [],
        padding: EdgeInsets {
            top: 4.0
            trailing: 9.0
            bottom: 4.0
            leading: 9.0
        },
        clipContent: false
    )
}

function foundationGraphicsStatsBadge(stats: borrow FoundationGraphicsStats) -> FoundationView {
    return Surface(
        children: [Text(foundationGraphicsStatsCompactLabel(stats), foundationFpsTextColor(), 13.0, 600.0)],
        width: SizeMode.Hug,
        height: SizeMode.Hug,
        flex: 0,
        fill: foundationFpsBadgeFill(),
        border: foundationFpsBadgeBorder(),
        borderWidth: 1.0,
        radius: 8.0,
        shape: FoundationShape.RegularRoundedRect,
        material: FoundationMaterial.Flat,
        effects: [],
        padding: EdgeInsets { top: 4.0 trailing: 9.0 bottom: 4.0 leading: 9.0 },
        clipContent: false,
    )
}

// A fixed composed view (a full-bleed app surface + the FPS badge) used by the
// overlay smoke so layout and path lookups see identical structure.
function foundationFpsSmokeView() -> FoundationView {
    let appRoot = Surface(
        children: [],
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        fill: Color { r: 0.1 g: 0.1 b: 0.12 a: 1.0 },
        border: Color { r: 0.0 g: 0.0 b: 0.0 a: 0.0 },
        borderWidth: 0.0,
        radius: 0.0,
        shape: FoundationShape.RegularRoundedRect,
        material: FoundationMaterial.Flat,
        effects: [],
        padding: EdgeInsets {},
        clipContent: false
    )
    return foundationComposeWithFps(move appRoot, 60)
}

// Proves the FPS overlay: the converted/formatted number is correct, the app
// view still fills the whole viewport, and the badge is placed in the
// bottom-right corner inset by the layer padding.
function FoundationFpsOverlaySmoke() -> Int {
    var passed = 0

    // Frame-duration -> rounded FPS via the Int() cast.
    passed = passed + smokePass(
        foundationFpsFromDuration(1.0 / 60.0) == 60 &&
        foundationFpsFromDuration(1.0 / 30.0) == 30 &&
        foundationFpsFromDuration(0.0) == 0
    )

    // Int -> decimal String.
    passed = passed + smokePass(
        foundationIntToString(0).count == 1 &&
        foundationIntToString(60).count == 2 &&
        foundationIntToString(120).count == 3
    )

    let viewport = Size { width: 1280.0 height: 720.0 }
    let laidOut = runFoundationLayout(foundationFpsSmokeView(), viewport)

    // App view fills the whole surface; the FPS layer does too (transparent).
    let appFrame = foundationFrameAtPath(foundationFpsSmokeView(), laidOut, [0])
    passed = passed + smokePass(
        approxEqual(appFrame.x, 0.0) &&
        approxEqual(appFrame.y, 0.0) &&
        approxEqual(appFrame.width, 1280.0) &&
        approxEqual(appFrame.height, 720.0)
    )

    // Badge sits in the bottom-left corner, inset 12pt from each edge.
    let badge = foundationFrameAtPath(foundationFpsSmokeView(), laidOut, [1, 0])
    passed = passed + smokePass(
        badge.width > 0.0 &&
        badge.height > 0.0 &&
        badge.x < 640.0 &&
        badge.y > 360.0 &&
        approxEqual(badge.x, 12.0) &&
        approxEqual(badge.y + badge.height, 720.0 - 12.0)
    )

    return passed
}

// Guards `foundationBadgeFps`: the badge must keep updating during a resize (when the
// re-present path that normally refreshes the FPS number never runs) while staying
// stable on static frames and never flashing 0.
function FoundationBadgeResizeSmoke() -> Int {
    var passed = 0

    // Resize frame (viewport changed): take the live measured rate, not the frozen
    // displayed value. This is the bug fix — the badge updates during a drag.
    passed = passed + smokePass(foundationBadgeFps(60, 24, true) == 24)

    // Static frame (viewport unchanged): keep the decoupled displayed value so a steady
    // dashboard stays stable instead of feeding rebuild durations back into the badge.
    passed = passed + smokePass(foundationBadgeFps(60, 24, false) == 60)

    // First frame / no measured duration yet: ignore the non-positive rate so the badge
    // never flashes "0 FPS", even though the viewport "changed" from its unset state.
    passed = passed + smokePass(foundationBadgeFps(60, 0, true) == 60)

    // A genuine slow resize cadence is reported honestly (not clamped to the old value).
    passed = passed + smokePass(foundationBadgeFps(60, 15, true) == 15)

    return passed
}

// The FPS badge wrapped in a full-size, transparent Frame that pins it to the
// bottom-left corner (inset 12pt). Rendered as a standalone overlay on top of the
// application view at the same viewport, so the badge can be re-rendered each frame
// without recomposing — and without cloning — the whole application tree.
function foundationFpsOverlay(fps: Int) -> FoundationView {
    return Frame(
        child: foundationFpsBadge(fps),
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        alignment: Alignment.BottomLeading,
        padding: EdgeInsets {
            top: 12.0
            trailing: 12.0
            bottom: 12.0
            leading: 12.0
        }
    )
}

function foundationGraphicsOverlay(stats: borrow FoundationGraphicsStats, expanded: Bool) -> FoundationView {
    var badge = foundationGraphicsStatsBadge(stats)
    if expanded {
        badge = foundationGraphicsHud(stats)
    }
    return Frame(
        child: move badge,
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        alignment: Alignment.BottomLeading,
        padding: EdgeInsets { top: 12.0 trailing: 12.0 bottom: 12.0 leading: 12.0 },
    )
}

function foundationComposeWithGraphics(root: FoundationView, stats: borrow FoundationGraphicsStats, expanded: Bool) -> FoundationView {
    return FoundationView {
        kind: FoundationViewKind.Frame
        width: SizeMode.Fill
        height: SizeMode.Fill
        alignment: Alignment.TopLeading
        children: [move root, foundationGraphicsOverlay(stats, expanded)]
    }
}

// Overlay the FPS badge bottom-left on top of `root`. The badge lives inside a
// full-size, transparent Frame so the application view keeps the whole surface
// and the badge is inset 12pt from the bottom-left corner.
function foundationComposeWithFps(root: FoundationView, fps: Int) -> FoundationView {
    let fpsLayer = Frame(
        child: foundationFpsBadge(fps),
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        alignment: Alignment.BottomLeading,
        padding: EdgeInsets {
            top: 12.0
            trailing: 12.0
            bottom: 12.0
            leading: 12.0
        }
    )
    return FoundationView {
        kind: FoundationViewKind.Frame
        width: SizeMode.Fill
        height: SizeMode.Fill
        alignment: Alignment.TopLeading
        children: [move root, fpsLayer]
    }
}
