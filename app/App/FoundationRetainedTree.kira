struct FoundationRetainedNode {
    var id: Int = 0
    var parentId: Int = 0
    var key: Int = 0
    var childOrdinal: Int = 0
    var kind: FoundationViewKind = FoundationViewKind.Column
    var childIds: [Int] = []
    var childCount: Int = 0
    var layoutSignature: Int = 0
    var renderSignature: Int = 0
    var layoutDirty: Bool = false
    var renderDirty: Bool = false
    var mounted: Bool = true
    var stateSlot: Int = 0
}

struct FoundationRetainedStateSlot {
    var nodeId: Int = 0
    var value: Int = 0
    var active: Bool = false
}

struct FoundationRetainedTree {
    var nextId: Int = 1
    var rootId: Int = 0
    var nodes: [FoundationRetainedNode] = []
    var stateSlots: [FoundationRetainedStateSlot] = []
    var stateSlotIds: [Int] = []
    var reusedIds: [Int] = []
    var reusedIdBits: [Bool] = []
    var removedIds: [Int] = []
    var mountCount: Int = 0
    var updateCount: Int = 0
    var teardownCount: Int = 0
    var layoutInvalidations: Int = 0
    var renderInvalidations: Int = 0
}

struct FoundationRetainedNodeResult {
    var tree: FoundationRetainedTree
    var nodeId: Int = 0
}

struct FoundationRetainedStateSlotResult {
    var tree: FoundationRetainedTree
    var slot: Int = 0
}

function foundationBoolCode(value: Bool) -> Int {
    return value ? 1 : 0
}

function foundationViewKindCode(kind: FoundationViewKind) -> Int {
    match kind {
        Row -> return 1;
        Column -> return 2;
        Expanded -> return 3;
        Frame -> return 4;
        Spacer -> return 5;
        Surface -> return 6;
        Text -> return 7;
        HitArea -> return 8;
        LayoutPriority -> return 9;
    }
}

function foundationMaterialCode(material: FoundationMaterial) -> Int {
    match material {
        Flat -> return 1;
        Translucent -> return 2;
        Frosted -> return 3;
        LayeredGlass -> return 4;
        Luminous -> return 5;
        Metallic -> return 6;
        Crystal -> return 7;
    }
}

function foundationShapeCode(shape: FoundationShape) -> Int {
    match shape {
        RegularRoundedRect -> return 1;
        Squircle -> return 2;
    }
}

function foundationLayoutSignature(view: borrow FoundationView) -> Int {
    return foundationViewKindCode(view.kind) * 100000 +
        view.key * 1013 +
        view.children.count * 97 +
        view.flex * 31 +
        view.content.count * 17 +
        foundationBoolCode(view.clipContent) * 7
}

function foundationRenderSignature(view: borrow FoundationView) -> Int {
    return foundationViewKindCode(view.kind) * 100000 +
        view.key * 1013 +
        view.content.count * 53 +
        foundationMaterialCode(view.material) * 29 +
        foundationShapeCode(view.shape) * 23 +
        view.effects.count * 19 +
        foundationBoolCode(view.disabled) * 11 +
        foundationBoolCode(view.clipContent) * 7
}

function foundationAppendPath(path: borrow [Int], childOrdinal: Int) -> [Int] {
    var next: [Int] = []
    var index = 0
    while index < path.count {
        next.append(path[index])
        index = index + 1
    }
    next.append(childOrdinal)
    return next
}

function foundationIntArrayContains(values: borrow [Int], value: Int) -> Bool {
    var index = 0
    while index < values.count {
        if values[index] == value {
            return true
        }
        index = index + 1
    }
    return false
}

function foundationRetainedEnsureBitsCapacity(bits: [Bool], minSize: Int) -> [Bool] {
    var result = bits
    while result.count <= minSize {
        result.append(false)
    }
    return result
}

function foundationRetainedMarkReused(tree: FoundationRetainedTree, id: Int) -> FoundationRetainedTree {
    var next = tree
    next.reusedIds.append(id)
    next.reusedIdBits = foundationRetainedEnsureBitsCapacity(next.reusedIdBits, id)
    next.reusedIdBits[id] = true
    return next
}

function foundationRetainedIsReused(tree: borrow FoundationRetainedTree, id: Int) -> Bool {
    if id < 0 || id >= tree.reusedIdBits.count {
        return false
    }
    return tree.reusedIdBits[id]
}

function foundationChildIdsChanged(previous: borrow [Int], next: borrow [Int]) -> Bool {
    if previous.count != next.count {
        return true
    }
    var index = 0
    while index < previous.count {
        if previous[index] != next[index] {
            return true
        }
        index = index + 1
    }
    return false
}

function foundationRetainedNodeWithChildren(
    node: borrow FoundationRetainedNode,
    childIds: [Int],
    layoutDirty: Bool,
    renderDirty: Bool,
) -> FoundationRetainedNode {
    let count = childIds.count
    return FoundationRetainedNode {
        id: node.id
        parentId: node.parentId
        key: node.key
        childOrdinal: node.childOrdinal
        kind: node.kind
        childIds: move childIds
        childCount: count
        layoutSignature: node.layoutSignature
        renderSignature: node.renderSignature
        layoutDirty: layoutDirty
        renderDirty: renderDirty
        mounted: node.mounted
        stateSlot: node.stateSlot
    }
}

function foundationRetainedNodeFromList(nodes: borrow [FoundationRetainedNode], id: Int) -> FoundationRetainedNode {
    var index = 0
    while index < nodes.count {
        if nodes[index].id == id {
            return nodes[index]
        }
        index = index + 1
    }
    return FoundationRetainedNode {}
}

function foundationRetainedEnsureStateSlot(tree: FoundationRetainedTree, nodeId: Int) -> FoundationRetainedStateSlotResult {
    var next = tree
    if nodeId < next.stateSlotIds.count && next.stateSlotIds[nodeId] != -1 {
        let index = next.stateSlotIds[nodeId]
        next.stateSlots[index] = FoundationRetainedStateSlot {
            nodeId: nodeId
            value: next.stateSlots[index].value
            active: true
        }
        return FoundationRetainedStateSlotResult {
            tree: move next
            slot: index
        }
    } else {
        next.stateSlots.append(FoundationRetainedStateSlot {
            nodeId: nodeId
            value: 0
            active: true
        })
        let slotIndex = next.stateSlots.count - 1
        while next.stateSlotIds.count <= nodeId {
            next.stateSlotIds.append(-1)
        }
        next.stateSlotIds[nodeId] = slotIndex
        return FoundationRetainedStateSlotResult {
            tree: move next
            slot: slotIndex
        }
    }
}

function foundationRetainedDeactivateStateForNode(tree: FoundationRetainedTree, nodeId: Int) -> FoundationRetainedTree {
    var next = tree
    if nodeId < next.stateSlotIds.count && next.stateSlotIds[nodeId] != -1 {
        let index = next.stateSlotIds[nodeId]
        next.stateSlots[index] = FoundationRetainedStateSlot {
            nodeId: nodeId
            value: next.stateSlots[index].value
            active: false
        }
        next.stateSlotIds[nodeId] = -1
    }
    return next
}

function foundationRetainedAppendFreshNode(
    tree: FoundationRetainedTree,
    view: borrow FoundationView,
    parentId: Int,
    childOrdinal: Int,
    path: borrow [Int],
) -> FoundationRetainedNodeResult {
    let ignored = path.count
    var next = tree
    let nodeId = next.nextId
    next.nextId = next.nextId + 1
    let stateResult = foundationRetainedEnsureStateSlot(move next, nodeId)
    next = stateResult.tree
    let nodeIndex = next.nodes.count
    next.nodes.append(FoundationRetainedNode {
        id: nodeId
        parentId: parentId
        key: view.key
        childOrdinal: childOrdinal
        kind: view.kind
        childIds: []
        childCount: view.children.count
        layoutSignature: foundationLayoutSignature(view)
        renderSignature: foundationRenderSignature(view)
        layoutDirty: true
        renderDirty: true
        mounted: true
        stateSlot: stateResult.slot
    })
    next.mountCount = next.mountCount + 1
    next.layoutInvalidations = next.layoutInvalidations + 1
    next.renderInvalidations = next.renderInvalidations + 1

    var childIds: [Int] = []
    var childOffset = 0
    while childOffset < view.children.count {
        let childResult = foundationRetainedAppendFreshNode(move next, view.children[childOffset], nodeId, childOffset, foundationAppendPath(path, childOffset))
        next = childResult.tree
        childIds.append(childResult.nodeId)
        childOffset = childOffset + 1
    }
    let current = next.nodes[nodeIndex]
    next.nodes[nodeIndex] = foundationRetainedNodeWithChildren(current, move childIds, current.layoutDirty, current.renderDirty)
    return FoundationRetainedNodeResult {
        tree: move next
        nodeId: nodeId
    }
}

// Flat O(n) index over the previous frame's nodes. `indexById` maps a node id
// to its slot in `previous` (id space is dense from `nextId`). The CSR triple
// (`childStart`/`childCount`/`childList`) groups previous nodes by their
// parentId so reconciliation matches a view child against only its parent's
// former children instead of scanning the whole previous tree -- turning the
// old O(n^2) reconcile into roughly O(n).
struct FoundationRetainedPrevIndex {
    var indexById: [Int] = []
    var childStart: [Int] = []
    var childCount: [Int] = []
    var childList: [Int] = []
}

function foundationRetainedBuildPrevIndex(previous: borrow [FoundationRetainedNode], capacity: Int) -> FoundationRetainedPrevIndex {
    var idx = FoundationRetainedPrevIndex {}
    var slot = 0
    while slot < capacity {
        idx.indexById.append(-1)
        idx.childStart.append(0)
        idx.childCount.append(0)
        slot = slot + 1
    }
    // Pass 1: record id -> slot and tally children per parent.
    var i = 0
    while i < previous.count {
        let node = previous[i]
        if node.id >= 0 && node.id < capacity {
            idx.indexById[node.id] = i
        }
        if node.parentId >= 0 && node.parentId < capacity {
            idx.childCount[node.parentId] = idx.childCount[node.parentId] + 1
        }
        i = i + 1
    }
    // Pass 2: prefix-sum the counts into per-parent start offsets.
    var acc = 0
    var p = 0
    while p < capacity {
        idx.childStart[p] = acc
        acc = acc + idx.childCount[p]
        p = p + 1
    }
    // Pass 3: scatter each previous slot into its parent's contiguous run.
    var cursor: [Int] = []
    p = 0
    while p < capacity {
        cursor.append(idx.childStart[p])
        p = p + 1
    }
    i = 0
    while i < previous.count {
        idx.childList.append(0)
        i = i + 1
    }
    i = 0
    while i < previous.count {
        let node = previous[i]
        if node.parentId >= 0 && node.parentId < capacity {
            let pos = cursor[node.parentId]
            idx.childList[pos] = i
            cursor[node.parentId] = pos + 1
        }
        i = i + 1
    }
    return idx
}

// Find a reusable previous node id for a view child, scanning only the former
// children of `parentId`. Returns 0 when no compatible, not-yet-reused match
// exists.
function foundationRetainedMatchReusableId(
    tree: borrow FoundationRetainedTree,
    idx: borrow FoundationRetainedPrevIndex,
    previous: borrow [FoundationRetainedNode],
    view: borrow FoundationView,
    parentId: Int,
    childOrdinal: Int,
) -> Int {
    if parentId < 0 || parentId >= idx.childStart.count {
        return 0
    }
    let start = idx.childStart[parentId]
    let count = idx.childCount[parentId]
    var reusableId = 0
    var c = 0
    while c < count {
        let node = previous[idx.childList[start + c]]
        if reusableId == 0 && node.kind == view.kind && !foundationRetainedIsReused(tree, node.id) {
            if view.key != 0 {
                if node.key == view.key {
                    reusableId = node.id
                }
            } else {
                if node.key == 0 && node.childOrdinal == childOrdinal {
                    reusableId = node.id
                }
            }
        }
        c = c + 1
    }
    return reusableId
}

function foundationRetainedReconcileNode(
    tree: FoundationRetainedTree,
    view: borrow FoundationView,
    parentId: Int,
    childOrdinal: Int,
    previous: borrow [FoundationRetainedNode],
    idx: borrow FoundationRetainedPrevIndex,
    path: borrow [Int],
) -> FoundationRetainedNodeResult {
    let ignored = path.count
    var next = tree
    let reusableId = foundationRetainedMatchReusableId(next, idx, previous, view, parentId, childOrdinal)
    if reusableId == 0 {
        return foundationRetainedAppendFreshNode(move next, view, parentId, childOrdinal, path)
    } else {
        next = foundationRetainedMarkReused(move next, reusableId)
        let previousNode = previous[idx.indexById[reusableId]]
        let layoutSignature = foundationLayoutSignature(view)
        let renderSignature = foundationRenderSignature(view)
        var layoutDirty = previousNode.layoutSignature != layoutSignature
        var renderDirty = previousNode.renderSignature != renderSignature
        let stateResult = foundationRetainedEnsureStateSlot(move next, reusableId)
        next = stateResult.tree
        let nodeIndex = next.nodes.count
        next.nodes.append(FoundationRetainedNode {
            id: reusableId
            parentId: parentId
            key: view.key
            childOrdinal: childOrdinal
            kind: view.kind
            childIds: []
            childCount: view.children.count
            layoutSignature: layoutSignature
            renderSignature: renderSignature
            layoutDirty: layoutDirty
            renderDirty: renderDirty
            mounted: true
            stateSlot: stateResult.slot
        })

        var childIds: [Int] = []
        var childOffset = 0
        while childOffset < view.children.count {
            let childResult = foundationRetainedReconcileNode(move next, view.children[childOffset], reusableId, childOffset, previous, idx, foundationAppendPath(path, childOffset))
            next = childResult.tree
            childIds.append(childResult.nodeId)
            childOffset = childOffset + 1
        }

        if (foundationChildIdsChanged(previousNode.childIds, childIds)) {
            layoutDirty = true
            renderDirty = true
        }
        if layoutDirty {
            next.layoutInvalidations = next.layoutInvalidations + 1
        }
        if renderDirty {
            next.renderInvalidations = next.renderInvalidations + 1
        }
        let current = next.nodes[nodeIndex]
        next.nodes[nodeIndex] = foundationRetainedNodeWithChildren(current, move childIds, layoutDirty, renderDirty)
        return FoundationRetainedNodeResult {
            tree: move next
            nodeId: reusableId
        }
    }
}

function foundationRetainedCollectRemoved(tree: FoundationRetainedTree, previous: borrow [FoundationRetainedNode]) -> FoundationRetainedTree {
    var next = tree
    var index = 0
    while index < previous.count {
        let node = previous[index]
        if (!foundationRetainedIsReused(next, node.id)) {
            next.removedIds.append(node.id)
            next.teardownCount = next.teardownCount + 1
            next = foundationRetainedDeactivateStateForNode(move next, node.id)
        }
        index = index + 1
    }
    return next
}

function foundationRetainedMount(root: borrow FoundationView) -> FoundationRetainedTree {
    var tree = FoundationRetainedTree {
        nextId: 1
        rootId: 0
        nodes: []
        stateSlots: []
        stateSlotIds: []
        reusedIds: []
        reusedIdBits: []
        removedIds: []
        mountCount: 0
        updateCount: 0
        teardownCount: 0
        layoutInvalidations: 0
        renderInvalidations: 0
    }
    let result = foundationRetainedAppendFreshNode(move tree, root, 0, 0, [])
    tree = result.tree
    tree.rootId = result.nodeId
    return tree
}

function foundationRetainedUpdate(tree: FoundationRetainedTree, root: borrow FoundationView) -> FoundationRetainedTree {
    var next = tree
    let previous = next.nodes
    next.nodes = []
    next.reusedIds = []
    next.reusedIdBits = []
    next.removedIds = []
    next.updateCount = next.updateCount + 1
    let prevIndex = foundationRetainedBuildPrevIndex(previous, next.nextId)
    let result = foundationRetainedReconcileNode(move next, root, 0, 0, previous, prevIndex, [])
    next = result.tree
    next.rootId = result.nodeId
    return foundationRetainedCollectRemoved(move next, previous)
}

function foundationRetainedSetState(tree: FoundationRetainedTree, nodeId: Int, value: Int) -> FoundationRetainedTree {
    let slotResult = foundationRetainedEnsureStateSlot(move tree, nodeId)
    var next = slotResult.tree
    next.stateSlots[slotResult.slot] = FoundationRetainedStateSlot {
        nodeId: nodeId
        value: value
        active: true
    }
    return next
}

function foundationRetainedStateValue(tree: borrow FoundationRetainedTree, nodeId: Int) -> Int {
    if nodeId < tree.stateSlotIds.count && tree.stateSlotIds[nodeId] != -1 {
        let index = tree.stateSlotIds[nodeId]
        if tree.stateSlots[index].active {
            return tree.stateSlots[index].value
        }
    }
    return 0
}

function foundationRetainedActiveStateSlotCount(tree: borrow FoundationRetainedTree) -> Int {
    var total = 0
    var index = 0
    while index < tree.stateSlots.count {
        if tree.stateSlots[index].active {
            total = total + 1
        }
        index = index + 1
    }
    return total
}

function foundationRetainedNodeIdForKey(tree: borrow FoundationRetainedTree, key: Int) -> Int {
    var index = 0
    while index < tree.nodes.count {
        if tree.nodes[index].key == key {
            return tree.nodes[index].id
        }
        index = index + 1
    }
    return 0
}

function foundationRetainedHitTargetIdAtIndex(tree: borrow FoundationRetainedTree, targetIndex: Int) -> Int {
    var currentTarget = 0
    var index = 0
    while index < tree.nodes.count {
        if tree.nodes[index].kind == FoundationViewKind.HitArea {
            if currentTarget == targetIndex {
                return tree.nodes[index].id
            }
            currentTarget = currentTarget + 1
        }
        index = index + 1
    }
    return 0
}

function foundationRetainedNodeLayoutDirty(tree: borrow FoundationRetainedTree, nodeId: Int) -> Bool {
    return foundationRetainedNodeFromList(tree.nodes, nodeId).layoutDirty
}

function foundationRetainedNodeRenderDirty(tree: borrow FoundationRetainedTree, nodeId: Int) -> Bool {
    return foundationRetainedNodeFromList(tree.nodes, nodeId).renderDirty
}

function foundationRetainedWasRemoved(tree: borrow FoundationRetainedTree, nodeId: Int) -> Bool {
    return foundationIntArrayContains(tree.removedIds, nodeId)
}

// Build a Row of keyed Text children from a list of keys. Used to stress the
// O(n) reconcile with many siblings under one parent (the case the old
// quadratic scan and the new CSR sibling index differ on).
function foundationRetainedKeyedRow(keys: borrow [Int]) -> FoundationView {
    var children: [FoundationView] = []
    var i = 0
    while i < keys.count {
        children.append(FoundationView {
            kind: FoundationViewKind.Text
            key: keys[i]
            content: "ITEM"
            color: foundationRetainedTestColor()
            size: 14.0
            weight: 400.0
        })
        i = i + 1
    }
    return Column(
        children: move children,
        width: SizeMode.Hug,
        height: SizeMode.Hug,
        spacing: 2.0,
        padding: EdgeInsets {},
        crossAxisAlignment: CrossAlignment.Start
    )
}

function foundationRetainedAllKeysStable(tree: borrow FoundationRetainedTree, keys: borrow [Int], expected: borrow [Int]) -> Bool {
    if keys.count != expected.count {
        return false
    }
    var i = 0
    while i < keys.count {
        if foundationRetainedNodeIdForKey(tree, keys[i]) != expected[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// Exercises reconcile across reorder / remove / insert with many keyed siblings.
// Keyed nodes must keep their identity (id) regardless of position, removed keys
// must tear down exactly once, and inserted keys must mount fresh -- proving the
// CSR sibling index matches the previous semantics at scale.
function FoundationRetainedReconcileScaleSmoke() -> Int {
    var passed = 0

    var tree = foundationRetainedMount(foundationRetainedKeyedRow([1, 2, 3, 4, 5]))
    let id1 = foundationRetainedNodeIdForKey(tree, 1)
    let id2 = foundationRetainedNodeIdForKey(tree, 2)
    let id3 = foundationRetainedNodeIdForKey(tree, 3)
    let id4 = foundationRetainedNodeIdForKey(tree, 4)
    let id5 = foundationRetainedNodeIdForKey(tree, 5)
    passed = passed + smokePass(id1 != 0 && id2 != 0 && id3 != 0 && id4 != 0 && id5 != 0)

    // Reorder: every keyed child keeps its id, nothing torn down.
    tree = foundationRetainedUpdate(move tree, foundationRetainedKeyedRow([5, 3, 1, 4, 2]))
    passed = passed + smokePass(
        foundationRetainedAllKeysStable(tree, [1, 2, 3, 4, 5], [id1, id2, id3, id4, id5]) &&
        tree.teardownCount == 0 &&
        tree.removedIds.count == 0
    )

    // Remove keys 2 and 4: exactly two teardowns, survivors keep their ids.
    tree = foundationRetainedUpdate(move tree, foundationRetainedKeyedRow([5, 3, 1]))
    passed = passed + smokePass(
        foundationRetainedNodeIdForKey(tree, 1) == id1 &&
        foundationRetainedNodeIdForKey(tree, 3) == id3 &&
        foundationRetainedNodeIdForKey(tree, 5) == id5 &&
        foundationRetainedNodeIdForKey(tree, 2) == 0 &&
        foundationRetainedNodeIdForKey(tree, 4) == 0 &&
        foundationRetainedWasRemoved(tree, id2) &&
        foundationRetainedWasRemoved(tree, id4) &&
        tree.removedIds.count == 2
    )

    // Insert a new key 9: survivors stable, key 9 is a fresh mount.
    tree = foundationRetainedUpdate(move tree, foundationRetainedKeyedRow([5, 9, 3, 1]))
    let id9 = foundationRetainedNodeIdForKey(tree, 9)
    passed = passed + smokePass(
        foundationRetainedNodeIdForKey(tree, 1) == id1 &&
        foundationRetainedNodeIdForKey(tree, 3) == id3 &&
        foundationRetainedNodeIdForKey(tree, 5) == id5 &&
        id9 != 0 &&
        id9 != id1 && id9 != id3 && id9 != id5 &&
        tree.removedIds.count == 0
    )

    return passed
}

function foundationRetainedTestColor() -> Color {
    return Color { r: 0.9 g: 0.9 b: 0.95 a: 1.0 }
}

function foundationRetainedTreeRoot(firstText: String, secondText: String, includeHitArea: Bool, hitFirst: Bool) -> FoundationView {
    let textNode = FoundationView {
        kind: FoundationViewKind.Text
        key: 10
        content: move firstText
        color: foundationRetainedTestColor()
        size: 16.0
        weight: 400.0
    }
    let hitNode = FoundationView {
        kind: FoundationViewKind.HitArea
        key: 20
        disabled: false
        onPress: foundationNoopPress
        children: [Text(move secondText, foundationRetainedTestColor(), 14.0, 400.0)]
    }
    if includeHitArea && hitFirst {
        return Column(
            children: [hitNode, textNode],
            width: SizeMode.Hug,
            height: SizeMode.Hug,
            spacing: 4.0,
            padding: EdgeInsets {},
            crossAxisAlignment: CrossAlignment.Start
        )
    }
    if includeHitArea {
        return Column(
            children: [textNode, hitNode],
            width: SizeMode.Hug,
            height: SizeMode.Hug,
            spacing: 4.0,
            padding: EdgeInsets {},
            crossAxisAlignment: CrossAlignment.Start
        )
    }
    return Column(
        children: [textNode],
        width: SizeMode.Hug,
        height: SizeMode.Hug,
        spacing: 4.0,
        padding: EdgeInsets {},
        crossAxisAlignment: CrossAlignment.Start
    )
}

function FoundationRetainedTreeSmoke() -> Int {
    var passed = 0
    var tree = foundationRetainedMount(foundationRetainedTreeRoot("ALPHA", "PRESS", true, false))
    let firstTextId = foundationRetainedNodeIdForKey(tree, 10)
    let firstHitId = foundationRetainedNodeIdForKey(tree, 20)
    let firstHitTarget = foundationRetainedHitTargetIdAtIndex(tree, 0)
    tree = foundationRetainedSetState(move tree, firstTextId, 42)

    passed = passed + smokePass(
        tree.rootId != 0 &&
        firstTextId != 0 &&
        firstHitId != 0 &&
        firstHitTarget == firstHitId &&
        foundationRetainedActiveStateSlotCount(tree) == tree.nodes.count
    )
    print("KIRA_UI_RETAINED_TREE_READY")

    tree = foundationRetainedUpdate(move tree, foundationRetainedTreeRoot("ALPHA", "PRESS", true, true))
    let reorderedTextId = foundationRetainedNodeIdForKey(tree, 10)
    let reorderedHitId = foundationRetainedNodeIdForKey(tree, 20)
    let reorderedHitTarget = foundationRetainedHitTargetIdAtIndex(tree, 0)
    passed = passed + smokePass(
        reorderedTextId == firstTextId &&
        reorderedHitId == firstHitId &&
        reorderedHitTarget == firstHitId &&
        foundationRetainedStateValue(tree, reorderedTextId) == 42 &&
        tree.removedIds.count == 0 &&
        tree.teardownCount == 0 &&
        foundationRetainedNodeLayoutDirty(tree, tree.rootId) &&
        foundationRetainedNodeRenderDirty(tree, tree.rootId)
    )
    print("KIRA_UI_RETAINED_CHILDREN_RECONCILED")
    print("KIRA_UI_LAYOUT_NON_EMPTY")

    tree = foundationRetainedUpdate(move tree, foundationRetainedTreeRoot("ALPHA-LONG", "PRESS", false, false))
    let finalTextId = foundationRetainedNodeIdForKey(tree, 10)
    passed = passed + smokePass(
        finalTextId == firstTextId &&
        foundationRetainedNodeIdForKey(tree, 20) == 0 &&
        foundationRetainedWasRemoved(tree, firstHitId) &&
        tree.removedIds.count == 2 &&
        tree.teardownCount == 2 &&
        foundationRetainedStateValue(tree, finalTextId) == 42 &&
        foundationRetainedStateValue(tree, firstHitId) == 0 &&
        foundationRetainedNodeLayoutDirty(tree, finalTextId) &&
        foundationRetainedNodeRenderDirty(tree, finalTextId)
    )
    print("KIRA_UI_DRAW_COMMANDS_SUBMITTED")

    return passed
}
