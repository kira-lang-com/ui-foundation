import KiraLayout
import KiraGraphics
import Foundation
// Centralised pointer / touch / keyboard event dispatch for the interactive
// Foundation app loop. `foundationDispatchEvent` recovers the app state from the
// native user-data pointer and fans out to the leaf handlers below, passing the
// mutable UI context and the (immutable) hit-region list as separate borrows.
// It translates raw Kira Graphics events into the higher-level interaction
// model: hover enter/exit, press + click, drag (start/move/end past a
// threshold), scroll, and text input. Touch events reuse the pointer path (Kira
// Graphics routes the primary touch into pointerX/Y), so the same widgets
// respond to mouse and touch. Text input is fed through the Kira-owned input
// method when the focused region opts in, giving Latin direct-commit and CJK
// pinyin composition with Hanzi prediction.
//
// Ownership note: the value returned by `nativeRecover` cannot be passed whole
// to a `borrow mut` parameter, but its fields can. Handlers therefore take
// `ui: borrow mut FoundationUiContext` plus `regions: borrow [...]` and never
// re-pass a `borrow mut` parameter onward.

function foundationDragThreshold() -> Float {
    return 6.0
}

function foundationRectContains(bounds: borrow Rect, x: Float, y: Float) -> Bool {
    return x >= bounds.x && x <= bounds.x + bounds.width && y >= bounds.y && y <= bounds.y + bounds.height
}

function foundationHitRegionIndexAtPoint(regions: borrow [FoundationHitRegionRecord], x: Float, y: Float) -> Int {
    var index = regions.count
    while index > 0 {
        index = index - 1
        let region = regions[index]
        if region.disabled == false {
            if foundationRectContains(region.bounds, x, y) {
                return index
            }
        }
    }
    return -1
}

function foundationHitRegionKeyAtPoint(regions: borrow [FoundationHitRegionRecord], x: Float, y: Float) -> Int {
    let index = foundationHitRegionIndexAtPoint(regions, x, y)
    if index < 0 {
        return 0
    }
    return regions[index].key
}

function foundationRegionIndexByKey(regions: borrow [FoundationHitRegionRecord], key: Int) -> Int {
    if key == 0 {
        return -1
    }
        for index in 0..regions.count {
        if regions[index].key == key {
            return index
        }
            }
    return -1
}

// Is the pointer over the window's own content? The platform routes moves to the
// app while system chrome sits over the frame — hovering Stage Manager's window
// strip on macOS is the reproducible case — and those arrive carrying locations
// outside the view. Hit testing them hovers whatever element happens to lie under
// the overlay, so a position outside the viewport counts as over nothing at all.
// Before the first event carrying a window size there is no viewport to test
// against, and everything is treated as inside.
function foundationPointerInsideViewport(ui: borrow FoundationUiContext, x: Float, y: Float) -> Bool {
    let width = ui.viewport.width
    let height = ui.viewport.height
    if width <= 0.0 || height <= 0.0 {
        return true
    }
    return x >= 0.0 && y >= 0.0 && x < width && y < height
}

// Update the cached pointer position, recompute the hovered region, fire hover
// exit on the region left and hover enter on the region entered, and return the
// hit region index (-1 when over nothing).
function foundationUpdatePointer(ui: borrow mut FoundationUiContext, regions: borrow [FoundationHitRegionRecord], x: Float, y: Float) -> Int {
    // The position is recorded even when it lands outside: a drag reports its
    // distance from the press point, and dragging past the window edge is normal.
    ui.pointerX = x
    ui.pointerY = y
    var index = -1
    if foundationPointerInsideViewport(ui, x, y) {
        index = foundationHitRegionIndexAtPoint(regions, x, y)
    }
    var newKey = 0
    if index >= 0 {
        newKey = regions[index].key
    }
    let oldKey = ui.hoveredKey
    if oldKey != newKey {
        if oldKey != 0 {
            let oldIndex = foundationRegionIndexByKey(regions, oldKey)
            if oldIndex >= 0 {
                regions[oldIndex].interaction.onHoverExit()
            }
        }
        if newKey != 0 {
            let newIndex = foundationRegionIndexByKey(regions, newKey)
            if newIndex >= 0 {
                regions[newIndex].interaction.onHoverEnter()
            }
        }
        // Hover moved to a different region: force a rebuild so widgets can
        // restyle for hover (buttons highlight by default; see foundationHovered).
        // A plain move WITHIN one region still skips the rebuild (retained fast
        // path), so only boundary crossings pay the cost.
        ui.eventCount = ui.eventCount + 1
    }
    ui.hoveredKey = newKey
    return index
}

// Fire hover exit on the currently hovered region and clear all pointer state.
function foundationClearHover(ui: borrow mut FoundationUiContext, regions: borrow [FoundationHitRegionRecord]) {
    let oldKey = ui.hoveredKey
    if oldKey != 0 {
        let oldIndex = foundationRegionIndexByKey(regions, oldKey)
        if oldIndex >= 0 {
            regions[oldIndex].interaction.onHoverExit()
        }
        // Something was actually hovered: widgets have to restyle, so force the
        // rebuild here rather than on every exit. An exit with nothing hovered is
        // a no-op — and one arrives for each move the pointer makes across another
        // application's overlay, which must not cost a rebuild apiece.
        ui.eventCount = ui.eventCount + 1
    }
    ui.hoveredKey = 0
    ui.pressedKey = 0
    ui.dragging = false
    ui.dragKey = 0
    return
}

function foundationBeginPress(ui: borrow mut FoundationUiContext, regions: borrow [FoundationHitRegionRecord], index: Int, allowFocus: Bool) {
    ui.pressedKey = ui.hoveredKey
    ui.pressX = ui.pointerX
    ui.pressY = ui.pointerY
    ui.dragging = false
    ui.dragKey = ui.hoveredKey
    // Publish the pressed region's bounds immediately (not just on the release
    // in foundationEndPress): ambient gesture code that runs on the press edge —
    // e.g. the editor viewport mapping a click to a world ray — needs the exact
    // hit-area rectangle right now, before any release.
    if index >= 0 {
        foundationWritePressBounds(ui, regions[index].bounds)
    }
    if allowFocus == false {
        // Right/middle presses drive gestures (camera drags) only — they never
        // move focus or the keyboard.
        return
    }
    if index >= 0 {
        let region = regions[index]
        if region.focusable {
            ui.focusedKey = region.key
            ui.ime = imeReset()
            graphicsShowKeyboard(true)
            return
        }
    }
    ui.focusedKey = 0
    ui.ime = imeReset()
    graphicsShowKeyboard(false)
    return
}

function foundationUpdateDrag(ui: borrow mut FoundationUiContext, regions: borrow [FoundationHitRegionRecord]) {
    if ui.pressedKey == 0 {
        return
    }
    let dx = ui.pointerX - ui.pressX
    let dy = ui.pointerY - ui.pressY
    let index = foundationRegionIndexByKey(regions, ui.dragKey)
    if index < 0 {
        return
    }
    let region = regions[index]
    if ui.dragging == false {
        let distSquared = dx * dx + dy * dy
        let threshold = foundationDragThreshold()
        if distSquared >= threshold * threshold {
            ui.dragging = true
            region.interaction.onDragStart(ui.pressX, ui.pressY)
        }
    }
    if ui.dragging {
        region.interaction.onDragMove(dx, dy)
    }
    return
}

function foundationEndPress(ui: borrow mut FoundationUiContext, regions: borrow [FoundationHitRegionRecord], index: Int) {
    if ui.dragging {
        let dragIndex = foundationRegionIndexByKey(regions, ui.dragKey)
        if dragIndex >= 0 {
            regions[dragIndex].interaction.onDragEnd(ui.pointerX, ui.pointerY)
        }
    } else {
        let releasedKey = ui.hoveredKey
        // Only LEFT presses count as widget clicks; right/middle are gesture-only.
        if releasedKey != 0 && releasedKey == ui.pressedKey && index >= 0 && ui.pressButton == 1 {
            let region = regions[index]
            // Publish the button's bounds before firing, so an onPress that opens
            // a menu can anchor it to this button (foundationPressBounds*).
            foundationWritePressBounds(ui, region.bounds)
            region.onPress()
            ui.clickedKey = region.key
        }
    }
    ui.pressedKey = 0
    ui.pressButton = 0
    ui.dragging = false
    ui.dragKey = 0
    return
}

// A wheel turn goes to the nearest thing under the pointer that SCROLLS, not to
// whatever happens to be under it: a row in a list is under the pointer too, and
// a wheel over a row moves the list the row is in.
function foundationScrollRegionIndexAtPoint(regions: borrow [FoundationHitRegionRecord], x: Float, y: Float) -> Int {
    var index = regions.count
    while index > 0 {
        index = index - 1
        let region = regions[index]
        if region.wheel && region.disabled == false {
            if foundationRectContains(region.bounds, x, y) {
                return index
            }
        }
    }
    return -1
}

function foundationHandleScroll(ui: borrow mut FoundationUiContext, regions: borrow [FoundationHitRegionRecord], dx: Float, dy: Float) {
    ui.scrollX = dx
    ui.scrollY = dy
    let index = foundationScrollRegionIndexAtPoint(regions, ui.pointerX, ui.pointerY)
    if index >= 0 {
        regions[index].onScroll(dx, dy)
    }
    return
}

// Route a committed text codepoint for the focused region. IME-enabled regions
// compose pinyin into Hanzi candidates; Latin regions commit directly.
function foundationHandleTextInputEvent(ui: borrow mut FoundationUiContext, regions: borrow [FoundationHitRegionRecord], codepoint: Int) {
    ui.lastTextCodepoint = codepoint
    if ui.focusedKey == 0 || codepoint == 0 {
        return
    }
    let index = foundationRegionIndexByKey(regions, ui.focusedKey)
    if index < 0 {
        return
    }
    let region = regions[index]
    if region.interaction.imeEnabled == false {
        region.onTextInput(graphicsStringFromCodepoint(codepoint))
        region.onTextCodepoint(codepoint)
        return
    }
    // Pinyin letters extend the composition buffer.
    if imeIsPinyinLetter(codepoint) {
        let next = imeAppendLetter(ui.ime, codepoint)
        ui.ime = move next
        return
    }
    // Space commits the highlighted candidate, or inserts a literal space.
    if codepoint == 32 {
        if imeIsComposing(ui.ime) {
            let chosen = imeCommitActive(ui.ime)
            if chosen != 0 {
                region.onTextInput(graphicsStringFromCodepoint(chosen))
            }
            ui.ime = imeReset()
            return
        }
        region.onTextInput(graphicsStringFromCodepoint(32))
        return
    }
    // Digits 1-9 pick a candidate by position while composing.
    if codepoint >= 49 && codepoint <= 57 {
        if imeIsComposing(ui.ime) {
            let chosen = imeCandidateAt(ui.ime, codepoint - 49)
            if chosen != 0 {
                region.onTextInput(graphicsStringFromCodepoint(chosen))
                ui.ime = imeReset()
                return
            }
        }
        region.onTextInput(graphicsStringFromCodepoint(codepoint))
        return
    }
    // Any other character commits a pending candidate, then inserts itself.
    if imeIsComposing(ui.ime) {
        let chosen = imeCommitActive(ui.ime)
        if chosen != 0 {
            region.onTextInput(graphicsStringFromCodepoint(chosen))
        }
        ui.ime = imeReset()
    }
    region.onTextInput(graphicsStringFromCodepoint(codepoint))
    return
}

// Reconcile keyboard focus against the freshly-built hit regions, once per full
// frame. Two rules, in order:
//   1. If the focused region no longer exists (its widget was removed — e.g. an
//      inline edit field was dismissed), drop focus so a later autofocus field
//      can claim it.
//   2. If nothing holds focus and some region requests autofocus, adopt the
//      first such region and raise the keyboard. Gated on focusedKey == 0 so it
//      never steals focus from the user mid-edit, and never ping-pongs between
//      two autofocus regions.
function foundationReconcileFocus(ui: borrow mut FoundationUiContext, regions: borrow [FoundationHitRegionRecord]) {
    if ui.focusedKey != 0 {
        if foundationRegionIndexByKey(regions, ui.focusedKey) < 0 {
            ui.focusedKey = 0
            graphicsShowKeyboard(false)
        }
    }
    if ui.focusedKey == 0 {
        for i in 0..regions.count {
            if regions[i].autofocus {
                ui.focusedKey = regions[i].key
                ui.ime = imeReset()
                graphicsShowKeyboard(true)
                return
            }
        }
    }
    return
}

function foundationHandleKeyEvent(ui: borrow mut FoundationUiContext, regions: borrow [FoundationHitRegionRecord], keyCode: Int) {
    ui.lastKeyCode = keyCode
    if ui.focusedKey == 0 {
        return
    }
    let index = foundationRegionIndexByKey(regions, ui.focusedKey)
    if index < 0 {
        return
    }
    let region = regions[index]
    let composing = region.interaction.imeEnabled && imeIsComposing(ui.ime)
    if keyCode == 259 {
        if composing {
            let next = imeBackspace(ui.ime)
            ui.ime = move next
        } else {
            region.onBackspace()
        }
        return
    }
    if keyCode == 257 {
        if composing {
            let chosen = imeCommitActive(ui.ime)
            if chosen != 0 {
                region.onTextInput(graphicsStringFromCodepoint(chosen))
            }
            ui.ime = imeReset()
        } else {
            region.onSubmit()
        }
        return
    }
    // Everything else (arrows, home/end, forward-delete, …) goes to the field's
    // navigation handler, which moves/edits at the caret.
    region.onKey(keyCode)
    return
}

// Single entry point used by the interactive app's `onEvent` hook. Owns the
// recovered `var` so it can hand mutable borrows of its fields to the handlers.
function foundationPointerButtonInt(button: PointerButton) -> Int {
    match button {
        Left -> return 1;
        Right -> return 2;
        Middle -> return 3;
        None -> return 0;
        Other -> return 0;
    }
}

function foundationDispatchEvent(userData: RawPtr, event: borrow AppEvent) {
    var state = nativeRecover<FoundationAppState>(userData)
    // eventCount gates the interactive runner's re-present fast path: bumping it
    // forces a full widget rebuild. Pointer MOVES never bump it: hover and drag
    // deliver through their callbacks right here (camera gestures need no
    // rebuild), UI-visible state changes only on press/release/scroll/keys —
    // and every rebuild leaks native memory today (the leak the old live-resize
    // path exposed), so mouse motion must keep hitting the retained fast path.
    // PointerExited joins the moves in NOT bumping it here: an overlay drawn over
    // the window (Stage Manager) turns every move it swallows into an exit, and
    // only the first one — the one that actually clears a hover — changes what the
    // UI looks like. foundationClearHover bumps it in exactly that case.
    if event.kind != .PointerMoved && event.kind != .PointerExited {
        state.ui.eventCount = state.ui.eventCount + 1
    }
    state.ui.modShift = event.modifiers.shift
    state.ui.modAlt = event.modifiers.alt
    if event.windowWidth > 0 && event.windowHeight > 0 {
        state.ui.viewport = Size {
            width: intAsFloat(value: event.windowWidth)
            height: intAsFloat(value: event.windowHeight)
        }
    }
    let kind = event.kind
    if kind == .PointerDown || kind == .TouchesBegan {
        var button = foundationPointerButtonInt(event.pointerButton)
        if button == 0 {
            // Synthetic/touch downs carry no button — treat as left.
            button = 1
        }
        state.ui.pressButton = button
        // Update the pointer/hover BEFORE snapshotting so ambient readers see the
        // region this press actually landed on (right-click routing needs it).
        let index = foundationUpdatePointer(state.ui, state.hitRegions, event.pointerX, event.pointerY)
        foundationWriteInputSnapshot(state.ui)
        foundationBeginPress(state.ui, state.hitRegions, index, button == 1)
        return
    }
    if kind == .KeyUp {
        let bit = foundationKeyBit(event.keyCode)
        if bit > 0 {
            let held = (state.ui.keysMask / bit) - ((state.ui.keysMask / bit) / 2) * 2 == 1
            if held {
                state.ui.keysMask = state.ui.keysMask - bit
            }
        }
        foundationWriteInputSnapshot(state.ui)
        return
    }
    if kind == .PointerMoved || kind == .TouchesMoved || kind == .PointerEntered {
        let ignored = foundationUpdatePointer(state.ui, state.hitRegions, event.pointerX, event.pointerY)
        foundationUpdateDrag(state.ui, state.hitRegions)
        // Ambient widget state (`foundationHovered`) reads the snapshot, not
        // this mutable dispatch context. Publish boundary changes on motion;
        // otherwise hover styling sees the last press and cannot react until a
        // button is clicked.
        foundationWriteInputSnapshot(state.ui)
        return
    }
    if kind == .PointerUp || kind == .TouchesEnded {
        let index = foundationUpdatePointer(state.ui, state.hitRegions, event.pointerX, event.pointerY)
        foundationEndPress(state.ui, state.hitRegions, index)
        foundationWriteInputSnapshot(state.ui)
        return
    }
    if kind == .PointerExited || kind == .TouchesCancelled {
        foundationClearHover(state.ui, state.hitRegions)
        foundationWriteInputSnapshot(state.ui)
        return
    }
    // A compositor may unmap a minimized surface without first delivering a
    // pointer leave. Focus loss is therefore also the end of every hover and
    // press owned by that window.
    if kind == .Unfocused {
        foundationClearHover(state.ui, state.hitRegions)
        foundationWriteInputSnapshot(state.ui)
        return
    }
    if kind == .Scroll {
        let ignored = foundationUpdatePointer(state.ui, state.hitRegions, event.pointerX, event.pointerY)
        foundationHandleScroll(state.ui, state.hitRegions, event.scrollX, event.scrollY)
        return
    }
    if kind == .TextInput {
        foundationHandleTextInputEvent(state.ui, state.hitRegions, event.textCodepoint)
        return
    }
    if kind == .KeyDown {
        let bit = foundationKeyBit(event.keyCode)
        if bit > 0 {
            let held = (state.ui.keysMask / bit) - ((state.ui.keysMask / bit) / 2) * 2 == 1
            if held == false {
                state.ui.keysMask = state.ui.keysMask + bit
            }
        }
        foundationWriteInputSnapshot(state.ui)
        foundationHandleKeyEvent(state.ui, state.hitRegions, event.keyCode)
        return
    }
    return
}

