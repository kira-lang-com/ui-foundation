// Ambient state slots backing the Kira UI `@State` property wrapper.
//
// A wrapped property's backing struct is allocated once with `nativeState`, anchored under a
// stable string key ("Owner.property") in the native slot store, and recovered by reference on
// every later access — so state survives the per-frame widget rebuilds of the interactive app
// loop. Kira has no mutable globals by design; the native store is the single process-global
// anchor, and it treats values as opaque Kira-runtime pointers.
//
// Single-threaded by contract (the UI frame loop).

@FFI.Extern { library: kirastatestore, symbol: kira_state_slot_has, abi: c }
function rawStateSlotHas(key: CString): I32
@FFI.Extern { library: kirastatestore, symbol: kira_state_slot_get, abi: c }
function rawStateSlotGet(key: CString): RawPtr
@FFI.Extern { library: kirastatestore, symbol: kira_state_slot_put, abi: c, retains: value }
function rawStateSlotPut(key: CString, value: RawPtr): Void
@FFI.Extern { library: kirastatestore, symbol: kira_state_slot_reset, abi: c }
function rawStateSlotReset(): Void
@FFI.Extern { library: kirastatestore, symbol: kira_state_slot_count, abi: c }
function rawStateSlotCount(): I32

// True when a value was stored under `key`.
@Native
function stateSlotHas(key: String) -> Bool {
    return rawStateSlotHas(key) != 0
}

// The pointer stored under `key` (null when absent — check with stateSlotHas first).
@Native
function stateSlotGet(key: String) -> RawPtr {
    return rawStateSlotGet(key)
}

// Transfer one affine callback-state owner under `key`, replacing any existing
// entry. `retains: value` is the ownership boundary: the compiler requires the
// move and does not release that state reference after the successful C call.
// The C store releases exactly that reference on replacement/reset.
@Native
function stateSlotPut(key: String, value: NativeState<Any>) {
    rawStateSlotPut(key, move value)
    return
}

// Drop every slot (test isolation / editor session reset), releasing the one
// native-state reference owned by each entry.
@Native
function stateSlotReset() {
    rawStateSlotReset()
    return
}

// Number of live slots.
@Native
function stateSlotCount() -> Int {
    let raw = rawStateSlotCount()
    return Int(raw)
}
