import KiraGraphics
import KiraLayout
import Foundation
function foundationTextIntrinsicWidth(size: Float, characterCount: Int) -> Float {
    let glyphWidth = size * 0.48
    let gap = size * 0.18
    if characterCount <= 0 {
        return 0.0
    }
    let measured = intAsFloat(value: characterCount) * glyphWidth + intAsFloat(value: characterCount - 1) * gap
    return measured + size * 0.02
}

function foundationTextIntrinsicHeight(size: Float) -> Float {
    return size * 1.20
}

// Real measurement from the FreeType engine, using the same (path,size) face
// cache as rasterization so measured advances match what gets drawn. Falls back
// to the proportional estimate if the engine is unavailable (e.g. no font found).
@Native
function foundationTextRunWidth(content: borrow String, size: Float) -> Float {
    return kira_text_measure_run("", content, size)
}

@Native
function foundationTextRunLineHeight(size: Float) -> Float {
    return kira_text_line_height("", size)
}

// Visible glyph bounds relative to the baseline. These are deliberately kept
// separate from line height: layout must not reserve the font's invisible
// leading when a text leaf is placed inside a padded card or stack.
@Native
function foundationTextRunInkTop(content: borrow String, size: Float) -> Float {
    return kira_text_run_ink_top("", content, size)
}

@Native
function foundationTextRunInkBottom(content: borrow String, size: Float) -> Float {
    return kira_text_run_ink_bottom("", content, size)
}

@Native
function foundationTextRunInkLeft(content: borrow String, size: Float) -> Float {
    return kira_text_run_ink_left("", content, size)
}

@Native
function foundationTextRunInkRight(content: borrow String, size: Float) -> Float {
    return kira_text_run_ink_right("", content, size)
}

// Decode an opaque String into its Unicode codepoints (up to 512), so an editable
// text buffer can be SEEDED from an existing String. String is otherwise opaque
// (count/+/== only); the native decoder walks the UTF-8 bytes in one call.
@Native
function foundationStringToCodepoints(content: borrow String) -> [Int] {
    var codes: [Int] = []
    if content.count > 0 {
        let max = 512
        let out = allocateBytes(U64(max * 4))
        let count = Int(decodeCodepoints(content, out, I32(max)))
        var i = 0
        while i < count {
            codes.append(readInt(out, U64(i * 4)))
            i = i + 1
        }
        freeBytes(out)
    }
    return move codes
}

// Build a display String from a codepoint slice [start, end) — the inverse of
// foundationStringToCodepoints, for rendering/measuring an editable buffer.
function foundationStringFromCodepoints(codes: borrow [Int], start: Int, end: Int) -> String {
    var s = ""
    var i = start
    while i < end {
        if i >= 0 && i < codes.count {
            s = s + graphicsStringFromCodepoint(codes[i])
        }
        i = i + 1
    }
    return s
}

function foundationTextMeasure(content: borrow String, size: Float) -> Size {
    if content.count <= 0 {
        return Size {
            width: 0.0
            height: foundationTextIntrinsicHeight(size: size)
        }
    }

    var width = foundationTextRunWidth(content: content, size: size)
    if width <= 0.0 {
        width = foundationTextIntrinsicWidth(size: size, characterCount: content.count)
    }

    var height = foundationTextRunLineHeight(size: size)
    if height <= 0.0 {
        height = foundationTextIntrinsicHeight(size: size)
    }

    return Size {
        width: width
        height: height
    }
}

class FoundationTextMeasurer {
    function intrinsicWidth(size: Float, characterCount: Int) -> Float {
        return foundationTextIntrinsicWidth(size: size, characterCount: characterCount)
    }

    function intrinsicHeight(size: Float) -> Float {
        return foundationTextIntrinsicHeight(size: size)
    }

    function measure(content: borrow String, size: Float) -> Size {
        return foundationTextMeasure(content: content, size: size)
    }
}

function Text(content: String, color: Color, size: Float, weight: Float) -> FoundationView {
    return FoundationView {
        kind: .Text
        content: content
        color: color
        size: size
        inkLeft: foundationTextRunInkLeft(content: content, size: size)
        inkRight: foundationTextRunInkRight(content: content, size: size)
        inkTop: foundationTextRunInkTop(content: content, size: size)
        inkBottom: foundationTextRunInkBottom(content: content, size: size)
        weight: weight
    }
}

// Text that reads the backdrop under it and inks itself dark or light accordingly.
// `fallback` is what it uses where there is nothing to read — below every glass
// layer, nothing has been captured, so the authored colour still decides.
function AdaptiveText(content: String, fallback: Color, size: Float, weight: Float) -> FoundationView {
    return FoundationView {
        kind: .Text
        content: content
        color: fallback
        size: size
        inkLeft: foundationTextRunInkLeft(content: content, size: size)
        inkRight: foundationTextRunInkRight(content: content, size: size)
        inkTop: foundationTextRunInkTop(content: content, size: size)
        inkBottom: foundationTextRunInkBottom(content: content, size: size)
        weight: weight
        adaptiveInk: true
    }
}

// A vector icon leaf: `svg` is SVG text (see NativeLibs/Icon for the supported
// subset), drawn as a `size`-by-`size` box tinted `color`.
function Icon(svg: String, color: Color, size: Float) -> FoundationView {
    return FoundationView {
        kind: .Icon
        content: svg
        color: color
        size: size
    }
}
