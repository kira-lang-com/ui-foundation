import KiraGraphics
import Foundation
import KiraLayout
enum FoundationViewKind {
    Row
    Column
    Expanded
    Frame
    Spacer
    Surface
    Text
    HitArea
    LayoutPriority
    // A leaf showing an EXTERNAL KiraGraphics texture (e.g. an engine viewport render
    // target) inside the UI layout — drawn by the batched compositor as a mode-2 quad.
    TextureView
    // A vector icon leaf: `content` holds SVG text (subset — see NativeLibs/Icon),
    // rasterized once per (icon, physical size) into the glyph atlas and drawn as a
    // color-tinted mode-1 quad, exactly like a text glyph. `size` is the logical
    // pixel box (square); `color` is the tint.
    Icon
}

function foundationNoopPress() {
    return
}

function foundationNoopTextInput(value: String) {
    let ignored = value.count
    return
}

function foundationNoopTextCodepoint(value: Int) {
    let ignored = value + 0
    return
}

function foundationNoopScroll(dx: Float, dy: Float) {
    let ignored = dx + dy
    return
}

// Extended pointer/touch interaction callbacks, bundled so a view carries them
// as a single Copy value. Hover enter/exit fire as the pointer (or primary
// touch) crosses a region boundary; drag start/move/end fire once a held
// pointer moves past the drag threshold. `imeEnabled` opts a focusable region
// into the Kira-owned input method (pinyin composition + Hanzi prediction);
// when false, text codepoints commit directly for Latin input.
struct FoundationInteraction {
    let onHoverEnter: () -> Void = foundationNoopPress
    let onHoverExit: () -> Void = foundationNoopPress
    let onDragStart: (Float, Float) -> Void = foundationNoopScroll
    let onDragMove: (Float, Float) -> Void = foundationNoopScroll
    let onDragEnd: (Float, Float) -> Void = foundationNoopScroll
    let imeEnabled: Bool = false
}

struct FoundationView {
    let kind: FoundationViewKind
    let key: Int = 0
    let children: [FoundationView] = []
    let width: SizeMode = SizeMode.Hug
    let height: SizeMode = SizeMode.Hug
    let flex: Int = 0
    let gap: Float = 0.0
    let padding: EdgeInsets = EdgeInsets {}
    let crossAxisAlignment: CrossAlignment = CrossAlignment.Stretch
    let alignment: Alignment = Alignment.Center
    let fill: Color = Color {
        r: 1.0
        g: 1.0
        b: 1.0
        a: 1.0
    }
    let border: Color = Color {
        r: 0.0
        g: 0.0
        b: 0.0
        a: 0.0
    }
    let borderWidth: Float = 0.0
    let radius: Float = 0.0
    // Optional background painted behind a HitArea (transparent = none). Buttons
    // use it for their default hover highlight without any layout wrapping.
    let backgroundFill: Color = Color {
        r: 0.0
        g: 0.0
        b: 0.0
        a: 0.0
    }
    let shape: FoundationShape = FoundationShape.RegularRoundedRect
    let material: FoundationMaterial = FoundationMaterial.Flat
    let effects: [FoundationEffect] = []
    let clipContent: Bool = false
    let content: String = ""
    let color: Color = Color {
        r: 0.08
        g: 0.08
        b: 0.10
        a: 1.0
    }
    let size: Float = 15.0
    let weight: Float = 400.0
    let disabled: Bool = false
    let focusable: Bool = false
    // A focusable region that grabs the keyboard as soon as it appears while
    // nothing else is focused (e.g. an inline rename field). The runner adopts it
    // once, never stealing focus mid-edit — see foundationReconcileFocus.
    let autofocus: Bool = false
    let onPress: () -> Void = foundationNoopPress
    let onTextInput: (String) -> Void = foundationNoopTextInput
    let onTextCodepoint: (Int) -> Void = foundationNoopTextCodepoint
    let onBackspace: () -> Void = foundationNoopPress
    let onSubmit: () -> Void = foundationNoopPress
    // Navigation / editing keys for a focused field (arrows, home/end, forward
    // delete) — receives the keyCode of every key press EXCEPT Enter/Backspace,
    // which have their own callbacks. Lets a text field move its caret.
    let onKey: (Int) -> Void = foundationNoopTextCodepoint
    let onScroll: (Float, Float) -> Void = foundationNoopScroll
    let minLength: Float = 0.0
    let interaction: FoundationInteraction = FoundationInteraction {}
    // TextureView: the external KiraGraphics texture id to show (0 = none), and its
    // opacity. Kept as Int at the view layer; the backend converts to the U32 handle.
    let texture: Int = 0
    let textureOpacity: Float = 1.0
    // LiquidGlass blur dial (0..1): how much of the blurred backdrop pyramid the
    // glass shows vs the sharp capture. 1 = the iOS search-pill look (fully
    // frosted), ~0 = the macOS dock look (crisp content, refraction + rims only).
    let blur: Float = 1.0
}


function foundationViewChildren(view: borrow FoundationView) -> [FoundationView] {
    return view.children
}

function foundationLayoutDescriptorWithFlex(layout: borrow LayoutDescriptor, flex: Int) -> LayoutDescriptor {
    return LayoutDescriptor {
        width: layout.width
        height: layout.height
        flex: flex
        arrange: layout.arrange
        axis: layout.axis
        spacing: layout.spacing
        rowSpacing: layout.rowSpacing
        alignment: layout.alignment
        overlayAlignment: layout.overlayAlignment
        columns: layout.columns
        padding: layout.padding
        margin: layout.margin
        x: layout.x
        y: layout.y
        zIndex: layout.zIndex
        clipContent: layout.clipContent
    }
}

function foundationViewLayoutDescriptor(view: borrow FoundationView) -> LayoutDescriptor {
    match view.kind {
        Row -> {
            return LayoutDescriptor {
                width: view.width
                height: view.height
                arrange: ArrangeMode.Stack
                axis: Axis.Horizontal
                spacing: view.gap
                alignment: view.crossAxisAlignment
                overlayAlignment: Alignment.Center
                padding: view.padding
                margin: EdgeInsets {}
            }
        }
        Column -> {
            return LayoutDescriptor {
                width: view.width
                height: view.height
                arrange: ArrangeMode.Stack
                axis: Axis.Vertical
                spacing: view.gap
                alignment: view.crossAxisAlignment
                overlayAlignment: Alignment.Center
                padding: view.padding
                margin: EdgeInsets {}
            }
        }
        Expanded -> {
            return LayoutDescriptor {
                width: SizeMode.Fill
                height: SizeMode.Fill
                flex: view.flex
                arrange: ArrangeMode.Fill
                axis: Axis.Vertical
                alignment: CrossAlignment.Stretch
                overlayAlignment: Alignment.Center
                padding: EdgeInsets {}
                margin: EdgeInsets {}
            }
        }
        Frame -> {
            return LayoutDescriptor {
                width: view.width
                height: view.height
                flex: view.flex
                arrange: ArrangeMode.Overlay
                axis: Axis.Vertical
                alignment: CrossAlignment.Stretch
                overlayAlignment: view.alignment
                padding: view.padding
                margin: EdgeInsets {}
            }
        }
        Spacer -> {
            let ignored = view.minLength
            return LayoutDescriptor {
                width: SizeMode.Fill
                height: SizeMode.Fill
                flex: view.flex
                arrange: ArrangeMode.Fill
                axis: Axis.Vertical
                alignment: CrossAlignment.Stretch
                overlayAlignment: Alignment.Center
                padding: EdgeInsets {}
                margin: EdgeInsets {}
            }
        }
        Surface -> {
            return LayoutDescriptor {
                width: view.width
                height: view.height
                flex: view.flex
                arrange: ArrangeMode.Fill
                axis: Axis.Vertical
                alignment: CrossAlignment.Stretch
                overlayAlignment: Alignment.Center
                padding: view.padding
                margin: EdgeInsets {}
                clipContent: view.clipContent
            }
        }
        Text -> {
            let measured = foundationTextMeasure(content: view.content, size: view.size)
            return LayoutDescriptor {
                width: SizeMode.Fixed(measured.width)
                height: SizeMode.Fixed(measured.height)
                arrange: ArrangeMode.Fill
                axis: Axis.Vertical
                alignment: CrossAlignment.Stretch
                overlayAlignment: Alignment.Center
                padding: EdgeInsets {}
                margin: EdgeInsets {}
            }
        }
        HitArea -> {
            // Honors the view's size modes (default Hug/Hug) so hit wrappers can
            // stretch with fill-width rows instead of collapsing around them.
            return LayoutDescriptor {
                width: view.width
                height: view.height
                arrange: ArrangeMode.Fill
                axis: Axis.Vertical
                alignment: CrossAlignment.Stretch
                overlayAlignment: Alignment.Center
                padding: EdgeInsets {}
                margin: EdgeInsets {}
            }
        }
        TextureView -> {
            // A sized leaf: the texture stretches to whatever box the layout gives it
            // (Fixed / Fill via the width/height modes, flex-participating like Surface).
            return LayoutDescriptor {
                width: view.width
                height: view.height
                flex: view.flex
                arrange: ArrangeMode.Fill
                axis: Axis.Vertical
                alignment: CrossAlignment.Stretch
                overlayAlignment: Alignment.Center
                padding: EdgeInsets {}
                margin: EdgeInsets {}
            }
        }
        Icon -> {
            // A fixed square leaf sized by the icon's logical pixel size.
            return LayoutDescriptor {
                width: SizeMode.Fixed(view.size)
                height: SizeMode.Fixed(view.size)
                arrange: ArrangeMode.Fill
                axis: Axis.Vertical
                alignment: CrossAlignment.Stretch
                overlayAlignment: Alignment.Center
                padding: EdgeInsets {}
                margin: EdgeInsets {}
            }
        }
        LayoutPriority -> {
            if view.children.count == 0 {
                return LayoutDescriptor {
                    width: SizeMode.Hug
                    height: SizeMode.Hug
                    flex: view.flex
                    arrange: ArrangeMode.Fill
                    axis: Axis.Vertical
                    alignment: CrossAlignment.Stretch
                    overlayAlignment: Alignment.Center
                    padding: EdgeInsets {}
                    margin: EdgeInsets {}
                }
            }
            return foundationLayoutDescriptorWithFlex(foundationViewLayoutDescriptor(view.children[0]), view.flex)
        }
    }
}