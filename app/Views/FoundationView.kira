import KiraGraphics
import Foundation
import KiraLayout
import KiraUIMotion
enum FoundationViewKind {
    Row
    Column
    Expanded
    Frame
    Spacer
    Surface
    Text
    HitArea
    LayoutPriority
    // A leaf showing an EXTERNAL KiraGraphics texture (e.g. an engine viewport render
    // target) inside the UI layout — drawn by the batched compositor as a mode-2 quad.
    TextureView
    // A vector icon leaf: `content` holds SVG text (subset — see NativeLibs/Icon),
    // rasterized once per (icon, physical size) into the glyph atlas and drawn as a
    // color-tinted mode-1 quad, exactly like a text glyph. `size` is the logical
    // pixel box (square); `color` is the tint.
    Icon
}

// Which way a gradient runs across the surface it fills. Named directions
// rather than an angle: these are the four a layout can answer without knowing
// how large the surface came out, and an angle over a box whose aspect changes
// is a gradient that shears as the window resizes.
enum FoundationGradient {
    None
    // Top to bottom.
    Down
    // Leading to trailing.
    Across
    // Top-leading corner to bottom-trailing corner.
    Diagonal
}

function foundationGradientAxis(gradient: borrow FoundationGradient) -> Float {
    match gradient {
        None -> return 0.0;
        Down -> return 1.0;
        Across -> return 2.0;
        Diagonal -> return 3.0;
    }
}

function foundationNoopPress() {
    return
}

function foundationNoopTextInput(value: String) {
    let ignored = value.count
    return
}

function foundationNoopTextCodepoint(value: Int) {
    let ignored = value + 0
    return
}

function foundationNoopScroll(dx: Float, dy: Float) {
    let ignored = dx + dy
    return
}

// Extended pointer/touch interaction callbacks, bundled so a view carries them
// as a single Copy value. Hover enter/exit fire as the pointer (or primary
// touch) crosses a region boundary; drag start/move/end fire once a held
// pointer moves past the drag threshold. `imeEnabled` opts a focusable region
// into the Kira-owned input method (pinyin composition + Hanzi prediction);
// when false, text codepoints commit directly for Latin input.
struct FoundationInteraction {
    let onHoverEnter: () -> Void = foundationNoopPress
    let onHoverExit: () -> Void = foundationNoopPress
    let onDragStart: (Float, Float) -> Void = foundationNoopScroll
    let onDragMove: (Float, Float) -> Void = foundationNoopScroll
    let onDragEnd: (Float, Float) -> Void = foundationNoopScroll
    let imeEnabled: Bool = false
}

function foundationNoopGuide(width: Float, height: Float) -> Float {
    let ignored = width + height
    return 0.0
}

// An alignment guide a view PUBLISHES: which guide it answers, and how it
// answers against its own resolved size.
//
// The answer is a closure rather than a number because a guide is a position in
// the publisher's own coordinates and those do not exist until the view has been
// measured. Resolving it after placement is what lets a guide be written as
// "twenty points in from my leading edge" and stay true when the view resizes.
struct FoundationGuidePublication {
    // The guide's identity. Zero is no guide.
    let tag: Int = 0
    let resolve: (Float, Float) -> Float = foundationNoopGuide
}

struct FoundationView {
    let kind: FoundationViewKind
    let key: Int = 0
    // Guides this view answers for whatever encloses it.
    let guides: [FoundationGuidePublication] = []
    // Guides this view's own painted extent is taken FROM: a separator whose ink
    // begins where the row above it says its content begins. Zero is none, and
    // then the view keeps the extent layout gave it.
    //
    // A consumer is adjusted after placement rather than before, because a
    // separator's inset changes what it paints and not what it occupies — so
    // nothing it is stacked with has to be laid out a second time.
    let guideLeading: Int = 0
    let guideTrailing: Int = 0
    let children: [FoundationView] = []
    let width: SizeMode = .Hug
    let height: SizeMode = .Hug
    let flex: Int = 0
    let gap: Float = 0.0
    let padding: EdgeInsets = EdgeInsets {}
    let crossAxisAlignment: CrossAlignment = .Stretch
    let alignment: Alignment = .Center
    let fill: Color = Color {
        r: 1.0
        g: 1.0
        b: 1.0
        a: 1.0
    }
    let border: Color = Color {
        r: 0.0
        g: 0.0
        b: 0.0
        a: 0.0
    }
    let borderWidth: Float = 0.0
    // A gradient fill: `fill` is the colour at the near end, this is the colour
    // at the far end, and `gradient` says which way far runs. `None` leaves the
    // surface flat, which is what every surface that says nothing about it is.
    //
    // It is a property of the surface rather than a widget of its own, so a
    // gradient can be a background, a card, a bar or a swatch without any of
    // them being a different kind of view — and it costs the same ONE quad a
    // flat fill does.
    let fillEnd: Color = Color { a: 0.0 }
    let gradient: FoundationGradient = .None
    let radius: Float = 0.0
    // Optional background painted behind a HitArea (transparent = none). Buttons
    // use it for their default hover highlight without any layout wrapping.
    let backgroundFill: Color = Color {
        r: 0.0
        g: 0.0
        b: 0.0
        a: 0.0
    }
    let shape: FoundationShape = .RegularRoundedRect
    let material: FoundationMaterial = .Flat
    let effects: [FoundationEffect] = []
    let clipContent: Bool = false
    // This view exists to PAINT, not to size: it wraps content it draws behind
    // (a background, an overlay) and takes that content's size. Layout treats it
    // like any other frame; the flag is read by the layer that builds these
    // views, so a size stated AFTER a background reaches the content rather than
    // stopping at the wrapper the background put around it.
    let sizingProxy: Bool = false
    let content: String = ""
    let color: Color = Color {
        r: 0.08
        g: 0.08
        b: 0.10
        a: 1.0
    }
    let size: Float = 15.0
    // Visible run bounds relative to the text origin/baseline. Text leaves use
    // these so layout padding and stack gaps measure from ink to ink instead of
    // from the font's invisible advance/line box.
    let inkLeft: Float = 0.0
    let inkRight: Float = 0.0
    let inkTop: Float = 0.0
    let inkBottom: Float = 0.0
    // Retained for typography metadata and fallback layout when ink metrics are
    // unavailable. Visible ink wins whenever both ink bounds are present.
    let lineHeight: Float = 0.0
    let weight: Float = 400.0
    // Where this leaf's baseline sits, from its own top edge, for a row that
    // lines its children up on one. Text computes its own from the face; a glyph
    // is told where it wants to sit against the words beside it. Zero means the
    // leaf has none, and such a leaf hangs from its bottom edge.
    let baseline: Float = 0.0
    // A glyph's own width. Its ink is not square — a folder is wider than it is
    // tall — and the leaf is the ink, so the two sides are stated separately.
    // Zero means square, which is what a leaf that says nothing about it is.
    let iconWidth: Float = 0.0
    // How much heavier than drawn a GLYPH is, in points of outward growth. The
    // symbol library is drawn at one weight, so a hairline symbol beside
    // semibold words reads as a lighter object standing near them rather than as
    // a character in the same run.
    let weightGrowth: Float = 0.0
    let disabled: Bool = false
    let focusable: Bool = false
    // A focusable region that grabs the keyboard as soon as it appears while
    // nothing else is focused (e.g. an inline rename field). The runner adopts it
    // once, never stealing focus mid-edit — see foundationReconcileFocus.
    let autofocus: Bool = false
    let onPress: () -> Void = foundationNoopPress
    let onTextInput: (String) -> Void = foundationNoopTextInput
    let onTextCodepoint: (Int) -> Void = foundationNoopTextCodepoint
    let onBackspace: () -> Void = foundationNoopPress
    let onSubmit: () -> Void = foundationNoopPress
    // Navigation / editing keys for a focused field (arrows, home/end, forward
    // delete) — receives the keyCode of every key press EXCEPT Enter/Backspace,
    // which have their own callbacks. Lets a text field move its caret.
    let onKey: (Int) -> Void = foundationNoopTextCodepoint
    let onScroll: (Float, Float) -> Void = foundationNoopScroll
    // Whether this view is a window onto content taller than itself. The offset
    // is held per `key` and applied after placement — see FoundationScroll.kira.
    // How this view is being deformed while it is drawn — the swell of a press,
    // the lean of a pull, the squash of a throw. It carries down the SUBTREE, so
    // a pressed button takes its label with it.
    //
    // Drawing state, not geometry: layout has already run and does not see this,
    // which is what stops a press on a row reflowing the list it is in. The
    // default is the identity, and the renderer skips the whole transform when
    // every view on the path has one.
    let deform: MotionDeformation = MotionDeformation {}
    // The light a touch is energizing this surface with. Its centre is in the
    // view's OWN coordinates — the light comes from where the finger landed,
    // not from the middle of what was touched — and it travels through the same
    // deformation the surface does.
    //
    // One touch's light, because that is what it is: two fingers are two views
    // carrying two of these, and they add up where they overlap.
    let glow: MotionGlowState = MotionGlowState {}
    // The shape this surface is FUSING with, and how hard.
    //
    // Two liquid-glass shapes near each other are still two shapes. Give one of
    // them the other's rectangle here with a non-zero `morphBlend` and they stop
    // being two: the field between them dips below the surface and grows a neck,
    // and what is on screen is one body with a pinched waist. Nothing draws the
    // neck — it is what the smooth minimum of the two distance fields leaves
    // behind, evaluated per pixel.
    //
    // The rectangle is in the same coordinates layout works in, so it is
    // wherever the other shape actually is; the surface carrying this one is
    // what rasterizes both, so it is the one whose quad grows to cover them.
    // Twenty points of reach is the figure the reference implementation uses for
    // shapes that should read as one body — `motionMetaballBlend()`.
    let morph: MotionShape = MotionShape {}
    let morphBlend: Float = 0.0
    // How far this view is turned about its own centre, in RADIANS.
    //
    // Drawing state, like the deformation above: the view occupies the box
    // layout gave it whatever angle it is drawn at, so a turning chevron cannot
    // reflow the row it is in. That is also what makes it safe to animate — an
    // angle that changed the layout would re-resolve the tree every frame of the
    // turn.
    let rotation: Float = 0.0
    let scrolls: Bool = false
    // Whether a wheel turn over this region belongs to it. A row inside a list
    // is under the pointer too, and the list is what a wheel over the row
    // moves, so a region says whether the turn is its own rather than the
    // topmost region taking every one.
    let wheel: Bool = false
    let minLength: Float = 0.0
    let interaction: FoundationInteraction = FoundationInteraction {}
    // TextureView: the external KiraGraphics texture id to show (0 = none), and its
    // opacity. Kept as Int at the view layer; the backend converts to the U32 handle.
    let texture: Int = 0
    let textureOpacity: Float = 1.0
    // Optional second texture and GPU crossfade position. TextureView uses these
    // for transitions where downstream effects (notably LiquidGlass capture) must
    // see the already-blended image rather than two separately composited quads.
    let secondaryTexture: Int = 0
    let textureTransition: Float = 0.0
    // Text: derive the ink from what the backdrop capture holds under the run
    // instead of using `color`, so a label stays legible whatever it ends up over.
    // Only meaningful above a glass layer, which is what produces a capture.
    let adaptiveInk: Bool = false
    // LiquidGlass blur dial (0..1): how much of the blurred backdrop pyramid the
    // glass shows vs the sharp capture. 1 = the iOS search-pill look (fully
    // frosted), ~0 = the macOS dock look (crisp content, refraction + rims only).
    let blur: Float = 1.0
    // LiquidGlass: what the surface shades itself with. Defaults to the values the
    // material was tuned to, so a surface that names none looks unchanged.
    let glassMaterial: FoundationGlassMaterial = FoundationGlassMaterial {}
    // LiquidGlass white edge-refraction strength. 1 preserves the platform
    // default; lower values soften the hairline/bloom and higher values intensify
    // it without changing the glass shape, blur, tint, or lens displacement.
    let edgeRefraction: Float = 1.0
}


function foundationViewChildren(view: borrow FoundationView) -> [FoundationView] {
    return view.children
}

function foundationLayoutDescriptorWithFlex(layout: borrow LayoutDescriptor, flex: Int) -> LayoutDescriptor {
    return LayoutDescriptor {
        width: layout.width
        height: layout.height
        flex: flex
        arrange: layout.arrange
        axis: layout.axis
        spacing: layout.spacing
        rowSpacing: layout.rowSpacing
        alignment: layout.alignment
        overlayAlignment: layout.overlayAlignment
        columns: layout.columns
        padding: layout.padding
        margin: layout.margin
        x: layout.x
        y: layout.y
        zIndex: layout.zIndex
        clipContent: layout.clipContent
    }
}

// The baseline a view offers a row that lines its children up on one.
//
// A leaf answers for itself: a run of text from the face, a glyph from where it
// asked to sit. A WRAPPER answers with its child's, moved down by whatever it
// holds the child off its own top edge — a glyph does not stop being a glyph
// because something was hung on it, and `.onClick(...)`, a frame or a priority
// marker each wrap one. Without this a symbol with a handler on it falls out of
// the line and is aligned by its bottom edge instead, which is how the one
// pressable glyph on a bar ends up sitting lower than the words beside it.
function foundationViewBaseline(view: borrow FoundationView) -> Float {
    match view.kind {
        Text -> {
            return foundationTextBaseline(view.size, view.weight, foundationViewTextHeight(view))
        }
        Icon -> {
            return view.baseline
        }
        HitArea -> {
            return foundationWrappedBaseline(view)
        }
        Frame -> {
            return foundationWrappedBaseline(view)
        }
        LayoutPriority -> {
            return foundationWrappedBaseline(view)
        }
        // A ROW of things reports the deepest line among them: a breadcrumb is a
        // row, and the row it is placed in has to see the line its words are
        // written on rather than the box they came in.
        Row -> { return foundationDeepestBaseline(view) }
        Column -> { return foundationWrappedBaseline(view) }
        Expanded -> { return foundationWrappedBaseline(view) }
        Surface -> { return foundationWrappedBaseline(view) }
        // A spacer is as tall as whatever it is put in, so it has no line to
        // offer and must not be asked for one.
        Spacer -> { return 0.0 }
        TextureView -> { return 0.0 }
    }
}

// The deepest line among a view's children, moved down by whatever the view
// holds them off its own top edge.
function foundationDeepestBaseline(view: borrow FoundationView) -> Float {
    var deepest = 0.0
    for index in 0..view.children.count {
        let child = foundationViewBaseline(view.children[index])
        if child > deepest {
            deepest = child
        }
    }
    if deepest <= 0.0 {
        return 0.0
    }
    return deepest + view.padding.top
}

function foundationWrappedBaseline(view: borrow FoundationView) -> Float {
    if view.children.count == 0 {
        return view.baseline
    }
    return foundationDeepestBaseline(view)
}

// The box a run of text is laid out in: its line, never its letters.
function foundationViewTextHeight(view: borrow FoundationView) -> Float {
    if view.lineHeight > 0.0 {
        return view.lineHeight
    }
    return foundationTextMeasure(content: view.content, size: view.size, weight: view.weight).height
}

// How wide a glyph leaf is: its own width when it stated one, and otherwise the
// square a symbol that said nothing about its shape gets.
function foundationIconWidth(view: borrow FoundationView) -> Float {
    if view.iconWidth > 0.0 {
        return view.iconWidth
    }
    // The drawing's own width at this height, which is what the descriptor
    // above says an icon is: "as wide as its drawing is at that height".
    //
    // It returned `view.size` — a SQUARE — so every symbol laid out square
    // whatever it was, and a symbol is rasterized trimmed to its ink into
    // exactly the box it was given. A wide one was therefore squeezed into a
    // square quad and lost what did not fit: MonitorPlay's screen loses its
    // right edge, SlidersHorizontal loses the ends of both bars, and the ink
    // measures aspect 1.000 for all of them against references of 1.087, 1.185
    // and 1.200. `foundationIconInkAspect` is the number that was missing, and
    // it was already here.
    return view.size * foundationIconInkAspect(view.content)
}

function foundationViewLayoutDescriptor(view: borrow FoundationView) -> LayoutDescriptor {
    match view.kind {
        Row -> {
            return LayoutDescriptor {
                width: view.width
                height: view.height
                arrange: .Stack
                axis: .Horizontal
                spacing: view.gap
                alignment: view.crossAxisAlignment
                overlayAlignment: .Center
                baseline: foundationDeepestBaseline(view)
                padding: view.padding
                margin: EdgeInsets {}
            }
        }
        Column -> {
            return LayoutDescriptor {
                width: view.width
                height: view.height
                arrange: .Stack
                axis: .Vertical
                spacing: view.gap
                alignment: view.crossAxisAlignment
                overlayAlignment: .Center
                baseline: foundationWrappedBaseline(view)
                padding: view.padding
                margin: EdgeInsets {}
            }
        }
        Expanded -> {
            return LayoutDescriptor {
                width: .Fill
                height: .Fill
                flex: view.flex
                arrange: .Fill
                axis: .Vertical
                alignment: .Stretch
                overlayAlignment: .Center
                padding: EdgeInsets {}
                margin: EdgeInsets {}
            }
        }
        Frame -> {
            return LayoutDescriptor {
                width: view.width
                height: view.height
                flex: view.flex
                arrange: .Overlay
                axis: .Vertical
                alignment: .Stretch
                overlayAlignment: view.alignment
                baseline: foundationWrappedBaseline(view)
                padding: view.padding
                margin: EdgeInsets {}
            }
        }
        Spacer -> {
            // The size the SPACER was given, not `.Fill` regardless.
            //
            // `Spacer()` builds one that fills — that is what a spacer without
            // a size is — but a spacer handed `.Fixed(120)` is a hundred and
            // twenty points of gap, the way `Spacer().frame(width: 120)` is.
            // Forcing `.Fill` here made every authored size a lie: two of them
            // holding a panel at (120, 300) swallowed the leftover space
            // instead and put the panel in the bottom-right corner.
            let ignored = view.minLength
            return LayoutDescriptor {
                width: view.width
                height: view.height
                flex: view.flex
                arrange: .Fill
                axis: .Vertical
                alignment: .Stretch
                overlayAlignment: .Center
                padding: EdgeInsets {}
                margin: EdgeInsets {}
            }
        }
        Surface -> {
            // A surface fills itself with its content — except a SCROLLING one,
            // which is a window onto content measured at its own height. Filling
            // that content to the window is what would stop it ever overflowing,
            // and content that never overflows never scrolls.
            if view.scrolls {
                return LayoutDescriptor {
                    width: view.width
                    height: view.height
                    flex: view.flex
                    arrange: .Overlay
                    axis: .Vertical
                    alignment: .Stretch
                    overlayAlignment: .TopLeading
                    padding: view.padding
                    margin: EdgeInsets {}
                    clipContent: view.clipContent
                }
            }
            return LayoutDescriptor {
                width: view.width
                height: view.height
                flex: view.flex
                arrange: .Fill
                axis: .Vertical
                alignment: .Stretch
                overlayAlignment: .Center
                padding: view.padding
                margin: EdgeInsets {}
                clipContent: view.clipContent
            }
        }
        Text -> {
            let measured = foundationTextMeasure(content: view.content, size: view.size, weight: view.weight)
            var hasInk = false
            if view.inkRight > view.inkLeft && view.inkTop > 0.0 && view.inkBottom >= 0.0 {
                hasInk = true
            }
            var textWidth = measured.width
            if hasInk {
                textWidth = view.inkRight - view.inkLeft
            }
            // A run is as tall as its LINE, never as tall as its letters.
            //
            // Ink is a property of the letters: sized to it, "Name" and
            // "dragon.kmesh 0" come out different heights, so centring the two in
            // one row puts them on different baselines and the row reads as two
            // rows slightly out of step. It also moves a value the moment its
            // text changes — `1.000` becoming `-1.250` would shift on its own.
            // The line box is a property of the FONT, so every run at one size is
            // one height, and a glyph centred beside them lands in the same place
            // every frame.
            //
            // Ink still decides the WIDTH: horizontal ink is what a run occupies,
            // and trimming the side bearings is what lets a column of glyphs and
            // a column of text line up on their edges.
            var textHeight = measured.height
            if view.lineHeight > 0.0 {
                textHeight = view.lineHeight
            }
            return LayoutDescriptor {
                width: .Fixed(textWidth)
                height: .Fixed(textHeight)
                arrange: .Fill
                axis: .Vertical
                alignment: .Stretch
                overlayAlignment: .Center
                baseline: foundationTextBaseline(view.size, view.weight, textHeight)
                padding: EdgeInsets {}
                margin: EdgeInsets {}
            }
        }
        HitArea -> {
            // Honors the view's size modes (default Hug/Hug) so hit wrappers can
            // stretch with fill-width rows instead of collapsing around them —
            // and its PADDING, which is what a pressable box is made of: a
            // button is a label held off the edges of its own fill, and a hit
            // area that dropped the padding drew the fill tight around the
            // letters.
            return LayoutDescriptor {
                width: view.width
                height: view.height
                arrange: .Fill
                axis: .Vertical
                alignment: .Stretch
                overlayAlignment: .Center
                baseline: foundationWrappedBaseline(view)
                padding: view.padding
                margin: EdgeInsets {}
            }
        }
        TextureView -> {
            // A sized leaf: the texture stretches to whatever box the layout gives it
            // (Fixed / Fill via the width/height modes, flex-participating like Surface).
            return LayoutDescriptor {
                width: view.width
                height: view.height
                flex: view.flex
                arrange: .Fill
                axis: .Vertical
                alignment: .Stretch
                overlayAlignment: .Center
                padding: EdgeInsets {}
                margin: EdgeInsets {}
            }
        }
        Icon -> {
            // A fixed leaf, the size of the symbol's own ink: as tall as the band
            // it was asked to fill and as wide as its drawing is at that height.
            return LayoutDescriptor {
                width: .Fixed(foundationIconWidth(view))
                height: .Fixed(view.size)
                arrange: .Fill
                axis: .Vertical
                alignment: .Stretch
                overlayAlignment: .Center
                baseline: view.baseline
                padding: EdgeInsets {}
                margin: EdgeInsets {}
            }
        }
        LayoutPriority -> {
            if view.children.count == 0 {
                return LayoutDescriptor {
                    width: .Hug
                    height: .Hug
                    flex: view.flex
                    arrange: .Fill
                    axis: .Vertical
                    alignment: .Stretch
                    overlayAlignment: .Center
                    padding: EdgeInsets {}
                    margin: EdgeInsets {}
                }
            }
            return foundationLayoutDescriptorWithFlex(foundationViewLayoutDescriptor(view.children[0]), view.flex)
        }
    }
}
