import KiraLayout
// A leaf view showing an EXTERNAL KiraGraphics texture inside the UI layout — the editor
// viewport primitive: the engine renders its scene into an offscreen render-target texture
// and the UI composites that texture like any other view (layout-sized, clipped, batched).
//
// A primary texture is always supported. `secondaryTexture` enables an optional
// GPU crossfade; the blended result is what later LiquidGlass surfaces capture.
function TextureView(
    texture: Int,
    width: SizeMode,
    height: SizeMode,
    flex: Int,
    opacity: Float,
    radius: Float,
    secondaryTexture: Int = 0,
    transition: Float = 0.0,
) -> FoundationView {
    return FoundationView {
        kind: FoundationViewKind.TextureView
        width: width
        height: height
        flex: flex
        texture: texture
        textureOpacity: opacity
        secondaryTexture: secondaryTexture
        textureTransition: transition
        radius: radius
    }
}
