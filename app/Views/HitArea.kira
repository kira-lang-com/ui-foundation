function HitArea(onPress: () -> Void, children: [FoundationView], disabled: Bool) -> FoundationView {
    return FoundationView {
        kind: FoundationViewKind.HitArea
        disabled: disabled
        onPress: onPress
        children: move children
    }
}

function InteractiveHitArea(
    key: Int,
    focusable: Bool,
    disabled: Bool,
    onPress: () -> Void,
    onTextInput: (String) -> Void,
    onTextCodepoint: (Int) -> Void,
    onBackspace: () -> Void,
    onSubmit: () -> Void,
    onScroll: (Float, Float) -> Void,
    children: [FoundationView],
    interaction: FoundationInteraction = FoundationInteraction {},
) -> FoundationView {
    return FoundationView {
        kind: FoundationViewKind.HitArea
        key: key
        focusable: focusable
        disabled: disabled
        onPress: onPress
        onTextInput: onTextInput
        onTextCodepoint: onTextCodepoint
        onBackspace: onBackspace
        onSubmit: onSubmit
        onScroll: onScroll
        interaction: interaction
        children: move children
    }
}

// Convenience hit area for hover- and drag-driven widgets (buttons, sliders,
// draggable cards). Pointer/touch presses still fire `onPress`; the extended
// hover and drag callbacks travel in `interaction`.
function GestureHitArea(
    key: Int,
    disabled: Bool,
    onPress: () -> Void,
    interaction: FoundationInteraction,
    children: [FoundationView],
) -> FoundationView {
    return FoundationView {
        kind: FoundationViewKind.HitArea
        key: key
        focusable: false
        disabled: disabled
        onPress: onPress
        interaction: interaction
        children: move children
    }
}
