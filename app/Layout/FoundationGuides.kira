import Foundation
import KiraLayout

// Resolving alignment guides.
//
// A guide travels the opposite way from everything else in the view tree.
// Themes, sizes and inks are handed DOWN from a parent; a guide is published by
// a descendant and read by something enclosing it — "where does the content of
// this row actually begin?" — and the honest answer lives with whatever draws
// the content, not with the container that has to line up against it.
//
// It runs AFTER placement, and it can, because of what consumes it. A separator
// inset does not change what the separator occupies, only what it paints, so
// adjusting the consumer's resolved frame is the whole operation: nothing it is
// stacked with moves, and no second measure/place pass is needed. A guide that
// changed a size would need one; none of them do.
//
// SCOPE is by order, among siblings. A publication applies to every consumer
// that comes after it under the same parent, at any depth beneath that sibling.
// That is what makes "the hairline under this row starts at this row's label"
// work without the row and the hairline having to know about each other: the row
// publishes, the separator that follows reads.

// The published guides in effect at a point in the walk, newest answer per tag.
struct FoundationGuideScope {
    var tags: [Int] = []
    var values: [Float] = []
}

function foundationGuideScopePut(scope: borrow mut FoundationGuideScope, tag: Int, value: Float) {
    var out = scope
        for index in 0..out.tags.count {
        if out.tags[index] == tag {
            out.values[index] = value
            return
        }
            }
    out.tags.append(tag)
    out.values.append(value)
    return
}

// The answer for `tag`, or `fallback` when nothing published one.
function foundationGuideScopeValue(scope: borrow FoundationGuideScope, tag: Int, fallback: Float) -> Float {
        for index in 0..scope.tags.count {
        if scope.tags[index] == tag {
            return scope.values[index]
        }
            }
    return fallback
}

// Resolve every guide in the tree and inset the views that read one.
function foundationResolveGuides(root: borrow FoundationView, tree: borrow mut LayoutTree) {
    var scope = FoundationGuideScope {}
    foundationResolveGuidesIn(root, tree, 0, scope)
    return
}

// Walk one view. `scope` carries the publications this view may read, and
// collects the ones it makes for the siblings that follow it.
function foundationResolveGuidesIn(
    view: borrow FoundationView,
    tree: borrow mut LayoutTree,
    nodeIndex: Int,
    scope: borrow mut FoundationGuideScope,
) {
    var t = tree
    var visible = scope
    let frame = layoutFrame(t, nodeIndex)

    // What this view publishes is measured against its own resolved size, then
    // carried in the root's coordinates so anything enclosing it can use the
    // answer without knowing where the publisher sits.
        for published in 0..view.guides.count {
        let publication = view.guides[published]
        if publication.tag != 0 {
            let resolve = publication.resolve
            foundationGuideScopePut(visible, publication.tag, frame.x + resolve(frame.width, frame.height))
        }
            }

    // What it reads. A guide names an absolute position, so the leading edge
    // moves to it and the width closes the difference; a missing answer leaves
    // the edge where layout put it.
    if view.guideLeading != 0 || view.guideTrailing != 0 {
        let leading = foundationGuideScopeValue(visible, view.guideLeading, frame.x)
        let trailing = foundationGuideScopeValue(visible, view.guideTrailing, frame.x + frame.width)
        var width = trailing - leading
        if width < 0.0 {
            width = 0.0
        }
        t.nodes[nodeIndex].originX = leading
        t.nodes[nodeIndex].measuredW = width
    }

    // Children are walked in order and share ONE scope, which is what makes a
    // publication apply to the siblings after it and not to the ones before.
    let firstChild = t.nodes[nodeIndex].firstChild
        for childOffset in 0..view.children.count {
        foundationResolveGuidesIn(view.children[childOffset], t, firstChild + childOffset, visible)
            }
    return
}
