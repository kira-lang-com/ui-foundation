// Append one flattened node plus its descriptor, keeping `nodes` and
// `descriptors` index-aligned. The descriptor is flattened into the node's
// inline scalars here (once) and then retained in the parallel `descriptors`
// array — it never rides on `LayoutNode`, so the engine's per-node binds on the
// resize hot path stay descriptor-free.
function foundationLayoutAppendNode(nodes: borrow mut [LayoutNode], descriptors: borrow mut [LayoutDescriptor], desc: LayoutDescriptor, firstChild: Int, childCount: Int) {
    var outNodes = nodes
    var outDescs = descriptors
    let node = layoutNodeFlattenDescriptor(LayoutNode {
        firstChild: firstChild
        childCount: childCount
    }, desc)
    outNodes.append(move node)
    outDescs.append(move desc)
    return
}

function foundationLayoutAppendRoot(view: borrow FoundationView, nodes: borrow mut [LayoutNode], descriptors: borrow mut [LayoutDescriptor]) {
    var outNodes = nodes
    var outDescs = descriptors
    let parentIndex = outNodes.count
    foundationLayoutAppendNode(outNodes, outDescs, foundationViewLayoutDescriptor(view), view.children.count > 0 ? parentIndex + 1 : 0, view.children.count)

    var childOffset = 0
    while childOffset < view.children.count {
        foundationLayoutAppendNode(outNodes, outDescs, foundationViewLayoutDescriptor(view.children[childOffset]), 0, view.children[childOffset].children.count)
        childOffset = childOffset + 1
    }

    var childIndex = parentIndex + 1
    childOffset = 0
    while childOffset < view.children.count {
        foundationLayoutAppendDescendants(view.children[childOffset], childIndex, outNodes, outDescs)
        childIndex = childIndex + 1
        childOffset = childOffset + 1
    }
    return
}

function foundationLayoutAppendDescendants(view: borrow FoundationView, nodeIndex: Int, nodes: borrow mut [LayoutNode], descriptors: borrow mut [LayoutDescriptor]) {
    var outNodes = nodes
    var outDescs = descriptors
    let firstChild = outNodes.count

    var childOffset = 0
    while childOffset < view.children.count {
        foundationLayoutAppendNode(outNodes, outDescs, foundationViewLayoutDescriptor(view.children[childOffset]), 0, view.children[childOffset].children.count)
        childOffset = childOffset + 1
    }

    if view.children.count > 0 {
        // firstChild / childCount are structural, not descriptor-derived, so the
        // already-flattened parent node only needs these two scalars patched in
        // place — no re-flatten (and no descriptor) required.
        outNodes[nodeIndex].firstChild = firstChild
        outNodes[nodeIndex].childCount = view.children.count

        var childIndex = firstChild
        childOffset = 0
        while childOffset < view.children.count {
            foundationLayoutAppendDescendants(view.children[childOffset], childIndex, outNodes, outDescs)
            childIndex = childIndex + 1
            childOffset = childOffset + 1
        }
    }

    return
}

class FoundationLayoutPass {
    let engine: LayoutEngine = LayoutEngine {}

    function run(root: borrow FoundationView, available: borrow Size) -> LayoutTree {
        var tree = collect(root)
        tree = layoutResetCounters(move tree)
        engine.measure(tree: tree, index: 0, available: available)
        engine.place(tree: tree, index: 0, origin: Point {})
        // The cached measure/place state is now valid for every node, so a later
        // retained re-layout (relayout) can reuse the geometry of any subtree whose
        // offer and origin are unchanged instead of recomputing the whole tree.
        tree = layoutMarkAllClean(move tree)
        return tree
    }

    // Incremental, retained layout. Reuses the previous frame's laid-out tree
    // when the view structure is unchanged: it patches only the descriptors that
    // actually changed, marks exactly those nodes (and their ancestors) dirty,
    // and lets the engine reuse cached geometry for every untouched subtree. A
    // structural change (added/removed/reordered nodes) falls back to a full
    // rebuild. The result is identical geometry to `run` but with the engine's
    // measure/place skip counters reflecting the avoided work.
    function runIncremental(root: borrow FoundationView, available: borrow Size, cached: LayoutTree) -> LayoutTree {
        var fresh = collect(root)
        if !layoutStructureMatches(fresh, cached) {
            fresh = layoutResetCounters(move fresh)
            engine.measure(tree: fresh, index: 0, available: available)
            engine.place(tree: fresh, index: 0, origin: Point {})
            return fresh
        }

        var result = cached
        var changed: [Bool] = []
        var index = 0
        while index < result.nodes.count {
            let same = layoutDescriptorEqual(result.descriptors[index], fresh.descriptors[index])
            changed.append(!same)
            result.descriptors[index] = fresh.descriptors[index]
            result.nodes[index] = layoutNodeFlattenDescriptor(result.nodes[index], result.descriptors[index])
            index = index + 1
        }
        result = layoutPropagateDirty(move result, changed)
        result = layoutResetCounters(move result)
        engine.measure(tree: result, index: 0, available: available)
        engine.place(tree: result, index: 0, origin: Point {})
        return result
    }

    function collect(root: borrow FoundationView) -> LayoutTree {
        var nodes: [LayoutNode] = []
        var descriptors: [LayoutDescriptor] = []
        foundationLayoutAppendRoot(root, nodes, descriptors)
        return LayoutTree {
            nodes: move nodes
            descriptors: move descriptors
        }
    }

    // Re-resolve geometry for an already-built tree against a new available size,
    // in place. Used for the resize path: the view tree (and therefore the tree's
    // structure and every descriptor) is unchanged, only the offered size differs,
    // so there is no need to rebuild the node list (`collect`) or compare/patch
    // descriptors — just re-measure and re-place. The engine's offer-based skip
    // keeps subtrees whose resolved constraints did not change, so a resize touches
    // only the nodes that actually move. Geometry is identical to a from-scratch
    // `run` at the same viewport (guarded by FoundationResizeLayoutSmoke); the win
    // is avoiding the full fresh `[LayoutNode]` allocation and the tree copy every
    // resize frame.
    function relayout(tree: LayoutTree, available: borrow Size) -> LayoutTree {
        var t = tree
        t.measureComputes = 0
        t.measureSkips = 0
        t.placeComputes = 0
        t.placeSkips = 0
        engine.measure(tree: t, index: 0, available: available)
        engine.place(tree: t, index: 0, origin: Point {})
        return t
    }

}
