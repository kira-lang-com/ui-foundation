import Foundation
import KiraGraphics
// Building the compositor: every pipeline the batch can draw with, created once.
//
// The generic pipeline compiled from `Shaders/UiBatch.ksl` is the one that can
// render every mode, and it is what runs on every backend. Beside it sit the four
// glass region pipelines and the Metal-only specializations, each of which draws
// a subset faster. Any of them failing to build is survivable: the draw path falls
// back to the generic pipeline, so a backend that cannot build one degrades in
// cost rather than in what it can show.

// Create the compositor's persistent GPU resources and font, store the state behind a
// nativeState handle, and return that handle.
@Native
function uiBatchCreate(graphics: borrow Graphics) -> RawPtr {
    var state = UiBatchState {
        engine: uiNullPtr()
        face: uiNullPtr()
        contentsPtr: uiNullPtr()
    }

    // The compositor's shader is written in KSL (Shaders/UiBatch.ksl) and
    // compiled at BUILD time by `ksl!`, which hands back every backend's source
    // inline. Editing the `.ksl` is what changes the pipeline, and every backend
    // gets the same shader from the same file — this is not Metal-only.
    //
    // Each of these artifacts used to be a pasted string holding the MSL and
    // WGSL this call now produces. The paste compiled, so nothing failed when
    // the `.ksl` and the string disagreed; a shader bug fixed in the readable
    // file simply did not reach the GPU.
    let batchArtifact = ksl!("Shaders/UiBatch.ksl")
    let shader = graphics.createShaderFromKslArtifact(
        "kira-ui-batch",
        batchArtifact.combinedMsl,
        batchArtifact.vertexWgsl,
        batchArtifact.fragmentWgsl,
        batchArtifact.vertexGlsl,
        batchArtifact.fragmentGlsl,
        batchArtifact.vertexEntry,
        batchArtifact.fragmentEntry,
        batchArtifact.uniformReflection
    )
    let pipeline = graphics.createRenderPipeline(RenderPipelineDescriptor {
        label: "kira-ui-batch-pipeline"
        shader: shader
        // Taken from the artifact rather than written here: the pipeline looks
        // its functions up BY NAME, and a name that does not match what the
        // backend emitted leaves the descriptor with a nil vertex function,
        // which Metal rejects at validation.
        vertexEntry: batchArtifact.vertexEntry
        fragmentEntry: batchArtifact.fragmentEntry
        // Empty: the vertex stage pulls from a storage buffer by vertex index
        // rather than taking `[[stage_in]]` attributes, so there is no layout to
        // describe.
        vertexLayout: VertexLayout {
            stride: 0
            attributes: []
        }
        colorTargets: [
            ColorTargetDescriptor {
                format: textureFormatSwapchain()
                blend: BlendState {
                    enabled: true
                    preset: blendPresetPremultipliedAlpha()
                }
            }
        ]
        depthStencil: DepthStencilDescriptor {
            depthEnabled: false
            depthWriteEnabled: false
            depthCompare: compareFunctionAlways()
            format: textureFormatDepth24Stencil8()
        }
        rasterization: RasterizationDescriptor {
            cullMode: cullModeNone()
            frontFace: frontFaceCounterClockwise()
        }
        primitive: PrimitiveDescriptor {
            topology: primitiveTopologyTriangleList()
        }
    })
    state.pipelineId = pipeline.id

    // Glass region pipelines, from the same KSL toolchain as the generic one —
    // every backend gets them. Their draw path falls back to the generic
    // pipeline (whose glass branch renders any glass mode correctly) if either
    // is missing, so a backend that fails to build one degrades to today's
    // behavior rather than to missing glass.
    let glassArtifact = ksl!("Shaders/UiGlassFull.ksl")
    let glassShader = graphics.createShaderFromKslArtifact(
        "kira-ui-glass-full",
        glassArtifact.combinedMsl,
        glassArtifact.vertexWgsl,
        glassArtifact.fragmentWgsl,
        glassArtifact.vertexGlsl,
        glassArtifact.fragmentGlsl,
        glassArtifact.vertexEntry,
        glassArtifact.fragmentEntry,
        glassArtifact.uniformReflection
    )
    let glassPipeline = graphics.createRenderPipeline(RenderPipelineDescriptor {
        label: "kira-ui-glass-full-pipeline"
        shader: glassShader
        vertexEntry: glassArtifact.vertexEntry
        fragmentEntry: glassArtifact.fragmentEntry
        vertexLayout: VertexLayout {
            stride: 0
            attributes: []
        }
        colorTargets: [
            ColorTargetDescriptor {
                format: textureFormatSwapchain()
                blend: BlendState {
                    enabled: true
                    preset: blendPresetPremultipliedAlpha()
                }
            }
        ]
        depthStencil: DepthStencilDescriptor {
            depthEnabled: false
            depthWriteEnabled: false
            depthCompare: compareFunctionAlways()
            format: textureFormatDepth24Stencil8()
        }
        rasterization: RasterizationDescriptor {
            cullMode: cullModeNone()
            frontFace: frontFaceCounterClockwise()
        }
        primitive: PrimitiveDescriptor {
            topology: primitiveTopologyTriangleList()
        }
    })
    state.glassFullPipelineId = glassPipeline.id
    let bandArtifact = ksl!("Shaders/UiGlassBand.ksl")
    let bandShader = graphics.createShaderFromKslArtifact(
        "kira-ui-glass-band",
        bandArtifact.combinedMsl,
        bandArtifact.vertexWgsl,
        bandArtifact.fragmentWgsl,
        bandArtifact.vertexGlsl,
        bandArtifact.fragmentGlsl,
        bandArtifact.vertexEntry,
        bandArtifact.fragmentEntry,
        bandArtifact.uniformReflection
    )
    let bandPipeline = graphics.createRenderPipeline(RenderPipelineDescriptor {
        label: "kira-ui-glass-band-pipeline"
        shader: bandShader
        vertexEntry: bandArtifact.vertexEntry
        fragmentEntry: bandArtifact.fragmentEntry
        vertexLayout: VertexLayout {
            stride: 0
            attributes: []
        }
        colorTargets: [
            ColorTargetDescriptor {
                format: textureFormatSwapchain()
                blend: BlendState {
                    // The interior is opaque (alpha exactly 1), and an
                    // opaque replace lets the tiler eliminate every
                    // fragment beneath it instead of shading and
                    // blending over them. Same output as premultiplied
                    // over at alpha 1, measured cheaper.
                    enabled: false
                    preset: blendPresetReplace()
                }
            }
        ]
        depthStencil: DepthStencilDescriptor {
            depthEnabled: false
            depthWriteEnabled: false
            depthCompare: compareFunctionAlways()
            format: textureFormatDepth24Stencil8()
        }
        rasterization: RasterizationDescriptor {
            cullMode: cullModeNone()
            frontFace: frontFaceCounterClockwise()
        }
        primitive: PrimitiveDescriptor {
            topology: primitiveTopologyTriangleList()
        }
    })
    state.glassBandPipelineId = bandPipeline.id
    let coreArtifact = ksl!("Shaders/UiGlassCore.ksl")
    let coreShader = graphics.createShaderFromKslArtifact(
        "kira-ui-glass-core",
        coreArtifact.combinedMsl,
        coreArtifact.vertexWgsl,
        coreArtifact.fragmentWgsl,
        coreArtifact.vertexGlsl,
        coreArtifact.fragmentGlsl,
        coreArtifact.vertexEntry,
        coreArtifact.fragmentEntry,
        coreArtifact.uniformReflection
    )
    let corePipeline = graphics.createRenderPipeline(RenderPipelineDescriptor {
        label: "kira-ui-glass-core-pipeline"
        shader: coreShader
        vertexEntry: coreArtifact.vertexEntry
        fragmentEntry: coreArtifact.fragmentEntry
        vertexLayout: VertexLayout {
            stride: 0
            attributes: []
        }
        colorTargets: [
            ColorTargetDescriptor {
                format: textureFormatSwapchain()
                blend: BlendState {
                    // The interior is opaque (alpha exactly 1), and an
                    // opaque replace lets the tiler eliminate every
                    // fragment beneath it instead of shading and
                    // blending over them. Same output as premultiplied
                    // over at alpha 1, measured cheaper.
                    enabled: false
                    preset: blendPresetReplace()
                }
            }
        ]
        depthStencil: DepthStencilDescriptor {
            depthEnabled: false
            depthWriteEnabled: false
            depthCompare: compareFunctionAlways()
            format: textureFormatDepth24Stencil8()
        }
        rasterization: RasterizationDescriptor {
            cullMode: cullModeNone()
            frontFace: frontFaceCounterClockwise()
        }
        primitive: PrimitiveDescriptor {
            topology: primitiveTopologyTriangleList()
        }
    })
    state.glassCorePipelineId = corePipeline.id
    let lensArtifact = ksl!("Shaders/UiGlassLens.ksl")
    let lensShader = graphics.createShaderFromKslArtifact(
        "kira-ui-glass-lens",
        lensArtifact.combinedMsl,
        lensArtifact.vertexWgsl,
        lensArtifact.fragmentWgsl,
        lensArtifact.vertexGlsl,
        lensArtifact.fragmentGlsl,
        lensArtifact.vertexEntry,
        lensArtifact.fragmentEntry,
        lensArtifact.uniformReflection
    )
    let lensPipeline = graphics.createRenderPipeline(RenderPipelineDescriptor {
        label: "kira-ui-glass-lens-pipeline"
        shader: lensShader
        vertexEntry: lensArtifact.vertexEntry
        fragmentEntry: lensArtifact.fragmentEntry
        vertexLayout: VertexLayout {
            stride: 0
            attributes: []
        }
        colorTargets: [
            ColorTargetDescriptor {
                format: textureFormatSwapchain()
                blend: BlendState {
                    // The interior is opaque (alpha exactly 1), and an
                    // opaque replace lets the tiler eliminate every
                    // fragment beneath it instead of shading and
                    // blending over them. Same output as premultiplied
                    // over at alpha 1, measured cheaper.
                    enabled: false
                    preset: blendPresetReplace()
                }
            }
        ]
        depthStencil: DepthStencilDescriptor {
            depthEnabled: false
            depthWriteEnabled: false
            depthCompare: compareFunctionAlways()
            format: textureFormatDepth24Stencil8()
        }
        rasterization: RasterizationDescriptor {
            cullMode: cullModeNone()
            frontFace: frontFaceCounterClockwise()
        }
        primitive: PrimitiveDescriptor {
            topology: primitiveTopologyTriangleList()
        }
    })
    state.glassLensPipelineId = lensPipeline.id
    let copyArtifact = ksl!("Shaders/UiGlassCopy.ksl")
    let copyShader = graphics.createShaderFromKslArtifact(
        "kira-ui-glass-copy",
        copyArtifact.combinedMsl,
        copyArtifact.vertexWgsl,
        copyArtifact.fragmentWgsl,
        copyArtifact.vertexGlsl,
        copyArtifact.fragmentGlsl,
        copyArtifact.vertexEntry,
        copyArtifact.fragmentEntry,
        copyArtifact.uniformReflection
    )
    let copyPipeline = graphics.createRenderPipeline(RenderPipelineDescriptor {
        label: "kira-ui-glass-copy-pipeline"
        shader: copyShader
        vertexEntry: copyArtifact.vertexEntry
        fragmentEntry: copyArtifact.fragmentEntry
        vertexLayout: VertexLayout {
            stride: 0
            attributes: []
        }
        colorTargets: [
            ColorTargetDescriptor {
                format: textureFormatSwapchain()
                blend: BlendState {
                    enabled: false
                    preset: blendPresetReplace()
                }
            }
        ]
        depthStencil: DepthStencilDescriptor {
            depthEnabled: false
            depthWriteEnabled: false
            depthCompare: compareFunctionAlways()
            format: textureFormatDepth24Stencil8()
        }
        rasterization: RasterizationDescriptor {
            cullMode: cullModeNone()
            frontFace: frontFaceCounterClockwise()
        }
        primitive: PrimitiveDescriptor {
            topology: primitiveTopologyTriangleList()
        }
    })
    state.glassCopyPipelineId = copyPipeline.id

    if graphics.backend == GraphicsBackend.Metal && !uiPtrIsNull(metalGetEnv("KIRA_UI_SPECIALIZED_RUNS")) {
        state.rectPipelineId = uiCreateSpecializedPipeline(graphics, "kira-ui-rect-fast", ksl!("Shaders/UiRect.ksl"))
        state.glyphPipelineId = uiCreateSpecializedPipeline(graphics, "kira-ui-glyph-fast", ksl!("Shaders/UiGlyph.ksl"))
        // Adaptive glyphs sit immediately after their glass surface. Keeping both
        // on the generic pipeline merges each island into one ordered range; a
        // separate adaptive pipeline costs more switches than it saves. That is
        // why there is no `Shaders/UiAdaptiveGlyph.ksl` — a shader nothing
        // compiles is a shader that rots.
        state.adaptiveGlyphPipelineId = 0
    }

    // This compositor is instantiated only by the Metal Foundation backend. The
    // public/Sokol TextureView implementation remains unchanged, and any texture
    // that does not satisfy the opaque-fullscreen gate below uses `pipelineId`.
    let backgroundArtifact = ksl!("Shaders/UiBackground.ksl")
    let backgroundShader = graphics.createShaderFromKslArtifact(
        "kira-ui-opaque-background",
        backgroundArtifact.combinedMsl,
        backgroundArtifact.vertexWgsl,
        backgroundArtifact.fragmentWgsl,
        backgroundArtifact.vertexGlsl,
        backgroundArtifact.fragmentGlsl,
        backgroundArtifact.vertexEntry,
        backgroundArtifact.fragmentEntry,
        backgroundArtifact.uniformReflection
    )
    let backgroundPipeline = graphics.createRenderPipeline(RenderPipelineDescriptor {
        label: "kira-ui-opaque-background-pipeline"
        shader: backgroundShader
        vertexEntry: backgroundArtifact.vertexEntry
        fragmentEntry: backgroundArtifact.fragmentEntry
        vertexLayout: VertexLayout { stride: 0 attributes: [] }
        colorTargets: [
            ColorTargetDescriptor {
                format: textureFormatSwapchain()
                blend: BlendState { enabled: false preset: blendPresetReplace() }
            }
        ]
        depthStencil: DepthStencilDescriptor {
            depthEnabled: false
            depthWriteEnabled: false
            depthCompare: compareFunctionAlways()
            format: textureFormatDepth24Stencil8()
        }
        rasterization: RasterizationDescriptor {
            cullMode: cullModeNone()
            frontFace: frontFaceCounterClockwise()
        }
        primitive: PrimitiveDescriptor { topology: primitiveTopologyTriangleList() }
    })
    state.backgroundPipelineId = backgroundPipeline.id
    let backgroundParams = graphics.createDynamicBuffer(4)
    state.backgroundParamsBufferId = backgroundParams.id
    state.backgroundParamsGroupId = graphics.createBufferBindGroup("kira-ui-opaque-background-params", uiSlotBackgroundParams(), Int(backgroundParams.id)).id

    let floatCapacity = uiBatchStreamFloatCapacity()
    let vbuf = graphics.createDynamicBuffer(floatCapacity)
    state.vertexBufferId = vbuf.id
    state.contentsPtr = graphics.dynamicBufferContents(vbuf)
    state.streams.append(UiStream {
        bufferId: vbuf.id
        contentsPtr: state.contentsPtr
        vertsGroupId: graphics.createBufferBindGroup("kira-ui-verts", uiSlotVerts(), Int(vbuf.id)).id
        quadModes: uiBatchIntZeros(uiBatchCapacityQuads())
    })

    // Second stream: the first glass layer. Allocated up front so the common
    // single-layer glass frame never allocates mid-frame; layers beyond this one
    // allocate on the first frame that stacks glass (uiBatchOpenStream).
    let vbuf2 = graphics.createDynamicBuffer(floatCapacity)
    state.streams.append(UiStream {
        bufferId: vbuf2.id
        contentsPtr: graphics.dynamicBufferContents(vbuf2)
        vertsGroupId: graphics.createBufferBindGroup("kira-ui-verts", uiSlotVerts(), Int(vbuf2.id)).id
        quadModes: uiBatchIntZeros(uiBatchCapacityQuads())
    })

    // The rest of the stream slots — the deeper glass layers and the HUD's own —
    // exist as placeholders from the start so every slot has a FIXED index. The HUD
    // is at uiBatchHudStream() whether or not glass ever stacks that deep, which is
    // what lets a HUD refresh address its stream without disturbing the layers.
    while state.streams.count < uiBatchStreamSlots() {
        state.streams.append(uiBatchPlaceholderStream())
    }

    state.glassGrid = uiBatchIntZeros(uiGlassGridCells())

    let ibuf = graphics.createIndexBuffer(IndexBufferDescriptor {
        label: "kira-ui-batch-indices"
        usage: bufferUsageIndex()
        data: uiBatchQuadIndices(uiBatchCapacityQuads())
    })
    state.indexBufferId = ibuf.id

    let atlasSize = uiBatchAtlasSize()
    let atlas = graphics.createTexture(TextureDescriptor {
        label: "kira-ui-glyph-atlas"
        width: atlasSize
        height: atlasSize
        format: textureFormatRgba8Unorm()
        usage: textureUsageSampled()
        sampleCount: 1
        storageMode: 0
    })
    state.atlasTextureId = atlas.id
    state.atlasW = atlasSize
    state.atlasH = atlasSize
    state.cursorX = uiAtlasGutter()
    state.cursorY = uiAtlasGutter()
    state.rowHeight = 0

    let sampler = graphics.createSampler(SamplerDescriptor {
        label: "kira-ui-glyph-sampler"
        minFilter: textureFilterLinear()
        magFilter: textureFilterLinear()
        addressModeU: textureAddressModeClampToEdge()
        addressModeV: textureAddressModeClampToEdge()
    })
    state.samplerId = sampler.id

    let bindGroup = graphics.beginBindGroup("kira-ui-batch-atlas")
    graphics.bindGroupAddTexture(bindGroup, uiSlotAtlasTexture(), atlas)
    graphics.bindGroupAddSampler(bindGroup, uiSlotAtlasSampler(), sampler)
    state.bindGroupId = bindGroup.id

    // The external-texture fallback: the shader always declares that slot, and
    // until a TextureView registers a real texture the atlas satisfies it (mode-2
    // quads are only emitted once one has).
    let fallbackExternal = graphics.beginBindGroup("kira-ui-batch-external-fallback")
    graphics.bindGroupAddTexture(fallbackExternal, uiSlotExternalTexture(), atlas)
    graphics.bindGroupAddSampler(fallbackExternal, uiSlotExternalSampler(), sampler)
    state.fallbackExternalBindGroupId = fallbackExternal.id

    // Same discipline for the two blurred levels, which share one group: a frame
    // with no glass keeps both satisfied by the atlas.
    let fallbackSoftNear = graphics.beginBindGroup("kira-ui-batch-soft-near-fallback")
    graphics.bindGroupAddTexture(fallbackSoftNear, uiSlotBackdropTexture(), atlas)
    graphics.bindGroupAddSampler(fallbackSoftNear, uiSlotBackdropSampler(), sampler)
    graphics.bindGroupAddTexture(fallbackSoftNear, uiSlotNearTexture(), atlas)
    graphics.bindGroupAddSampler(fallbackSoftNear, uiSlotNearSampler(), sampler)
    state.fallbackBackdropBindGroupId = fallbackSoftNear.id

    var cacheKeySeed: [Float] = []
    while cacheKeySeed.count < uiGlassCacheMaxSurfaces() * uiGlassCacheKeyFloats() {
        cacheKeySeed.append(0.0)
    }
    state.glassCacheKeys = cacheKeySeed
    state.glassCacheKeySet = uiBatchIntZeros(uiGlassCacheMaxSurfaces())
    state.glyphHashKeys = uiBatchIntZeros(uiBatchGlyphHashCap())
    state.glyphHashVals = uiBatchIntZeros(uiBatchGlyphHashCap())

    state.probeQuads = !uiPtrIsNull(metalGetEnv("KIRA_UI_QUAD_PROBE"))
    state.probeCost = !uiPtrIsNull(metalGetEnv("KIRA_UI_COST_PROBE"))
    state.probeModes = !uiPtrIsNull(metalGetEnv("KIRA_UI_MODE_PROBE"))
    state.probeBatch = !uiPtrIsNull(metalGetEnv("KIRA_UI_BATCH_PROBE"))
    state.probeGlassLayers = !uiPtrIsNull(metalGetEnv("KIRA_GLASS_LAYERS"))
    state.probeGlassLayerOpen = !uiPtrIsNull(metalGetEnv("KIRA_GLASS_LAYER_PROBE"))
    state.benchFinalOnly = !uiPtrIsNull(metalGetEnv("KIRA_GLASS_BENCH_FINAL_ONLY"))
    state.benchBackgroundOnly = !uiPtrIsNull(metalGetEnv("KIRA_GLASS_BENCH_BACKGROUND_ONLY"))
    state.benchNoBackground = !uiPtrIsNull(metalGetEnv("KIRA_GLASS_BENCH_NO_BACKGROUND"))
    state.glassCacheDisabled = !uiPtrIsNull(metalGetEnv("KIRA_GLASS_CACHE_OFF"))
    state.referenceBlur = !uiPtrIsNull(metalGetEnv("KIRA_GLASS_REFERENCE"))

    uiBatchStateLoadFont(state)

    let storage = nativeState(state)
    return nativeUserData(storage)
}

