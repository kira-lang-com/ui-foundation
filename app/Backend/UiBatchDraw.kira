import Foundation
import KiraGraphics
// Submitting the frame: one indexed draw per stream, the fullscreen background
// under them, the HUD stream over them, and the pass structure that orders the
// whole thing.
//
// Everything the compositor accumulated during the frame is a range of quads in a
// stream. Drawing is therefore mostly bind-and-issue: pick the pipeline the range's
// modes allow, bind the three texture slots that pipeline reads, and draw. The
// specialized pipelines are chosen here, and the generic one is what runs when a
// range's modes do not all fit one of them.

// Bind the batch pipeline + a vertex stream + the three texture slots and issue one
// indexed draw. Slot assignments:
//  - slot 0: always the glyph/icon atlas.
//  - slot 1: `slot1GroupId`; 0 means the frame's external texture (TextureView) or
//    the atlas fallback. Glass streams pass the sharp tap here.
//  - slot 2: `slot2GroupId`; 0 means the atlas fallback, which keeps
//    texture(2)/sampler(2) satisfied on streams that hold no glass.
//  - slot 3: `slot3GroupId`, the near blur level, same fallback discipline.
extend UiBatch {
    function drawStream(encoder: borrow mut RenderEncoder, modeStream: Int, quadCount: Int, slot1Group: borrow BindGroup, slot2Group: borrow BindGroup, slot3Group: borrow BindGroup) {
        var state = nativeRecover<UiBatchState>(self.storage)
        if quadCount <= 0 || modeStream < 0 || modeStream >= state.streams.count {
            return
        }
        // The stream's vertices are already in its buffer — written into shared
        // memory as they were emitted on Metal, handed over by
        // `commitDynamicBuffer` on sokol — so there is nothing to upload here.
        let bindGroup = state.atlasGroup
        // Caveat on the glass streams' external slot: a TextureView ABOVE a glass plane
        // samples the sharp capture instead of its own texture; below-glass
        // TextureViews (the common case) draw in stream 0 and are fine.
        var externalGroup = slot1Group
        if externalGroup.id == 0 {
            externalGroup = state.fallbackExternalGroup
            if state.externalBindReady {
                externalGroup = state.externalGroup
            }
        }
        // The two blurred levels arrive together, so slot3Group is only consulted as
        // the layer's combined group when the caller has one.
        var softNearGroup = slot2Group
        if softNearGroup.id == 0 {
            softNearGroup = slot3Group
        }
        if softNearGroup.id == 0 {
            if state.secondaryExternalBindReady {
                softNearGroup = state.secondaryExternalGroup
            } else {
                softNearGroup = state.fallbackBackdropGroup
            }
        }
        // The vertex data is a STORAGE resource in the shader, not an attribute
        // stream: it binds through a group like every other resource, and the vertex
        // stage reads it one slot above (vertex buffer 0 is the attribute stream that
        // this shader does not have).
        let vertsGroup = state.streams[modeStream].vertsGroup
        encoder.setIndexBuffer(state.indexBuffer, .Uint32)
        encoder.setBindGroup(vertexBindGroup(), vertsGroup)
        encoder.setBindGroup(atlasBindGroup(), bindGroup)
        encoder.setBindGroup(externalBindGroup(), externalGroup)
        encoder.setBindGroup(softNearBindGroup(), softNearGroup)
        let completeModes = state.streams[modeStream].quadModes.count >= quadCount
        // Run-splitting is on whenever any per-region pipeline exists; the rect and
        // glyph fast paths additionally require their own (env-gated) pipelines.
        let glassSplit = state.glassFullPipeline.id != 0 && state.glassBandPipeline.id != 0 && state.glassLensPipeline.id != 0 && state.glassCorePipeline.id != 0
        let fastRuns = state.rectPipeline.id != 0 && state.glyphPipeline.id != 0
        let specialized = (glassSplit || fastRuns) && completeModes
        if state.probeModes {
            print(676766)
            print(modeStream)
            print(state.streams.count)
            print(quadCount)
            print(state.streams[modeStream].quadModes.count)
            if specialized { print(1) } else { print(0) }
        }
        if specialized {
            var firstQuad = 0
            var runCount = 0
            while firstQuad < quadCount {
                let modeCode = state.streams[modeStream].quadModes[firstQuad]
                let runUsesExternalTexture = modeCode == 20 && state.externalBindReady
                var runPipeline = state.pipeline
                if fastRuns {
                    if modeCode == 0 { runPipeline = state.rectPipeline }
                    if modeCode == 10 { runPipeline = state.glyphPipeline }
                }
                // A copy quad presents cached interior pixels — but only when the
                // cache provably holds them; otherwise it renders live through
                // the band pipeline, which is exact for every interior region.
                // A cache sized for a different drawable is not this frame's cache,
                // whatever its key says: the key describes the blur inputs, and the
                // dimensions are the other half of the proof.
                let copySized = state.glassCacheW == state.drawableW && state.glassCacheH == state.drawableH
                let copyLive = state.glassCacheDisabled || !state.glassBackdropStatic || state.glassCacheTexture.id == 0 || !state.glassCacheCleared || !copySized || state.glassCacheRenderedKey != state.glassCacheKeyNow
                if glassSplit {
                    if modeCode == 30 { runPipeline = state.glassFullPipeline }
                    if modeCode == 31 {
                        runPipeline = state.glassCopyPipeline
                        if copyLive { runPipeline = state.glassBandPipeline }
                    }
                    if modeCode == 32 { runPipeline = state.glassBandPipeline }
                    if modeCode == 33 { runPipeline = state.glassLensPipeline }
                    if modeCode == 34 { runPipeline = state.glassCorePipeline }
                }
                var endQuad = firstQuad + 1
                var samePipeline = true
                while endQuad < quadCount && samePipeline {
                    let nextMode = state.streams[modeStream].quadModes[endQuad]
                    var nextPipeline = state.pipeline
                    if fastRuns {
                        if nextMode == 0 { nextPipeline = state.rectPipeline }
                        if nextMode == 10 { nextPipeline = state.glyphPipeline }
                    }
                    if glassSplit {
                        if nextMode == 30 { nextPipeline = state.glassFullPipeline }
                        if nextMode == 31 {
                            nextPipeline = state.glassCopyPipeline
                            if copyLive { nextPipeline = state.glassBandPipeline }
                        }
                        if nextMode == 32 { nextPipeline = state.glassBandPipeline }
                        if nextMode == 33 { nextPipeline = state.glassLensPipeline }
                        if nextMode == 34 { nextPipeline = state.glassCorePipeline }
                    }
                    let nextUsesExternalTexture = nextMode == 20 && state.externalBindReady
                    if nextPipeline.id == runPipeline.id && nextUsesExternalTexture == runUsesExternalTexture {
                        endQuad = endQuad + 1
                    } else {
                        samePipeline = false
                    }
                }
                encoder.setPipeline(runPipeline)
                // A stream may contain both Liquid Glass quads and a live
                // TextureView. Glass runs read the stream's capture group;
                // mode 2 must read the host-published engine target instead.
                // Bind at the run boundary rather than once per stream so the
                // two resources can share the same ordered stream safely.
                var runExternalGroup = externalGroup
                if runUsesExternalTexture {
                    runExternalGroup = state.externalGroup
                }
                encoder.setBindGroup(externalBindGroup(), runExternalGroup)
                // Copy runs read the cache through the atlas slot; swap the group
                // in for the run and restore the stream's atlas after it.
                let copyRun = runPipeline.id == state.glassCopyPipeline.id && state.glassCacheGroup.id != 0
                if copyRun {
                    encoder.setBindGroup(atlasBindGroup(), state.glassCacheGroup)
                }
                encoder.drawIndexedRange((endQuad - firstQuad) * 6, firstQuad * 6)
                if copyRun {
                    encoder.setBindGroup(atlasBindGroup(), bindGroup)
                }
                firstQuad = endQuad
                runCount = runCount + 1
            }
            if state.probeModes {
                print(676767)
                print(modeStream)
                print(quadCount)
                print(state.streams[modeStream].quadModes.count)
                print(runCount)
            }
        } else {
            encoder.setPipeline(state.pipeline)
            encoder.drawIndexed(quadCount * 6)
        }
        return
    }
}


// Submit a glass-free frame as one indexed draw on the active render-pass encoder.
// Glass frames are drawn stream by stream by presentBatch, which owns the
// capture/blur passes each layer needs.
extend UiBatch {
    function flushBatch(graphics: borrow Graphics, encoder: borrow mut RenderEncoder) {
        var state = nativeRecover<UiBatchState>(self.storage)
        let quadCount = state.quadCount
        var target = encoder
        let none = emptyBindGroup()
        self.drawStream(target, state.streamIndex, quadCount, none, none, none)
        return
    }
}


function prepareBackground(state: borrow mut UiBatchState, graphics: borrow Graphics) {
    if !state.backgroundActive || state.backgroundParams.id == 0 {
        return
    }
    graphics.updateUniform(state.backgroundParams, [F32(state.backgroundTransition), F32(0.0), F32(0.0), F32(0.0)])
    return
}

// Native: it mutates the encoder, and a struct receiver has no seam
// representation, so a mutating call is always same-engine.
@Native
function drawBackground(state: borrow mut UiBatchState, encoder: borrow mut RenderEncoder) {
    if !state.backgroundActive || state.backgroundPipeline.id == 0 || !state.externalBindReady {
        return
    }
    // Diagnostic bisection: skip the opaque fullscreen photo while leaving every
    // pass, clear and present in place. That is what separates the cost of
    // sampling one fullscreen texture from the cost of having the pass at all.
    if state.benchNoBackground {
        return
    }
    let params = state.backgroundParamsGroup
    let primary = state.externalGroup
    var secondary = state.fallbackBackdropGroup
    if state.secondaryExternalBindReady {
        secondary = state.secondaryExternalGroup
    }
    encoder.setPipeline(state.backgroundPipeline)
    encoder.setBindGroup(0, primary)
    encoder.setBindGroup(1, secondary)
    encoder.setBindGroup(2, params)
    encoder.draw(3)
    return
}

// Draw the retained HUD stream over everything the frame composed. It goes last for
// the same reason the composed overlay was the last child of the root: it is the
// topmost layer. It is bound with the groups the TOPMOST UI stream uses, so a frame
// that switches the HUD to a backdrop-reading quad shades against the same capture
// the chrome beneath it does. Costs nothing when no HUD has ever been written —
// drawStream returns on a zero quad count.
extend UiBatch {
    function drawHud(state: borrow mut UiBatchState, encoder: borrow mut RenderEncoder) {
        let hud = hudStreamIndex()
        if state.streams[hud].quadCount <= 0 {
            return
        }
        let top = state.streamIndex
        self.drawStream(
            encoder,
            hud,
            state.streams[hud].quadCount,
            glassSharpStreamGroup(state, top),
            glassSoftNearStreamGroup(state, top),
            emptyBindGroup()
        )
        return
    }
}


extend UiBatch {
    function presentBatch(frame: borrow mut RenderFrame, graphics: borrow Graphics, bgR: Float, bgG: Float, bgB: Float, bgA: Float) {
        // Rolling boundary between present phases (see UiBatchStats.kira). Read
        // before anything else this function does, and every path out of it
        // charges the time since the last boundary to exactly one phase, so the
        // four sum to the call.
        var phaseMark = Int(frame.monotonicNanoseconds())
        var state = nativeRecover<UiBatchState>(self.storage)
        uiGlassStatsResetPresentation(state)
        // Never let the endpoint-only direct source escape the present that proved
        // its preconditions. Crossfades and later frames must re-evaluate it.
        state.directBackdropLayer0 = false
        state.glassBackdropStatic = false
        state.directBackdropSharpGroup = emptyBindGroup()
        // The active stream's count only reaches its entry here: emitting keeps it in
        // the mirrored hot field.
        state.streams[state.streamIndex].quadCount = state.quadCount
        let layers = state.streamIndex
        state.glassStatLayers = layers
        let bg = Color {
            r: bgR
            g: bgG
            b: bgB
            a: bgA
        }
        prepareBackground(state, graphics)
        // How far between the two backdrop photographs this frame stands, and
        // whether that is a place it can rest. `UiBackground.ksl` settles onto
        // one photo inside the same threshold, so a backdrop taken directly is
        // the same image the capture would have held.
        //
        // Uploaded whatever this frame turns out to do, because it changes
        // nothing for a group that stands over one image: those bind it at both
        // of the sharp tap's slots, and mixing a texel with itself is that
        // texel at any weight.
        var backdropBlend = state.backgroundTransition
        if backdropBlend < 0.0 { backdropBlend = 0.0 }
        if backdropBlend > 1.0 { backdropBlend = 1.0 }
        let backdropSettled = backdropBlend <= 0.001 || backdropBlend >= 0.999
        if state.backdropBlend.id != 0 {
            graphics.updateUniform(state.backdropBlend, [F32(backdropBlend), F32(0.0), F32(0.0), F32(0.0)])
        }
        // Any glyph packed during this frame's walk reaches the atlas texture
        // here, before the first pass samples it.
        self.commitAtlas(graphics)
        // Hand every stream's written prefix to the GPU before any pass reads it.
        // On Metal this is nothing — the emit already wrote into the buffer — and
        // on sokol it is the one upload per buffer the frame is allowed.
        var commitStream = 0
        while commitStream < state.streams.count {
            self.commitStream(graphics, commitStream)
            commitStream = commitStream + 1
        }
        let uploadsDone = Int(frame.monotonicNanoseconds())
        state.presentUploadNs = uploadsDone - phaseMark
        phaseMark = uploadsDone
        // The swapchain pass CLEARS rather than discarding, even though an opaque
        // fullscreen photo covers every pixel it clears. Discarding instead was
        // measured at 2.80/2.88/2.85 ms against 2.97/2.83/2.72 — no change, because a
        // tile-based GPU initializes the tile rather than writing the clear to
        // memory. So the clear is free and the discard only risks showing the last
        // frame wherever the cover turns out to be less than total.
        let swapchainPass = clearSwapchainRenderPass(bg)
        if layers == 0 || !state.glassReady {
            var encoder = frame.beginRenderPass(swapchainPass)
            drawBackground(state, encoder)
            self.flushBatch(graphics, encoder)
            self.drawHud(state, encoder)
            frame.endPass()
            announceVisibleContent(state)
            state.presentCompositeNs = Int(frame.monotonicNanoseconds()) - phaseMark
            return
        }

        // KIRA_GLASS_LAYERS=1 prints 616161 then how many glass layers this frame cut
        // itself into — the number that says whether stacked glass got its own capture
        // or fell back onto the layer below it (maxDrawStreams caps it).
        if state.probeGlassLayers {
            print(616161)
            print(layers)
        }
        // KIRA_UI_BATCH_PROBE=1 prints a sentinel, the stream count, then one quad
        // count per stream. It turns retained-capacity tuning into measured work
        // rather than guessing from the shape of the widget tree.
        if state.probeBatch {
            print(626262)
            print(state.streams.count)
            var probeStream = 0
            while probeStream < state.streams.count {
                print(state.streams[probeStream].quadCount)
                probeStream = probeStream + 1
            }
        }
        // Diagnostic bisection: isolates the full-resolution composite at native
        // drawable size. Never enabled by the application; the benchmark uses it to
        // distinguish 4K final-pass fill/shader cost from the backdrop preparation.
        let skipBackdropPrep = state.benchFinalOnly

        var layer = 0
        while layer < layers && !skipBackdropPrep {
            var directSourceId: U32 = 0
            var directSecondId: U32 = 0
            var directSharpGroup = emptyBindGroup()
            // Liquid Glass commonly sits directly above one opaque fullscreen
            // photo — or, mid-scheme-change, above a crossfade between two.
            // Rendering that into an identical full-resolution intermediate
            // before the blur is pure resampling work: the blur reads two
            // sources and blends them itself, and the composite's sharp tap
            // does the same, so there is nothing left for a capture to hold.
            // Sample the originals instead, but only when there are no stream-0
            // quads to preserve — stacked content still needs the capture below.
            // Either way the blur that follows is the same two dispatches over
            // the same grid: this chooses what they READ, not how.
            if layer == 0 &&
                state.streams[0].quadCount == 0 &&
                state.backgroundActive &&
                state.externalBindReady {
                if state.secondaryExternalBindReady {
                    directSourceId = state.externalTextureId
                    directSecondId = state.secondaryExternalTextureId
                    directSharpGroup = state.backdropSharpGroup
                } else if backdropBlend <= 0.001 {
                    // No second photo to fade to. The background pass then mixes
                    // the primary against the atlas fallback, which is only the
                    // primary while the transition is at rest, so that is the
                    // only place this may take it directly.
                    directSourceId = state.externalTextureId
                    directSharpGroup = state.externalGroup
                }
            }
            if directSourceId != 0 && directSharpGroup.id != 0 {
                state.directBackdropLayer0 = true
                state.directBackdropSharpGroup = directSharpGroup
                // The interior cache may trust a backdrop that is standing
                // still: a photo at rest has a blur at rest. A crossfade in
                // flight moves every interior pixel every frame, so it keeps the
                // direct backdrop and drops the cache — a capture-path layer
                // drops both, and every interior copy routes to the live band
                // pipeline instead.
                if layer == 0 && backdropSettled {
                    state.glassBackdropStatic = true
                }
            }
            // Capture: every stream below layer+1, drawn into this layer's own target.
            // Redrawn per layer rather than accumulated into one texture because the
            // capture a layer refracts must not contain the layer itself — and a target
            // cannot be sampled by the pass that writes it, which an accumulating
            // capture would need.
            if directSourceId == 0 {
                var sceneEncoder = frame.beginRenderPass(glassTexturePass("kira-ui-glass-scene-pass", state.glassLayers[layer].sceneTexture, bgR, bgG, bgB, bgA))
                let boundsStream = layer + 1
                let boundCount = state.streams[boundsStream].glassBoundCount
                if boundCount > 0 {
                    var bound = 0
                    while bound < boundCount {
                        let base = bound * 4
                        glassMergeCaptureBound(
                            state,
                            state.streams[boundsStream].glassBounds[base],
                            state.streams[boundsStream].glassBounds[base + 1],
                            state.streams[boundsStream].glassBounds[base + 2],
                            state.streams[boundsStream].glassBounds[base + 3]
                        )
                        bound = bound + 1
                    }
                    bound = 0
                    while bound < state.captureRectCount {
                        let base = bound * 4
                        let sx = Float(state.glassTexW) / state.viewportW
                        let sy = Float(state.glassTexH) / state.viewportH
                        var x0 = Int(state.captureRects[base] * sx)
                        var y0 = Int(state.captureRects[base + 1] * sy)
                        var x1 = Int(state.captureRects[base + 2] * sx + 1.0)
                        var y1 = Int(state.captureRects[base + 3] * sy + 1.0)
                        if x0 < 0 { x0 = 0 }
                        if y0 < 0 { y0 = 0 }
                        if x1 > state.glassTexW { x1 = state.glassTexW }
                        if y1 > state.glassTexH { y1 = state.glassTexH }
                        if x1 > x0 && y1 > y0 {
                            state.glassStatCaptureRegions = state.glassStatCaptureRegions + 1
                            sceneEncoder.setScissorRect(x0, y0, x1 - x0, y1 - y0)
                            self.glassDrawCaptureContents(state, sceneEncoder, layer)
                        }
                        bound = bound + 1
                    }
                    state.captureRectCount = 0
                    sceneEncoder.setScissorRect(0, 0, state.glassTexW, state.glassTexH)
                } else {
                    // Defensive fallback for a custom backend that opens a glass stream but
                    // emits no bounds metadata.
                    self.glassDrawCaptureContents(state, sceneEncoder, layer)
                }
                frame.endPass()
            }
            let captureDone = Int(frame.monotonicNanoseconds())
            state.presentCaptureNs = state.presentCaptureNs + captureDone - phaseMark
            phaseMark = captureDone

            // The blur. Two dispatches, every glass layer, every frame — there is
            // no second encoding of it and no condition under which it is skipped.
            //
            // The sources are textures rather than ids, because a backend that
            // splits an image from its views binds a view: the capture carries its
            // own, and the direct backdrop is a view id the widget tree carried
            // here on its own. A capture holds one image and passes it as both,
            // at weight 0; the direct backdrop passes the two photographs and the
            // crossfade the horizontal half filters through.
            var computeSource = state.glassLayers[layer].sceneTexture
            var computeSecond = computeSource
            var computeBlend = 0.0
            if directSourceId != 0 {
                computeSource = sampledTextureFromViewId(directSourceId)
                computeSecond = computeSource
                if directSecondId != 0 {
                    computeSecond = sampledTextureFromViewId(directSecondId)
                    computeBlend = backdropBlend
                }
            }
            // Two dispatches, one per axis, for this layer.
            state.glassStatBlurDispatches = state.glassStatBlurDispatches + 2
            frame.dispatchTextureComputePair(
                state.blurComputeHPipelineId,
                state.blurComputeVPipelineId,
                computeSource,
                computeSecond,
                computeBlend,
                state.blurTextureA,
                state.blurTextureB,
                state.glassLayers[layer].nearTexture,
                state.glassLayers[layer].blurTexture,
                state.sampler,
                state.glassBlurW,
                state.glassBlurH,
            )
            // The compute writes leave both outputs in the uncompressed
            // shader-write layout, and every glass tap of the composite samples
            // them. Re-tile so those taps read the fast layout.
            frame.optimizeTexture(Int(state.glassLayers[layer].nearTexture.id))
            frame.optimizeTexture(Int(state.glassLayers[layer].blurTexture.id))
            // Which backdrop layer 0's blur was taken from. It is half of the
            // interior cache's key: a cached interior shaded against one photo is
            // not the interior of the same surface over another. Zero for the
            // capture path, whose input is scene content nothing may assume static.
            if layer == 0 {
                state.glassBlurSourceId = directSourceId
            }
            let blurDone = Int(frame.monotonicNanoseconds())
            state.presentBlurNs = state.presentBlurNs + blurDone - phaseMark
            phaseMark = blurDone
            layer = layer + 1
        }

        // Final pass: the swapchain composite — every stream in emission order at full
        // resolution, each glass layer refracting the blur of what was under it.
        // Interior cache: re-render this frame's dirty glass interiors into the
        // cache texture before the composite reads them back as copies. The pass
        // preserves previously cached surfaces (load) once the texture has been
        // cleared a first time.
        state.glassCacheKeyNow = Float(state.glassBlurSourceId) + state.backgroundTransition * 0.5
        if state.probeGlassLayers {
            print(696969)
            print(state.glassCacheRangeCount)
            if state.glassBackdropStatic { print(1) } else { print(0) }
            if state.glassCacheCleared { print(1) } else { print(0) }
            if state.glassCacheRenderedKey == state.glassCacheKeyNow { print(1) } else { print(0) }
        }
        // Sized BEFORE anything asks whether the cache may be copied, and whether or
        // not this frame has dirty interiors to render into it. The drawable changes
        // size without any glass quad being re-pushed — a resize while the retained
        // stream replays leaves nothing dirty — and a cache still holding the old
        // dimensions is sampled by the new geometry's uv, which clamps to the edge and
        // presents black slabs. Re-creating it here drops `glassCacheCleared`, so every
        // copy routes to the live band pipeline until a rebuild refills the cache at
        // the size the drawable is now.
        if state.glassBackdropStatic {
            glassEnsureInteriorCache(state, graphics)
        }
        if state.glassBackdropStatic && state.glassCacheRangeCount > 0 {
            if state.glassCacheTexture.id != 0 {
                var cacheEncoder = frame.beginRenderPass(glassInteriorCachePass(state))
                glassDrawCacheRanges(state, cacheEncoder)
                frame.endPass()
                state.glassCacheCleared = true
                // Consumed: the retained stream replays every frame, but these
                // interiors are in the cache now.
                state.glassCacheRangeCount = 0
                state.glassCacheRenderedKey = state.glassCacheKeyNow
            }
        }
        var mainEncoder = frame.beginRenderPass(swapchainPass)
        drawBackground(state, mainEncoder)
        var stream = 0
        var finalStreamCount = layers
        if state.benchBackgroundOnly {
            finalStreamCount = 0
        }
        while stream <= finalStreamCount {
            self.drawStream(
                mainEncoder,
                stream,
                state.streams[stream].quadCount,
                glassSharpStreamGroup(state, stream),
                glassSoftNearStreamGroup(state, stream),
                emptyBindGroup()
            )
            stream = stream + 1
        }
        self.drawHud(state, mainEncoder)
        frame.endPass()
        announceVisibleContent(state)
        state.presentCompositeNs = Int(frame.monotonicNanoseconds()) - phaseMark
        return
    }
}


// Say, once per run, that a frame carried real application content.
//
// The markers a live session and the example harness wait on. On the immediate
// path they come from the C batch when its vertex list turns out non-empty; the
// retained path's equivalent moment is a presented frame whose streams held
// quads, which is here.
function announceVisibleContent(state: borrow mut UiBatchState) {
    if state.announcedVisibleContent {
        return
    }
    for stream in 0..state.streams.count {
        if state.streams[stream].quadCount > 0 {
            state.announcedVisibleContent = true
            kiraGraphicsLiveVisibleContentSubmitted()
            return
        }
    }
    return
}
