import Foundation
import KiraGraphics
// Liquid glass, the resources side: the occupancy grid that decides whether a
// surface has anything under it worth capturing, and the per-layer render targets
// the capture and its blur pyramid live in.
//
// Glass is layered because one glass surface can sit over another. Each layer owns
// a scene texture, a near and a far blur level, and the bind groups that read them,
// and a layer is only built when something actually asks for it — a UI with no
// glass allocates none of this.

// Which grid column/row a pixel coordinate falls in, clamped to the grid.
function glassCellIndex(value: Float, extent: Float, cells: Int) -> Int {
    if extent <= 0.0 {
        return 0
    }
    var idx = Int(value / extent * Float(cells))
    if idx < 0 {
        idx = 0
    }
    if idx >= cells {
        idx = cells - 1
    }
    return idx
}

// Record exact content bounds for the active glass layer.
function glassMarkRect(state: borrow mut UiBatchState, x0: Float, y0: Float, x1: Float, y1: Float) {
    let base = state.glassRectCount * 4
    if base + 3 < state.glassRects.count {
        state.glassRects[base] = x0
        state.glassRects[base + 1] = y0
        state.glassRects[base + 2] = x1
        state.glassRects[base + 3] = y1
    } else {
        state.glassRects.append(x0)
        state.glassRects.append(y0)
        state.glassRects.append(x1)
        state.glassRects.append(y1)
    }
    state.glassRectCount = state.glassRectCount + 1
    return
}

// Does this rect sit over anything the current glass layer has already drawn? A
// glass surface that does must start its own layer to refract it.
function glassLayerOccupied(state: borrow mut UiBatchState, x0: Float, y0: Float, x1: Float, y1: Float) -> Bool {
    var i = 0
    while i < state.glassRectCount {
        let base = i * 4
        let rx0 = state.glassRects[base]
        let ry0 = state.glassRects[base + 1]
        let rx1 = state.glassRects[base + 2]
        let ry1 = state.glassRects[base + 3]
        if x0 < rx1 && x1 > rx0 && y0 < ry1 && y1 > ry0 {
            return true
        }
        i = i + 1
    }
    return false
}

// One `BlurParams` uniform: the axis step in the source's uv, the pyramid level
// to write, and the fourth slot `Shaders/UiBlur.ksl` declares beside them.
function blurParamsUniform(graphics: borrow Graphics, label: String) -> Uniform {
    return uniformOrReport(graphics.createUniform(UniformDescriptor {
        label: label
        expectedFloatCount: 4
        data: [F32(0.0), F32(0.0), F32(0.0), F32(0.0)]
    }), "blur params")
}

// `Shaders/UiBlur.ksl`'s level selector, the two values its fragment branch
// splits on.
function blurLevelNear() -> Float { return 0.0 }
function blurLevelFar() -> Float { return 1.0 }

function blurParamsGroup(graphics: borrow Graphics, label: String, uniform: borrow Uniform) -> BindGroup {
    return bindGroupOrReport(graphics.createUniformBindGroup(label, blurParamsSlot(), uniform), "blur params group")
}

// A render pass targeting one of the glass offscreen textures.
function glassTexturePass(label: String, texture: borrow GraphicsTexture, r: Float, g: Float, b: Float, a: Float) -> RenderPassDescriptor {
    let target = RenderTarget {
        kind: .Texture
        texture: texture
        mipLevel: 0
        arrayLayer: 0
    }
    let attachment = ColorAttachment {
        target: target
        loadAction: .Clear
        storeAction: .Store
        clearColor: Color {
            r: r
            g: g
            b: b
            a: a
        }
        resolveTarget: emptyRenderTarget()
        hasResolveTarget: false
    }
    return RenderPassDescriptor {
        label: label
        colorAttachments: [attachment]
        primaryColorAttachment: attachment
        hasPrimaryColorAttachment: true
        depthAttachment: emptyDepthAttachment()
        hasDepthAttachment: false
        stencilAttachment: emptyStencilAttachment()
        hasStencilAttachment: false
    }
}

function glassDestroyTexture(graphics: borrow Graphics, texture: borrow GraphicsTexture) {
    if texture.id == 0 {
        return
    }
    graphics.destroyTexture(texture)
    return
}

function glassDestroyBindGroup(graphics: borrow Graphics, group: borrow BindGroup) {
    if group.id == 0 {
        return
    }
    graphics.destroyBindGroup(group)
    return
}

// Release the application-owned references to a superseded glass target set.
// Metal command buffers retain every resource they encode until completion, so
// prior in-flight frames remain valid while the registry can stop retaining the
// old resize bucket immediately.
function glassDestroyTargets(state: borrow mut UiBatchState, graphics: borrow Graphics) {
    glassDestroyBindGroup(graphics, state.blurInputAGroup)
    glassDestroyBindGroup(graphics, state.blurInputBGroup)
    glassDestroyTexture(graphics, state.blurTextureA)
    glassDestroyTexture(graphics, state.blurTextureB)
    for layer in 0..state.glassLayers.count {
        glassDestroyBindGroup(graphics, state.glassLayers[layer].sceneSharpGroup)
        glassDestroyBindGroup(graphics, state.glassLayers[layer].sceneBlurInGroup)
        glassDestroyBindGroup(graphics, state.glassLayers[layer].softNearGroup)
        glassDestroyTexture(graphics, state.glassLayers[layer].sceneTexture)
        glassDestroyTexture(graphics, state.glassLayers[layer].nearTexture)
        glassDestroyTexture(graphics, state.glassLayers[layer].blurTexture)
    }
    state.blurInputAGroup = emptyBindGroup()
    state.blurInputBGroup = emptyBindGroup()
    state.blurTextureA = emptyGraphicsTexture()
    state.blurTextureB = emptyGraphicsTexture()
    state.glassBlurW = 0
    state.glassBlurH = 0
    state.blurCacheSourceId = 0
    state.blurCacheW = 0
    state.blurCacheH = 0
    // The interior cache is drawable-sized and its keys describe the old
    // viewport; both die with the glass targets. (The texture itself is
    // re-created lazily by glassEnsureInteriorCache at the new size.)
    state.glassCacheW = 0
    state.glassCacheH = 0
    state.glassCacheCleared = false
    state.glassCacheEpochValue = state.glassCacheEpochValue + 1
    state.glassLayers = []
    state.glassReady = false
    return
}

// Attach all targets used by glass layer `layer`. Layer 0 is built with the first
// glass frame; deeper layers are built only when a frame actually stacks that far,
// so an ordinary one- or two-layer UI does not reserve the maximum chain.
function glassEnsureLayerScene(state: borrow mut UiBatchState, graphics: borrow Graphics, layer: Int) {
    if layer < 0 || layer >= state.glassLayers.count {
        return
    }
    if state.glassLayers[layer].sceneTexture.id != 0 {
        return
    }
    // Keep the refracted SHARP tap at logical resolution. On a Retina 4K window
    // this is already a 2x reduction per axis from the drawable and is confined to
    // the Liquid Glass effect; reducing it again visibly changed photo detail under
    // clear glass. Only the blurred levels use the more aggressive pyramid below.
    var sceneDiv = 1
    let blurDiv = glassBlurDivisor()
    var sceneW = state.glassTexW / sceneDiv
    if sceneW < 1 {
        sceneW = 1
    }
    var sceneH = state.glassTexH / sceneDiv
    if sceneH < 1 {
        sceneH = 1
    }
    var blurW = state.glassTexW / blurDiv
    if blurW < 1 {
        blurW = 1
    }
    var blurH = state.glassTexH / blurDiv
    if blurH < 1 {
        blurH = 1
    }
    let scene = textureOrReport(graphics.createTexture(TextureDescriptor {
        label: "kira-ui-glass-scene"
        width: sceneW
        height: sceneH
        format: .Rgba8Unorm
        usage: .RenderTargetSampled
        sampleCount: 1
        storage: .Transient
    }), "glass scene target")
    let sampler = state.sampler
    let nearOut = textureOrReport(graphics.createTexture(TextureDescriptor {
        label: "kira-ui-glass-blur-near"
        width: blurW
        height: blurH
        format: .Rgba8Unorm
        usage: .RenderTargetSampledStorage
        sampleCount: 1
        storage: .Transient
    }), "glass near-blur target")
    let blurOut = textureOrReport(graphics.createTexture(TextureDescriptor {
        label: "kira-ui-glass-blur-out"
        width: blurW
        height: blurH
        format: .Rgba8Unorm
        usage: .RenderTargetSampledStorage
        sampleCount: 1
        storage: .Transient
    }), "glass blur target")
    state.glassLayers[layer].sceneTexture = scene
    // The capture rides the shader's EXTERNAL slot — mode 3 reads its sharp tap
    // from the same place a TextureView reads its texture. It has to be that slot
    // and not the atlas's: two groups binding the same texture index means
    // whichever is applied last wins, and the glyphs lose their atlas.
    let sharp = bindGroupOrReport(graphics.beginBindGroup("kira-ui-glass-scene-sharp"), "sharp")
    graphics.bindGroupAddTexture(sharp, externalTextureSlot(), scene)
    graphics.bindGroupAddSampler(sharp, externalSamplerSlot(), sampler)
    state.glassLayers[layer].sceneSharpGroup = sharp
    // The blur chain is its own pipeline reading at ITS slot 0.
    state.glassLayers[layer].sceneBlurInGroup = bindGroupOrReport(graphics.createTextureSamplerBindGroup("kira-ui-glass-scene-blur-in", blurTextureSlot(), scene, blurSamplerSlot(), sampler), "scene blur in group")
    let softNear = bindGroupOrReport(graphics.beginBindGroup("kira-ui-glass-soft-near"), "soft near")
    graphics.bindGroupAddTexture(softNear, backdropTextureSlot(), blurOut)
    graphics.bindGroupAddSampler(softNear, backdropSamplerSlot(), sampler)
    graphics.bindGroupAddTexture(softNear, nearTextureSlot(), nearOut)
    graphics.bindGroupAddSampler(softNear, nearSamplerSlot(), sampler)
    state.glassLayers[layer].nearTexture = nearOut
    state.glassLayers[layer].blurTexture = blurOut
    state.glassLayers[layer].softNearGroup = softNear
    return
}

// Ensure the glass pipelines/param buffers exist (once) and the offscreen targets
// cover the current physical viewport. Targets grow in buckets: the capture is
// sampled through uv 0..1, so a larger-than-viewport target still composites 1:1,
// shrinking does not churn resources, and a superseded growth bucket is retired
// before its replacement is installed.
extend UiBatch {
    function ensureGlassResources(graphics: borrow Graphics) {
        var state = nativeRecover<UiBatchState>(self.storage)
        if state.blurPipeline.id == 0 {
            let blurArtifact = ksl!("Shaders/UiBlur.ksl")
            let blurShader = shaderOrReport(graphics.createShaderFromKslArtifact("kira-ui-glass-blur", blurArtifact), "blur shader")
            let blurPipeline = pipelineOrReport(graphics.createRenderPipeline(RenderPipelineDescriptor {
                label: "kira-ui-glass-blur-pipeline"
                shader: blurShader
                vertexEntry: blurArtifact.vertexEntry
                fragmentEntry: blurArtifact.fragmentEntry
                vertexLayout: VertexLayout {
                    stride: 0
                    attributes: []
                }
                colorTargets: [
                    ColorTargetDescriptor {
                        format: .Rgba8Unorm
                        blend: BlendState {
                            enabled: false
                            preset: .Replace
                        }
                    }
                ]
                depthStencil: DepthStencilDescriptor {
                    depthEnabled: false
                    depthWriteEnabled: false
                    depthCompare: .Always
                    format: .None
                }
                rasterization: RasterizationDescriptor {
                    cullMode: .None
                    frontFace: .CounterClockwise
                }
                primitive: PrimitiveDescriptor {
                    topology: .TriangleList
                }
            }), "blur pipeline")
            state.blurPipeline = blurPipeline
            // Real uniforms, not buffers bound at a uniform slot: `UiBlur.ksl`
            // declares `uniform params`, and a backend that pushes uniforms
            // through its own call rather than reading them out of memory has no
            // way to see a buffer a caller bound instead.
            state.blurParamsNearH = blurParamsUniform(graphics, "kira-ui-glass-blur-params-near-h")
            state.blurParamsNearHGroup = blurParamsGroup(graphics, "kira-ui-glass-blur-params-near-h", state.blurParamsNearH)
            state.blurParamsFarH = blurParamsUniform(graphics, "kira-ui-glass-blur-params-far-h")
            state.blurParamsFarHGroup = blurParamsGroup(graphics, "kira-ui-glass-blur-params-far-h", state.blurParamsFarH)
            state.blurParamsNearV = blurParamsUniform(graphics, "kira-ui-glass-blur-params-near-v")
            state.blurParamsNearVGroup = blurParamsGroup(graphics, "kira-ui-glass-blur-params-near-v", state.blurParamsNearV)
            state.blurParamsFarV = blurParamsUniform(graphics, "kira-ui-glass-blur-params-far-v")
            state.blurParamsFarVGroup = blurParamsGroup(graphics, "kira-ui-glass-blur-params-far-v", state.blurParamsFarV)

            // One `.ksl` holds one compute stage, so the two passes are two files
            // sharing `Shaders/UiGlassBlurCommon.ksl` — the filters they both run
            // are written once there, which is what the single MSL string used to
            // buy by declaring both kernels beside their two `static inline`s.
            //
            // Compiled for every target, like every other shader here: the pair is
            // one shader set, not a Metal specialization written twice, and the
            // whole artifact is handed over rather than its MSL beside seven empty
            // strings. What is asked at run time is the capability, not the
            // backend's name — a backend that grows compute encoding starts
            // running this without a line here naming it.
            if graphics.supportsCompute() {
                let hArtifact = ksl!("Shaders/UiGlassBlurH.ksl")
                let hShader = shaderOrReport(graphics.createShaderFromKslArtifact("kira-ui-glass-blur-h", hArtifact), "h shader")
                state.blurComputeHPipelineId = graphics.createComputePipeline("kira-ui-glass-blur-h", hShader, hArtifact.computeEntry)

                let vArtifact = ksl!("Shaders/UiGlassBlurV.ksl")
                let vShader = shaderOrReport(graphics.createShaderFromKslArtifact("kira-ui-glass-blur-v", vArtifact), "v shader")
                state.blurComputeVPipelineId = graphics.createComputePipeline("kira-ui-glass-blur-v", vShader, vArtifact.computeEntry)
            }
        }

        // Targets sized in LOGICAL points, exactly like the Kira Graphics example
        // (its scene target is the 1600x900 window size regardless of backing scale,
        // its blur chain half that). On Retina the capture is therefore half the
        // drawable and the blurred backdrop a quarter — that resolution pyramid,
        // upscaled at composite, is most of the example's visible blur, so matching
        // it point-for-point matches the look.
        let wantW = Int(state.viewportW)
        let wantH = Int(state.viewportH)
        if wantW <= state.glassTexW && wantH <= state.glassTexH {
            return
        }
        // Quantized grow-only targets keep resize drags from recreating resources at
        // every pixel without the old 1.5x-per-axis headroom, which reserved 2.25x
        // the visible area. Width grows in 256-point buckets and height in 128-point
        // buckets; the floor covers compact windows without penalizing normal ones.
        var texW = ((wantW + 255) / 256) * 256
        if texW < 1024 {
            texW = 1024
        }
        var texH = ((wantH + 127) / 128) * 128
        if texH < 640 {
            texH = 640
        }
        if state.glassTexW > texW {
            texW = state.glassTexW
        }
        if state.glassTexH > texH {
            texH = state.glassTexH
        }
        // Logical capture -> quarter-logical blur, in both encodings. The drawn
        // ladder used to halve the divisor instead, which changed the physical
        // blur radius rather than its quality — the kernel steps in level texels,
        // so a finer level is a *narrower* blur — and made KIRA_GLASS_REFERENCE
        // compare two effects rather than two encodings of one.
        let blurDiv = glassBlurDivisor()
        var blurW = texW / blurDiv
        if blurW < 1 {
            blurW = 1
        }
        var blurH = texH / blurDiv
        if blurH < 1 {
            blurH = 1
        }
        glassDestroyTargets(state, graphics)
        let blurA = textureOrReport(graphics.createTexture(TextureDescriptor {
            label: "kira-ui-glass-blur-a"
            width: blurW
            height: blurH
            format: .Rgba8Unorm
            usage: .RenderTargetSampledStorage
            sampleCount: 1
            storage: .Transient
        }), "glass blur ping target")
        let blurB = textureOrReport(graphics.createTexture(TextureDescriptor {
            label: "kira-ui-glass-blur-b"
            width: blurW
            height: blurH
            format: .Rgba8Unorm
            usage: .RenderTargetSampledStorage
            sampleCount: 1
            storage: .Transient
        }), "glass blur pong target")
        state.blurTextureA = blurA
        state.blurTextureB = blurB
        state.glassTexW = texW
        state.glassTexH = texH
        state.glassBlurW = blurW
        state.glassBlurH = blurH

        let sampler = state.sampler
        state.blurInputAGroup = bindGroupOrReport(graphics.createTextureSamplerBindGroup("kira-ui-glass-blur-in-a", blurTextureSlot(), blurA, blurSamplerSlot(), sampler), "blur in a")
        state.blurInputBGroup = bindGroupOrReport(graphics.createTextureSamplerBindGroup("kira-ui-glass-blur-in-b", blurTextureSlot(), blurB, blurSamplerSlot(), sampler), "blur in b")

        // Reserve only the lightweight layer records. Their scene, far-blur and
        // near-blur textures are allocated together on first use by
        // glassEnsureLayerScene, rather than eagerly reserving the maximum stack.
        var layer = 0
        while layer < maxDrawStreams() - 1 {
            state.glassLayers.append(UiGlassLayer {})
            layer = layer + 1
        }
        glassEnsureLayerScene(state, graphics, 0)

        // The drawn ladder's four passes, in the terms `Shaders/UiBlur.ksl`
        // reads: one texel of the level being written, along the axis that pass
        // filters, expressed in the source's uv — which is the same step
        // `UiGlassBlurH`/`V` derive from their extent uniform, so the two
        // encodings run the same kernel over the same grid.
        let stepX = F32(1.0 / Float(blurW))
        let stepY = F32(1.0 / Float(blurH))
        let zero = F32(0.0)
        graphics.updateUniform(state.blurParamsNearH, [stepX, zero, F32(blurLevelNear()), zero])
        graphics.updateUniform(state.blurParamsFarH, [stepX, zero, F32(blurLevelFar()), zero])
        graphics.updateUniform(state.blurParamsNearV, [zero, stepY, F32(blurLevelNear()), zero])
        graphics.updateUniform(state.blurParamsFarV, [zero, stepY, F32(blurLevelFar()), zero])
        state.glassReady = true
        return
    }
}


