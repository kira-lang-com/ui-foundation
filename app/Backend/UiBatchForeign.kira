import Foundation
import KiraGraphics
// Foreign surface for the batched UI compositor.
//
// The compositor renders the whole UI through the Kira Graphics public abstraction
// (buffers / pipeline / texture / draw — backend-agnostic, currently the from-scratch
// Metal path). The only direct FFI here is to the real font engine (glyph
// rasterization, the cross-platform equivalent of FreeType) and to the kira_runtime
// raw-memory helpers used to read the C glyph-bitmap struct and decode UTF-8. There
// is NO rendering shim: glyph coverage is rasterized, packed into a Kira Graphics
// atlas texture, and drawn as textured quads through the abstraction. There is no
// immediate-mode blit path beside it on any backend.

// ---------------------------------------------------------------------------
// kira_runtime raw memory helpers (read the glyph bitmap struct, decode UTF-8).
//
// A C symbol must have exactly one Kira @FFI.Extern binding across the whole linked
// program. Kira Graphics' Metal backend already binds most of the kira_runtime raw
// helpers (metalMemAlloc / metalMemReadU32 / ...), so the compositor REUSES those
// through thin @Native wrappers rather than re-declaring the same symbols here (a
// second binding would be dropped, leaving the call unresolved). Only the two helpers
// the Metal backend does not bind — read_i32_at and read_f32_at — are declared here.
// ---------------------------------------------------------------------------

// NOTE: only U32/U64/RawPtr/Bool-return FFI is known to lower in this toolchain;
// I32-RETURN and F32-RETURN do not. The engine's signed 32-bit int fields are read
// as u32 and sign-corrected (readInt), and its 32-bit float fields are read as
// u32 and decoded (floatFromBits / readFloat — see UiBatch.kira).

@Native
function writeU32(ptr: RawPtr, offset: U64, value: U32) {
    metalMemWriteU32(ptr, offset, value)
    return
}
@Native
function writeF32(ptr: RawPtr, offset: U64, value: Float) {
    metalMemWriteF32(ptr, offset, value)
    return
}
// Write one quad's record: the thirty floats the KSL `UiQuad` struct reads for
// every mode, in its field order (see quadFloatCount in UiBatch.kira).
// `px`/`py` are pixel coordinates, which the fragment stage clips against; `pos`
// is the same point in clip space, with the y flip a top-left-origin UI needs.
//
// The clip position is computed HERE rather than in the vertex stage, so that the
// stage only ever selects between two stored numbers and the bytes reaching the
// rasterizer are the ones a per-vertex buffer used to hold.
//
// Written in Kira rather than behind a native fast-path symbol. A `kira_ui`
// library existed for this and no toolchain shipped one, so every call trapped
// by name on the platform the compositor actually runs on; a UI that needs a
// native library to draw a rectangle is not portable. The cost is per-float
// writes through the runtime's raw-memory helpers, which are on every native
// link line and need no platform to have anything.
@Native
function writeQuadRecord(
    ptr: RawPtr, baseFloats: U64,
    px0: Float, py0: Float, px1: Float, py1: Float,
    lx0: Float, ly0: Float, lx1: Float, ly1: Float,
    vw: Float, vh: Float,
    halfW: Float, halfH: Float, radius: Float, borderWidth: Float, mode: Float,
    edgeRefraction: Float,
    fr: Float, fg: Float, fb: Float, fa: Float,
    br: Float, bg: Float, bb: Float, ba: Float,
    clipMinX: Float, clipMinY: Float, clipMaxX: Float, clipMaxY: Float,
) {
    let bytes = baseFloats * U64(4)
    writeF32(ptr, bytes, px0 / vw * 2.0 - 1.0)
    writeF32(ptr, bytes + U64(4), 1.0 - py0 / vh * 2.0)
    writeF32(ptr, bytes + U64(8), px1 / vw * 2.0 - 1.0)
    writeF32(ptr, bytes + U64(12), 1.0 - py1 / vh * 2.0)
    writeF32(ptr, bytes + U64(16), px0)
    writeF32(ptr, bytes + U64(20), py0)
    writeF32(ptr, bytes + U64(24), px1)
    writeF32(ptr, bytes + U64(28), py1)
    writeF32(ptr, bytes + U64(32), lx0)
    writeF32(ptr, bytes + U64(36), ly0)
    writeF32(ptr, bytes + U64(40), lx1)
    writeF32(ptr, bytes + U64(44), ly1)
    writeF32(ptr, bytes + U64(48), halfW)
    writeF32(ptr, bytes + U64(52), halfH)
    writeF32(ptr, bytes + U64(56), radius)
    writeF32(ptr, bytes + U64(60), borderWidth)
    writeF32(ptr, bytes + U64(64), mode)
    writeF32(ptr, bytes + U64(68), edgeRefraction)
    writeF32(ptr, bytes + U64(72), fr)
    writeF32(ptr, bytes + U64(76), fg)
    writeF32(ptr, bytes + U64(80), fb)
    writeF32(ptr, bytes + U64(84), fa)
    writeF32(ptr, bytes + U64(88), br)
    writeF32(ptr, bytes + U64(92), bg)
    writeF32(ptr, bytes + U64(96), bb)
    writeF32(ptr, bytes + U64(100), ba)
    writeF32(ptr, bytes + U64(104), clipMinX)
    writeF32(ptr, bytes + U64(108), clipMinY)
    writeF32(ptr, bytes + U64(112), clipMaxX)
    writeF32(ptr, bytes + U64(116), clipMaxY)
    return
}

// The material block that follows a record: what a liquid-glass surface shades
// itself with. Mode 3 is the only mode whose shader reads any of it, so it is the
// only mode that writes it.
@Native
function writeQuadMaterial(
    ptr: RawPtr, baseFloats: U64,
    m0: Float, m1: Float, m2: Float, m3: Float,
    m4: Float, m5: Float, m6: Float, m7: Float,
    m8: Float, m9: Float, m10: Float, m11: Float,
    m12: Float, m13: Float, m14: Float, m15: Float,
    m16: Float, m17: Float, m18: Float, m19: Float,
    m20: Float, m21: Float, m22: Float, m23: Float,
) {
    let bytes = (baseFloats + U64(30)) * U64(4)
    writeF32(ptr, bytes, m0)
    writeF32(ptr, bytes + U64(4), m1)
    writeF32(ptr, bytes + U64(8), m2)
    writeF32(ptr, bytes + U64(12), m3)
    writeF32(ptr, bytes + U64(16), m4)
    writeF32(ptr, bytes + U64(20), m5)
    writeF32(ptr, bytes + U64(24), m6)
    writeF32(ptr, bytes + U64(28), m7)
    writeF32(ptr, bytes + U64(32), m8)
    writeF32(ptr, bytes + U64(36), m9)
    writeF32(ptr, bytes + U64(40), m10)
    writeF32(ptr, bytes + U64(44), m11)
    writeF32(ptr, bytes + U64(48), m12)
    writeF32(ptr, bytes + U64(52), m13)
    writeF32(ptr, bytes + U64(56), m14)
    writeF32(ptr, bytes + U64(60), m15)
    writeF32(ptr, bytes + U64(64), m16)
    writeF32(ptr, bytes + U64(68), m17)
    writeF32(ptr, bytes + U64(72), m18)
    writeF32(ptr, bytes + U64(76), m19)
    writeF32(ptr, bytes + U64(80), m20)
    writeF32(ptr, bytes + U64(84), m21)
    writeF32(ptr, bytes + U64(88), m22)
    writeF32(ptr, bytes + U64(92), m23)
    return
}
@Native
function readU32(ptr: RawPtr, offset: U64) -> U32 {
    return metalMemReadU32(ptr, offset)
}
@Native
function readPointer(ptr: RawPtr, offset: U64) -> RawPtr {
    return metalMemReadPtr(ptr, offset)
}

// ---------------------------------------------------------------------------
// Font engine (real glyph rasterization). Declared with RawPtr/primitive shapes so
// the C glyph-bitmap struct can be read field-by-field through the helpers above.
// ---------------------------------------------------------------------------

@FFI.Extern { library: kiratext; symbol: kira_text_engine_create; abi: c; }
function createTextEngine(): RawPtr;
@FFI.Extern { library: kiratext; symbol: kira_text_face_load; abi: c; }
function loadFace(engine: RawPtr, path: CString, faceIndex: I32): RawPtr;
// The Figtree variable face compiled into libkiratext. The one face that exists
// wherever the library is linked — including a browser, which has no filesystem
// to name a system font in — so the retained atlas always has an outline source
// and never has to ask whether text is possible on this platform.
@FFI.Extern { library: kiratext; symbol: kira_text_face_load_bundled; abi: c; }
function loadBundledFace(engine: RawPtr): RawPtr;
@FFI.Extern { library: kiratext; symbol: kira_text_face_set_pixel_size; abi: c; }
function faceSetPixelSize(face: RawPtr, pixelSize: F32, weight: F32): I32;
@FFI.Extern { library: kiratext; symbol: kira_text_face_glyph_index; abi: c; }
function faceGlyphIndex(face: RawPtr, codepoint: U32): U32;
@FFI.Extern { library: kiratext; symbol: kira_text_face_render_glyph; abi: c; }
function faceRenderGlyph(face: RawPtr, glyphIndex: U32, out: RawPtr): I32;
// Subpixel-positioned rasterization: the outline is shifted by xOffset26_6 (64 to a
// pixel) before it is scan-converted, so coverage is computed for where the glyph
// actually lands rather than computed once and resampled. Both entry points render
// UNHINTED, which is the other half of what makes macOS text look the way it does.
@FFI.Extern { library: kiratext; symbol: kira_text_face_render_glyph_offset; abi: c; }
function faceRenderGlyphOffset(face: RawPtr, glyphIndex: U32, xOffset26_6: I32, out: RawPtr): I32;
@FFI.Extern { library: kiratext; symbol: kira_text_face_vmetrics; abi: c; }
function faceVerticalMetrics(face: RawPtr, out: RawPtr): Void;
@FFI.Extern { library: kiratext; symbol: kira_text_utf8_next; abi: c; }
function nextUtf8Scalar(s: CString, len: I32, indexPtr: RawPtr, codepointPtr: RawPtr): I32;
@FFI.Extern { library: kiratext; symbol: kira_text_decode_codepoints; abi: c; }
function decodeCodepoints(s: CString, out: RawPtr, max: I32): I32;

// ---------------------------------------------------------------------------
// Icon engine (SVG-subset rasterizer, NativeLibs/Icon): coverage bitmaps packed
// into the same atlas as glyphs and drawn as tinted mode-1 quads.
// ---------------------------------------------------------------------------

@FFI.Extern { library: kiraicon; symbol: kira_icon_hash; abi: c; }
function iconHash(svg: CString): Int;
@FFI.Extern { library: kiraicon; symbol: kira_icon_rasterize; abi: c; }
function rasterizeIcon(svg: CString, px: I32, outBuffer: RawPtr): I32;
@FFI.Extern { library: kiraicon; symbol: kira_icon_rasterize_weighted; abi: c; }
function rasterizeIconWeighted(svg: CString, px: I32, dilatePx: Float, outBuffer: RawPtr): I32;

// libc fread — the only raw-file symbol the linked program does not already bind
// (fopen/fwrite/fclose live in the Metal backend's foreign surface and are reused
// below through their Kira functions; a second @FFI.Extern binding of the same C
// symbol would be dropped).
@FFI.Extern { library: kiratext; symbol: fread; abi: c; }
function readFileBytes(ptr: RawPtr, size: U64, count: U64, stream: RawPtr): U64;

// Copy a Kira string's UTF-8 bytes into a NUL-terminated C buffer (caller frees).
// Needed because fopen's one program-wide binding takes a RawPtr path (the shape
// the image-dump hook needed for getenv-returned paths).
@Native
function allocateCPath(path: borrow String) -> RawPtr {
    let buf = allocateBytes(U64(path.count * 4 + 1))
    let indexSlot = allocateBytes(8)
    let cpSlot = allocateBytes(8)
    writeU32(indexSlot, 0, 0)
    writeU32(cpSlot, 0, 0)
    var at = 0
    var more = true
    var guard = 0
    while more && guard < 4096 {
        let produced = nextUtf8Scalar(path, 1000000, indexSlot, cpSlot)
        if produced == 0 {
            more = false
        } else {
            let codepoint = Int(readU32(cpSlot, 0))
            if codepoint == 0 || codepoint > 127 {
                // ASCII paths only — enough for the demo assets this serves.
                more = codepoint > 127
                if codepoint > 127 {
                    metalMemWriteU8(buf, at, 63)
                    at = at + 1
                }
            } else {
                metalMemWriteU8(buf, at, codepoint)
                at = at + 1
            }
        }
        guard = guard + 1
    }
    metalMemWriteU8(buf, at, 0)
    freeBytes(indexSlot)
    freeBytes(cpSlot)
    return buf
}

// Load a raw RGBA8 pixel blob into a sampled texture, returning the view a draw
// call takes — or why there is none.
//
// `path` names `width * height * 4` bytes, row-major, no header. The file is
// read through Foundation, which routes to `kira_rt_fs_*` on every backend, and
// uploaded through the Kira Graphics texture API — so this works wherever a
// Kira program runs rather than only where Metal did. Reaching into the Metal
// backend's Objective-C surface directly is what made every non-Apple host
// report the backdrop as missing whatever path it was handed.
//
// The reason travels with the failure. A file that is not there and a device
// that refused the upload are different problems with different fixes, and
// answering both with a zero is what hid the first one behind a message about
// the second.
function loadRgbaTexture(graphics: borrow Graphics, path: borrow String, width: Int, height: Int) -> Result<Int, ResourceFailure> {
    let total = width * height * 4
    let pixels = readFileRange(path, 0, total)
    if pixels.count != total {
        return .Error(.AssetUnreadable)
    }
    attempt {
        let texture = try graphics.createTextureFromPixels(TextureDescriptor {
            label: path
            width: width
            height: height
            format: .Rgba8Unorm
            usage: .Sampled
            sampleCount: 1
            storage: .Persistent
        }, pixels)
        return .Ok(Int(texture.viewId))
    } handle {
        DeviceRefused { return .Error(.DeviceRefused) }
        AssetUnreadable { return .Error(.AssetUnreadable) }
        ShaderRejected { return .Error(.ShaderRejected) }
    }
}

// Is `name` present in the environment with an EMPTY value? Loading cannot report
// this: a missing variable and a variable set to "" both fail to open a file and
// both return 0. The difference is intent — an empty value is a run saying "no
// image here", which callers use to skip their fallback paths entirely.
function environmentValueIsEmpty(name: borrow String) -> Bool {
    return environmentIsSet(name) && environmentValue(name).count == 0
}

// As above, but the path is the VALUE of environment variable `envName` (the
// image-dump-style hookup for scripted runs).
function loadRgbaTextureFromEnvironment(graphics: borrow Graphics, envName: borrow String, width: Int, height: Int) -> Result<Int, ResourceFailure> {
    if !environmentIsSet(envName) {
        return .Error(.AssetUnreadable)
    }
    return loadRgbaTexture(graphics, environmentValue(envName), width, height)
}

//   0  int   width
//   4  int   rows
//   8  int   bearing_x
//  12  int   bearing_y
//  16  float advance
//  20  int   pitch
//  24  const uint8_t* buffer
function glyphBitmapSize() -> U64 { return 32 }
function glyphWidthOffset() -> U64 { return 0 }
function glyphRowsOffset() -> U64 { return 4 }
function glyphBearingXOffset() -> U64 { return 8 }
function glyphBearingYOffset() -> U64 { return 12 }
function glyphAdvanceOffset() -> U64 { return 16 }
function glyphPitchOffset() -> U64 { return 20 }
function glyphBufferOffset() -> U64 { return 24 }

// kira_text_vmetrics: three floats (ascender, descender, line_height).
function verticalMetricsSize() -> U64 { return 12 }

// The gradient block that follows the material one: the colour the far end of
// the quad takes, and which way "far" runs.
//
// It is written for EVERY quad, including the flat ones, which write zeros. A
// record's slot is reused by whatever quad lands in it next, so a block left
// unwritten carries the last gradient that occupied it — a flat surface would
// inherit a fade from a quad two frames ago.
@Native
function writeQuadGradient(
    ptr: RawPtr, baseFloats: U64,
    r: Float, g: Float, b: Float, a: Float, axis: Float,
) {
    let bytes = (baseFloats + U64(54)) * U64(4)
    writeF32(ptr, bytes, r)
    writeF32(ptr, bytes + U64(4), g)
    writeF32(ptr, bytes + U64(8), b)
    writeF32(ptr, bytes + U64(12), a)
    writeF32(ptr, bytes + U64(16), axis)
    return
}
