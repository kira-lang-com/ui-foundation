import Foundation
import KiraGraphics
// Foreign surface for the batched UI compositor.
//
// The compositor renders the whole UI through the Kira Graphics public abstraction
// (buffers / pipeline / texture / draw — backend-agnostic, currently the from-scratch
// Metal path). The only direct FFI here is to the real font engine (glyph
// rasterization, the cross-platform equivalent of FreeType) and to the kira_runtime
// raw-memory helpers used to read the C glyph-bitmap struct and decode UTF-8. There
// is NO rendering shim: glyph coverage is rasterized, packed into a Kira Graphics
// atlas texture, and drawn as textured quads through the abstraction — the legacy
// immediate-mode kira_text_draw_run blit path is gone.

// ---------------------------------------------------------------------------
// kira_runtime raw memory helpers (read the glyph bitmap struct, decode UTF-8).
//
// A C symbol must have exactly one Kira @FFI.Extern binding across the whole linked
// program. Kira Graphics' Metal backend already binds most of the kira_runtime raw
// helpers (metalMemAlloc / metalMemReadU32 / ...), so the compositor REUSES those
// through thin @Native wrappers rather than re-declaring the same symbols here (a
// second binding would be dropped, leaving the call unresolved). Only the two helpers
// the Metal backend does not bind — read_i32_at and read_f32_at — are declared here.
// ---------------------------------------------------------------------------

// NOTE: only U32/U64/RawPtr/Bool-return FFI is known to lower in this toolchain;
// I32-RETURN and F32-RETURN do not. The engine's signed 32-bit int fields are read
// as u32 and sign-corrected (uiMemReadInt), and its 32-bit float fields are read as
// u32 and decoded (uiF32FromBits / uiMemReadFloat — see UiBatch.kira).

@Native
function uiMemAlloc(size: U64) -> RawPtr {
    return metalMemAlloc(size)
}
@Native
function uiMemFree(ptr: RawPtr) {
    metalMemFree(ptr)
    return
}
@Native
function uiMemWriteU32(ptr: RawPtr, offset: U64, value: U32) {
    metalMemWriteU32(ptr, offset, value)
    return
}
@Native
function uiMemWriteF32(ptr: RawPtr, offset: U64, value: Float) {
    metalMemWriteF32(ptr, offset, value)
    return
}
// Write one quad's record: the thirty floats the KSL `UiQuad` struct reads for
// every mode, in its field order (see uiBatchFloatsPerQuad in UiBatch.kira).
// `px`/`py` are pixel coordinates, which the fragment stage clips against; `pos`
// is the same point in clip space, with the y flip a top-left-origin UI needs.
//
// The clip position is computed HERE rather than in the vertex stage, so that the
// stage only ever selects between two stored numbers and the bytes reaching the
// rasterizer are the ones a per-vertex buffer used to hold.
//
// Written in Kira rather than behind a native fast-path symbol. A `kira_ui`
// library existed for this and no toolchain shipped one, so every call trapped
// by name on the platform the compositor actually runs on; a UI that needs a
// native library to draw a rectangle is not portable. The cost is per-float
// writes through the runtime's raw-memory helpers, which are on every native
// link line and need no platform to have anything.
@Native
function uiWriteQuadRecord(
    ptr: RawPtr, baseFloats: U64,
    px0: Float, py0: Float, px1: Float, py1: Float,
    lx0: Float, ly0: Float, lx1: Float, ly1: Float,
    vw: Float, vh: Float,
    halfW: Float, halfH: Float, radius: Float, borderWidth: Float, mode: Float,
    edgeRefraction: Float,
    fr: Float, fg: Float, fb: Float, fa: Float,
    br: Float, bg: Float, bb: Float, ba: Float,
    clipMinX: Float, clipMinY: Float, clipMaxX: Float, clipMaxY: Float,
) {
    let bytes = baseFloats * U64(4)
    uiMemWriteF32(ptr, bytes, px0 / vw * 2.0 - 1.0)
    uiMemWriteF32(ptr, bytes + U64(4), 1.0 - py0 / vh * 2.0)
    uiMemWriteF32(ptr, bytes + U64(8), px1 / vw * 2.0 - 1.0)
    uiMemWriteF32(ptr, bytes + U64(12), 1.0 - py1 / vh * 2.0)
    uiMemWriteF32(ptr, bytes + U64(16), px0)
    uiMemWriteF32(ptr, bytes + U64(20), py0)
    uiMemWriteF32(ptr, bytes + U64(24), px1)
    uiMemWriteF32(ptr, bytes + U64(28), py1)
    uiMemWriteF32(ptr, bytes + U64(32), lx0)
    uiMemWriteF32(ptr, bytes + U64(36), ly0)
    uiMemWriteF32(ptr, bytes + U64(40), lx1)
    uiMemWriteF32(ptr, bytes + U64(44), ly1)
    uiMemWriteF32(ptr, bytes + U64(48), halfW)
    uiMemWriteF32(ptr, bytes + U64(52), halfH)
    uiMemWriteF32(ptr, bytes + U64(56), radius)
    uiMemWriteF32(ptr, bytes + U64(60), borderWidth)
    uiMemWriteF32(ptr, bytes + U64(64), mode)
    uiMemWriteF32(ptr, bytes + U64(68), edgeRefraction)
    uiMemWriteF32(ptr, bytes + U64(72), fr)
    uiMemWriteF32(ptr, bytes + U64(76), fg)
    uiMemWriteF32(ptr, bytes + U64(80), fb)
    uiMemWriteF32(ptr, bytes + U64(84), fa)
    uiMemWriteF32(ptr, bytes + U64(88), br)
    uiMemWriteF32(ptr, bytes + U64(92), bg)
    uiMemWriteF32(ptr, bytes + U64(96), bb)
    uiMemWriteF32(ptr, bytes + U64(100), ba)
    uiMemWriteF32(ptr, bytes + U64(104), clipMinX)
    uiMemWriteF32(ptr, bytes + U64(108), clipMinY)
    uiMemWriteF32(ptr, bytes + U64(112), clipMaxX)
    uiMemWriteF32(ptr, bytes + U64(116), clipMaxY)
    return
}

// The material block that follows a record: what a liquid-glass surface shades
// itself with. Mode 3 is the only mode whose shader reads any of it, so it is the
// only mode that writes it.
@Native
function uiWriteQuadMaterial(
    ptr: RawPtr, baseFloats: U64,
    m0: Float, m1: Float, m2: Float, m3: Float,
    m4: Float, m5: Float, m6: Float, m7: Float,
    m8: Float, m9: Float, m10: Float, m11: Float,
    m12: Float, m13: Float, m14: Float, m15: Float,
    m16: Float, m17: Float, m18: Float, m19: Float,
    m20: Float, m21: Float, m22: Float, m23: Float,
) {
    let bytes = (baseFloats + U64(30)) * U64(4)
    uiMemWriteF32(ptr, bytes, m0)
    uiMemWriteF32(ptr, bytes + U64(4), m1)
    uiMemWriteF32(ptr, bytes + U64(8), m2)
    uiMemWriteF32(ptr, bytes + U64(12), m3)
    uiMemWriteF32(ptr, bytes + U64(16), m4)
    uiMemWriteF32(ptr, bytes + U64(20), m5)
    uiMemWriteF32(ptr, bytes + U64(24), m6)
    uiMemWriteF32(ptr, bytes + U64(28), m7)
    uiMemWriteF32(ptr, bytes + U64(32), m8)
    uiMemWriteF32(ptr, bytes + U64(36), m9)
    uiMemWriteF32(ptr, bytes + U64(40), m10)
    uiMemWriteF32(ptr, bytes + U64(44), m11)
    uiMemWriteF32(ptr, bytes + U64(48), m12)
    uiMemWriteF32(ptr, bytes + U64(52), m13)
    uiMemWriteF32(ptr, bytes + U64(56), m14)
    uiMemWriteF32(ptr, bytes + U64(60), m15)
    uiMemWriteF32(ptr, bytes + U64(64), m16)
    uiMemWriteF32(ptr, bytes + U64(68), m17)
    uiMemWriteF32(ptr, bytes + U64(72), m18)
    uiMemWriteF32(ptr, bytes + U64(76), m19)
    uiMemWriteF32(ptr, bytes + U64(80), m20)
    uiMemWriteF32(ptr, bytes + U64(84), m21)
    uiMemWriteF32(ptr, bytes + U64(88), m22)
    uiMemWriteF32(ptr, bytes + U64(92), m23)
    return
}
@Native
function uiMemReadU32(ptr: RawPtr, offset: U64) -> U32 {
    return metalMemReadU32(ptr, offset)
}
@Native
function uiMemReadPtr(ptr: RawPtr, offset: U64) -> RawPtr {
    return metalMemReadPtr(ptr, offset)
}
@Native
function uiNullPtr() -> RawPtr {
    return metalNullPtr()
}
@Native
function uiPtrIsNull(ptr: RawPtr) -> Bool {
    return metalPtrIsNull(ptr)
}

// ---------------------------------------------------------------------------
// Font engine (real glyph rasterization). Declared with RawPtr/primitive shapes so
// the C glyph-bitmap struct can be read field-by-field through the helpers above.
// ---------------------------------------------------------------------------

@FFI.Extern { library: kiratext; symbol: kira_text_engine_create; abi: c; }
function uiTextEngineCreate(): RawPtr;
@FFI.Extern { library: kiratext; symbol: kira_text_face_load; abi: c; }
function uiTextFaceLoad(engine: RawPtr, path: CString, faceIndex: I32): RawPtr;
@FFI.Extern { library: kiratext; symbol: kira_text_face_set_pixel_size; abi: c; }
function uiTextFaceSetPixelSize(face: RawPtr, pixelSize: F32): I32;
@FFI.Extern { library: kiratext; symbol: kira_text_face_glyph_index; abi: c; }
function uiTextFaceGlyphIndex(face: RawPtr, codepoint: U32): U32;
@FFI.Extern { library: kiratext; symbol: kira_text_face_render_glyph; abi: c; }
function uiTextFaceRenderGlyph(face: RawPtr, glyphIndex: U32, out: RawPtr): I32;
// Subpixel-positioned rasterization: the outline is shifted by xOffset26_6 (64 to a
// pixel) before it is scan-converted, so coverage is computed for where the glyph
// actually lands rather than computed once and resampled. Both entry points render
// UNHINTED, which is the other half of what makes macOS text look the way it does.
@FFI.Extern { library: kiratext; symbol: kira_text_face_render_glyph_offset; abi: c; }
function uiTextFaceRenderGlyphOffset(face: RawPtr, glyphIndex: U32, xOffset26_6: I32, out: RawPtr): I32;
@FFI.Extern { library: kiratext; symbol: kira_text_face_vmetrics; abi: c; }
function uiTextFaceVMetrics(face: RawPtr, out: RawPtr): Void;
@FFI.Extern { library: kiratext; symbol: kira_text_utf8_next; abi: c; }
function uiTextUtf8Next(s: CString, len: I32, indexPtr: RawPtr, codepointPtr: RawPtr): I32;
@FFI.Extern { library: kiratext; symbol: kira_text_decode_codepoints; abi: c; }
function uiTextDecodeCodepoints(s: CString, out: RawPtr, max: I32): I32;

// ---------------------------------------------------------------------------
// Icon engine (SVG-subset rasterizer, NativeLibs/Icon): coverage bitmaps packed
// into the same atlas as glyphs and drawn as tinted mode-1 quads.
// ---------------------------------------------------------------------------

@FFI.Extern { library: kiraicon; symbol: kira_icon_hash; abi: c; }
function uiIconHash(svg: CString): I64;
@FFI.Extern { library: kiraicon; symbol: kira_icon_rasterize; abi: c; }
function uiIconRasterize(svg: CString, px: I32, outBuffer: RawPtr): I32;
// Immediate-mode icon draw for the legacy (non-Metal-batch) path — the icon
// counterpart of kira_text_draw_run: rasterizes (cached per icon+size) and
// blits the tinted coverage through kg_ui_blit_coverage. This is what draws
// icons on the Sokol path, including WebGPU on wasm32-emscripten.
@FFI.Extern { library: kiraicon; symbol: kira_icon_draw_run; abi: c; }
function uiIconDrawRun(svg: CString, x: F64, y: F64, w: F64, h: F64, r: F64, g: F64, b: F64, a: F64): Void;

// libc fread — the only raw-file symbol the linked program does not already bind
// (fopen/fwrite/fclose live in the Metal backend's foreign surface and are reused
// below through their Kira functions; a second @FFI.Extern binding of the same C
// symbol would be dropped).
@FFI.Extern { library: kiratext; symbol: fread; abi: c; }
function uiFRead(ptr: RawPtr, size: U64, count: U64, stream: RawPtr): U64;

// Copy a Kira string's UTF-8 bytes into a NUL-terminated C buffer (caller frees).
// Needed because fopen's one program-wide binding takes a RawPtr path (the shape
// the image-dump hook needed for getenv-returned paths).
@Native
function uiCPathAlloc(path: borrow String) -> RawPtr {
    let buf = uiMemAlloc(U64(path.count * 4 + 1))
    let indexSlot = uiMemAlloc(8)
    let cpSlot = uiMemAlloc(8)
    uiMemWriteU32(indexSlot, 0, 0)
    uiMemWriteU32(cpSlot, 0, 0)
    var at = 0
    var more = true
    var guard = 0
    while more && guard < 4096 {
        let produced = uiTextUtf8Next(path, 1000000, indexSlot, cpSlot)
        if produced == 0 {
            more = false
        } else {
            let codepoint = Int(uiMemReadU32(cpSlot, 0))
            if codepoint == 0 || codepoint > 127 {
                // ASCII paths only — enough for the demo assets this serves.
                more = codepoint > 127
                if codepoint > 127 {
                    metalMemWriteU8(buf, at, 63)
                    at = at + 1
                }
            } else {
                metalMemWriteU8(buf, at, codepoint)
                at = at + 1
            }
        }
        guard = guard + 1
    }
    metalMemWriteU8(buf, at, 0)
    uiMemFree(indexSlot)
    uiMemFree(cpSlot)
    return buf
}

// Load a raw RGBA8 pixel blob (width*height*4 bytes, row-major, no header) from
// `path`, upload it into a new registered sampled texture, and return the texture
// id (0 on any failure). Metal path only — id 0 elsewhere. Intended for
// demo/example backdrops shown through a TextureView.
@Native
function uiLoadRgbaTextureFile(graphics: borrow Graphics, path: borrow String, width: Int, height: Int) -> Int {
    let ctx = graphics.metalContext
    if uiPtrIsNull(ctx) {
        return 0
    }
    let cPath = uiCPathAlloc(path)
    let stream = metalFOpen(cPath, "rb")
    uiMemFree(cPath)
    if uiPtrIsNull(stream) {
        return 0
    }
    let total = width * height * 4
    let buf = uiMemAlloc(U64(total))
    let readCount = uiFRead(buf, 1, U64(total), stream)
    metalFClose(stream)
    if Int(readCount) != total {
        uiMemFree(buf)
        return 0
    }
    let textureId = metalCreateTexture(ctx, width, height)
    let region = uiMemAlloc(48)
    metalMemWriteU64(region, 0, 0)
    metalMemWriteU64(region, 8, 0)
    metalMemWriteU64(region, 16, 0)
    metalMemWriteU64(region, 24, width)
    metalMemWriteU64(region, 32, height)
    metalMemWriteU64(region, 40, 1)
    metalMsgSendReplaceRegion(metalLookup(ctx, textureId), metalSel("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), region, 0, buf, U64(width * 4))
    uiMemFree(region)
    uiMemFree(buf)
    // A backdrop loads once and is then sampled every frame — by the fullscreen
    // TextureView, the glass sharp taps, and the blur chain's source read — so
    // trade one blit now for the GPU-optimal layout all of them sample.
    metalOptimizeTextureForGpu(ctx, textureId)
    return textureId
}

// Is `name` present in the environment with an EMPTY value? Loading cannot report
// this: a missing variable and a variable set to "" both fail to open a file and
// both return 0. The difference is intent — an empty value is a run saying "no
// image here", which callers use to skip their fallback paths entirely.
function uiEnvValueIsEmpty(name: borrow String) -> Bool {
    return environmentIsSet(name) && environmentValue(name).count == 0
}

// As above, but the path is the VALUE of environment variable `envName` (the
// image-dump-style hookup for scripted runs).
@Native
function uiLoadRgbaTextureFromEnv(graphics: borrow Graphics, envName: borrow String, width: Int, height: Int) -> Int {
    let ctx = graphics.metalContext
    if uiPtrIsNull(ctx) {
        return 0
    }
    let path = metalGetEnv(envName)
    if uiPtrIsNull(path) {
        return 0
    }
    let stream = metalFOpen(path, "rb")
    if uiPtrIsNull(stream) {
        return 0
    }
    let total = width * height * 4
    let buf = uiMemAlloc(U64(total))
    let readCount = uiFRead(buf, 1, U64(total), stream)
    metalFClose(stream)
    if Int(readCount) != total {
        uiMemFree(buf)
        return 0
    }
    let textureId = metalCreateTexture(ctx, width, height)
    let region = uiMemAlloc(48)
    metalMemWriteU64(region, 0, 0)
    metalMemWriteU64(region, 8, 0)
    metalMemWriteU64(region, 16, 0)
    metalMemWriteU64(region, 24, width)
    metalMemWriteU64(region, 32, height)
    metalMemWriteU64(region, 40, 1)
    metalMsgSendReplaceRegion(metalLookup(ctx, textureId), metalSel("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), region, 0, buf, U64(width * 4))
    uiMemFree(region)
    uiMemFree(buf)
    // A backdrop loads once and is then sampled every frame — by the fullscreen
    // TextureView, the glass sharp taps, and the blur chain's source read — so
    // trade one blit now for the GPU-optimal layout all of them sample.
    metalOptimizeTextureForGpu(ctx, textureId)
    return textureId
}

// @Native bridges so non-native code (app wiring, the render backend) can obtain a
// null RawPtr and test pointers without using the FFI symbols directly.
@Native
function uiBatchNullPtr() -> RawPtr {
    return uiNullPtr()
}

@Native
function uiBatchPtrIsNull(ptr: RawPtr) -> Bool {
    return uiPtrIsNull(ptr)
}

// kira_text_glyph_bitmap field offsets (C layout):
//   0  int   width
//   4  int   rows
//   8  int   bearing_x
//  12  int   bearing_y
//  16  float advance
//  20  int   pitch
//  24  const uint8_t* buffer
function uiGlyphBitmapSize() -> U64 { return 32 }
function uiGlyphOffWidth() -> U64 { return 0 }
function uiGlyphOffRows() -> U64 { return 4 }
function uiGlyphOffBearingX() -> U64 { return 8 }
function uiGlyphOffBearingY() -> U64 { return 12 }
function uiGlyphOffAdvance() -> U64 { return 16 }
function uiGlyphOffPitch() -> U64 { return 20 }
function uiGlyphOffBuffer() -> U64 { return 24 }

// kira_text_vmetrics: three floats (ascender, descender, line_height).
function uiVMetricsSize() -> U64 { return 12 }
