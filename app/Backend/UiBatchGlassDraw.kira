import Foundation
import KiraGraphics
// Liquid glass, the drawing side: the blur pyramid, and presenting a cached
// interior.
//
// The blur is iterative rather than one wide kernel — a 3x3 gaussian run several
// times reaches the same radius for a fraction of the taps, and the intermediate
// levels are exactly the near/far the material wants anyway. The interior cache
// is a second target the unchanged core of a surface is copied out of, so a frame
// where nothing about a glass surface moved shades only its edges.

// One fullscreen blur tap: bind the blur pipeline, the direction/resolution params
// (vertex buffer 0) and the input texture (slot 0), and draw the vertex_id triangle.
@Native
function drawBlurPass(encoder: borrow mut RenderEncoder, pipeline: borrow RenderPipeline, params: borrow BindGroup, inputGroup: borrow BindGroup) {
    encoder.setPipeline(pipeline)
    encoder.setBindGroup(0, inputGroup)
    encoder.setBindGroup(1, params)
    encoder.draw(3)
    return
}

// The blur pyramid drawn as render passes, for a backend that cannot encode a
// compute dispatch — and, through KIRA_GLASS_REFERENCE, live even where one can,
// so an effect comparison exercises this application and compositor rather than
// a stale offline image.
//
// Four passes, the same four halves `dispatchTextureComputePair` runs: each
// level filtered along x into its own intermediate, then along y into the level
// the material samples. The compute pair writes both levels per dispatch because
// a kernel may store to two images; a fragment stage writes one target, which is
// the only difference between the two encodings. `Shaders/UiBlur.ksl` and
// `Shaders/UiGlassBlur{H,V}.ksl` call the same two filters, so the images agree.
//
// Native like the pass it belongs to. `beginRenderPass` and `endPass` mutate the
// frame, and a struct receiver has no seam representation, so a mutating call is
// always same-engine: leaving this half on the VM put one across the seam and the
// bytecode compiler refused the program (`MutCallAcrossSeam`). Its only caller is
// the native presentBatch and its only callee the native drawBlurPass, so the
// annotation is what the code already was everywhere except here.
@Native
function glassDrawnBlur(
    frame: borrow mut RenderFrame,
    state: borrow mut UiBatchState,
    layer: Int,
    blurPipeline: borrow RenderPipeline,
) {
    let sceneGroup = state.glassLayers[layer].sceneBlurInGroup
    var nearH = frame.beginRenderPass(glassTexturePass("kira-ui-glass-blur-near-h-pass", state.blurTextureA, 0.0, 0.0, 0.0, 1.0))
    drawBlurPass(nearH, blurPipeline, state.blurParamsNearHGroup, sceneGroup)
    frame.endPass()

    var farH = frame.beginRenderPass(glassTexturePass("kira-ui-glass-blur-far-h-pass", state.blurTextureB, 0.0, 0.0, 0.0, 1.0))
    drawBlurPass(farH, blurPipeline, state.blurParamsFarHGroup, sceneGroup)
    frame.endPass()

    var nearV = frame.beginRenderPass(glassTexturePass("kira-ui-glass-blur-near-v-pass", state.glassLayers[layer].nearTexture, 0.0, 0.0, 0.0, 1.0))
    drawBlurPass(nearV, blurPipeline, state.blurParamsNearVGroup, state.blurInputAGroup)
    frame.endPass()

    var farV = frame.beginRenderPass(glassTexturePass("kira-ui-glass-blur-far-v-pass", state.glassLayers[layer].blurTexture, 0.0, 0.0, 0.0, 1.0))
    drawBlurPass(farV, blurPipeline, state.blurParamsFarVGroup, state.blurInputBGroup)
    frame.endPass()
    return
}

// The sharp tap (slot 1) and blurred backdrop (slot 2) stream `stream` draws with:
// stream 0 sits under all glass and takes the frame's defaults, and stream j
// refracts glass layer j-1's capture. Returned as the bind group ids
// drawStream takes.
function glassSharpStreamGroup(state: borrow mut UiBatchState, stream: Int) -> BindGroup {
    if stream <= 0 {
        return emptyBindGroup()
    }
    if stream == 1 && state.directBackdropLayer0 {
        return state.directBackdropSharpGroup
    }
    return state.glassLayers[stream - 1].sceneSharpGroup
}

// Both blurred levels, in the one group they share.
function glassSoftNearStreamGroup(state: borrow mut UiBatchState, stream: Int) -> BindGroup {
    if stream <= 0 {
        return emptyBindGroup()
    }
    return state.glassLayers[stream - 1].softNearGroup
}

// Draw everything below `layer + 1` once. Capture callers may invoke this under
// several scissors; the opaque background draw resets an overlapping region before
// the same premultiplied UI is replayed, so overlapping padded bounds remain exact.
// Native: it mutates the encoder, and a struct receiver has no seam
// representation, so the call is always same-engine (see glassIterativeBlur).
extend UiBatch {
    function glassDrawCaptureContents(state: borrow mut UiBatchState, encoder: borrow mut RenderEncoder, layer: Int) {
        drawBackground(state, encoder)
        var captured = 0
        while captured <= layer {
            self.drawStream(
                encoder,
                captured,
                state.streams[captured].quadCount,
                glassSharpStreamGroup(state, captured),
                glassSoftNearStreamGroup(state, captured),
                emptyBindGroup()
            )
            captured = captured + 1
        }
        return
    }
}


// Add one capture bound, coalescing overlap with an existing region. Bounds arrive
// in layout order; adjacent swatches and dock controls therefore fold into one
// growing union instead of replaying their overlapping blur halos independently.
function glassMergeCaptureBound(state: borrow mut UiBatchState, x0: Float, y0: Float, x1: Float, y1: Float) {
    var i = 0
    while i < state.captureRectCount {
        let base = i * 4
        let rx0 = state.captureRects[base]
        let ry0 = state.captureRects[base + 1]
        let rx1 = state.captureRects[base + 2]
        let ry1 = state.captureRects[base + 3]
        if x0 <= rx1 && x1 >= rx0 && y0 <= ry1 && y1 >= ry0 {
            if x0 < rx0 { state.captureRects[base] = x0 }
            if y0 < ry0 { state.captureRects[base + 1] = y0 }
            if x1 > rx1 { state.captureRects[base + 2] = x1 }
            if y1 > ry1 { state.captureRects[base + 3] = y1 }
            return
        }
        i = i + 1
    }
    let base = state.captureRectCount * 4
    if base + 3 < state.captureRects.count {
        state.captureRects[base] = x0
        state.captureRects[base + 1] = y0
        state.captureRects[base + 2] = x1
        state.captureRects[base + 3] = y1
    } else {
        state.captureRects.append(x0)
        state.captureRects.append(y0)
        state.captureRects.append(x1)
        state.captureRects.append(y1)
    }
    state.captureRectCount = state.captureRectCount + 1
    return
}

// Present the frame. With no glass this is the classic single swapchain pass. With
// glass it runs one liquid-glass chain PER LAYER — the streams under layer k into
// layer k's capture (points-sized, feeding the blur pyramid), separable half-res
// blur, and then one swapchain pass drawing every stream in order at FULL
// resolution, each glass layer refracting its own blurred capture. Stacked glass
// therefore refracts the glass beneath it, and the streams below each layer are the
// only content its capture holds — no layer ever refracts itself.
// Create (or re-create after a resize) the interior-cache texture, its
// nearest-texel sampler and the bind group that rides the atlas slot around
// copy runs. A fresh texture invalidates every key: nothing cached yet.
function glassEnsureInteriorCache(state: borrow mut UiBatchState, graphics: borrow Graphics) {
    // Drawable pixels, not logical points: the cache must hold one texel per
    // device pixel or the copies re-present an upscale.
    let cacheW = Int(state.viewportW * state.scale)
    let cacheH = Int(state.viewportH * state.scale)
    if state.glassCacheTexture.id != 0 && state.glassCacheW == cacheW && state.glassCacheH == cacheH {
        return
    }
    if state.glassCacheGroup.id != 0 {
        glassDestroyBindGroup(graphics, state.glassCacheGroup)
        state.glassCacheGroup = emptyBindGroup()
    }
    if state.glassCacheTexture.id != 0 {
        glassDestroyTexture(graphics, state.glassCacheTexture)
        state.glassCacheTexture = emptyGraphicsTexture()
    }
    if cacheW <= 0 || cacheH <= 0 {
        return
    }
    let cacheTex = textureOrReport(graphics.createTexture(TextureDescriptor {
        label: "kira-ui-glass-interior-cache"
        width: cacheW
        height: cacheH
        format: .Swapchain
        usage: .RenderTargetSampled
        sampleCount: 1
        storage: .Transient
    }), "glass interior cache")
    if state.glassCacheSampler.id == 0 {
        // Nearest: a copy fragment lands exactly on its texel centre, and
        // nearest guarantees the fetch returns that texel's bytes unchanged.
        state.glassCacheSampler = samplerOrReport(graphics.createSampler(SamplerDescriptor {
            label: "kira-ui-glass-cache-nearest"
            minFilter: .Nearest
            magFilter: .Nearest
            addressModeU: .ClampToEdge
            addressModeV: .ClampToEdge
        }), "glass cache sampler")
    }
    let sampler = state.glassCacheSampler
    let group = bindGroupOrReport(graphics.beginBindGroup("kira-ui-glass-cache"), "group")
    graphics.bindGroupAddTexture(group, atlasTextureSlot(), cacheTex)
    graphics.bindGroupAddSampler(group, atlasSamplerSlot(), sampler)
    state.glassCacheTexture = cacheTex
    state.glassCacheGroup = group
    state.glassCacheW = cacheW
    state.glassCacheH = cacheH
    state.glassCacheCleared = false
    // A fresh texture holds nothing: bump the epoch (folded into every key)
    // so each surface misses once and re-renders into it.
    state.glassCacheEpochValue = state.glassCacheEpochValue + 1
    return
}

// The cache pass: clear on first use, preserve previously cached interiors on
// every later one.
function glassInteriorCachePass(state: borrow mut UiBatchState) -> RenderPassDescriptor {
    var load: LoadAction = .Load
    if !state.glassCacheCleared {
        load = .Clear
    }
    let attachment = ColorAttachment {
        target: RenderTarget {
            kind: .Texture
            texture: state.glassCacheTexture
            mipLevel: 0
            arrayLayer: 0
        }
        loadAction: load
        storeAction: .Store
        clearColor: Color { r: 0.0 g: 0.0 b: 0.0 a: 0.0 }
        resolveTarget: emptyRenderTarget()
        hasResolveTarget: false
    }
    return RenderPassDescriptor {
        label: "kira-ui-glass-interior-cache-pass"
        colorAttachments: [attachment]
        primaryColorAttachment: attachment
        hasPrimaryColorAttachment: true
        depthAttachment: emptyDepthAttachment()
        hasDepthAttachment: false
        stencilAttachment: emptyStencilAttachment()
        hasStencilAttachment: false
    }
}

// Re-render each dirty surface's interior quads into the cache with the same
// pipelines, bind groups and index ranges the live path would use — the cache
// holds exactly the bytes the composite would have produced.
function glassDrawCacheRanges(state: borrow mut UiBatchState, encoder: borrow mut RenderEncoder) {
    encoder.setIndexBuffer(state.indexBuffer, .Uint32)
    encoder.setBindGroup(atlasBindGroup(), state.atlasGroup)
    var r = 0
    while r < state.glassCacheRangeCount {
        let stream = state.glassCacheRangeStream[r]
        if state.probeGlassLayers {
            print(717272)
            print(r)
            print(stream)
            print(state.glassCacheRangeStart[r])
            print(state.glassCacheRangeBand[r])
            print(state.glassCacheRangeLens[r])
            print(state.glassCacheRangeCore[r])
        }
        encoder.setBindGroup(vertexBindGroup(), state.streams[stream].vertsGroup)
        encoder.setBindGroup(externalBindGroup(), glassSharpStreamGroup(state, stream))
        encoder.setBindGroup(softNearBindGroup(), glassSoftNearStreamGroup(state, stream))
        // One pipeline for the whole interior: the band shader is byte-equal
        // to the full glass branch everywhere at least 0.5pt inside (verified
        // by whole-frame compare), so the cache holds exactly the bytes the
        // composite would produce. The lens/core split only matters for
        // per-frame cost, and a cache render is a rare, one-off frame.
        let total = state.glassCacheRangeBand[r] + state.glassCacheRangeLens[r] + state.glassCacheRangeCore[r]
        encoder.setPipeline(state.glassBandPipeline)
        encoder.drawIndexedRange(total * 6, state.glassCacheRangeStart[r] * 6)
        r = r + 1
    }
    return
}

