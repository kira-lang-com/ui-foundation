import KiraLayout
import KiraGraphics
import Foundation
struct FoundationHitRegionRecord {
    let key: Int = 0
    let bounds: Rect
    let disabled: Bool = false
    let focusable: Bool = false
    let autofocus: Bool = false
    let onPress: () -> Void
    let onTextInput: (String) -> Void = foundationNoopTextInput
    let onTextCodepoint: (Int) -> Void = foundationNoopTextCodepoint
    let onBackspace: () -> Void = foundationNoopPress
    let onSubmit: () -> Void = foundationNoopPress
    let onKey: (Int) -> Void = foundationNoopTextCodepoint
    let onScroll: (Float, Float) -> Void = foundationNoopScroll
    // Whether this region is what a wheel turn over it moves. A row inside a
    // list is under the pointer too, and it is not the thing that scrolls.
    let wheel: Bool = false
    let interaction: FoundationInteraction = FoundationInteraction {}
}

// Drop the last saved clip rect (4 floats) off the stack, returning the shorter array.
function foundationPopClipStack(stack: [Float]) -> [Float] {
    var out: [Float] = []
    let keep = stack.count - 4
    var i = 0
    while i < keep {
        out.append(stack[i])
        i = i + 1
    }
    return out
}

// Drop the last float off a stack (the saved clip radius).
function foundationPopOneFloat(stack: [Float]) -> [Float] {
    var out: [Float] = []
    let keep = stack.count - 1
    var i = 0
    while i < keep {
        out.append(stack[i])
        i = i + 1
    }
    return out
}

// The Foundation render backend. Every primitive is accumulated into a single
// batched draw through the Kira Graphics abstraction (UiBatch): the backdrop is
// captured, blurred through the pyramid and refracted by the glass shaders, and
// the whole frame reaches the GPU as one quad stream per layer. The backend is
// constructed per frame; the batch (atlas, glyph cache, GPU resources) persists
// in the app state and is reached here through `batch`.
//
// There was a second, immediate-mode path beside this one, selected by a flag
// that was really asking "am I Metal". It had no capture and no blur at all —
// its LiquidGlass material was a flat translucent tint — so every backend but
// Metal drew something the application is not. It is gone: both backends run the
// retained path, and a build with no system font rasterizes from the face
// compiled into the text library rather than falling back to another renderer.
class KiraGraphicsFoundationBackend {
    var graphics: Graphics
    var batch: UiBatch
    // Whether the WINDOW is composited with holes in it. A window-backdrop
    // surface is a hole, and a hole in a window that has none is a magenta
    // rectangle — so where the window cannot carry one, the surface draws in
    // its own colour like any other.
    var windowTransparent: Bool = false
    var hitRegions: [FoundationHitRegionRecord] = []
    var clipDepth: Int = 0
    var backdropDepth: Int = 0
    var offscreenDepth: Int = 0
    var drewVisibleUi: Bool = false
    // Current (intersected) clip rect in pixel space, and the saved-parent stack.
    var clipMinX: Float = 0.0
    var clipMinY: Float = 0.0
    var clipMaxX: Float = 1000000.0
    var clipMaxY: Float = 1000000.0
    var clipStack: [Float] = []
    // Corner radius of the innermost clip. The batch clip itself is rectangular;
    // rounding is realized by transferring this radius onto any fill quad that
    // exactly covers the clip rect (the `.background(...).cornerRadius(...)`
    // pill idiom lowers to a radius-0 tint filling a rounded clip surface).
    var clipRadius: Float = 0.0
    var clipRadiusStack: [Float] = []
    // Set by a LiquidGlass beginBackdrop: the surface's next fill quad is skipped
    // (its fill became the shader-side adaptive wash); the border still draws.
    var suppressNextFill: Bool = false
    // The wash of the glass surface currently being filled — strength and the
    // luminance of its colour — so adaptive text drawn on it can mix back what the
    // capture underneath does not contain.
    var glassWash: Float = 0.0
    var glassWashLuma: Float = 1.0
    // The enclosing surfaces' washes, so glass inside glass restores what it was
    // sitting on when it closes rather than dropping the whole subtree back to bare
    // capture. Pushed by every beginBackdrop and popped by every endBackdrop, glass
    // or not, so the two stay balanced whatever the material.
    var glassWashStack: [Float] = []
    var glassWashLumaStack: [Float] = []

    function beginFrame(width: Int, height: Int) {
        self.hitRegions = []
        self.clipDepth = 0
        self.backdropDepth = 0
        self.offscreenDepth = 0
        self.drewVisibleUi = false
        self.clipStack = []
        self.glassWash = 0.0
        self.glassWashLuma = 1.0
        self.glassWashStack = []
        self.glassWashLumaStack = []
        self.clipMinX = 0.0
        self.clipMinY = 0.0
        self.clipMaxX = intAsFloat(value: width)
        self.clipMaxY = intAsFloat(value: height)

        // The logical viewport is the drawable divided by the scale, so forcing
        // the scale trades logical AREA for device pixels per point — which is
        // exactly what a denser display gives, and the only way to see it on a
        // panel that has not got the pixels.
        let renderScale = foundationRenderScale(self.graphics.backingScale())
        let logicalW = intAsFloat(value: self.graphics.contextWidth()) / renderScale
        let logicalH = intAsFloat(value: self.graphics.contextHeight()) / renderScale
        self.clipMaxX = logicalW
        self.clipMaxY = logicalH

        self.batch.beginBatch(
            logicalW,
            logicalH,
            renderScale,
            self.graphics.contextWidth(),
            self.graphics.contextHeight()
        )
        // Claim this frame's slot in each vertex stream before anything emits into
        // one; the frames still on the GPU keep theirs.
        self.batch.beginFrameSlots(self.graphics)
        // No page-colour quad: the capture and presentation passes already clear
        // to it, so emitting an opaque fullscreen quad shaded every 4K pixel
        // again and was invisible under any application content.
        return
    }

    // Begin a HUD-only walk. The clip state is reset exactly as beginFrame resets
    // it, but the batch is NOT rewound: the UI streams keep the vertices, counts and
    // ring slots the last full frame left them, and everything emitted from here
    // until endHudFrame lands in the HUD's own stream.
    function beginHudFrame(width: Int, height: Int) {
        self.clipDepth = 0
        self.backdropDepth = 0
        self.offscreenDepth = 0
        self.clipStack = []
        self.clipRadiusStack = []
        self.clipRadius = 0.0
        self.glassWash = 0.0
        self.glassWashLuma = 1.0
        self.glassWashStack = []
        self.glassWashLumaStack = []
        self.clipMinX = 0.0
        self.clipMinY = 0.0
        self.clipMaxX = intAsFloat(value: width)
        self.clipMaxY = intAsFloat(value: height)
        self.batch.beginHud(self.graphics)
        return
    }

    function endHudFrame() {
        self.batch.endHud()
        return
    }

    function pushClip(frame: borrow Rect, radius: Float) {
        self.clipStack.append(self.clipMinX)
        self.clipStack.append(self.clipMinY)
        self.clipStack.append(self.clipMaxX)
        self.clipStack.append(self.clipMaxY)
        self.clipRadiusStack.append(self.clipRadius)
        self.clipRadius = radius
        var nx0 = frame.x
        if self.clipMinX > nx0 {
            nx0 = self.clipMinX
        }
        var ny0 = frame.y
        if self.clipMinY > ny0 {
            ny0 = self.clipMinY
        }
        var nx1 = frame.x + frame.width
        if self.clipMaxX < nx1 {
            nx1 = self.clipMaxX
        }
        var ny1 = frame.y + frame.height
        if self.clipMaxY < ny1 {
            ny1 = self.clipMaxY
        }
        self.clipMinX = nx0
        self.clipMinY = ny0
        self.clipMaxX = nx1
        self.clipMaxY = ny1
        self.clipDepth = self.clipDepth + 1
        return
    }

    function popClip() {
        if self.clipDepth > 0 {
            let n = self.clipStack.count
            if n >= 4 {
                self.clipMinX = self.clipStack[n - 4]
                self.clipMinY = self.clipStack[n - 3]
                self.clipMaxX = self.clipStack[n - 2]
                self.clipMaxY = self.clipStack[n - 1]
                self.clipStack = foundationPopClipStack(self.clipStack)
            }
            let rn = self.clipRadiusStack.count
            if rn >= 1 {
                self.clipRadius = self.clipRadiusStack[rn - 1]
                self.clipRadiusStack = foundationPopOneFloat(self.clipRadiusStack)
            }
            self.clipDepth = self.clipDepth - 1
        }
        return
    }

    function drawSurface(bounds: borrow Rect, paint: borrow FoundationSurfacePaint) {
        drawSurfaceFields(bounds, paint.fill, paint.border, paint.borderWidth, paint.radius)
        return
    }

    function drawSurfaceFields(
        bounds: borrow Rect,
        fill: borrow Color,
        border: borrow Color,
        borderWidth: Float,
        radius: Float,
        // The far end of a gradient fill and the direction it runs. A flat
        // surface leaves them alone and draws exactly as it did.
        fillEnd: borrow Color = Color { a: 0.0 },
        gradient: borrow FoundationGradient = FoundationGradient.None,
    ) {
        self.drewVisibleUi = true
        if environmentIsSet("KIRA_UI_DUMP_LAYOUT") {
            printLine(
                "paint x=" + String(bounds.x) + " y=" + String(bounds.y)
                    + " w=" + String(bounds.width) + " h=" + String(bounds.height)
                    + " r=" + String(radius)
            )
        }
        if self.suppressNextFill {
            self.suppressNextFill = false
            let noFill = Color {
                r: 0.0
                g: 0.0
                b: 0.0
                a: 0.0
            }
            self.batch.pushRect(bounds.x, bounds.y, bounds.width, bounds.height, noFill, border, borderWidth, radius, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY)
            return
        }
        // Rounded-clip realization: the batch clip is rectangular, so a square
        // fill that exactly covers the innermost ROUNDED clip (the pill idiom:
        // `.background(tint).cornerRadius(r)`) inherits the clip's radius here.
        var effectiveRadius = radius
        if radius <= 0.0 && self.clipRadius > 0.0 {
            let dx0 = bounds.x - self.clipMinX
            let dy0 = bounds.y - self.clipMinY
            let dx1 = self.clipMaxX - (bounds.x + bounds.width)
            let dy1 = self.clipMaxY - (bounds.y + bounds.height)
            if dx0 > 0.0 - 1.5 && dx0 < 1.5 && dy0 > 0.0 - 1.5 && dy0 < 1.5 && dx1 > 0.0 - 1.5 && dx1 < 1.5 && dy1 > 0.0 - 1.5 && dy1 < 1.5 {
                effectiveRadius = self.clipRadius
            }
        }
        self.batch.pushRect(
            bounds.x, bounds.y, bounds.width, bounds.height,
            fill, border, borderWidth, effectiveRadius,
            self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY,
            0.0,
            fillEnd, foundationGradientAxis(gradient)
        )
        return
    }

    // TextureView: register the external texture with the batch (slot-1 bind group,
    // cached per id) and emit its mode-2 quad.
    //
    // TextureView carries its own rounded mask so an engine target remains a
    // self-contained editor viewport instead of leaking through its corners.
    function drawTextureFields(bounds: borrow Rect, texture: Int, secondaryTexture: Int, transition: Float, opacity: Float, radius: Float) {
        self.drewVisibleUi = true
        if texture <= 0 {
            return
        }
        self.batch.setExternalTextures(self.graphics, U32(texture), U32(secondaryTexture))
        self.batch.pushExternalRect(bounds.x, bounds.y, bounds.width, bounds.height, opacity, transition, radius, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY)
        return
    }

    function drawSquircleSurface(bounds: borrow Rect, paint: borrow FoundationSurfacePaint) {
        drawSquircleSurfaceFields(bounds, paint.fill, paint.border, paint.borderWidth, paint.radius)
        return
    }

    function drawSquircleSurfaceFields(bounds: borrow Rect, fill: borrow Color, border: borrow Color, borderWidth: Float, radius: Float) {
        self.drewVisibleUi = true
        if environmentIsSet("KIRA_UI_DUMP_LAYOUT") {
            printLine(
                "paint squircle x=" + String(bounds.x) + " y=" + String(bounds.y)
                    + " w=" + String(bounds.width) + " h=" + String(bounds.height)
            )
        }
        self.batch.pushRect(bounds.x, bounds.y, bounds.width, bounds.height, fill, border, borderWidth, radius, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY, 0.25)
        return
    }

    function drawText(bounds: borrow Rect, paint: borrow FoundationTextPaint) {
        drawTextFields(bounds, paint.content, paint.color, paint.size, paint.weight, false)
        return
    }

    function drawTextFields(bounds: borrow Rect, content: borrow String, color: borrow Color, size: Float, weight: Float, adaptiveInk: Bool, inkLeft: Float = 0.0, inkRight: Float = 0.0, inkTop: Float = 0.0, inkBottom: Float = 0.0) {
        self.drewVisibleUi = true
        if environmentIsSet("KIRA_UI_DUMP_LAYOUT") && content.count <= 3 {
            printLine(
                "paint text '" + content + "' x=" + String(bounds.x) + " w=" + String(bounds.width)
                    + " advance=" + String(foundationTextRunWidth(content: content, size: size, weight: weight))
                    + " inkL=" + String(foundationTextRunInkLeft(content: content, size: size, weight: weight))
                    + " inkR=" + String(foundationTextRunInkRight(content: content, size: size, weight: weight))
            )
        }
        self.batch.pushText(self.graphics, content, bounds.x, bounds.y, bounds.width, bounds.height, color, size, weight, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY, adaptiveInk, self.glassWash, self.glassWashLuma, inkLeft, inkRight, inkTop, inkBottom)
        return
    }

    function drawIconFields(bounds: borrow Rect, svg: borrow String, color: borrow Color, weightGrowth: Float = 0.0) {
        self.drewVisibleUi = true
        self.batch.pushIcon(self.graphics, svg, bounds.x, bounds.y, bounds.width, bounds.height, color, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY, weightGrowth)
        return
    }

    // Debug-only geometry pass. Set KIRA_UI_LAYOUT_DEBUG=1 to draw the retained
    // frame for every node and print its coordinates/padding in logical points.
    // Text gets a second cyan box for the visible ink height used by layout.
    function drawLayoutDebug(frame: borrow Rect, view: borrow FoundationView, nodeIndex: Int) {
        if !self.batch.layoutDebugEnabled() {
            return
        }
        let transparent = Color {
            r: 0.0
            g: 0.0
            b: 0.0
            a: 0.0
        }
        let frameColor = Color {
            r: 1.0
            g: 0.20
            b: 0.05
            a: 0.78
        }
        let inkColor = Color {
            r: 0.05
            g: 0.85
            b: 1.0
            a: 0.95
        }
        self.batch.pushRect(frame.x, frame.y, frame.width, frame.height, transparent, frameColor, 0.75, 0.0, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY)

        print("KIRA_UI_LAYOUT_NODE")
        print(nodeIndex)
        print(Int(frame.x * 100.0))
        print(Int(frame.y * 100.0))
        print(Int(frame.width * 100.0))
        print(Int(frame.height * 100.0))
        print(Int(view.padding.leading * 100.0))
        print(Int(view.padding.trailing * 100.0))
        print(Int(view.padding.top * 100.0))
        print(Int(view.padding.bottom * 100.0))
        print(Int(view.gap * 100.0))
        var hasInk = false
        if view.kind == .Text && view.inkRight > view.inkLeft && view.inkTop > 0.0 && view.inkBottom >= 0.0 {
            hasInk = true
        }
        if hasInk {
            let inkWidth = view.inkRight - view.inkLeft
            let inkHeight = view.inkTop + view.inkBottom
            var inkY = frame.y
            if frame.height > inkHeight {
                inkY = frame.y + (frame.height - inkHeight) / 2.0
            }
            self.batch.pushRect(frame.x, inkY, inkWidth, inkHeight, transparent, inkColor, 0.75, 0.0, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY)
            print(Int(view.inkLeft * 100.0))
            print(Int(view.inkRight * 100.0))
            print(Int(view.inkTop * 100.0))
            print(Int(view.inkBottom * 100.0))
        } else {
            print(0)
            print(0)
            print(0)
            print(0)
        }
        return
    }

    function beginBackdrop(bounds: borrow Rect, material: borrow FoundationMaterial, radius: Float, blur: Float, edgeRefraction: Float, fill: borrow Color, glassMaterial: borrow FoundationGlassMaterial) {
        self.backdropDepth = self.backdropDepth + 1
        self.glassWashStack.append(self.glassWash)
        self.glassWashLumaStack.append(self.glassWashLuma)
        // REAL liquid glass on the batched path: cut the quad stream so
        // everything below this surface becomes the captured-and-blurred backdrop,
        // and emit the refracting mode-3 quad in the surface's rounded shape. The
        // surface's own fill/border/children draw over it through the normal path.
        // The bounds decide whether this surface can share the layer already open or
        // is stacked on it and needs a capture of its own.
        if material == .LiquidGlass {
            self.drewVisibleUi = true
            self.batch.beginGlassCapture(self.graphics, bounds.x, bounds.y, bounds.width, bounds.height)
            // What adaptive text has to measure is the WHOLE wash, both fills and
            // their blend modes — not the lower fill's opacity, which is what this
            // used to hand over. The platform's light materials put nearly all of
            // their brightness in the upper colour-dodge fill: Thick is 34% linear
            // dodge under 84% colour dodge, so the surface never falls below 0.89
            // luma, while its lower alpha alone claims 0.34. Text over a dark photo
            // then measured 0.54, landed in the middle of the ink ramp, and came out
            // grey — or white, on a surface that is very nearly white.
            //
            // The equivalent normal-blend layer is exactly that measurement, and it
            // is the same one the scheme crossfade already travels along. For a white
            // or black wash — every entry in both tables — the fit is not an
            // approximation at all: those blends are affine in the backdrop.
            let inkWash = foundationTintStackEquivalent(FoundationTintStack {
                lower: FoundationTintLayer {
                    color: fill
                    alpha: fill.a
                    blend: foundationBlendModeFromId(glassMaterial.washBlend)
                }
                upper: FoundationTintLayer {
                    color: Color {
                        r: glassMaterial.washUpperR
                        g: glassMaterial.washUpperG
                        b: glassMaterial.washUpperB
                        a: 1.0
                    }
                    alpha: glassMaterial.washUpperAlpha
                    blend: foundationBlendModeFromId(glassMaterial.washUpperBlend)
                }
            })
            self.glassWash = inkWash.alpha
            self.glassWashLuma = inkWash.color.r * 0.299 + inkWash.color.g * 0.587 + inkWash.color.b * 0.114
            // The surface's fill IS the glass wash: the shader applies it
            // adaptively (stronger over dark backdrop, near invisible over light),
            // so the separate fill quad is suppressed for this surface.
            self.batch.pushGlass(bounds.x, bounds.y, bounds.width, bounds.height, radius, fill, blur, edgeRefraction, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY, glassMaterial)
            self.suppressNextFill = true
            return
        }
        let tint = materialTint(material: material)
        let hairline = Color {
            r: 1.0
            g: 1.0
            b: 1.0
            a: 0.08
        }
        drawSurfaceFields(bounds, tint, hairline, 1.0, radius)
        return
    }

    function applyBackdropEffect(bounds: borrow Rect, effect: borrow FoundationEffect) {
        match effect {
            BackdropGlow(glow) -> {
                drawGlowFields(bounds, glow.color, glow.radius, glow.intensity)
                return
            }
            LayerGlow(glow) -> {
                drawGlowFields(bounds, glow.color, glow.radius, glow.intensity)
                return
            }
        }
    }

    function drawGlowFields(bounds: borrow Rect, color: borrow Color, radius: Float, intensity: Float) {
        // Glow is rendered as a soft translucent rounded surface behind the layer
        // (a single batched quad). A separable-blur effect pass can refine this
        // later; the approximation keeps the abstraction backend-agnostic.
        let glow = Color {
            r: color.r
            g: color.g
            b: color.b
            a: color.a * intensity * 0.5
        }
        let noBorder = Color {
            r: 0.0
            g: 0.0
            b: 0.0
            a: 0.0
        }
        self.batch.pushRect(bounds.x, bounds.y, bounds.width, bounds.height, glow, noBorder, 0.0, radius, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY)
        return
    }

    function endBackdrop(bounds: borrow Rect) {
        if self.backdropDepth > 0 {
            self.backdropDepth = self.backdropDepth - 1
        }
        let n = self.glassWashStack.count
        if n >= 1 {
            self.glassWash = self.glassWashStack[n - 1]
            self.glassWashStack = foundationPopOneFloat(self.glassWashStack)
        } else {
            self.glassWash = 0.0
        }
        let ln = self.glassWashLumaStack.count
        if ln >= 1 {
            self.glassWashLuma = self.glassWashLumaStack[ln - 1]
            self.glassWashLumaStack = foundationPopOneFloat(self.glassWashLumaStack)
        } else {
            self.glassWashLuma = 1.0
        }
        let ignored = bounds
        return
    }

    function beginOffscreen(bounds: borrow Rect) {
        self.offscreenDepth = self.offscreenDepth + 1
        pushClip(bounds, 0.0)
        return
    }

    function applyLayerEffect(bounds: borrow Rect, effect: borrow FoundationEffect) {
        match effect {
            LayerGlow(glow) -> {
                drawGlowFields(bounds, glow.color, glow.radius, glow.intensity)
                return
            }
            BackdropGlow(glow) -> {
                drawGlowFields(bounds, glow.color, glow.radius, glow.intensity)
                return
            }
        }
    }

    function endOffscreen(bounds: borrow Rect) {
        if self.offscreenDepth > 0 {
            popClip()
            self.offscreenDepth = self.offscreenDepth - 1
        }
        let ignored = bounds
        return
    }

    function registerHitRegion(
        key: Int,
        bounds: borrow Rect,
        disabled: Bool,
        focusable: Bool,
        autofocus: Bool,
        onPress: () -> Void,
        onTextInput: (String) -> Void,
        onTextCodepoint: (Int) -> Void,
        onBackspace: () -> Void,
        onSubmit: () -> Void,
        onKey: (Int) -> Void,
        onScroll: (Float, Float) -> Void,
        wheel: Bool,
        interaction: FoundationInteraction,
    ) {
        self.hitRegions.append(FoundationHitRegionRecord {
            key: key
            bounds: bounds
            disabled: disabled
            focusable: focusable
            autofocus: autofocus
            onPress: onPress
            onTextInput: onTextInput
            onTextCodepoint: onTextCodepoint
            onBackspace: onBackspace
            onSubmit: onSubmit
            onKey: onKey
            onScroll: onScroll
            wheel: wheel
            interaction: interaction
        })
        return
    }

    // The flat wash a non-refracting material draws as. `beginBackdrop` answers
    // LiquidGlass with a real capture and never reaches here, so its entry is
    // the wash a glass surface would have if it were drawn flat — the near-zero
    // tint that matches the platform's "clear" appearance.
    function materialTint(material: borrow FoundationMaterial) -> Color {
        match material {
            Flat -> return Color { r: 0.0 g: 0.0 b: 0.0 a: 0.0 };
            Frosted -> return Color { r: 0.88 g: 0.94 b: 1.0 a: 0.10 };
            LiquidGlass -> return Color { r: 1.0 g: 1.0 b: 1.0 a: 0.04 };
            // The compositor fills this one; nothing is washed over it here.
            WindowBackdrop -> return Color { r: 0.0 g: 0.0 b: 0.0 a: 0.0 };
        }
    }

}
