import KiraLayout
import KiraGraphics
import Foundation
struct FoundationHitRegionRecord {
    let key: Int = 0
    let bounds: Rect
    let disabled: Bool = false
    let focusable: Bool = false
    let autofocus: Bool = false
    let onPress: () -> Void
    let onTextInput: (String) -> Void = foundationNoopTextInput
    let onTextCodepoint: (Int) -> Void = foundationNoopTextCodepoint
    let onBackspace: () -> Void = foundationNoopPress
    let onSubmit: () -> Void = foundationNoopPress
    let onKey: (Int) -> Void = foundationNoopTextCodepoint
    let onScroll: (Float, Float) -> Void = foundationNoopScroll
    let interaction: FoundationInteraction = FoundationInteraction {}
}

function graphicsRect(bounds: borrow Rect) -> GraphicsRect {
    return GraphicsRect {
        x: bounds.x
        y: bounds.y
        width: bounds.width
        height: bounds.height
    }
}

// Legacy immediate-mode text blit (Sokol path only). The retained Metal path
// rasterizes glyphs into a Kira Graphics atlas and draws them as batched textured
// quads through the abstraction (see UiBatch.kira) — no immediate blit.
@Native
function foundationDrawText(content: borrow String, bounds: borrow Rect, color: borrow Color, size: Float) {
    kira_text_draw_run("", content, bounds.x, bounds.y, bounds.width, bounds.height, color.r, color.g, color.b, color.a, size)
    return
}

// Legacy immediate-mode icon blit (Sokol path only, incl. wasm32-emscripten):
// the icon counterpart of foundationDrawText. The rasterized coverage is cached
// per (icon, pixel size) inside kiraicon and blitted tinted through
// kg_ui_blit_coverage, exactly like text glyph coverage.
@Native
function foundationDrawIcon(svg: borrow String, bounds: borrow Rect, color: borrow Color) {
    uiIconDrawRun(svg, bounds.x, bounds.y, bounds.width, bounds.height, color.r, color.g, color.b, color.a)
    return
}

function foundationDefaultGraphics() -> Graphics {
    return Graphics {
        userData: uiBatchNullPtr()
        backend: GraphicsBackend.Sokol
        metalContext: uiBatchNullPtr()
    }
}

// Drop the last saved clip rect (4 floats) off the stack, returning the shorter array.
function foundationPopClipStack(stack: [Float]) -> [Float] {
    var out: [Float] = []
    let keep = stack.count - 4
    var i = 0
    while i < keep {
        out.append(stack[i])
        i = i + 1
    }
    return out
}

// Drop the last float off a stack (the saved clip radius).
function foundationPopOneFloat(stack: [Float]) -> [Float] {
    var out: [Float] = []
    let keep = stack.count - 1
    var i = 0
    while i < keep {
        out.append(stack[i])
        i = i + 1
    }
    return out
}

// The Foundation render backend. On the Metal path every primitive is accumulated
// into a single batched draw through the Kira Graphics abstraction (UiBatch); on the
// legacy Sokol path it forwards to the immediate-mode render encoder. The backend is
// constructed per frame; the batch (atlas, glyph cache, GPU resources) persists in
// the app state and is reached here through `uiBatchPtr`.
class KiraGraphicsFoundationBackend {
    var encoder: RenderEncoder
    var graphics: Graphics
    var uiBatchPtr: RawPtr
    var gpuTelemetry: Bool = false
    var hitRegions: [FoundationHitRegionRecord] = []
    var clipDepth: Int = 0
    var backdropDepth: Int = 0
    var offscreenDepth: Int = 0
    var drewVisibleUi: Bool = false
    // Current (intersected) clip rect in pixel space, and the saved-parent stack.
    var clipMinX: Float = 0.0
    var clipMinY: Float = 0.0
    var clipMaxX: Float = 1000000.0
    var clipMaxY: Float = 1000000.0
    var clipStack: [Float] = []
    // Corner radius of the innermost clip. The batch clip itself is rectangular;
    // rounding is realized by transferring this radius onto any fill quad that
    // exactly covers the clip rect (the `.background(...).cornerRadius(...)`
    // pill idiom lowers to a radius-0 tint filling a rounded clip surface).
    var clipRadius: Float = 0.0
    var clipRadiusStack: [Float] = []
    // Set by a LiquidGlass beginBackdrop: the surface's next fill quad is skipped
    // (its fill became the shader-side adaptive wash); the border still draws.
    var suppressNextFill: Bool = false
    // The wash of the glass surface currently being filled — strength and the
    // luminance of its colour — so adaptive text drawn on it can mix back what the
    // capture underneath does not contain.
    var glassWash: Float = 0.0
    var glassWashLuma: Float = 1.0
    // The enclosing surfaces' washes, so glass inside glass restores what it was
    // sitting on when it closes rather than dropping the whole subtree back to bare
    // capture. Pushed by every beginBackdrop and popped by every endBackdrop, glass
    // or not, so the two stay balanced whatever the material.
    var glassWashStack: [Float] = []
    var glassWashLumaStack: [Float] = []

    function beginFrame(width: Int, height: Int) {
        self.hitRegions = []
        self.clipDepth = 0
        self.backdropDepth = 0
        self.offscreenDepth = 0
        self.drewVisibleUi = false
        self.clipStack = []
        self.glassWash = 0.0
        self.glassWashLuma = 1.0
        self.glassWashStack = []
        self.glassWashLumaStack = []
        self.clipMinX = 0.0
        self.clipMinY = 0.0
        self.clipMaxX = intAsFloat(value: width)
        self.clipMaxY = intAsFloat(value: height)

        let bg = Color {
            r: 0.96
            g: 0.95
            b: 0.93
            a: 1.0
        }
        let transparent = Color {
            r: 0.0
            g: 0.0
            b: 0.0
            a: 0.0
        }
        if self.gpuTelemetry {
            uiBatchBegin(self.uiBatchPtr, intAsFloat(value: width), intAsFloat(value: height), self.graphics.backingScale())
            // Claim this frame's slot in each vertex stream before anything emits into
            // one; the frames still on the GPU keep theirs.
            uiBatchBeginFrameSlots(self.uiBatchPtr, self.graphics)
            // Metal capture and presentation passes already clear to this exact
            // page colour. Emitting the same opaque fullscreen quad shaded every
            // 4K pixel again and was invisible under any application content.
            return
        }
        self.encoder.drawSurface(
            GraphicsRect {
                x: 0.0
                y: 0.0
                width: intAsFloat(value: width)
                height: intAsFloat(value: height)
            },
            bg,
            transparent,
            0.0,
            0.0
        )
        return
    }

    // Begin a HUD-only walk. The clip state is reset exactly as beginFrame resets
    // it, but the batch is NOT rewound: the UI streams keep the vertices, counts and
    // ring slots the last full frame left them, and everything emitted from here
    // until endHudFrame lands in the HUD's own stream. Metal only — the immediate
    // Sokol path has no retained batch to leave alone, so it redraws whole frames.
    function beginHudFrame(width: Int, height: Int) {
        self.clipDepth = 0
        self.backdropDepth = 0
        self.offscreenDepth = 0
        self.clipStack = []
        self.clipRadiusStack = []
        self.clipRadius = 0.0
        self.glassWash = 0.0
        self.glassWashLuma = 1.0
        self.glassWashStack = []
        self.glassWashLumaStack = []
        self.clipMinX = 0.0
        self.clipMinY = 0.0
        self.clipMaxX = intAsFloat(value: width)
        self.clipMaxY = intAsFloat(value: height)
        uiBatchBeginHud(self.uiBatchPtr, self.graphics)
        return
    }

    function endHudFrame() {
        uiBatchEndHud(self.uiBatchPtr)
        return
    }

    function endFrame() {
        if self.gpuTelemetry {
            // The batch is presented by uiBatchPresent AFTER the walk (the run
            // loops own the pass structure — a liquid-glass frame needs the
            // capture/blur passes to run before the swapchain pass begins).
            return
        }
        while self.clipDepth > 0 {
            popClip()
        }
        return
    }

    function submit() {
        return
    }

    function pushClip(frame: borrow Rect, radius: Float) {
        self.clipStack.append(self.clipMinX)
        self.clipStack.append(self.clipMinY)
        self.clipStack.append(self.clipMaxX)
        self.clipStack.append(self.clipMaxY)
        self.clipRadiusStack.append(self.clipRadius)
        self.clipRadius = radius
        var nx0 = frame.x
        if self.clipMinX > nx0 {
            nx0 = self.clipMinX
        }
        var ny0 = frame.y
        if self.clipMinY > ny0 {
            ny0 = self.clipMinY
        }
        var nx1 = frame.x + frame.width
        if self.clipMaxX < nx1 {
            nx1 = self.clipMaxX
        }
        var ny1 = frame.y + frame.height
        if self.clipMaxY < ny1 {
            ny1 = self.clipMaxY
        }
        self.clipMinX = nx0
        self.clipMinY = ny0
        self.clipMaxX = nx1
        self.clipMaxY = ny1
        if !self.gpuTelemetry {
            self.encoder.pushClip(graphicsRect(frame), radius)
        }
        self.clipDepth = self.clipDepth + 1
        return
    }

    function popClip() {
        if self.clipDepth > 0 {
            if !self.gpuTelemetry {
                self.encoder.popClip()
            }
            let n = self.clipStack.count
            if n >= 4 {
                self.clipMinX = self.clipStack[n - 4]
                self.clipMinY = self.clipStack[n - 3]
                self.clipMaxX = self.clipStack[n - 2]
                self.clipMaxY = self.clipStack[n - 1]
                self.clipStack = foundationPopClipStack(self.clipStack)
            }
            let rn = self.clipRadiusStack.count
            if rn >= 1 {
                self.clipRadius = self.clipRadiusStack[rn - 1]
                self.clipRadiusStack = foundationPopOneFloat(self.clipRadiusStack)
            }
            self.clipDepth = self.clipDepth - 1
        }
        return
    }

    function drawSurface(bounds: borrow Rect, paint: borrow FoundationSurfacePaint) {
        drawSurfaceFields(bounds, paint.fill, paint.border, paint.borderWidth, paint.radius)
        return
    }

    function drawSurfaceFields(bounds: borrow Rect, fill: borrow Color, border: borrow Color, borderWidth: Float, radius: Float) {
        self.drewVisibleUi = true
        if self.suppressNextFill {
            self.suppressNextFill = false
            let noFill = Color {
                r: 0.0
                g: 0.0
                b: 0.0
                a: 0.0
            }
            if self.gpuTelemetry {
                uiBatchPushRect(self.uiBatchPtr, bounds.x, bounds.y, bounds.width, bounds.height, noFill, border, borderWidth, radius, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY)
            }
            return
        }
        // Rounded-clip realization: the batch clip is rectangular, so a square
        // fill that exactly covers the innermost ROUNDED clip (the pill idiom:
        // `.background(tint).cornerRadius(r)`) inherits the clip's radius here.
        var effectiveRadius = radius
        if radius <= 0.0 && self.clipRadius > 0.0 {
            let dx0 = bounds.x - self.clipMinX
            let dy0 = bounds.y - self.clipMinY
            let dx1 = self.clipMaxX - (bounds.x + bounds.width)
            let dy1 = self.clipMaxY - (bounds.y + bounds.height)
            if dx0 > 0.0 - 1.5 && dx0 < 1.5 && dy0 > 0.0 - 1.5 && dy0 < 1.5 && dx1 > 0.0 - 1.5 && dx1 < 1.5 && dy1 > 0.0 - 1.5 && dy1 < 1.5 {
                effectiveRadius = self.clipRadius
            }
        }
        if self.gpuTelemetry {
            uiBatchPushRect(self.uiBatchPtr, bounds.x, bounds.y, bounds.width, bounds.height, fill, border, borderWidth, effectiveRadius, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY)
            return
        }
        self.encoder.drawSurface(graphicsRect(bounds), fill, border, borderWidth, effectiveRadius)
        return
    }

    // TextureView: register the external texture with the batch (slot-1 bind group,
    // cached per id) and emit its mode-2 quad on the Metal path. The Sokol path
    // composites through the immediate-2D textured pipeline (kg_ui_draw_texture),
    // which samples the registered render-target texture directly.
    function drawTextureFields(bounds: borrow Rect, texture: Int, secondaryTexture: Int, transition: Float, opacity: Float, radius: Float) {
        self.drewVisibleUi = true
        if texture <= 0 {
            return
        }
        if self.gpuTelemetry {
            // NOTE: the Metal UiBatch external-texture path (mode 2) does not yet
            // apply a rounded-rect coverage mask, so `radius` is a no-op here; the
            // viewport composites square-cornered on Metal. The Sokol path below
            // rounds it. Rounding the Metal external quad is a separate task.
            uiBatchSetExternalTextures(self.uiBatchPtr, self.graphics, U32(texture), U32(secondaryTexture))
            uiBatchPushExternalRect(self.uiBatchPtr, bounds.x, bounds.y, bounds.width, bounds.height, opacity, transition, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY)
            return
        }
        if secondaryTexture > 0 && transition > 0.0 {
            self.encoder.drawTexture(graphicsRect(bounds), texture, opacity * (1.0 - transition), radius)
            self.encoder.drawTexture(graphicsRect(bounds), secondaryTexture, opacity * transition, radius)
        } else {
            self.encoder.drawTexture(graphicsRect(bounds), texture, opacity, radius)
        }
        return
    }

    function drawSquircleSurface(bounds: borrow Rect, paint: borrow FoundationSurfacePaint) {
        drawSquircleSurfaceFields(bounds, paint.fill, paint.border, paint.borderWidth, paint.radius)
        return
    }

    function drawSquircleSurfaceFields(bounds: borrow Rect, fill: borrow Color, border: borrow Color, borderWidth: Float, radius: Float) {
        self.drewVisibleUi = true
        if self.gpuTelemetry {
            uiBatchPushRect(self.uiBatchPtr, bounds.x, bounds.y, bounds.width, bounds.height, fill, border, borderWidth, radius, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY)
            return
        }
        self.encoder.drawSquircleSurface(graphicsRect(bounds), fill, border, borderWidth, radius)
        return
    }

    function drawText(bounds: borrow Rect, paint: borrow FoundationTextPaint) {
        drawTextFields(bounds, paint.content, paint.color, paint.size, false)
        return
    }

    function drawTextFields(bounds: borrow Rect, content: borrow String, color: borrow Color, size: Float, adaptiveInk: Bool) {
        self.drewVisibleUi = true
        if self.gpuTelemetry {
            uiBatchPushText(self.uiBatchPtr, self.graphics, content, bounds.x, bounds.y, bounds.width, bounds.height, color, size, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY, adaptiveInk, self.glassWash, self.glassWashLuma)
            return
        }
        // The immediate-mode path has no capture to read: adaptive text keeps the
        // colour it was authored with.
        foundationDrawText(content, bounds, color, size)
        return
    }

    function drawIconFields(bounds: borrow Rect, svg: borrow String, color: borrow Color) {
        self.drewVisibleUi = true
        if self.gpuTelemetry {
            uiBatchPushIcon(self.uiBatchPtr, self.graphics, svg, bounds.x, bounds.y, bounds.width, bounds.height, color, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY)
            return
        }
        foundationDrawIcon(svg, bounds, color)
        return
    }

    function beginBackdrop(bounds: borrow Rect, material: borrow FoundationMaterial, radius: Float, blur: Float, edgeRefraction: Float, fill: borrow Color, glassMaterial: borrow FoundationGlassMaterial) {
        self.backdropDepth = self.backdropDepth + 1
        self.glassWashStack.append(self.glassWash)
        self.glassWashLumaStack.append(self.glassWashLuma)
        // REAL liquid glass on the batched Metal path: cut the quad stream so
        // everything below this surface becomes the captured-and-blurred backdrop,
        // and emit the refracting mode-3 quad in the surface's rounded shape. The
        // surface's own fill/border/children draw over it through the normal path.
        // The bounds decide whether this surface can share the layer already open or
        // is stacked on it and needs a capture of its own.
        if material == .LiquidGlass && self.gpuTelemetry {
            self.drewVisibleUi = true
            uiBatchBeginGlassCapture(self.uiBatchPtr, self.graphics, bounds.x, bounds.y, bounds.width, bounds.height)
            // What adaptive text has to measure is the WHOLE wash, both fills and
            // their blend modes — not the lower fill's opacity, which is what this
            // used to hand over. The platform's light materials put nearly all of
            // their brightness in the upper colour-dodge fill: Thick is 34% linear
            // dodge under 84% colour dodge, so the surface never falls below 0.89
            // luma, while its lower alpha alone claims 0.34. Text over a dark photo
            // then measured 0.54, landed in the middle of the ink ramp, and came out
            // grey — or white, on a surface that is very nearly white.
            //
            // The equivalent normal-blend layer is exactly that measurement, and it
            // is the same one the scheme crossfade already travels along. For a white
            // or black wash — every entry in both tables — the fit is not an
            // approximation at all: those blends are affine in the backdrop.
            let inkWash = foundationTintStackEquivalent(FoundationTintStack {
                lower: FoundationTintLayer {
                    color: fill
                    alpha: fill.a
                    blend: foundationBlendModeFromId(glassMaterial.washBlend)
                }
                upper: FoundationTintLayer {
                    color: Color {
                        r: glassMaterial.washUpperR
                        g: glassMaterial.washUpperG
                        b: glassMaterial.washUpperB
                        a: 1.0
                    }
                    alpha: glassMaterial.washUpperAlpha
                    blend: foundationBlendModeFromId(glassMaterial.washUpperBlend)
                }
            })
            self.glassWash = inkWash.alpha
            self.glassWashLuma = inkWash.color.r * 0.299 + inkWash.color.g * 0.587 + inkWash.color.b * 0.114
            // The surface's fill IS the glass wash: the shader applies it
            // adaptively (stronger over dark backdrop, near invisible over light),
            // so the separate fill quad is suppressed for this surface.
            uiBatchPushGlass(self.uiBatchPtr, bounds.x, bounds.y, bounds.width, bounds.height, radius, fill, blur, edgeRefraction, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY, glassMaterial)
            self.suppressNextFill = true
            return
        }
        let tint = materialTint(material: material)
        let hairline = Color {
            r: 1.0
            g: 1.0
            b: 1.0
            a: 0.08
        }
        drawSurfaceFields(bounds, tint, hairline, 1.0, radius)
        return
    }

    function applyBackdropEffect(bounds: borrow Rect, effect: borrow FoundationEffect) {
        match effect {
            BackdropGlow(glow) -> {
                drawGlowFields(bounds, glow.color, glow.radius, glow.intensity)
                return
            }
            LayerGlow(glow) -> {
                drawGlowFields(bounds, glow.color, glow.radius, glow.intensity)
                return
            }
        }
    }

    function drawGlowFields(bounds: borrow Rect, color: borrow Color, radius: Float, intensity: Float) {
        if self.gpuTelemetry {
            // Glow is rendered as a soft translucent rounded surface behind the layer
            // (a single batched quad). A separable-blur effect pass can refine this
            // later; the approximation keeps the abstraction backend-agnostic.
            let glow = Color {
                r: color.r
                g: color.g
                b: color.b
                a: color.a * intensity * 0.5
            }
            let noBorder = Color {
                r: 0.0
                g: 0.0
                b: 0.0
                a: 0.0
            }
            uiBatchPushRect(self.uiBatchPtr, bounds.x, bounds.y, bounds.width, bounds.height, glow, noBorder, 0.0, radius, self.clipMinX, self.clipMinY, self.clipMaxX, self.clipMaxY)
            return
        }
        self.encoder.drawGlow(graphicsRect(bounds), color, radius, intensity)
        return
    }

    function endBackdrop(bounds: borrow Rect) {
        if self.backdropDepth > 0 {
            self.backdropDepth = self.backdropDepth - 1
        }
        let n = self.glassWashStack.count
        if n >= 1 {
            self.glassWash = self.glassWashStack[n - 1]
            self.glassWashStack = foundationPopOneFloat(self.glassWashStack)
        } else {
            self.glassWash = 0.0
        }
        let ln = self.glassWashLumaStack.count
        if ln >= 1 {
            self.glassWashLuma = self.glassWashLumaStack[ln - 1]
            self.glassWashLumaStack = foundationPopOneFloat(self.glassWashLumaStack)
        } else {
            self.glassWashLuma = 1.0
        }
        let ignored = bounds
        return
    }

    function beginOffscreen(bounds: borrow Rect) {
        self.offscreenDepth = self.offscreenDepth + 1
        pushClip(bounds, 0.0)
        return
    }

    function applyLayerEffect(bounds: borrow Rect, effect: borrow FoundationEffect) {
        match effect {
            LayerGlow(glow) -> {
                drawGlowFields(bounds, glow.color, glow.radius, glow.intensity)
                return
            }
            BackdropGlow(glow) -> {
                drawGlowFields(bounds, glow.color, glow.radius, glow.intensity)
                return
            }
        }
    }

    function endOffscreen(bounds: borrow Rect) {
        if self.offscreenDepth > 0 {
            popClip()
            self.offscreenDepth = self.offscreenDepth - 1
        }
        let ignored = bounds
        return
    }

    function registerHitRegion(
        key: Int,
        bounds: borrow Rect,
        disabled: Bool,
        focusable: Bool,
        autofocus: Bool,
        onPress: () -> Void,
        onTextInput: (String) -> Void,
        onTextCodepoint: (Int) -> Void,
        onBackspace: () -> Void,
        onSubmit: () -> Void,
        onKey: (Int) -> Void,
        onScroll: (Float, Float) -> Void,
        interaction: FoundationInteraction,
    ) {
        self.hitRegions.append(FoundationHitRegionRecord {
            key: key
            bounds: bounds
            disabled: disabled
            focusable: focusable
            autofocus: autofocus
            onPress: onPress
            onTextInput: onTextInput
            onTextCodepoint: onTextCodepoint
            onBackspace: onBackspace
            onSubmit: onSubmit
            onKey: onKey
            onScroll: onScroll
            interaction: interaction
        })
        return
    }

    function materialTint(material: borrow FoundationMaterial) -> Color {
        match material {
            Flat -> return Color { r: 0.0 g: 0.0 b: 0.0 a: 0.0 };
            Frosted -> return Color { r: 0.88 g: 0.94 b: 1.0 a: 0.10 };
            // Metal path: a subtle wash mixed over the refracted backdrop sample
            // (mode-3 tint) — near-zero, matching the platform "clear" appearance.
            // Sokol fallback: drawn as a translucent tint quad.
            LiquidGlass -> return Color { r: 1.0 g: 1.0 b: 1.0 a: 0.04 };
        }
    }

}
