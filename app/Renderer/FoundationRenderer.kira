import KiraLayout
import KiraGraphics
import Foundation
function foundationRender(root: borrow FoundationView, tree: borrow LayoutTree, backend: borrow mut KiraGraphicsFoundationBackend) -> Int {
    var current = backend
    let rendered = foundationRenderView(root, tree, 0, current)
    if current.batch.layoutDebugEnabled() {
        return rendered + foundationRenderDebugView(root, tree, 0, current)
    }
    return rendered
}

function foundationRenderDebugChildren(view: borrow FoundationView, tree: borrow LayoutTree, nodeIndex: Int, backend: borrow mut KiraGraphicsFoundationBackend) -> Int {
    let firstChild = tree.nodes[nodeIndex].firstChild
    var current = backend
    var rendered = 0
    for childOffset in 0..view.children.count {
        rendered = rendered + foundationRenderDebugView(view.children[childOffset], tree, firstChild + childOffset, current)
    }
    return rendered
}

function foundationRenderDebugView(view: borrow FoundationView, tree: borrow LayoutTree, nodeIndex: Int, backend: borrow mut KiraGraphicsFoundationBackend) -> Int {
    var current = backend
    let frame = layoutFrame(tree, nodeIndex)
    current.drawLayoutDebug(frame, view, nodeIndex)
    return foundationRenderDebugChildren(view, tree, nodeIndex, current) + 1
}

// What a surface is filled with.
//
// Its own colour, except where the material is the WINDOW's backdrop: there the
// fill is the key colour, which is not a colour the surface is painted but the
// absence of paint the compositor answers with what is behind the window.
function foundationSurfaceFill(view: borrow FoundationView, windowTransparent: Bool) -> Color {
    if view.material == .WindowBackdrop && windowTransparent {
        return graphicsTransparentKey()
    }
    return view.fill
}

function foundationRenderChildren(view: borrow FoundationView, tree: borrow LayoutTree, nodeIndex: Int, backend: borrow mut KiraGraphicsFoundationBackend) -> Int {
    // Read only the scalar we need through the array (borrow-elided) instead of
    // cloning the whole ~40-field node per rendered container.
    let firstChild = tree.nodes[nodeIndex].firstChild
    var current = backend
    var rendered = 0
        for childOffset in 0..view.children.count {
        rendered = rendered + foundationRenderView(view.children[childOffset], tree, firstChild + childOffset, current)
            }
    return rendered
}

function foundationRenderView(view: borrow FoundationView, tree: borrow LayoutTree, nodeIndex: Int, backend: borrow mut KiraGraphicsFoundationBackend) -> Int {
    var current = backend
    // `frame` (the node's laid-out Rect) is only needed by the kinds that draw or
    // register a hit region; pure layout containers (Row/Column/Frame/...) just
    // recurse, so building the Rect for them is wasted per-view work. Compute it
    // inside the branches that use it.
    match view.kind {
        Surface -> {
            let frame = layoutFrame(tree, nodeIndex)
            // The backdrop is OPEN for the whole subtree, not just for its own
            // effects. What a surface washes over is state its content has to read —
            // adaptive text measures the material it is sitting on — and closing the
            // backdrop before descending handed every child the state of a surface
            // that was no longer there. The close moves below the children instead,
            // which is where the surface actually stops.
            // The window's own backdrop is filled by the desktop compositor, so
            // it opens no capture here: what shows through it is what is behind
            // the WINDOW, which this compositor has never seen.
            let hasBackdrop = (view.material != .Flat && view.material != .WindowBackdrop) || view.effects.count > 0
            if hasBackdrop {
                current.beginBackdrop(frame, view.material, view.radius, view.blur, view.edgeRefraction, view.fill, view.glassMaterial)
                var effectIndex = 0
                while effectIndex < view.effects.count {
                    current.applyBackdropEffect(frame, view.effects[effectIndex])
                    effectIndex = effectIndex + 1
                }
            }

            // A window-backdrop surface is drawn as the window's key colour: the
            // pixels become a hole, and the desktop compositor fills them with
            // the blurred, tinted backdrop it keeps behind the window. Anything
            // the surface holds still draws over it, crisp.
            let surfaceFill = foundationSurfaceFill(view, current.windowTransparent)
            if view.shape == .Squircle {
                current.drawSquircleSurfaceFields(frame, surfaceFill, view.border, view.borderWidth, view.radius)
            } else {
                current.drawSurfaceFields(frame, surfaceFill, view.border, view.borderWidth, view.radius, view.fillEnd, view.gradient)
            }

            var childRendered = 0
            if view.radius > 0.0 || view.clipContent {
                current.pushClip(frame, view.radius)
                childRendered = foundationRenderChildren(view, tree, nodeIndex, current)
                current.popClip()
            } else {
                childRendered = foundationRenderChildren(view, tree, nodeIndex, current)
            }

            if hasBackdrop {
                current.endBackdrop(frame)
            }

            return childRendered + 1
        }
        Text -> {
            let frame = layoutFrame(tree, nodeIndex)
            current.drawTextFields(frame, view.content, view.color, view.size, view.weight, view.adaptiveInk, view.inkLeft, view.inkRight, view.inkTop, view.inkBottom)
            return 1
        }
        HitArea -> {
            let frame = layoutFrame(tree, nodeIndex)
            // Paint the optional background (default transparent) behind the
            // children — the default-hover highlight rides on this.
            if view.backgroundFill.a > 0.0 {
                current.drawSurfaceFields(frame, view.backgroundFill, view.border, view.borderWidth, view.radius)
            }
            current.registerHitRegion(view.key, frame, view.disabled, view.focusable, view.autofocus, view.onPress, view.onTextInput, view.onTextCodepoint, view.onBackspace, view.onSubmit, view.onKey, view.onScroll, view.wheel, view.interaction)
            return foundationRenderChildren(view, tree, nodeIndex, current)
        }
        TextureView -> {
            let frame = layoutFrame(tree, nodeIndex)
            current.drawTextureFields(frame, view.texture, view.secondaryTexture, view.textureTransition, view.textureOpacity, view.radius)
            return 1
        }
        Icon -> {
            let frame = layoutFrame(tree, nodeIndex)
            current.drawIconFields(frame, view.content, view.color, view.weightGrowth)
            return 1
        }
        Row -> return foundationRenderChildren(view, tree, nodeIndex, current);
        Column -> return foundationRenderChildren(view, tree, nodeIndex, current);
        Expanded -> return foundationRenderChildren(view, tree, nodeIndex, current);
        Frame -> return foundationRenderChildren(view, tree, nodeIndex, current);
        Spacer -> return foundationRenderChildren(view, tree, nodeIndex, current);
        LayoutPriority -> return foundationRenderChildren(view, tree, nodeIndex, current);
    }
}
