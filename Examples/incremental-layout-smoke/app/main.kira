import KiraUIFoundation

function smokeSuitePartA() -> Int {
    return FoundationIncrementalLayoutSmoke()
}

function smokeSuitePartB() -> Int {
    return FoundationIncrementalDeepSmoke()
}

function smokeSuitePartC() -> Int {
    return FoundationResizeLayoutSmoke()
}

function smokeSuiteTotal() -> Int {
    return smokeSuitePartA() + smokeSuitePartB() + smokeSuitePartC()
}

@Main
function main() {
    print(smokeSuiteTotal())
    return
}
