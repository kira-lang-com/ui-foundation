import Foundation
import KiraLayout
import KiraUIFoundation

// Liquid Glass Kitchen — an editor for the material itself.
//
// The canvas holds widgets that are nothing but liquid glass in different shapes
// and sizes; the sidebar holds controls that move the numbers those widgets shade
// themselves with, live. Every control is made of the same glass it edits, so the
// editor is its own preview: drag `Stroke strength` and the sliders' own edges
// move with the widgets'.
//
// What the sliders reach is FoundationGlassMaterial, carried per surface — the
// shader compiles with none of these baked in, so the design happens here rather
// than in a rebuild.

function widgetCaption(text: String) -> FoundationView {
    return centered(AdaptiveText(move text, inkStrong(), 13.0, 600.0))
}

function canvas(state: borrow KitchenState) -> FoundationView {
    let material = kitchenMaterial(state)
    let frost = frostForStep(state.frostStep)
    let blur = blurForStep(state.blurStep)
    let lighting = state.edgeLighting

    // A card, a pill, a circle, a tile, a bar and a chip: the shapes a UI is
    // actually built from, so a material tuned here is tuned for all of them —
    // the lens and the edge behave differently at each radius and size.
    let card = glass(
        children: [widgetCaption("Card")],
        w: 300.0, h: 190.0, radius: state.radius,
        frost: frostForStep(state.frostStep), blur: blurForStep(state.blurStep),
        material: kitchenMaterial(state), edgeLighting: lighting
    )
    let pill = glass(
        children: [widgetCaption("Pill")],
        w: 300.0, h: 56.0, radius: 28.0,
        frost: frostForStep(state.frostStep), blur: blurForStep(state.blurStep),
        material: kitchenMaterial(state), edgeLighting: lighting
    )
    let circle = glass(
        children: [widgetCaption("Round")],
        w: 132.0, h: 132.0, radius: 66.0,
        frost: frostForStep(state.frostStep), blur: blurForStep(state.blurStep),
        material: kitchenMaterial(state), edgeLighting: lighting
    )
    let tile = glass(
        children: [widgetCaption("Tile")],
        w: 148.0, h: 132.0, radius: state.radius,
        frost: move frost, blur: move blur,
        material: move material, edgeLighting: lighting
    )
    let bar = glass(
        children: [widgetCaption("Toolbar")],
        w: 464.0, h: 64.0, radius: 20.0,
        frost: frostForStep(state.frostStep), blur: blurForStep(state.blurStep),
        material: kitchenMaterial(state), edgeLighting: lighting
    )
    let chip = glass(
        children: [widgetCaption("Chip")],
        w: 132.0, h: 56.0, radius: 16.0,
        frost: frostForStep(state.frostStep), blur: blurForStep(state.blurStep),
        material: kitchenMaterial(state), edgeLighting: lighting
    )

    let topRow = Row(
        children: [move card, Column(
            children: [move circle, move chip],
            width: SizeMode.Hug,
            height: SizeMode.Hug,
            spacing: 18.0,
            padding: EdgeInsets {},
            crossAxisAlignment: CrossAlignment.Start
        ), move tile],
        width: SizeMode.Hug,
        height: SizeMode.Hug,
        spacing: 18.0,
        padding: EdgeInsets {},
        crossAxisAlignment: CrossAlignment.Start
    )
    return Column(
        children: [move topRow, move bar, move pill],
        width: SizeMode.Hug,
        height: SizeMode.Hug,
        spacing: 18.0,
        padding: EdgeInsets {},
        crossAxisAlignment: CrossAlignment.Start
    )
}

// ---------------------------------------------------------------------------
// The sidebar: every control, each one glass
// ---------------------------------------------------------------------------

function sidebarWidth() -> Float {
    return sliderWidth() + 28.0 + 36.0
}

function controls(state: borrow KitchenState, stateUser: RawPtr) -> FoundationView {
    let material = kitchenMaterial(state)
    let frost = frostForStep(state.frostStep)
    let blur = blurForStep(state.blurStep)
    let lighting = state.edgeLighting

    // Each control gets its own pair of closures: the press remembers where the
    // value was, the move walks it from there.
    let strokeSet: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokeStrength = 0.0 + (0.6 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let strokeStart: (Float, Float) -> Void = { x, y in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokeStrength = 0.0 + (0.6 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let strokeMove: (Float, Float) -> Void = { dx, dy in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokeStrength = 0.0 + (0.6 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let darkenSet: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokeDarken = 0.0 + (1.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let darkenStart: (Float, Float) -> Void = { x, y in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokeDarken = 0.0 + (1.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let darkenMove: (Float, Float) -> Void = { dx, dy in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokeDarken = 0.0 + (1.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let peakSet: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokePeak = 0.0 + (6.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let peakStart: (Float, Float) -> Void = { x, y in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokePeak = 0.0 + (6.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let peakMove: (Float, Float) -> Void = { dx, dy in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokePeak = 0.0 + (6.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let fadeSet: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokeFade = 0.2 + (12.0 - 0.2) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let fadeStart: (Float, Float) -> Void = { x, y in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokeFade = 0.2 + (12.0 - 0.2) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let fadeMove: (Float, Float) -> Void = { dx, dy in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeStrokeFade = 0.2 + (12.0 - 0.2) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let sheenSet: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.sheenStrength = 0.0 + (0.4 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let sheenStart: (Float, Float) -> Void = { x, y in
        var s = nativeRecover<KitchenState>(stateUser)
        s.sheenStrength = 0.0 + (0.4 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let sheenMove: (Float, Float) -> Void = { dx, dy in
        var s = nativeRecover<KitchenState>(stateUser)
        s.sheenStrength = 0.0 + (0.4 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let bendSet: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.lensMaxBend = 0.0 + (200.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let bendStart: (Float, Float) -> Void = { x, y in
        var s = nativeRecover<KitchenState>(stateUser)
        s.lensMaxBend = 0.0 + (200.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let bendMove: (Float, Float) -> Void = { dx, dy in
        var s = nativeRecover<KitchenState>(stateUser)
        s.lensMaxBend = 0.0 + (200.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let reachSet: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.refractionReach = 20.0 + (600.0 - 20.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let reachStart: (Float, Float) -> Void = { x, y in
        var s = nativeRecover<KitchenState>(stateUser)
        s.refractionReach = 20.0 + (600.0 - 20.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let reachMove: (Float, Float) -> Void = { dx, dy in
        var s = nativeRecover<KitchenState>(stateUser)
        s.refractionReach = 20.0 + (600.0 - 20.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let splitSet: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.blurNearSplit = 0.05 + (0.95 - 0.05) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let splitStart: (Float, Float) -> Void = { x, y in
        var s = nativeRecover<KitchenState>(stateUser)
        s.blurNearSplit = 0.05 + (0.95 - 0.05) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let splitMove: (Float, Float) -> Void = { dx, dy in
        var s = nativeRecover<KitchenState>(stateUser)
        s.blurNearSplit = 0.05 + (0.95 - 0.05) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let radiusSet: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.radius = 0.0 + (90.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let radiusStart: (Float, Float) -> Void = { x, y in
        var s = nativeRecover<KitchenState>(stateUser)
        s.radius = 0.0 + (90.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let radiusMove: (Float, Float) -> Void = { dx, dy in
        var s = nativeRecover<KitchenState>(stateUser)
        s.radius = 0.0 + (90.0 - 0.0) * kitchenPointerFraction()
        kitchenEdited(s)
        return
    }
    let frostPress: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.frostStep = (s.frostStep + 1) % 6
        kitchenEdited(s)
        return
    }
    let blurPress: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.blurStep = (s.blurStep + 1) % 6
        kitchenEdited(s)
        return
    }
    let lightingPress: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        s.edgeLighting = !s.edgeLighting
        kitchenEdited(s)
        return
    }
    let resetPress: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        // Edits nobody snapshotted are the only thing here that cannot be got
        // back, so the first press arms rather than discards, and the label says
        // what the second one will do.
        if s.dirty && !s.resetArmed {
            s.resetArmed = true
            return
        }
        s.edgeStrokeStrength = 0.0
        s.edgeStrokeDarken = 0.62
        s.edgeStrokePeak = 0.9
        s.edgeStrokeFade = 2.0
        s.sheenStrength = 0.0
        s.lensMaxBend = 72.0
        s.refractionReach = 180.0
        s.blurNearSplit = 0.25
        s.frostStep = 2
        s.blurStep = 3
        s.radius = 28.0
        s.edgeLighting = true
        s.dirty = false
        s.resetArmed = false
        saveCurrent(s)
        return
    }
    let snapshotPress: () -> Void = { in
        var s = nativeRecover<KitchenState>(stateUser)
        takeSnapshot(s)
        return
    }

    var rows: [FoundationView] = [
        sectionLabel("SCALES"),
        stepper(
            key: 301, label: "Frost", stepLabel: stepName(state.frostStep, "Translucent"),
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting, onPress: move frostPress
        ),
        stepper(
            key: 302, label: "Blur", stepLabel: stepName(state.blurStep, "None"),
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting, onPress: move blurPress
        ),
        sectionLabel("EDGE"),
        slider(
            key: 311, label: "Stroke strength", value: state.edgeStrokeStrength,
            minimum: 0.0, maximum: 0.6,
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting,
            onPress: move strokeSet,
            onDragStart: move strokeStart, onDragMove: move strokeMove
        ),
        slider(
            key: 312, label: "Stroke darken", value: state.edgeStrokeDarken,
            minimum: 0.0, maximum: 1.0,
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting,
            onPress: move darkenSet,
            onDragStart: move darkenStart, onDragMove: move darkenMove
        ),
        slider(
            key: 313, label: "Stroke peak", value: state.edgeStrokePeak,
            minimum: 0.0, maximum: 6.0,
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting,
            onPress: move peakSet,
            onDragStart: move peakStart, onDragMove: move peakMove
        ),
        slider(
            key: 314, label: "Stroke fade", value: state.edgeStrokeFade,
            minimum: 0.2, maximum: 12.0,
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting,
            onPress: move fadeSet,
            onDragStart: move fadeStart, onDragMove: move fadeMove
        ),
        slider(
            key: 315, label: "Sheen", value: state.sheenStrength,
            minimum: 0.0, maximum: 0.4,
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting,
            onPress: move sheenSet,
            onDragStart: move sheenStart, onDragMove: move sheenMove
        ),
        sectionLabel("LENS"),
        slider(
            key: 321, label: "Lens bend", value: state.lensMaxBend,
            minimum: 0.0, maximum: 200.0,
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting,
            onPress: move bendSet,
            onDragStart: move bendStart, onDragMove: move bendMove
        ),
        slider(
            key: 322, label: "Refraction reach", value: state.refractionReach,
            minimum: 20.0, maximum: 600.0,
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting,
            onPress: move reachSet,
            onDragStart: move reachStart, onDragMove: move reachMove
        ),
        slider(
            key: 323, label: "Blur split", value: state.blurNearSplit,
            minimum: 0.05, maximum: 0.95,
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting,
            onPress: move splitSet,
            onDragStart: move splitStart, onDragMove: move splitMove
        ),
        sectionLabel("SHAPE"),
        slider(
            key: 331, label: "Corner radius", value: state.radius,
            minimum: 0.0, maximum: 90.0,
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting,
            onPress: move radiusSet,
            onDragStart: move radiusStart, onDragMove: move radiusMove
        ),
        stepper(
            key: 332, label: "Edge lighting", stepLabel: onOffText(state.edgeLighting),
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting, onPress: move lightingPress
        ),
        stepper(
            key: 333, label: resetLabel(state), stepLabel: resetAction(state),
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting, onPress: move resetPress
        ),
        sectionLabel("SNAPSHOTS"),
        stepper(
            key: 334, label: snapshotStatus(state), stepLabel: "Take",
            material: move material, frost: move frost,
            blur: move blur, edgeLighting: lighting, onPress: move snapshotPress
        )
    ]
    // The snapshots themselves, newest first: press one to load it back. Only the
    // last few are listed — the file keeps every one, the sidebar shows what fits.
    var shown = 0
    var index = snapshotCount(state) - 1
    while index >= 0 && shown < 4 {
        let at = index * recordFields()
        let applyPress: () -> Void = { in
            var s = nativeRecover<KitchenState>(stateUser)
            applyRecord(s, s.snapshots, at)
            s.dirty = false
            s.resetArmed = false
            saveCurrent(s)
            return
        }
        rows.append(stepper(
            key: 400 + index,
            label: "Snapshot " + intText(index + 1),
            stepLabel: snapshotSummary(state.snapshots, at),
            material: kitchenMaterial(state), frost: frostForStep(state.frostStep),
            blur: blurForStep(state.blurStep), edgeLighting: lighting, onPress: move applyPress
        ))
        shown = shown + 1
        index = index - 1
    }
    return Column(
        children: move rows,
        width: SizeMode.Hug,
        height: SizeMode.Hug,
        spacing: 6.0,
        padding: EdgeInsets {},
        crossAxisAlignment: CrossAlignment.Start
    )
}

// What the reset row says, which is what pressing it will do.
function resetLabel(state: borrow KitchenState) -> String {
    if state.resetArmed {
        return "Discard unsaved edits?"
    }
    return "Reset"
}

function resetAction(state: borrow KitchenState) -> String {
    if state.resetArmed {
        return "Confirm"
    }
    if state.dirty {
        return "Unsaved"
    }
    return "Defaults"
}

// The snapshot row's own label: how many there are, and whether the edit on
// screen is in any of them.
function snapshotStatus(state: borrow KitchenState) -> String {
    let count = snapshotCount(state)
    if count == 0 {
        return "No snapshots yet"
    }
    if state.dirty {
        return intText(count) + " saved, edits unsaved"
    }
    return intText(count) + " saved"
}

// A snapshot in three numbers — frost step, blur step, stroke strength — which is
// enough to tell two apart in a list.
function snapshotSummary(snapshots: borrow [Int], at: Int) -> String {
    if at + recordFields() > snapshots.count {
        return ""
    }
    return stepName(snapshots[at + 8], "Clear") + " / " + stepName(snapshots[at + 9], "Sharp") + " / " + floatText(fromMilli(snapshots[at]))
}

function onOffText(on: Bool) -> String {
    if on {
        return "On"
    }
    return "Off"
}

// Every control calls this after it changes something: the edit is now unsaved,
// a primed reset is no longer primed for the state it was primed against, and the
// working file matches what is on screen.
function kitchenEdited(state: borrow mut KitchenState) {
    state.dirty = true
    state.resetArmed = false
    saveCurrent(state)
    return
}

function kitchenClamp(value: Float, low: Float, high: Float) -> Float {
    if value < low {
        return low
    }
    if value > high {
        return high
    }
    return value
}

// ---------------------------------------------------------------------------
// Root
// ---------------------------------------------------------------------------

function rootView(context: borrow FoundationUiContext, stateUser: RawPtr, state: borrow KitchenState) -> FoundationView {
    var layers: [FoundationView] = []
    if state.textureId > 0 {
        layers.append(TextureView(
            texture: state.textureId,
            width: SizeMode.Fill,
            height: SizeMode.Fill,
            flex: 0,
            opacity: 1.0,
            radius: 0.0
        ))
    }
    // The sidebar is one tall pane of glass with the controls stacked inside it,
    // so the controls are glass ON glass — the stacked case the compositor has to
    // get right, and the one an editor exercises constantly.
    layers.append(Frame(
        child: glass(
            children: [
                Frame(
                    child: controls(state, stateUser),
                    width: SizeMode.Fill,
                    height: SizeMode.Fill,
                    flex: 0,
                    alignment: Alignment.TopLeading,
                    padding: EdgeInsets { top: 14.0 trailing: 18.0 bottom: 14.0 leading: 18.0 }
                )
            ],
            w: sidebarWidth(), h: context.viewport.height - 36.0, radius: 28.0,
            frost: frostForStep(state.frostStep), blur: blurForStep(state.blurStep),
            material: kitchenMaterial(state), edgeLighting: state.edgeLighting
        ),
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        alignment: Alignment.Leading,
        padding: EdgeInsets { leading: 18.0 }
    ))
    layers.append(Frame(
        child: Column(
            children: [
                AdaptiveText("Liquid Glass Kitchen", inkStrong(), 34.0, 800.0),
                AdaptiveText("Drag a control. Every widget and every control is the material you are editing.", inkSoft(), 14.0, 500.0)
            ],
            width: SizeMode.Hug,
            height: SizeMode.Hug,
            spacing: 6.0,
            padding: EdgeInsets {},
            crossAxisAlignment: CrossAlignment.Start
        ),
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        alignment: Alignment.TopLeading,
        padding: EdgeInsets { top: 40.0 leading: sidebarWidth() + 64.0 }
    ))
    layers.append(Frame(
        child: canvas(state),
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        alignment: Alignment.TopLeading,
        padding: EdgeInsets { top: 132.0 leading: sidebarWidth() + 64.0 }
    ))
    return Surface(
        children: move layers,
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        fill: Color { r: 0.09 g: 0.10 b: 0.13 a: 1.0 },
        border: Color { r: 0.0 g: 0.0 b: 0.0 a: 0.0 },
        borderWidth: 0.0,
        radius: 0.0,
        shape: FoundationShape.RegularRoundedRect,
        material: FoundationMaterial.Flat,
        effects: [],
        padding: EdgeInsets {},
        clipContent: false
    )
}

@Main
function main() {
    let storage = nativeState(KitchenState {})
    let stateUser = nativeUserData(storage)
    RunFoundationInteractiveApp(
        title: "Liquid Glass Kitchen",
        width: 1600,
        height: 900,
        rootBuilder: { ui in
            var state = nativeRecover<KitchenState>(stateUser)
            return rootView(ui, stateUser, state)
        },
        engineFrame: { frame in
            var state = nativeRecover<KitchenState>(stateUser)
            if !state.loaded {
                state.loaded = true
                // Snapshots first, then the working edit on top of them: the file
                // that was open when the window closed is what opens with it.
                state.snapshots = readNumbers(snapshotsPath())
                let current = readNumbers(currentPath())
                if current.count >= recordFields() {
                    applyRecord(state, current, 0)
                }
            }
            if !state.attempted {
                state.attempted = true
                state.backdropOff = environmentValueIsEmpty("KIRA_GLASS_BG")
                var id = 0
                if !state.backdropOff {
                    id = kitchenBackdropView(foundationFrameGraphics(frame))
                }
                state.textureId = id
            }
            return
        },
        needsRebuild: foundationNoContinuousRebuild,
        showFpsOverlay: false
    )
    return
}
