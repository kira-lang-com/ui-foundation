import Foundation
import KiraLayout
import KiraUIFoundation
import KiraGraphics

// Liquid glass — a REAL app composition. A photo backdrop (fullscreen
// TextureView) with app chrome floating over it, every piece of chrome a
// FoundationMaterial.LiquidGlass surface in its own shape:
//   - a large glass info card in the middle (rounded rect),
//   - a glass search pill and a round glass button docked at the bottom.
// Each glass surface captures the content rendered beneath it, blurs it through
// the Kira Graphics liquid_glass example's half-res pyramid, and refracts it with
// that example's composite shader — generalized to the surface's own corner
// radius, so the pill is pill-shaped glass and the button is a glass circle.
//
// The photo arrives as a raw RGBA blob (1600x900x4, cover-cropped offline from
// examples/liquid_glass/assets/background-cubes.jpg); it is loaded from the
// example's assets directory (or the KIRA_GLASS_BG environment variable).
//
// Two of them ship. background-cubes-cool.rgba is the default: the same photograph
// with its red and blue channels exchanged, which turns the food into glass and ice
// and gives the material a cool palette to refract instead of a warm one. It exists
// because a colour-channel bug in a screenshot converter produced it by accident and
// it looked better than the thing it was a mistake about. The original is still
// beside it and still loads if the cool one is missing.

function cardTitle(selected: Int) -> String {
    if selected == 1 {
        return "Materials"
    }
    if selected == 2 {
        return "Effects"
    }
    if selected == 3 {
        return "Settings"
    }
    return "Welcome to Kira"
}

function cardLead(selected: Int) -> String {
    if selected == 1 {
        return "Flat, frosted, metallic, crystal — and this,"
    }
    if selected == 2 {
        return "Glow bleeds through from behind the layer,"
    }
    if selected == 3 {
        return "Corner radius, blur and edge refraction are"
    }
    return "Everything behind this card is real content,"
}

function cardTrail(selected: Int) -> String {
    if selected == 1 {
        return "liquid glass, captured live."
    }
    if selected == 2 {
        return "or radiates from the surface itself."
    }
    if selected == 3 {
        return "per-surface, so no two need to match."
    }
    return "captured, blurred and refracted live."
}

// The pinned note: a small glass island parked over the card's lower-right corner.
// It overlaps the card, so it starts a glass layer of its own and refracts the card
// — the card's wash, its text, its rim — rather than the photo behind everything.
function pinnedNote(at: Float) -> FoundationView {
    return Frame(
        child: glassSurface(
            children: [
                centered(AdaptiveText("Pinned", glassForeground(at), 14.0, 600.0))
            ],
            w: 132.0, h: 54.0, radius: 20.0, frost: FoundationFrost.XHigh, edgeRefraction: 0.9,
            edgeLighting: true, blur: FoundationBlur.Step, at: at
        ),
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        alignment: Alignment.BottomTrailing,
        padding: EdgeInsets {
            trailing: 26.0
            bottom: 26.0
        }
    )
}

// Big glass info card, centre screen.
function glassCard(selected: Int, notePinned: Bool, frostLevel: Int, at: Float) -> FoundationView {
    var layers: [FoundationView] = [
        centered(VStack(
            children: [
                AdaptiveText(cardTitle(selected), glassForeground(at), 30.0, 700.0),
                AdaptiveText(cardLead(selected), glassForeground(at), 15.0, 500.0),
                AdaptiveText(cardTrail(selected), glassForeground(at), 15.0, 500.0)
            ],
            spacing: 10.0,
            padding: EdgeInsets {}
        ))
    ]
    if notePinned {
        layers.append(pinnedNote(at))
    }
    return glassSurface(
        children: move layers,
        w: 480.0, h: 300.0, radius: 44.0, frost: frostForLevel(frostLevel), edgeRefraction: 1.0,
        edgeLighting: true, blur: FoundationBlur.Step, at: at
    )
}

// The pill shows what has been typed; empty and unfocused it shows the prompt, and
// focused it shows a caret so an empty field still reads as ready for input.
function searchText(query: borrow String, focused: Bool) -> String {
    if query.count > 0 {
        return query
    }
    if focused {
        return "|"
    }
    return "Search"
}

// One ink, like the sidebar labels: the placeholder separates itself by opacity,
// not by hue. A blue-grey lost against the glass's own wash and the bright photo
// behind it, so it read as no text at all.
function searchTint(query: borrow String, focused: Bool, at: Float) -> Color {
    if query.count > 0 || focused {
        return schemeInk(1, at, 1.0)
    }
    return schemeInk(1, at, 0.72)
}

// Bottom dock: a round glass button that pins the note, and a glass search pill
// that takes keyboard input while focused (click it, type, backspace, enter clears).
function glassDock(context: borrow FoundationUiContext, demoUser: RawPtr, query: String, notePinned: Bool, at: Float) -> FoundationView {
    let togglePin: () -> Void = { in
        var demo = nativeRecover<GlassDemoState>(demoUser)
        demo.notePinned = !demo.notePinned
        return
    }
    let typeCodepoint: (Int) -> Void = { codepoint in
        var demo = nativeRecover<GlassDemoState>(demoUser)
        demo.query = foundationAppendCodepoint(demo.query, codepoint)
        return
    }
    let backspace: () -> Void = { in
        var demo = nativeRecover<GlassDemoState>(demoUser)
        demo.query = foundationDropLastScalar(demo.query)
        return
    }
    let clear: () -> Void = { in
        var demo = nativeRecover<GlassDemoState>(demoUser)
        demo.query = ""
        return
    }
    let searchFocused = context.focusedKey == searchKey()
    let buttonHot = context.hoveredKey == addKey() || context.pressedKey == addKey() || notePinned
    var buttonFrost = FoundationFrost.XHigh
    if buttonHot {
        buttonFrost = FoundationFrost.Max
    }
    let button = GestureHitArea(
        key: addKey(),
        disabled: false,
        onPress: move togglePin,
        interaction: FoundationInteraction {},
        children: [
            glassSurface(
                children: [centered(addIcon(at))],
                w: 44.0, h: 44.0, radius: 22.0, frost: move buttonFrost, edgeRefraction: 1.0,
                edgeLighting: true, blur: FoundationBlur.Step, at: at
            )
        ]
    )
    var pillFrost = FoundationFrost.XHigh
    if searchFocused {
        pillFrost = FoundationFrost.Max
    }
    let pill = InteractiveHitArea(
        key: searchKey(),
        focusable: true,
        disabled: false,
        onPress: ignoreAction,
        onTextInput: ignoreText,
        onTextCodepoint: move typeCodepoint,
        onBackspace: move backspace,
        onSubmit: move clear,
        onScroll: ignoreScroll,
        children: [
            glassSurface(
                children: [
                    Frame(
                        child: AdaptiveText(searchText(query, searchFocused), searchTint(query, searchFocused, at), 15.0, 500.0),
                        width: SizeMode.Fill,
                        height: SizeMode.Fill,
                        flex: 0,
                        alignment: Alignment.Leading,
                        padding: EdgeInsets {
                            top: 0.0
                            trailing: 0.0
                            bottom: 0.0
                            leading: 18.0
                        }
                    )
                ],
                w: 330.0, h: 44.0, radius: 22.0, frost: move pillFrost, edgeRefraction: 1.0,
                edgeLighting: true, blur: FoundationBlur.Step, at: at
            )
        ]
    )
    // Search first, the round button hugging the corner: right-aligned chrome
    // reads outward from the edge.
    return HStack(
        children: [move pill, move button],
        spacing: 9.0,
        padding: EdgeInsets {}
    )
}

// One swatch of the frost scale: a small glass card carrying nothing but its step's
// wash. Every swatch shares the radius and edge refraction of its neighbours, so the
// strip isolates exactly one variable — the material a FoundationFrost step names.
//
// There is no blur strip beside it any more. Blur is not a scale a design picks
// from: it is there to keep a half-resolution capture from reading as one, it
// follows the step, and a row advertising it as a choice said otherwise.
function frostSwatch(demoUser: RawPtr, level: Int, label: String, frost: FoundationFrost, selected: Bool, at: Float) -> FoundationView {
    let choose: () -> Void = { in
        var demo = nativeRecover<GlassDemoState>(demoUser)
        demo.frostLevel = level
        return
    }
    var weight = 600.0
    if selected {
        weight = 800.0
    }
    return GestureHitArea(
        key: frostKey(level),
        disabled: false,
        onPress: move choose,
        interaction: FoundationInteraction {},
        children: [
            glassSurface(
                children: [
                    centered(AdaptiveText(move label, glassForeground(at), 12.0, weight))
                ],
                w: 122.0, h: 74.0, radius: 22.0, frost: move frost, edgeRefraction: 1.0,
                edgeLighting: true, blur: FoundationBlur.Step, at: at
            )
        ]
    )
}

// The scale end to end, left to right: Translucent adds no wash at all (the
// refracted backdrop as it is) through Max, the strongest tint the scale defines.
function frostStrip(demoUser: RawPtr, selectedLevel: Int, at: Float) -> FoundationView {
    return HStack(
        children: [
            frostSwatch(demoUser, 0, "Translucent", FoundationFrost.Translucent, selectedLevel == 0, at),
            frostSwatch(demoUser, 1, "Light", FoundationFrost.Light, selectedLevel == 1, at),
            frostSwatch(demoUser, 2, "Medium", FoundationFrost.Medium, selectedLevel == 2, at),
            frostSwatch(demoUser, 3, "High", FoundationFrost.High, selectedLevel == 3, at),
            frostSwatch(demoUser, 4, "XHigh", FoundationFrost.XHigh, selectedLevel == 4, at),
            frostSwatch(demoUser, 5, "Max", FoundationFrost.Max, selectedLevel == 5, at)
        ],
        spacing: 11.0,
        padding: EdgeInsets {}
    )
}

function headline(at: Float) -> FoundationView {
    return VStack(
        children: [
            Text("Liquid Glass", glassForeground(at), 42.0, 800.0),
            Text("UI Foundation — real backdrop capture and refraction", glassForeground(at), 16.0, 500.0)
        ],
        spacing: 8.0,
        padding: EdgeInsets {}
    )
}

function rootView(context: borrow FoundationUiContext, demoUser: RawPtr, textureId: Int, darkTextureId: Int, backdropOff: Bool, selected: Int, frostLevel: Int, query: String, notePinned: Bool, at: Float) -> FoundationView {
    var layers: [FoundationView] = []
    if textureId > 0 {
        layers.append(TextureView(
            texture: textureId,
            width: SizeMode.Fill,
            height: SizeMode.Fill,
            flex: 0,
            opacity: 1.0,
            radius: 0.0,
            secondaryTexture: darkTextureId,
            transition: at
        ))
    }
    if textureId == 0 && !backdropOff {
        // Backdrop blob not found: say so instead of refracting a blank wall. A run
        // that asked for no backdrop (KIRA_GLASS_BG="") skips the notice.
        layers.append(Frame(
            child: Text("assets/background-cubes-cool.rgba could not be read — run from the example package directory, or set KIRA_GLASS_BG to a 1600x900 RGBA8 blob", glassForeground(at), 16.0, 600.0),
            width: SizeMode.Fill,
            height: SizeMode.Fill,
            flex: 0,
            alignment: Alignment.TopLeading,
            padding: EdgeInsets {
                top: 24.0
                trailing: 24.0
                bottom: 0.0
                leading: 24.0
            }
        ))
    }
    // Inset on every edge it touches by the same margin. The island is as tall as
    // that leaves it — the layout works the height out, nobody writes it down.
    layers.append(Frame(
        child: glassSidebar(context, demoUser, selected, at),
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        alignment: Alignment.Leading,
        padding: EdgeInsets {
            top: sidebarInset()
            trailing: 0.0
            bottom: sidebarInset()
            leading: sidebarInset()
        }
    ))
    // The headline starts past the sidebar island, not under it.
    layers.append(Frame(
        child: headline(at),
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        alignment: Alignment.TopLeading,
        padding: EdgeInsets {
            top: 44.0
            trailing: 0.0
            bottom: 0.0
            leading: sidebarInset() + sidebarWidth() + 44.0
        }
    ))
    layers.append(centered(glassCard(selected, notePinned, frostLevel, at)))
    // The frost scale, on the bottom margin like every other island: six identical
    // surfaces that differ only in the material their FoundationFrost step names.
    layers.append(Frame(
        child: frostStrip(demoUser, frostLevel, at),
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        alignment: Alignment.Bottom,
        padding: EdgeInsets {
            top: 0.0
            trailing: 0.0
            bottom: sidebarInset()
            leading: 0.0
        }
    ))
    layers.append(Frame(
        child: glassDock(context, demoUser, move query, notePinned, at),
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        alignment: Alignment.TopTrailing,
        padding: EdgeInsets {
            top: sidebarInset()
            trailing: sidebarInset()
            bottom: 0.0
            leading: 0.0
        }
    ))
    // A Fill-arranged Surface stacks its children over the same bounds: the photo
    // backdrop, then the chrome layers above it.
    // The page behind everything. It only shows with the photo off, but it has to
    // be the scheme's own page — glass over a white wall in dark mode is a light UI
    // with dark chrome on it.
    let pageLight = Color { r: 1.0 g: 1.0 b: 1.0 a: 1.0 }
    let pageDark = Color { r: 0.07 g: 0.07 b: 0.08 a: 1.0 }
    var page = mixColor(pageLight, pageDark, at)
    if textureId > 0 {
        // The opaque photo covers the page completely. Keep the page only for the
        // documented backdrop-off/missing-asset state instead of drawing another
        // fullscreen 4K layer underneath it.
        page.a = 0.0
    }
    return Surface(
        children: move layers,
        width: SizeMode.Fill,
        height: SizeMode.Fill,
        flex: 0,
        fill: move page,
        border: Color { r: 0.0 g: 0.0 b: 0.0 a: 0.0 },
        borderWidth: 0.0,
        radius: 0.0,
        shape: FoundationShape.RegularRoundedRect,
        material: FoundationMaterial.Flat,
        effects: [],
        padding: EdgeInsets {},
        clipContent: false
    )
}

@Main
function main() {
    let storage = nativeState(GlassDemoState {})
    let demoUser = nativeUserData(storage)
    RunFoundationInteractiveApp(
        title: "Kira UI Foundation Liquid Glass",
        // 1920x1080 logical points on a 2x Retina display presents at native 4K.
        width: 1920,
        height: 1080,
        rootBuilder: { ui in
            var demo = nativeRecover<GlassDemoState>(demoUser)
            return rootView(ui, demoUser, demo.textureId, demo.darkTextureId, demo.backdropOff, demo.selected, demo.frostLevel, demo.query, demo.notePinned, demo.schemeAt)
        },
        engineFrame: { frame in
            var demo = nativeRecover<GlassDemoState>(demoUser)
            // Walk the scheme position toward whichever mode was asked for. A step
            // per frame, and it lands exactly on the end rather than approaching it
            // forever, so "arrived" is a state the app actually reaches.
            var target = 0.0
            if demo.dark {
                target = 1.0
            }
            // Distance still to cover, measured from where this move began. The
            // duration is scaled by it, so a move interrupted near its end finishes
            // briskly instead of taking a full transition to travel a sliver.
            var span = target - demo.schemeFrom
            if span < 0.0 {
                span = 0.0 - span
            }
            if span < 0.0001 {
                demo.schemeProgress = 1.0
                demo.schemeAt = target
            } else {
                if demo.schemeProgress < 1.0 {
                    let seconds = foundationFrameDuration(frame)
                    demo.schemeProgress = demo.schemeProgress + schemeStep(seconds) / span
                    if demo.schemeProgress > 1.0 {
                        demo.schemeProgress = 1.0
                    }
                }
                // The curve shapes the MOVE: 0 is where it set off, 1 is the
                // destination, and it reads the same run in either direction.
                demo.schemeAt = demo.schemeFrom + (target - demo.schemeFrom) * schemeEase(demo.schemeProgress)
            }
            if !demo.attempted {
                demo.attempted = true
                let graphics = foundationFrameGraphics(frame)
                // `KIRA_GLASS_BG` overrides for a scripted run; otherwise the
                // asset is beside the package, which is where `kira run` starts.
                demo.backdropOff = environmentValueIsEmpty("KIRA_GLASS_BG")
                var id = 0
                var darkId = 0
                if !demo.backdropOff {
                    id = glassBackdropView(graphics, "background-cubes-cool.rgba")
                    // The original photograph, still here and still loadable —
                    // point KIRA_GLASS_BG at it, or delete the cool one and this
                    // takes over.
                    if id == 0 {
                        id = glassBackdropView(graphics, "background-cubes.rgba")
                    }
                    darkId = glassBackdropView(graphics, "background-cubes-cool-dark.rgba")
                }
                demo.textureId = id
                // If a checkout predates the dark asset, keep the primary texture
                // valid at both ends instead of sampling the atlas fallback.
                if darkId == 0 {
                    darkId = id
                }
                demo.darkTextureId = darkId
            }
            return
        },
        needsRebuild: { in
            var demo = nativeRecover<GlassDemoState>(demoUser)
            return demo.schemeProgress < 1.0
        },
        showFpsOverlay: true,
        showGraphicsHud: true
    )
    return
}

// One backdrop asset, tried at the two directories a run actually starts in:
// the example package itself, and the ui-foundation checkout above it. Named
// once here rather than spelled at every call site, so adding an asset does not
// add a ladder.
function glassLoadBackdrop(graphics: borrow Graphics, name: borrow String) -> Result<Int, ResourceFailure> {
    attempt {
        let view = try loadRgbaTexture(graphics, "assets/" + name, 1600, 900)
        return .Ok(view)
    } handle {
        // Not beside the package — try the checkout above it. This is the only
        // failure a second path can fix, which is why it is the only one that
        // retries: a device that refused the upload will refuse it again, and
        // retrying would turn one clear reason into two identical ones.
        AssetUnreadable { return loadRgbaTexture(graphics, "Examples/liquid-glass-app/assets/" + name, 1600, 900) }
        DeviceRefused { return .Error(.DeviceRefused) }
        ShaderRejected { return .Error(.ShaderRejected) }
    }
}

// The backdrop's view id, or 0 with the reason on the log.
//
// `KIRA_GLASS_BG` overrides for a scripted run; otherwise the asset is beside
// the package. The widget layer downstream already draws its notice when the id
// is 0 — what this adds is that a run which *did* find the file and still got
// nothing says so, instead of leaving a reader to conclude the path was wrong.
function glassBackdropView(graphics: borrow Graphics, name: borrow String) -> Int {
    attempt {
        let view = try glassBackdropOutcome(graphics, name)
        return view
    } handle {
        AssetUnreadable { return 0 }
        DeviceRefused { return reportBackdrop(name, .DeviceRefused) }
        ShaderRejected { return reportBackdrop(name, .ShaderRejected) }
    }
}

// The environment override first, then the asset beside the package.
function glassBackdropOutcome(graphics: borrow Graphics, name: borrow String) -> Result<Int, ResourceFailure> {
    attempt {
        let overridden = try loadRgbaTextureFromEnvironment(graphics, "KIRA_GLASS_BG", 1600, 900)
        return .Ok(overridden)
    } handle {
        AssetUnreadable { return glassLoadBackdrop(graphics, name) }
        DeviceRefused { return .Error(.DeviceRefused) }
        ShaderRejected { return .Error(.ShaderRejected) }
    }
}

function reportBackdrop(name: borrow String, failure: ResourceFailure) -> Int {
    printLine("liquid-glass: " + name + " loaded no backdrop — " + resourceFailureReason(move failure))
    return 0
}
